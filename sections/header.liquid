<header class="site-header">

  <div class="site-header__inner">

    <!-- =====================================================
         NAVIGATION GAUCHE
    ====================================================== -->

    <nav class="site-header__nav site-header__nav--left">


      <!-- =================================================
           BOUTIQUE + MEGA MENU
      ================================================== -->

      <div class="site-header__item site-header__item--dropdown">

        <a
          href="/pages/boutique?view=vetements"
          class="site-header__link"
        >
          BOUTIQUE
        </a>


        <div class="site-header__dropdown">

          <div class="site-header__dropdown-inner">


            <!-- =============================================
                 NAVIGATION MEGA MENU
            ============================================== -->

            <div class="site-header__mega-navigation">

              <div class="site-header__mega-column">

                <p class="site-header__mega-heading">
                  VÊTEMENTS
                </p>


                <a
                  href="/pages/collection-001?view=collection-001"
                  class="site-header__mega-collection site-header__mega-link"
                >
                  COLLECTION 001
                </a>


                <div class="site-header__mega-links">

                  {% if section.settings.all_link != blank %}

                    <a
                      href="{{ section.settings.all_link }}"
                      class="site-header__mega-link"
                    >
                      Tous
                    </a>

                  {% endif %}


                  {% if section.settings.tshirts_link != blank %}

                    <a
                      href="{{ section.settings.tshirts_link }}"
                      class="site-header__mega-link"
                    >
                      T-Shirts
                    </a>

                  {% endif %}


                  {% if section.settings.hoodies_link != blank %}

                    <a
                      href="{{ section.settings.hoodies_link }}"
                      class="site-header__mega-link"
                    >
                      Hoodies
                    </a>

                  {% endif %}


                  {% if section.settings.sweatshirts_link != blank %}

                    <a
                      href="{{ section.settings.sweatshirts_link }}"
                      class="site-header__mega-link"
                    >
                      Sweatshirts
                    </a>

                  {% endif %}

                </div>

              </div>

            </div>


            <!-- =============================================
                 VISUELS DROITE
            ============================================== -->

            <div class="site-header__mega-featured">


              <!-- VISUEL 01 -->

              {% if section.settings.menu_image_1 != blank %}

                <a
                  href="{{ section.settings.menu_image_link_1 | default: '#' }}"
                  class="site-header__mega-card"
                >

                  <div class="site-header__mega-image-wrap">

                    {{
                      section.settings.menu_image_1
                      | image_url: width: 1200
                      | image_tag:
                        class: 'site-header__mega-image',
                        loading: 'lazy'
                    }}

                  </div>


                  <div class="site-header__mega-card-info">

                    {% if section.settings.menu_image_title_1 != blank %}

                      <p class="site-header__mega-card-title">
                        {{ section.settings.menu_image_title_1 }}
                      </p>

                    {% endif %}


                    {% if section.settings.menu_image_subtitle_1 != blank %}

                      <p class="site-header__mega-card-subtitle">
                        {{ section.settings.menu_image_subtitle_1 }}
                      </p>

                    {% endif %}

                  </div>

                </a>

              {% endif %}


              <!-- VISUEL 02 -->

              {% if section.settings.menu_image_2 != blank %}

                <a
                  href="{{ section.settings.menu_image_link_2 | default: '#' }}"
                  class="site-header__mega-card"
                >

                  <div class="site-header__mega-image-wrap">

                    {{
                      section.settings.menu_image_2
                      | image_url: width: 1200
                      | image_tag:
                        class: 'site-header__mega-image',
                        loading: 'lazy'
                    }}

                  </div>


                  <div class="site-header__mega-card-info">

                    {% if section.settings.menu_image_title_2 != blank %}

                      <p class="site-header__mega-card-title">
                        {{ section.settings.menu_image_title_2 }}
                      </p>

                    {% endif %}


                    {% if section.settings.menu_image_subtitle_2 != blank %}

                      <p class="site-header__mega-card-subtitle">
                        {{ section.settings.menu_image_subtitle_2 }}
                      </p>

                    {% endif %}

                  </div>

                </a>

              {% endif %}

            </div>

          </div>

        </div>

      </div>


      <!-- =================================================
           CLUB PRIVILÈGES
      ================================================== -->

      <a
        href="/pages/club-privileges?view=club-privileges"
        class="site-header__link"
      >
        CLUB PRIVILÈGES
      </a>


      <!-- =================================================
           CONTACT
      ================================================== -->

      <a
        href="/pages/contact?view=contact"
        class="site-header__link"
      >
        CONTACT
      </a>

    </nav>


    <!-- =====================================================
         LOGO CENTRE
    ====================================================== -->

    <a
      href="{{ routes.root_url }}"
      class="site-header__logo"
    >

      {% if section.settings.logo != blank %}

        {{
          section.settings.logo
          | image_url: width: 600
          | image_tag:
            class: 'site-header__logo-image',
            loading: 'eager',
            alt: shop.name
        }}

      {% else %}

        POUR

      {% endif %}

    </a>


    <!-- =====================================================
         ACTIONS DROITE
    ====================================================== -->

    <div class="site-header__actions">

      <a
        href="{{ routes.account_url }}"
        class="site-header__link"
      >
        COMPTE
      </a>


      <button
        type="button"
        class="site-header__link site-header__cart"
        data-cart-drawer-open
        aria-label="Ouvrir le panier"
      >
        PANIER{% if cart.item_count > 0 %} ({{ cart.item_count }}){% endif %}
      </button>

    </div>

  </div>

</header>



<!-- =========================================================
     CART DRAWER — OVERLAY
========================================================= -->

<div
  class="cart-drawer-overlay"
  data-cart-drawer-overlay
></div>



<!-- =========================================================
     CART DRAWER
========================================================= -->

<aside
  class="cart-drawer"
  data-cart-drawer
  aria-hidden="true"
>

  <!-- HEADER -->

  <div class="cart-drawer__header">

    <p class="cart-drawer__title">
      PANIER
    </p>


    <button
      type="button"
      class="cart-drawer__close"
      data-cart-drawer-close
      aria-label="Fermer le panier"
    >
      ×
    </button>

  </div>


  {% if cart.item_count > 0 %}


    <!-- =====================================================
         PRODUITS
    ====================================================== -->

    <div class="cart-drawer__items">

      {% for item in cart.items %}

        <div
  class="cart-drawer__item"
  data-cart-item
  data-key="{{ item.key }}"
>


          <!-- IMAGE -->

          <a
            href="{{ item.url }}"
            class="cart-drawer__media"
          >

            {% if item.image != blank %}

              {{
                item.image
                | image_url: width: 600
                | image_tag:
                  class: 'cart-drawer__image',
                  loading: 'lazy',
                  alt: item.product.title
              }}

            {% endif %}

          </a>


          <!-- CONTENU -->

          <div class="cart-drawer__content">

            <a
              href="{{ item.url }}"
              class="cart-drawer__item-title"
            >
              {{ item.product.title }}
            </a>


            <p class="cart-drawer__item-price">
              {{ item.final_line_price | money }}
            </p>


            {% unless item.product.has_only_default_variant %}

              <div class="cart-drawer__variants">

                {% for option in item.options_with_values %}

                  <p>
                    {{ option.value }}
                  </p>

                {% endfor %}

              </div>

            {% endunless %}


            <!-- =============================================
                 QUANTITÉ + SUPPRIMER
            ============================================== -->

            <div class="cart-drawer__actions">


              <div class="cart-drawer__quantity">

                <button
  type="button"
  data-cart-change
  data-key="{{ item.key }}"
  data-quantity="{{ item.quantity | minus: 1 }}"
  aria-label="Réduire la quantité"
>
  −
</button>

<span data-cart-quantity>
  {{ item.quantity }}
</span>

<button
  type="button"
  data-cart-change
  data-key="{{ item.key }}"
  data-quantity="{{ item.quantity | plus: 1 }}"
  aria-label="Augmenter la quantité"
>
  +
</button>

              </div>

<button
  type="button"
  class="cart-drawer__remove"
  data-cart-change
  data-key="{{ item.key }}"
  data-quantity="0"
>
  SUPPRIMER
</button>

            </div>

          </div>

        </div>

      {% endfor %}

    </div>


    <!-- =====================================================
         BAS DU DRAWER
    ====================================================== -->

    <div class="cart-drawer__footer">

      <div class="cart-drawer__total">

        <span>
          SOUS-TOTAL
        </span>

       <span data-cart-total>
  {{ cart.total_price | money }}
</span>

      </div>


      <p class="cart-drawer__shipping">
        Livraison et taxes calculées à l’étape suivante.
      </p>


      <form
        action="{{ routes.cart_url }}"
        method="post"
      >

        <button
          type="submit"
          name="checkout"
          class="cart-drawer__checkout"
        >

          <span>
            PASSER AU PAIEMENT
          </span>

          <span aria-hidden="true">
            →
          </span>

        </button>

      </form>


      <a
        href="{{ routes.cart_url }}"
        class="cart-drawer__view-cart"
      >
        VOIR LE PANIER
      </a>

    </div>


  {% else %}


    <!-- =====================================================
         PANIER VIDE
    ====================================================== -->

    <div class="cart-drawer__empty">

      <p>
        VOTRE PANIER EST VIDE.
      </p>


      <a href="/pages/boutique?view=vetements">
        DÉCOUVRIR LA COLLECTION
      </a>

    </div>

  {% endif %}

</aside>



<style>

/* =========================================================
   PANIER HEADER
========================================================= */

.site-header__actions .site-header__cart {
  padding: 0 !important;
  margin: 0 !important;

  min-width: 0 !important;
  min-height: 0 !important;

  width: auto !important;
  height: auto !important;

  border: 0 !important;

  background: transparent !important;

  appearance: none !important;
  -webkit-appearance: none !important;

  font-family:
    "Helvetica Neue",
    Helvetica,
    Arial,
    sans-serif !important;

  font-size: 12px !important;
  font-weight: 400 !important;

  line-height: 1 !important;

  letter-spacing: 0 !important;

  color: #111111 !important;

  cursor: pointer;

  text-decoration: none;
}



/* =========================================================
   ÉVITE LE PETIT REBOND À L'OUVERTURE
========================================================= */

html {
  scrollbar-gutter: stable;
}


body.cart-drawer-open {
  overflow: hidden;
}



/* =========================================================
   OVERLAY
========================================================= */

.cart-drawer-overlay {
  position: fixed;

  inset: 0;

  z-index: 99998;

  background:
    rgba(0, 0, 0, .38);

  opacity: 0;

  visibility: hidden;

  pointer-events: none;

  transition:
    opacity .45s cubic-bezier(.22,1,.36,1),
    visibility .45s ease;
}


.cart-drawer-overlay.is-active {
  opacity: 1;

  visibility: visible;

  pointer-events: auto;
}



/* =========================================================
   DRAWER
========================================================= */

.cart-drawer {
  position: fixed;

  top: 0;
  right: 0;

  z-index: 99999;

  display: flex;
  flex-direction: column;

  width: min(510px, 92vw);

  height: 100vh;
  height: 100dvh;

  background: #ffffff;

  color: #111111;

  transform:
    translate3d(100%, 0, 0);

  transition:
    transform .6s cubic-bezier(.76,0,.24,1);

  will-change: transform;

  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;

  font-family:
    "Helvetica Neue",
    Helvetica,
    Arial,
    sans-serif;

  box-shadow:
    -10px
    0
    35px
    rgba(0,0,0,.08);
}


.cart-drawer.is-active {
  transform:
    translate3d(0, 0, 0);
}



/* =========================================================
   HEADER DRAWER
========================================================= */

.cart-drawer__header {
  display: flex;

  align-items: center;
  justify-content: space-between;

  min-height: 74px;

  padding:
    0
    34px;

  flex-shrink: 0;

  border-bottom:
    1px solid
    rgba(17,17,17,.10);
}


.cart-drawer__title {
  margin: 0;

  font-size: 11px;
  font-weight: 400;

  letter-spacing: .18em;

  text-transform: uppercase;
}


.cart-drawer__close {
  display: flex;

  align-items: center;
  justify-content: center;

  width: 30px;
  height: 30px;

  padding: 0;

  border: 0;

  background: transparent;

  color: #111111;

  font-family: inherit;

  font-size: 26px;
  font-weight: 200;

  line-height: 1;

  cursor: pointer;

  appearance: none;
  -webkit-appearance: none;

  transition:
    transform .35s ease;
}


.cart-drawer__close:hover {
  transform: rotate(90deg);
}



/* =========================================================
   ITEMS
========================================================= */

.cart-drawer__items {
  flex: 1;

  min-height: 0;

  overflow-y: auto;
  overscroll-behavior: contain;

  padding:
    25px
    34px;
}


.cart-drawer__item {
  display: grid;

  grid-template-columns:
    125px
    minmax(0,1fr);

  gap: 22px;

  padding:
    22px
    0;

  border-bottom:
    1px solid
    rgba(17,17,17,.09);

  transition: opacity .25s ease;
}

.cart-drawer__item.is-removing {
  opacity: .35;
  pointer-events: none;
}

/* IMAGE */

.cart-drawer__media {
  display: block;

  width: 125px;

  overflow: hidden;

  text-decoration: none;
}


.cart-drawer__image {
  display: block;

  width: 100%;
  height: auto;

  transform: translateZ(0);

  backface-visibility: hidden;
}



/* =========================================================
   CONTENU PRODUIT
========================================================= */

.cart-drawer__content {
  display: flex;

  flex-direction: column;

  justify-content: flex-start;

  min-width: 0;
}


.cart-drawer__item-title {
  color: #111111;

  font-size: 11px;
  font-weight: 400;

  line-height: 1.25;

  letter-spacing: .08em;

  text-transform: uppercase;

  text-decoration: none;
}


.cart-drawer__item-price {
  margin:
    10px
    0
    0;

  font-size: 10px;

  color:
    rgba(17,17,17,.55);
}


.cart-drawer__variants {
  margin-top: 8px;
}


.cart-drawer__variants p {
  margin:
    2px
    0
    0;

  font-size: 9px;

  color:
    rgba(17,17,17,.48);
}



/* =========================================================
   ACTIONS PRODUIT
========================================================= */

.cart-drawer__actions {
  display: flex;

  align-items: center;
  justify-content: space-between;

  gap: 15px;

  margin-top: 22px;
}



/* QUANTITÉ */

.cart-drawer__quantity {
  display: grid;

  grid-template-columns:
    32px
    32px
    32px;

  height: 32px;

  border:
    1px solid
    rgba(17,17,17,.18);
}


.cart-drawer__quantity button,
.cart-drawer__quantity span {
  display: flex;

  align-items: center;
  justify-content: center;

  width: 32px;
  height: 32px;

  padding: 0;
  margin: 0;

  border: 0;

  background: transparent;

  color: #111111;

  font-family: inherit;

  font-size: 11px;
  font-weight: 400;

  line-height: 1;

  appearance: none;
  -webkit-appearance: none;
}


.cart-drawer__quantity button {
  cursor: pointer;

  transition:
    background-color .25s ease;
}


.cart-drawer__quantity button:hover {
  background:
    rgba(17,17,17,.05);
}



/* =========================================================
   SUPPRIMER
========================================================= */

.cart-drawer__remove {
  position: relative;

  padding:
    0
    0
    4px;

  margin: 0;

  border: 0;

  background: transparent;

  color:
    rgba(17,17,17,.55);

  font-family: inherit;

  font-size: 8px;
  font-weight: 400;

  line-height: 1;

  letter-spacing: .10em;

  text-transform: uppercase;

  cursor: pointer;

  appearance: none;
  -webkit-appearance: none;
}


.cart-drawer__remove::after {
  content: "";

  position: absolute;

  left: 0;
  bottom: 0;

  width: 100%;
  height: 1px;

  background: currentColor;

  transform-origin: left;

  transition:
    transform .4s cubic-bezier(.22,1,.36,1);
}


.cart-drawer__remove:hover::after {
  transform: scaleX(.4);
}



/* =========================================================
   FOOTER DRAWER
========================================================= */

.cart-drawer__footer {
  flex-shrink: 0;

  padding:
    28px
    34px
    32px;

  border-top:
    1px solid
    rgba(17,17,17,.10);

  background: #ffffff;
}


.cart-drawer__total {
  display: flex;

  align-items: center;
  justify-content: space-between;

  gap: 30px;

  font-size: 10px;

  letter-spacing: .08em;

  text-transform: uppercase;
}


.cart-drawer__shipping {
  margin:
    13px
    0
    0;

  font-size: 9px;

  line-height: 1.45;

  color:
    rgba(17,17,17,.50);
}



/* =========================================================
   CHECKOUT
========================================================= */

.cart-drawer__checkout {
  display: flex;

  align-items: center;
  justify-content: space-between;

  width: 100%;

  min-height: 52px;

  margin-top: 22px;

  padding:
    0
    20px;

  border:
    1px solid
    #111111;

  border-radius: 0;

  background: #111111;

  color: #ffffff;

  font-family: inherit;

  font-size: 9px;
  font-weight: 400;

  letter-spacing: .11em;

  text-transform: uppercase;

  cursor: pointer;

  appearance: none;
  -webkit-appearance: none;

  transition:
    background-color .5s cubic-bezier(.22,1,.36,1),
    color .5s cubic-bezier(.22,1,.36,1);
}


.cart-drawer__checkout:hover {
  background: #ffffff;

  color: #111111;
}



/* =========================================================
   VOIR LE PANIER
========================================================= */

.cart-drawer__view-cart {
  display: block;

  width: max-content;

  margin:
    18px
    auto
    0;

  padding-bottom: 4px;

  border-bottom:
    1px solid
    currentColor;

  color: #111111;

  font-size: 8px;

  letter-spacing: .12em;

  text-decoration: none;

  text-transform: uppercase;
}



/* =========================================================
   PANIER VIDE
========================================================= */

.cart-drawer__empty {
  display: flex;

  flex: 1;

  flex-direction: column;

  align-items: center;
  justify-content: center;

  padding: 40px;

  text-align: center;
}


.cart-drawer__empty p {
  margin: 0;

  font-size: 24px;

  font-weight: 400;

  letter-spacing: -.03em;
}


.cart-drawer__empty a {
  margin-top: 24px;

  padding-bottom: 5px;

  border-bottom:
    1px solid
    currentColor;

  color: #111111;

  font-size: 9px;

  letter-spacing: .12em;

  text-decoration: none;

  text-transform: uppercase;
}



/* =========================================================
   MOBILE
========================================================= */

@media screen and (max-width: 600px) {

  .cart-drawer {
    width: 100%;
  }


  .cart-drawer__header {
    padding:
      0
      20px;
  }


  .cart-drawer__items {
    padding:
      20px;
  }


  .cart-drawer__item {
    grid-template-columns:
      105px
      minmax(0,1fr);

    gap: 16px;
  }


  .cart-drawer__media {
    width: 105px;
  }


  .cart-drawer__footer {
    padding:
      24px
      20px
      28px;
  }

}

</style>



<script>

(function () {

  /* =========================================================
     ÉVITE D'INITIALISER LE SCRIPT PLUSIEURS FOIS
  ========================================================= */

  if (window.__pourCartSystemLoaded) {
    return;
  }

  window.__pourCartSystemLoaded = true;



  /* =========================================================
     UTILITAIRES
  ========================================================= */

  function getRoot() {

    if (
      window.Shopify &&
      Shopify.routes &&
      Shopify.routes.root
    ) {
      return Shopify.routes.root;
    }

    return '/';

  }


  function getCurrency() {

    if (
      window.Shopify &&
      Shopify.currency &&
      Shopify.currency.active
    ) {
      return Shopify.currency.active;
    }

    return 'EUR';

  }


  function money(cents) {

    try {

      return new Intl.NumberFormat(
        'fr-FR',
        {
          style: 'currency',
          currency: getCurrency()
        }
      ).format(cents / 100);

    } catch (error) {

      return (cents / 100)
        .toFixed(2)
        .replace('.', ',') + ' €';

    }

  }


  function escapeHTML(value) {

    const div =
      document.createElement('div');

    div.textContent =
      value == null ? '' : String(value);

    return div.innerHTML;

  }



  /* =========================================================
     OUVERTURE DU DRAWER
  ========================================================= */

  function openDrawer() {

    const drawer =
      document.querySelector(
        '[data-cart-drawer]'
      );

    const overlay =
      document.querySelector(
        '[data-cart-drawer-overlay]'
      );


    if (!drawer || !overlay) {
      return;
    }


    drawer.classList.add(
      'is-active'
    );

    overlay.classList.add(
      'is-active'
    );


    drawer.setAttribute(
      'aria-hidden',
      'false'
    );


    document.body.classList.add(
      'cart-drawer-open'
    );

  }



  /* =========================================================
     FERMETURE
  ========================================================= */

  function closeDrawer() {

    const drawer =
      document.querySelector(
        '[data-cart-drawer]'
      );

    const overlay =
      document.querySelector(
        '[data-cart-drawer-overlay]'
      );


    if (drawer) {

      drawer.classList.remove(
        'is-active'
      );

      drawer.setAttribute(
        'aria-hidden',
        'true'
      );

    }


    if (overlay) {

      overlay.classList.remove(
        'is-active'
      );

    }


    document.body.classList.remove(
      'cart-drawer-open'
    );

  }



  /* =========================================================
     COMPTEUR HEADER
  ========================================================= */

  function updateHeaderCartCount(cart) {

    document
      .querySelectorAll(
        '[data-cart-drawer-open]'
      )
      .forEach((button) => {

        button.textContent =
          cart.item_count > 0
            ? `PANIER (${cart.item_count})`
            : 'PANIER';

      });

  }



  /* =========================================================
     RECONSTRUCTION DU DRAWER
  ========================================================= */

  async function refreshDrawer() {

    const root =
      getRoot();


    const response =
      await fetch(
        root + 'cart.js',
        {
          headers: {
            Accept:
              'application/json'
          }
        }
      );


    if (!response.ok) {
      throw new Error(
        'Impossible de charger le panier.'
      );
    }


    const cart =
      await response.json();


    updateHeaderCartCount(cart);


    const drawer =
      document.querySelector(
        '[data-cart-drawer]'
      );


    if (!drawer) {
      return cart;
    }



    /* =====================================================
       PANIER VIDE
    ====================================================== */

    if (cart.item_count === 0) {

      drawer.innerHTML = `

        <div class="cart-drawer__header">

          <p class="cart-drawer__title">
            PANIER
          </p>

          <button
            type="button"
            class="cart-drawer__close"
            data-cart-drawer-close
            aria-label="Fermer le panier"
          >
            ×
          </button>

        </div>


        <div class="cart-drawer__empty">

          <p>
            VOTRE PANIER EST VIDE.
          </p>

          <a href="/pages/boutique?view=vetements">
            DÉCOUVRIR LA COLLECTION
          </a>

        </div>
      `;


      return cart;

    }



    /* =====================================================
       ITEMS
    ====================================================== */

    const itemsHTML =
      cart.items
        .map(
          (item, index) => {

            const imageHTML =
              item.image
                ? `
                  <img
                    src="${escapeHTML(item.image)}"
                    class="cart-drawer__image"
                    alt="${escapeHTML(item.product_title)}"
                    loading="lazy"
                  >
                `
                : '';


            const variantHTML =
              item.variant_title &&
              item.variant_title !== 'Default Title'
                ? `
                  <div class="cart-drawer__variants">
                    <p>
                      ${escapeHTML(item.variant_title)}
                    </p>
                  </div>
                `
                : '';


           return `

  <div
    class="cart-drawer__item"
    data-cart-item
    data-key="${escapeHTML(item.key)}"
  >

    <a
      href="${escapeHTML(item.url)}"
      class="cart-drawer__media"
    >
      ${imageHTML}
    </a>


    <div class="cart-drawer__content">

      <a
        href="${escapeHTML(item.url)}"
        class="cart-drawer__item-title"
      >
        ${escapeHTML(item.product_title)}
      </a>


      <p class="cart-drawer__item-price">
        ${money(item.final_line_price)}
      </p>


      ${variantHTML}


      <div class="cart-drawer__actions">

        <div class="cart-drawer__quantity">

          <button
            type="button"
            data-cart-change
            data-key="${escapeHTML(item.key)}"
            data-quantity="${Math.max(0, item.quantity - 1)}"
            aria-label="Réduire la quantité"
          >
            −
          </button>


          <span data-cart-quantity>
            ${item.quantity}
          </span>


          <button
            type="button"
            data-cart-change
            data-key="${escapeHTML(item.key)}"
            data-quantity="${item.quantity + 1}"
            aria-label="Augmenter la quantité"
          >
            +
          </button>

        </div>


        <button
          type="button"
          class="cart-drawer__remove"
          data-cart-change
          data-key="${escapeHTML(item.key)}"
          data-quantity="0"
        >
          SUPPRIMER
        </button>

      </div>

    </div>

  </div>
`;

          }
        )
        .join('');



    drawer.innerHTML = `

      <div class="cart-drawer__header">

        <p class="cart-drawer__title">
          PANIER
        </p>


        <button
          type="button"
          class="cart-drawer__close"
          data-cart-drawer-close
          aria-label="Fermer le panier"
        >
          ×
        </button>

      </div>


      <div class="cart-drawer__items">
        ${itemsHTML}
      </div>


      <div class="cart-drawer__footer">

        <div class="cart-drawer__total">

          <span>
            SOUS-TOTAL
          </span>

          <span data-cart-total>
  ${money(cart.total_price)}
</span>

        </div>


        <p class="cart-drawer__shipping">
          Livraison et taxes calculées à l’étape suivante.
        </p>


        <form
          action="${root}cart"
          method="post"
        >

          <button
            type="submit"
            name="checkout"
            class="cart-drawer__checkout"
          >

            <span>
              PASSER AU PAIEMENT
            </span>

            <span aria-hidden="true">
              →
            </span>

          </button>

        </form>


        <a
          href="${root}cart"
          class="cart-drawer__view-cart"
        >
          VOIR LE PANIER
        </a>

      </div>
    `;


    return cart;

  }



  /* =========================================================
     CLICK GLOBAL
  ========================================================= */

  document.addEventListener(
    'click',
    async function (event) {


      /* OUVERTURE */

      const openButton =
        event.target.closest(
          '[data-cart-drawer-open]'
        );


      if (openButton) {

        event.preventDefault();

        openDrawer();

        return;

      }



      /* FERMETURE */

      const closeButton =
        event.target.closest(
          '[data-cart-drawer-close]'
        );


      if (closeButton) {

        event.preventDefault();

        closeDrawer();

        return;

      }



      /* OVERLAY */

      if (
        event.target.matches(
          '[data-cart-drawer-overlay]'
        )
      ) {

        closeDrawer();

        return;

      }



      /* =====================================================
   QUANTITÉ / SUPPRIMER — MISE À JOUR INSTANTANÉE
===================================================== */

const changeButton =
  event.target.closest(
    '[data-cart-change]'
  );

if (changeButton) {

  event.preventDefault();

  const key =
    changeButton.dataset.key;

  const newQuantity =
    Math.max(
      0,
      Number(changeButton.dataset.quantity)
    );

  if (!key) {
    return;
  }


  const itemElement =
    changeButton.closest(
      '[data-cart-item]'
    );

  const quantityElement =
    itemElement
      ? itemElement.querySelector(
          '[data-cart-quantity]'
        )
      : null;


  /*
    Quantité actuellement affichée.
    On la garde pour pouvoir revenir en arrière
    si Shopify renvoie une erreur.
  */

  const previousQuantity =
    quantityElement
      ? Number(quantityElement.textContent.trim())
      : 0;


  /* =====================================================
     MISE À JOUR VISUELLE IMMÉDIATE
  ===================================================== */

  if (
    newQuantity > 0 &&
    quantityElement
  ) {

    quantityElement.textContent =
      newQuantity;


    /*
      Actualise immédiatement les nouvelles valeurs
      des boutons + et −.
    */

    const buttons =
      itemElement.querySelectorAll(
        '[data-cart-change]'
      );

    buttons.forEach((button) => {

      if (
        button.classList.contains(
          'cart-drawer__remove'
        )
      ) {

        button.dataset.quantity = 0;

        return;

      }


      const symbol =
        button.textContent.trim();


      if (symbol === '−') {

        button.dataset.quantity =
          Math.max(
            0,
            newQuantity - 1
          );

      }


      if (symbol === '+') {

        button.dataset.quantity =
          newQuantity + 1;

      }

    });

  }


  /*
    SUPPRIMER :
    on ne détruit pas immédiatement le HTML,
    mais on atténue légèrement le produit pendant
    la requête pour garder quelque chose de fluide.
  */

  if (
    newQuantity === 0 &&
    itemElement
  ) {

    itemElement.classList.add(
      'is-removing'
    );

  }


  try {

    const response =
      await fetch(
        getRoot() + 'cart/change.js',
        {
          method: 'POST',

          headers: {
            'Content-Type':
              'application/json',

            Accept:
              'application/json'
          },

          body:
            JSON.stringify({
              id: key,
              quantity: newQuantity
            })
        }
      );


    if (!response.ok) {

      throw new Error(
        'Impossible de modifier le panier.'
      );

    }


    const cart =
      await response.json();


    /* =====================================================
       COMPTEUR DU HEADER
    ===================================================== */

    updateHeaderCartCount(cart);


    /* =====================================================
       SUPPRESSION CONFIRMÉE
    ===================================================== */

    if (
      newQuantity === 0 &&
      itemElement
    ) {

      itemElement.remove();

    }


    /* =====================================================
       TOTAL
    ===================================================== */

    const totalElement =
      document.querySelector(
        '[data-cart-total]'
      );


    if (totalElement) {

      totalElement.textContent =
        money(cart.total_price);

    }


    /* =====================================================
       PANIER VIDE
    ===================================================== */

    if (cart.item_count === 0) {

      await refreshDrawer();

      openDrawer();

    }


  } catch (error) {

    console.error(
      'POUR Cart:',
      error
    );


    /*
      Shopify a refusé :
      on remet la quantité précédente.
    */

    if (
      quantityElement &&
      previousQuantity > 0
    ) {

      quantityElement.textContent =
        previousQuantity;

    }


    if (itemElement) {

      itemElement.classList.remove(
        'is-removing'
      );

    }

  }


  return;

}

    }
  );



  /* =========================================================
     AJOUT PRODUIT AU PANIER EN AJAX
  ========================================================= */

  document.addEventListener(
    'submit',
    async function (event) {

      const form =
        event.target.closest(
          'form[action*="/cart/add"]'
        );


      if (!form) {
        return;
      }


      event.preventDefault();


      const submitButton =
        form.querySelector(
          '[type="submit"]'
        );


      if (submitButton) {
        submitButton.disabled = true;
      }


      try {

        const response =
          await fetch(
            getRoot() + 'cart/add.js',
            {
              method: 'POST',

              headers: {
                Accept:
                  'application/json'
              },

              body:
                new FormData(form)
            }
          );


        if (!response.ok) {

          const data =
            await response.json();

          throw new Error(
            data.description ||
            'Impossible d’ajouter ce produit.'
          );

        }


        await refreshDrawer();


        openDrawer();


      } catch (error) {

        console.error(
          'POUR Add to cart:',
          error
        );


        alert(
          error.message ||
          'Une erreur est survenue.'
        );

      } finally {

        if (submitButton) {
          submitButton.disabled = false;
        }

      }

    }
  );



  /* =========================================================
     ESCAPE
  ========================================================= */

  document.addEventListener(
    'keydown',
    function (event) {

      if (event.key === 'Escape') {
        closeDrawer();
      }

    }
  );

})();

</script>



