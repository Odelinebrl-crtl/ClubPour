<header class="site-header">
  <div class="site-header__inner">

    <nav class="site-header__nav site-header__nav--left">

      <div class="site-header__item site-header__item--dropdown">
        <a href="/collections/all" class="site-header__link">
          Vêtements
        </a>

        <div class="site-header__dropdown">
          <a href="/collections/collection-001">
            Collection 001
          </a>
        </div>
      </div>

      <a href="/pages/club-privileges" class="site-header__link">
        Club Privilèges
      </a>

      <a href="/pages/contact" class="site-header__link">
        Contact
      </a>

    </nav>

    <a href="{{ routes.root_url }}" class="site-header__logo">
      {% if section.settings.logo != blank %}
        {{
          section.settings.logo
          | image_url: width: 600
          | image_tag:
            class: 'site-header__logo-image',
            loading: 'eager',
            alt: shop.name
        }}
      {% else %}
        POUR
      {% endif %}
    </a>

    <div class="site-header__actions">

      <a href="{{ routes.account_url }}" class="site-header__link">
        Compte
      </a>

      <a href="{{ routes.cart_url }}" class="site-header__cart">
        Panier{% if cart.item_count > 0 %} ({{ cart.item_count }}){% endif %}
      </a>

    </div>

  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    }
  ]
}
{% endschema %}
