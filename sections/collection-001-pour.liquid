</style>



<script>

(function () {

  function initCollection001Intro() {

    const section =
      document.getElementById(
        'Collection001Pour-{{ section.id }}'
      );

    if (!section) return;


    const elements =
      section.querySelectorAll(
        '.collection001-pour__intro-reveal'
      );


    elements.forEach((element) => {

      const delay =
        element.getAttribute(
          'data-delay'
        ) || 0;


      element.style.setProperty(
        '--collection-intro-delay',
        delay + 'ms'
      );

    });


    const observer =
      new IntersectionObserver(
        (entries) => {

          entries.forEach((entry) => {

            entry.target.classList.toggle(
              'is-visible',
              entry.isIntersecting
            );

          });

        },
        {
          threshold: .18,
          rootMargin:
            '0px 0px -5% 0px'
        }
      );


    elements.forEach((element) => {

      observer.observe(element);

    });

  }


  if (
    document.readyState === 'loading'
  ) {

    document.addEventListener(
      'DOMContentLoaded',
      initCollection001Intro
    );

  } else {

    initCollection001Intro();

  }


  document.addEventListener(
    'shopify:section:load',
    initCollection001Intro
  );

})();

</script>



