<section
  id="Collection001Pour-{{ section.id }}"
  class="collection001-pour"
>

  <div
    id="collection-content"
    class="collection001-pour__anchor"
    aria-hidden="true"
  ></div>


  <!-- =====================================================
       INTRO
  ====================================================== -->

  <div class="collection001-pour__intro">

    <p
      class="collection001-pour__eyebrow collection001-pour__intro-reveal"
      data-delay="0"
    >
      COLLECTION 001
    </p>

    {% if section.settings.heading != blank %}
      <h1
        class="collection001-pour__title collection001-pour__intro-reveal"
        data-delay="100"
      >
        {{ section.settings.heading }}
      </h1>
    {% endif %}

    {% if section.settings.intro_text != blank %}
      <p
        class="collection001-pour__lead collection001-pour__intro-reveal"
        data-delay="190"
      >
        {{ section.settings.intro_text }}
      </p>
    {% endif %}

  </div>


  <!-- =====================================================
       FOCUS 01
  ====================================================== -->

  {% if section.settings.product_1 != blank %}

    {% assign product_1 = section.settings.product_1 %}

    <div class="collection001-pour__focus collection001-pour__focus--left">

      <!-- GRAND PRODUIT + TEXTE -->

      <div class="collection001-pour__focus-main">

        <div class="collection001-pour__focus-media">

          {% if section.settings.image_1 != blank %}

            {{
              section.settings.image_1
              | image_url: width: 1800
              | image_tag:
                class: 'collection001-pour__focus-image',
                loading: 'lazy',
                alt: product_1.title
            }}

          {% elsif product_1.featured_image != blank %}

            {{
              product_1.featured_image
              | image_url: width: 1800
              | image_tag:
                class: 'collection001-pour__focus-image',
                loading: 'lazy',
                alt: product_1.title
            }}

          {% endif %}

        </div>


        <div class="collection001-pour__focus-content">

          <p class="collection001-pour__number">
            01
          </p>

          <h2 class="collection001-pour__focus-title">
            {{ product_1.title }}
          </h2>

          <p class="collection001-pour__price">
            {{ product_1.price | money }}
          </p>

          <a
            href="{{ product_1.url }}"
            class="collection001-pour__link"
          >
            DÉCOUVRIR
          </a>

        </div>

      </div>


      <!-- MINI PRODUITS DROITE -->

      <div class="collection001-pour__mini-grid">

        {% for i in (1..4) %}

          {% assign product_key = 'focus_1_product_' | append: i %}
          {% assign image_key = 'focus_1_image_' | append: i %}

          {% assign mini_product = section.settings[product_key] %}
          {% assign mini_image = section.settings[image_key] %}

          {% if mini_product != blank %}

           <article class="collection001-pour__mini-card">

  <div class="collection001-pour__mini-media">

    <a
      href="{{ mini_product.url }}"
      class="collection001-pour__mini-media-link"
      aria-label="{{ mini_product.title }}"
    >

      {% if mini_image != blank %}

        {{
          mini_image
          | image_url: width: 1200
          | image_tag:
            class: 'collection001-pour__mini-image',
            loading: 'lazy',
            alt: mini_product.title
        }}

      {% elsif mini_product.featured_image != blank %}

        {{
          mini_product.featured_image
          | image_url: width: 1200
          | image_tag:
            class: 'collection001-pour__mini-image',
            loading: 'lazy',
            alt: mini_product.title
        }}

      {% endif %}

    </a>


    <button
      type="button"
      class="collection001-pour__mini-quick-add"
      data-collection-mini-quick-add
      data-product-handle="{{ mini_product.handle }}"
      aria-label="Ajouter rapidement {{ mini_product.title }}"
    ></button>

  </div>


  <a
    href="{{ mini_product.url }}"
    class="collection001-pour__mini-info-link"
  >

    <div class="collection001-pour__mini-info">

      <p class="collection001-pour__mini-title">
        {{ mini_product.title }}
      </p>

      <p class="collection001-pour__mini-price">
        {{ mini_product.price | money }}
      </p>

    </div>

  </a>

</article>

          {% endif %}

        {% endfor %}

      </div>

    </div>

  {% endif %}


  <!-- =====================================================
       FOCUS 02
  ====================================================== -->

  {% if section.settings.product_2 != blank %}

    {% assign product_2 = section.settings.product_2 %}

    <div class="collection001-pour__focus collection001-pour__focus--right">

      <!-- MINI PRODUITS GAUCHE -->

      <div class="collection001-pour__mini-grid">

        {% for i in (1..4) %}

          {% assign product_key = 'focus_2_product_' | append: i %}
          {% assign image_key = 'focus_2_image_' | append: i %}

          {% assign mini_product = section.settings[product_key] %}
          {% assign mini_image = section.settings[image_key] %}

          {% if mini_product != blank %}

            <article class="collection001-pour__mini-card">

  <div class="collection001-pour__mini-media">

    <a
      href="{{ mini_product.url }}"
      class="collection001-pour__mini-media-link"
      aria-label="{{ mini_product.title }}"
    >

      {% if mini_image != blank %}

        {{
          mini_image
          | image_url: width: 1200
          | image_tag:
            class: 'collection001-pour__mini-image',
            loading: 'lazy',
            alt: mini_product.title
        }}

      {% elsif mini_product.featured_image != blank %}

        {{
          mini_product.featured_image
          | image_url: width: 1200
          | image_tag:
            class: 'collection001-pour__mini-image',
            loading: 'lazy',
            alt: mini_product.title
        }}

      {% endif %}

    </a>


    <button
      type="button"
      class="collection001-pour__mini-quick-add"
      data-collection-mini-quick-add
      data-product-handle="{{ mini_product.handle }}"
      aria-label="Ajouter rapidement {{ mini_product.title }}"
    ></button>

  </div>


  <a
    href="{{ mini_product.url }}"
    class="collection001-pour__mini-info-link"
  >

    <div class="collection001-pour__mini-info">

      <p class="collection001-pour__mini-title">
        {{ mini_product.title }}
      </p>

      <p class="collection001-pour__mini-price">
        {{ mini_product.price | money }}
      </p>

    </div>

  </a>

</article>

          {% endif %}

        {% endfor %}

      </div>


      <!-- TEXTE + GRAND PRODUIT -->

      <div class="collection001-pour__focus-main">

        <div class="collection001-pour__focus-content">

          <p class="collection001-pour__number">
            02
          </p>

          <h2 class="collection001-pour__focus-title">
            {{ product_2.title }}
          </h2>

          <p class="collection001-pour__price">
            {{ product_2.price | money }}
          </p>

          <a
            href="{{ product_2.url }}"
            class="collection001-pour__link"
          >
            DÉCOUVRIR
          </a>

        </div>


        <div class="collection001-pour__focus-media">

          {% if section.settings.image_2 != blank %}

            {{
              section.settings.image_2
              | image_url: width: 1800
              | image_tag:
                class: 'collection001-pour__focus-image',
                loading: 'lazy',
                alt: product_2.title
            }}

          {% elsif product_2.featured_image != blank %}

            {{
              product_2.featured_image
              | image_url: width: 1800
              | image_tag:
                class: 'collection001-pour__focus-image',
                loading: 'lazy',
                alt: product_2.title
            }}

          {% endif %}

        </div>

      </div>

    </div>

  {% endif %}
<!-- =====================================================
     QUICK VIEW MINIATURES
====================================================== -->

<div
  class="collection-mini-qv__overlay"
  data-collection-mini-qv-overlay
></div>

<div
  class="collection-mini-qv"
  data-collection-mini-qv
  aria-hidden="true"
>

  <button
    type="button"
    class="collection-mini-qv__close"
    data-collection-mini-qv-close
    aria-label="Fermer"
  ></button>

  <div
    class="collection-mini-qv__inner"
    data-collection-mini-qv-content
  ></div>

</div>
</section>


<style>

/* =========================================================
   COLLECTION 001
========================================================= */

#Collection001Pour-{{ section.id }} {
  position: relative;

  width: 100vw;
  max-width: none;

  margin-left: calc(50% - 50vw);
  margin-right: calc(50% - 50vw);

  padding: 0;

  overflow: hidden;

  background: #ffffff;
  color: #111111;

  font-family:
    "Helvetica Neue",
    Helvetica,
    Arial,
    sans-serif;
}


#Collection001Pour-{{ section.id }}
.collection001-pour__anchor {
  position: absolute;

  top: 0;
  left: 0;

  width: 1px;
  height: 1px;

  pointer-events: none;
}


/* =========================================================
   INTRO
========================================================= */

#Collection001Pour-{{ section.id }}
.collection001-pour__intro {
  width: 100%;

  padding:
    90px
    54px
    115px;

  box-sizing: border-box;

  text-align: center;
}


#Collection001Pour-{{ section.id }}
.collection001-pour__eyebrow {
  margin: 0 0 24px;

  font-size: 9px;
  font-weight: 400;

  line-height: 1;

  letter-spacing: .22em;

  text-transform: uppercase;

  color: rgba(17,17,17,.46);
}


#Collection001Pour-{{ section.id }}
.collection001-pour__title {
  max-width: 980px;

  margin: 0 auto;

  font-size:
    clamp(
      46px,
      6vw,
      92px
    );

  font-weight: 400;

  line-height: .92;

  letter-spacing: -.055em;

  text-transform: uppercase;
}


#Collection001Pour-{{ section.id }}
.collection001-pour__lead {
  max-width: 560px;

  margin: 34px auto 0;

  font-size: 13px;

  line-height: 1.6;

  color: rgba(17,17,17,.62);
}


/* =========================================================
   INTRO — SCROLL REVEAL
========================================================= */

#Collection001Pour-{{ section.id }}
.collection001-pour__intro-reveal {
  opacity: 0;

  transform: translateY(45px);

  transition:
    opacity .9s cubic-bezier(.22,1,.36,1),
    transform .9s cubic-bezier(.22,1,.36,1);

  transition-delay:
    var(--collection-intro-delay, 0ms);

  will-change:
    opacity,
    transform;
}


#Collection001Pour-{{ section.id }}
.collection001-pour__intro-reveal.is-visible {
  opacity: 1;

  transform: translateY(0);
}


/* =========================================================
   FOCUS BASE
========================================================= */

#Collection001Pour-{{ section.id }}
.collection001-pour__focus {
  display: grid;

  align-items: center;

  width: 100%;

  box-sizing: border-box;
}


/* =========================================================
   FOCUS 01
========================================================= */

#Collection001Pour-{{ section.id }}
.collection001-pour__focus--left {
  grid-template-columns:
    minmax(0, 1fr)
    500px;

  gap: 42px;

  padding:
    65px
    54px
    130px;
}


/* =========================================================
   FOCUS 02
========================================================= */

#Collection001Pour-{{ section.id }}
.collection001-pour__focus--right {
  grid-template-columns:
    500px
    minmax(0, 1fr);

  gap: 42px;

  padding:
    65px
    54px
    130px;
}


/* =========================================================
   PRINCIPAL + TEXTE
========================================================= */

#Collection001Pour-{{ section.id }}
.collection001-pour__focus-main {
  display: grid;

  grid-template-columns:
    500px
    260px;

  align-items: center;

  gap: 42px;

  min-width: 0;
}


/* FOCUS 01 À GAUCHE */

#Collection001Pour-{{ section.id }}
.collection001-pour__focus--left
.collection001-pour__focus-main {
  justify-self: start;
}


/* FOCUS 02 À DROITE */

#Collection001Pour-{{ section.id }}
.collection001-pour__focus--right
.collection001-pour__focus-main {
  grid-template-columns:
    260px
    500px;

  justify-self: end;

  width: 802px;

  margin-left: auto;
  margin-right: 0;
}


/* =========================================================
   GRANDE IMAGE
========================================================= */

#Collection001Pour-{{ section.id }}
.collection001-pour__focus-media {
  width: 500px;
  max-width: 500px;

  overflow: hidden;
}


#Collection001Pour-{{ section.id }}
.collection001-pour__focus-image {
  display: block;

  width: 100%;
  height: auto;

  object-fit: contain;
}


/* FORCE LE FOCUS 02 AU BORD DROIT */

#Collection001Pour-{{ section.id }}
.collection001-pour__focus--right
.collection001-pour__focus-media {
  justify-self: end;
}


/* =========================================================
   TEXTE PRINCIPAL
========================================================= */

#Collection001Pour-{{ section.id }}
.collection001-pour__focus-content {
  width: 100%;

  max-width: 260px;
}


#Collection001Pour-{{ section.id }}
.collection001-pour__number {
  margin: 0 0 24px;

  font-size: 9px;

  color: rgba(17,17,17,.40);
}


#Collection001Pour-{{ section.id }}
.collection001-pour__focus-title {
  margin: 0;

  font-size:
    clamp(
      32px,
      3.1vw,
      52px
    );

  font-weight: 400;

  line-height: .98;

  letter-spacing: -.045em;

  text-transform: uppercase;
}


#Collection001Pour-{{ section.id }}
.collection001-pour__price {
  margin: 24px 0 0;

  font-size: 11px;

  color: rgba(17,17,17,.54);
}


/* =========================================================
   DÉCOUVRIR
========================================================= */

#Collection001Pour-{{ section.id }}
.collection001-pour__link {
  position: relative;

  display: inline-block;

  margin-top: 34px;

  padding-bottom: 5px;

  font-size: 10px;

  letter-spacing: .06em;

  text-transform: uppercase;

  text-decoration: none;

  color: #111111;
}


#Collection001Pour-{{ section.id }}
.collection001-pour__link::after {
  content: "";

  position: absolute;

  left: 0;
  bottom: 0;

  width: 100%;
  height: 1px;

  background: currentColor;

  transform-origin: left center;

  transition:
    transform .4s cubic-bezier(.22,1,.36,1);
}


#Collection001Pour-{{ section.id }}
.collection001-pour__link:hover::after {
  transform: scaleX(.45);
}


/* =========================================================
   MINI PRODUITS
========================================================= */

#Collection001Pour-{{ section.id }}
.collection001-pour__mini-grid {
  display: grid;

  grid-template-columns:
    repeat(2, 220px);

  gap:
    38px
    28px;

  width: 468px;

  align-items: start;
}


/* FOCUS 01 MINI À DROITE */

#Collection001Pour-{{ section.id }}
.collection001-pour__focus--left
.collection001-pour__mini-grid {
  justify-self: end;
}


/* FOCUS 02 MINI À GAUCHE */

#Collection001Pour-{{ section.id }}
.collection001-pour__focus--right
.collection001-pour__mini-grid {
  justify-self: start;
}


#Collection001Pour-{{ section.id }}
.collection001-pour__mini-card {
  display: block;

  width: 220px;

  color: #111111;

  text-decoration: none;
}


#Collection001Pour-{{ section.id }}
.collection001-pour__mini-media {
  width: 220px;
  height: 280px;

  overflow: hidden;

  background: #FAF9F6;
}


#Collection001Pour-{{ section.id }}
.collection001-pour__mini-image {
  display: block;

  width: 100%;
  height: 100%;

  object-fit: cover;

  transition:
    transform .65s cubic-bezier(.22,1,.36,1);
}


#Collection001Pour-{{ section.id }}
.collection001-pour__mini-card:hover
.collection001-pour__mini-image {
  transform: scale(1.035);
}


#Collection001Pour-{{ section.id }}
.collection001-pour__mini-info {
  padding-top: 11px;
}


#Collection001Pour-{{ section.id }}
.collection001-pour__mini-title {
  margin: 0;

  font-size: 10px;

  line-height: 1.25;

  text-transform: uppercase;
}


#Collection001Pour-{{ section.id }}
.collection001-pour__mini-price {
  margin: 5px 0 0;

  font-size: 9px;

  color: rgba(17,17,17,.48);
}

/* =========================================================
   MINIATURES — QUICK ADD
========================================================= */

#Collection001Pour-{{ section.id }}
.collection001-pour__mini-media {
  position: relative;
}

#Collection001Pour-{{ section.id }}
.collection001-pour__mini-media-link,
#Collection001Pour-{{ section.id }}
.collection001-pour__mini-info-link {
  display: block;
  color: inherit;
  text-decoration: none;
}


/* PETIT + */

#Collection001Pour-{{ section.id }}
.collection001-pour__mini-quick-add {
  position: absolute;

  right: 7px;
  bottom: 7px;

  z-index: 10;

  width: 27px;
  height: 27px;

  min-width: 27px;
  min-height: 27px;

  padding: 0;
  margin: 0;

  border: 0;
  border-radius: 0;

  background: #ffffff;

  cursor: pointer;

  opacity: 0;
  visibility: hidden;

  transform: translateY(3px);

  transition:
    opacity .18s ease,
    visibility .18s ease,
    transform .24s cubic-bezier(.22,1,.36,1);

  appearance: none;
  -webkit-appearance: none;
}


/* + horizontal */

#Collection001Pour-{{ section.id }}
.collection001-pour__mini-quick-add::before {
  content: "";

  position: absolute;

  top: 50%;
  left: 50%;

  width: 9px;
  height: 1px;

  background: #111111;

  transform: translate(-50%, -50%);
}


/* + vertical */

#Collection001Pour-{{ section.id }}
.collection001-pour__mini-quick-add::after {
  content: "";

  position: absolute;

  top: 50%;
  left: 50%;

  width: 1px;
  height: 9px;

  background: #111111;

  transform: translate(-50%, -50%);
}


/* visible uniquement au hover */

#Collection001Pour-{{ section.id }}
.collection001-pour__mini-media:hover
.collection001-pour__mini-quick-add {
  opacity: 1;
  visibility: visible;

  transform: translateY(0);
}


/* =========================================================
   QUICK VIEW — OVERLAY
========================================================= */

#Collection001Pour-{{ section.id }}
.collection-mini-qv__overlay {
  position: fixed;
  inset: 0;

  z-index: 100000;

  background: rgba(0,0,0,.38);

  opacity: 0;
  visibility: hidden;

  pointer-events: none;

  transition:
    opacity .3s ease,
    visibility .3s ease;
}

#Collection001Pour-{{ section.id }}
.collection-mini-qv__overlay.is-active {
  opacity: 1;
  visibility: visible;

  pointer-events: auto;
}


/* =========================================================
   QUICK VIEW
========================================================= */

#Collection001Pour-{{ section.id }}
.collection-mini-qv {
  position: fixed;

  top: 50%;
  left: 50%;

  z-index: 100001;

  width: min(960px, calc(100vw - 80px));

  max-height: calc(100vh - 70px);

  overflow-y: auto;

  background: #ffffff;

  opacity: 0;
  visibility: hidden;

  pointer-events: none;

  transform: translate(-50%, -47%);

  transition:
    opacity .3s ease,
    visibility .3s ease,
    transform .45s cubic-bezier(.22,1,.36,1);
}

#Collection001Pour-{{ section.id }}
.collection-mini-qv.is-active {
  opacity: 1;
  visibility: visible;

  pointer-events: auto;

  transform: translate(-50%, -50%);
}


/* CROIX */

#Collection001Pour-{{ section.id }}
.collection-mini-qv__close {
  position: absolute;

  top: 24px;
  right: 24px;

  z-index: 10;

  width: 28px;
  height: 28px;

  padding: 0;

  border: 0;
  background: transparent;

  cursor: pointer;
}

#Collection001Pour-{{ section.id }}
.collection-mini-qv__close::before,
#Collection001Pour-{{ section.id }}
.collection-mini-qv__close::after {
  content: "";

  position: absolute;

  top: 50%;
  left: 50%;

  width: 18px;
  height: 1px;

  background: #111111;
}

#Collection001Pour-{{ section.id }}
.collection-mini-qv__close::before {
  transform: translate(-50%, -50%) rotate(45deg);
}

#Collection001Pour-{{ section.id }}
.collection-mini-qv__close::after {
  transform: translate(-50%, -50%) rotate(-45deg);
}


/* CONTENU */

#Collection001Pour-{{ section.id }}
.collection-mini-qv__inner {
  display: grid;

  grid-template-columns:
    minmax(0,1fr)
    minmax(320px,.9fr);

  align-items: center;

  min-height: 570px;

  padding: 65px 70px;
}

#Collection001Pour-{{ section.id }}
.collection-mini-qv__media {
  display: flex;
  align-items: center;
  justify-content: center;
}

#Collection001Pour-{{ section.id }}
.collection-mini-qv__image {
  display: block;

  width: 100%;
  max-width: 430px;
  max-height: 470px;

  object-fit: contain;
}

#Collection001Pour-{{ section.id }}
.collection-mini-qv__info {
  padding-left: 50px;
}

#Collection001Pour-{{ section.id }}
.collection-mini-qv__title {
  margin: 0;

  font-size: 16px;
  font-weight: 400;

  letter-spacing: .1em;

  text-transform: uppercase;
}

#Collection001Pour-{{ section.id }}
.collection-mini-qv__price {
  margin-top: 15px;

  font-size: 13px;

  color: rgba(17,17,17,.55);
}


/* TAILLES */

#Collection001Pour-{{ section.id }}
.collection-mini-qv__options {
  margin-top: 32px;
}

#Collection001Pour-{{ section.id }}
.collection-mini-qv__option-label {
  margin: 0 0 12px;

  font-size: 11px;
}

#Collection001Pour-{{ section.id }}
.collection-mini-qv__variants {
  display: flex;
  flex-wrap: wrap;

  gap: 8px;
}

#Collection001Pour-{{ section.id }}
.collection-mini-qv__variant {
  position: relative;
}

#Collection001Pour-{{ section.id }}
.collection-mini-qv__variant input {
  position: absolute;

  opacity: 0;

  pointer-events: none;
}

#Collection001Pour-{{ section.id }}
.collection-mini-qv__variant span {
  display: flex;

  align-items: center;
  justify-content: center;

  min-width: 46px;
  height: 42px;

  padding: 0 13px;

  border: 1px solid rgba(17,17,17,.18);

  font-size: 11px;

  cursor: pointer;
}


/* sélection fine, comme celle qu'on vient de corriger */

#Collection001Pour-{{ section.id }}
.collection-mini-qv__variant
input:checked + span {
  border: 1px solid #111111;
  box-shadow: none;
}


/* AJOUTER */

#Collection001Pour-{{ section.id }}
.collection-mini-qv__submit {
  display: flex;

  align-items: center;
  justify-content: center;

  width: 100%;
  height: 50px;

  margin-top: 30px;

  border: 1px solid #111111;

  background: #111111;
  color: #ffffff;

  font-size: 10px;

  letter-spacing: .15em;

  text-transform: uppercase;

  cursor: pointer;
}

#Collection001Pour-{{ section.id }}
.collection-mini-qv__details {
  display: inline-block;

  margin-top: 22px;

  padding-bottom: 4px;

  border-bottom: 1px solid currentColor;

  color: #111111;

  font-size: 9px;

  text-decoration: none;

  text-transform: uppercase;
}


#Collection001Pour-{{ section.id }}
.collection-mini-qv__loading {
  grid-column: 1 / -1;

  display: flex;
  align-items: center;
  justify-content: center;

  min-height: 440px;

  font-size: 9px;

  letter-spacing: .15em;
}


@media screen and (max-width: 750px) {

  #Collection001Pour-{{ section.id }}
  .collection-mini-qv {
    width: calc(100vw - 24px);

    max-height: calc(100vh - 24px);
  }

  #Collection001Pour-{{ section.id }}
  .collection-mini-qv__inner {
    grid-template-columns: 1fr;

    min-height: 0;

    padding: 60px 22px 35px;
  }

  #Collection001Pour-{{ section.id }}
  .collection-mini-qv__info {
    padding: 30px 0 0;
  }

}

@media (hover: none) {

  #Collection001Pour-{{ section.id }}
  .collection001-pour__mini-quick-add {
    opacity: 1;
    visibility: visible;

    transform: none;
  }

}
