<section
  id="Collection001Pour-{{ section.id }}"
  class="collection001-pour"
>

  <div
    id="collection-content"
    class="collection001-pour__anchor"
    aria-hidden="true"
  ></div>
  <!-- =========================================
       INTRO
  ========================================== -->

  <div class="collection001-pour__intro">

   <p class="collection001-pour__eyebrow collection001-pour__intro-reveal" data-delay="0">
      COLLECTION 001
    </p>

   <h1 class="collection001-pour__title collection001-pour__intro-reveal" data-delay="100">
      {{ section.settings.heading }}
    </h1>

    {% if section.settings.intro_text != blank %}
   <p class="collection001-pour__lead collection001-pour__intro-reveal" data-delay="190">
        {{ section.settings.intro_text }}
      </p>
    {% endif %}

  </div>


  <!-- =========================================
       FOCUS 01
  ========================================== -->

  {% if section.settings.product_1 != blank %}

    {% assign product_1 = section.settings.product_1 %}

    <div class="collection001-pour__focus">

      <div class="collection001-pour__focus-media">

        {% if section.settings.image_1 != blank %}

          {{
            section.settings.image_1
            | image_url: width: 2200
            | image_tag:
              class: 'collection001-pour__focus-image',
              loading: 'lazy'
          }}

        {% elsif product_1.featured_image != blank %}

          {{
            product_1.featured_image
            | image_url: width: 2200
            | image_tag:
              class: 'collection001-pour__focus-image',
              loading: 'lazy'
          }}

        {% endif %}

      </div>

      <div class="collection001-pour__focus-content">

        <p class="collection001-pour__number">
          01
        </p>

        <h2>
          {{ product_1.title }}
        </h2>

        <p class="collection001-pour__price">
          {{ product_1.price | money }}
        </p>

        <a
          href="{{ product_1.url }}"
          class="collection001-pour__link"
        >
          DÉCOUVRIR
        </a>

      </div>

    </div>

  {% endif %}


  <!-- =========================================
       FOCUS 02 — INVERSÉ
  ========================================== -->

  {% if section.settings.product_2 != blank %}

    {% assign product_2 = section.settings.product_2 %}

    <div class="collection001-pour__focus collection001-pour__focus--reverse">

      <div class="collection001-pour__focus-media">

        {% if section.settings.image_2 != blank %}

          {{
            section.settings.image_2
            | image_url: width: 2200
            | image_tag:
              class: 'collection001-pour__focus-image',
              loading: 'lazy'
          }}

        {% elsif product_2.featured_image != blank %}

          {{
            product_2.featured_image
            | image_url: width: 2200
            | image_tag:
              class: 'collection001-pour__focus-image',
              loading: 'lazy'
          }}

        {% endif %}

      </div>

      <div class="collection001-pour__focus-content">

        <p class="collection001-pour__number">
          02
        </p>

        <h2>
          {{ product_2.title }}
        </h2>

        <p class="collection001-pour__price">
          {{ product_2.price | money }}
        </p>

        <a
          href="{{ product_2.url }}"
          class="collection001-pour__link"
        >
          DÉCOUVRIR
        </a>

      </div>

    </div>

  {% endif %}


  <!-- =========================================
       GRILLE PRODUITS
  ========================================== -->

  <div class="collection001-pour__grid">

    {% for block in section.blocks %}

      {% assign product = block.settings.product %}

      {% if product != blank %}

        <a
          href="{{ product.url }}"
          class="collection001-pour__card"
          {{ block.shopify_attributes }}
        >

          <div class="collection001-pour__card-media">

            {% if block.settings.image != blank %}

              {{
                block.settings.image
                | image_url: width: 1400
                | image_tag:
                  class: 'collection001-pour__card-image',
                  loading: 'lazy'
              }}

            {% elsif product.featured_image != blank %}

              {{
                product.featured_image
                | image_url: width: 1400
                | image_tag:
                  class: 'collection001-pour__card-image',
                  loading: 'lazy'
              }}

            {% endif %}

          </div>

          <div class="collection001-pour__card-info">

            <h3>
              {{ product.title }}
            </h3>

            <p>
              {{ product.price | money }}
            </p>

          </div>

        </a>

      {% endif %}

    {% endfor %}

  </div>


#Collection001Pour-{{ section.id }}
.collection001-pour__intro-reveal.is-visible {
  opacity: 1;

  transform: translateY(0);
}

</section>

<style>

#Collection001Pour-{{ section.id }} {
  width: 100%;
  padding-top: 68px;

  background: #ffffff;
  color: #111111;

  font-family:
    "Helvetica Neue",
    Helvetica,
    Arial,
    sans-serif;
}


/* INTRO */

#Collection001Pour-{{ section.id }}
.collection001-pour__intro {
  padding:
    85px
    54px
    105px;

  text-align: center;
}

#Collection001Pour-{{ section.id }}
.collection001-pour__eyebrow {
  margin: 0 0 24px;

  font-size: 9px;
  letter-spacing: .22em;
  text-transform: uppercase;

  color: rgba(17,17,17,.48);
}

#Collection001Pour-{{ section.id }}
.collection001-pour__title {
  max-width: 1100px;

  margin: 0 auto;

  font-size:
    clamp(
      50px,
      7vw,
      110px
    );

  font-weight: 400;

  line-height: .9;
  letter-spacing: -.06em;

  text-transform: uppercase;
}

#Collection001Pour-{{ section.id }}
.collection001-pour__lead {
  max-width: 560px;

  margin: 40px auto 0;

  font-size: 13px;
  line-height: 1.6;

  color: rgba(17,17,17,.62);
}


/* FOCUS */

#Collection001Pour-{{ section.id }}
.collection001-pour__focus {
  display: grid;

  grid-template-columns:
    minmax(0, 1fr)
    minmax(260px, 360px);

  align-items: center;

  gap: clamp(50px, 7vw, 110px);

  width: min(1180px, calc(100% - 108px));

  margin: 0 auto;

  padding:
    45px
    0
    90px;
}

#Collection001Pour-{{ section.id }}
.collection001-pour__focus--reverse {
  grid-template-columns:
    minmax(260px, 360px)
    minmax(0, 1fr);
}

#Collection001Pour-{{ section.id }}
.collection001-pour__focus--reverse
.collection001-pour__focus-media {
  order: 2;
}

#Collection001Pour-{{ section.id }}
.collection001-pour__focus--reverse
.collection001-pour__focus-content {
  order: 1;
}

#Collection001Pour-{{ section.id }}
.collection001-pour__focus-media {
  width: 100%;
  max-width: 720px;
}

#Collection001Pour-{{ section.id }}
.collection001-pour__focus-image {
  display: block;

  width: 100%;
  height: auto;

  max-height: 540px;

  object-fit: contain;
}

#Collection001Pour-{{ section.id }}
.collection001-pour__focus-content {
  max-width: 380px;
}

#Collection001Pour-{{ section.id }}
.collection001-pour__number {
  margin: 0 0 28px;

  font-size: 9px;

  color: rgba(17,17,17,.45);
}

#Collection001Pour-{{ section.id }}
.collection001-pour__focus-content h2 {
  margin: 0;

  font-size:
    clamp(
      34px,
      4vw,
      64px
    );

  font-weight: 400;

  line-height: .95;

  text-transform: uppercase;
}

#Collection001Pour-{{ section.id }}
.collection001-pour__price {
  margin: 22px 0 0;

  font-size: 12px;

  color: #777;
}

#Collection001Pour-{{ section.id }}
.collection001-pour__link {
  position: relative;

  display: inline-block;

  margin-top: 34px;

  font-size: 10px;

  letter-spacing: .12em;

  text-transform: uppercase;
}

#Collection001Pour-{{ section.id }}
.collection001-pour__link::after {
  content: "";

  position: absolute;

  left: 0;
  bottom: -5px;

  width: 100%;
  height: 1px;

  background: #111111;
}


/* GRID */

#Collection001Pour-{{ section.id }}
.collection001-pour__grid {
  display: grid;

  grid-template-columns:
    repeat(3, minmax(0,1fr));

  gap: 70px 22px;

  padding:
    100px
    54px
    140px;
}

#Collection001Pour-{{ section.id }}
.collection001-pour__card {
  display: block;
}

#Collection001Pour-{{ section.id }}
.collection001-pour__card-media {
  width: 100%;
}

#Collection001Pour-{{ section.id }}
.collection001-pour__card-image {
  display: block;

  width: 100%;
  height: auto;
}

#Collection001Pour-{{ section.id }}
.collection001-pour__card-info {
  padding-top: 20px;

  text-align: center;
}

#Collection001Pour-{{ section.id }}
.collection001-pour__card-info h3 {
  margin: 0;

  font-size: 11px;
  font-weight: 400;

  text-transform: uppercase;
}

#Collection001Pour-{{ section.id }}
.collection001-pour__card-info p {
  margin: 8px 0 0;

  font-size: 11px;

  color: #777;
}
/* =========================================================
   INTRO COLLECTION 001 — SCROLL REVEAL
========================================================= */

#Collection001Pour-{{ section.id }}
.collection001-pour__intro-reveal {
  opacity: 0;

  transform: translateY(45px);

  transition:
    opacity .9s cubic-bezier(.22,1,.36,1),
    transform .9s cubic-bezier(.22,1,.36,1);

  transition-delay:
    var(--collection-intro-delay, 0ms);

  will-change:
    opacity,
    transform;
}


/* MOBILE */

@media screen and (max-width: 768px) {

  #Collection001Pour-{{ section.id }} {
    padding-top: 64px;
  }

  #Collection001Pour-{{ section.id }}
  .collection001-pour__intro {
    padding:
      80px
      18px
      100px;
  }

  #Collection001Pour-{{ section.id }}
  .collection001-pour__focus,
  #Collection001Pour-{{ section.id }}
  .collection001-pour__focus--reverse {
    grid-template-columns: 1fr;

    gap: 40px;

    padding:
      50px
      18px
      90px;
  }

  #Collection001Pour-{{ section.id }}
  .collection001-pour__focus--reverse
  .collection001-pour__focus-media,
  #Collection001Pour-{{ section.id }}
  .collection001-pour__focus--reverse
  .collection001-pour__focus-content {
    order: initial;
  }

  #Collection001Pour-{{ section.id }}
  .collection001-pour__grid {
    grid-template-columns:
      repeat(2, minmax(0,1fr));

    gap: 45px 10px;

    padding:
      70px
      16px
      100px;
  }

}

</style>
<script>
(function () {

  function initCollection001Intro() {

    const section =
      document.getElementById(
        'Collection001Pour-{{ section.id }}'
      );

    if (!section) return;


    const elements =
      section.querySelectorAll(
        '.collection001-pour__intro-reveal'
      );


    elements.forEach((element) => {

      const delay =
        element.getAttribute('data-delay') || 0;

      element.style.setProperty(
        '--collection-intro-delay',
        delay + 'ms'
      );

    });


    const observer =
      new IntersectionObserver(
        (entries) => {

          entries.forEach((entry) => {

            entry.target.classList.toggle(
              'is-visible',
              entry.isIntersecting
            );

          });

        },
        {
          threshold: .08,
          rootMargin: '0px 0px 10% 0px'
        }
      );


    elements.forEach((element) => {
      observer.observe(element);
    });

  }


  if (document.readyState === 'loading') {

    document.addEventListener(
      'DOMContentLoaded',
      initCollection001Intro
    );

  } else {

    initCollection001Intro();

  }


  document.addEventListener(
    'shopify:section:load',
    initCollection001Intro
  );

})();
</script>

{% schema %}
{
  "name": "Collection 001",

  "settings": [

    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "LA PREMIÈRE COLLECTION POUR"
    },

    {
      "type": "text",
      "id": "intro_text",
      "label": "Texte introduction",
      "default": "Huit pièces pensées autour de l’automobile, des destinations et de l’univers graphique POUR."
    },

    {
      "type": "header",
      "content": "Focus 01"
    },

    {
      "type": "product",
      "id": "product_1",
      "label": "Produit 01"
    },

    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image personnalisée 01"
    },

    {
      "type": "header",
      "content": "Focus 02"
    },

    {
      "type": "product",
      "id": "product_2",
      "label": "Produit 02"
    },

    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image personnalisée 02"
    }

  ],

  "blocks": [
    {
      "type": "product",
      "name": "Produit grille",
      "settings": [

        {
          "type": "product",
          "id": "product",
          "label": "Produit"
        },

        {
          "type": "image_picker",
          "id": "image",
          "label": "Image personnalisée"
        }

      ]
    }
  ],

  "max_blocks": 8,

  "presets": [
    {
      "name": "Collection 001"
    }
  ]
}
{% endschema %}
