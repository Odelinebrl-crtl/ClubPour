</style>


<script>

(function () {

  function initCollection001Intro() {

    const section =
      document.getElementById(
        'Collection001Pour-{{ section.id }}'
      );

    if (!section) return;


    const elements =
      section.querySelectorAll(
        '.collection001-pour__intro-reveal'
      );


    elements.forEach((element) => {

      const delay =
        element.getAttribute('data-delay') || 0;

      element.style.setProperty(
        '--collection-intro-delay',
        delay + 'ms'
      );

    });


    const observer =
      new IntersectionObserver(
        (entries) => {

          entries.forEach((entry) => {

            entry.target.classList.toggle(
              'is-visible',
              entry.isIntersecting
            );

          });

        },
        {
          threshold: .18,
          rootMargin: '0px 0px -5% 0px'
        }
      );


    elements.forEach((element) => {
      observer.observe(element);
    });

  }


  if (document.readyState === 'loading') {

    document.addEventListener(
      'DOMContentLoaded',
      initCollection001Intro
    );

  } else {

    initCollection001Intro();

  }


  document.addEventListener(
    'shopify:section:load',
    initCollection001Intro
  );

})();

</script>

<script>
(function () {

  const section =
    document.getElementById(
      'Collection001Pour-{{ section.id }}'
    );

  if (!section) return;


  const modal =
    section.querySelector(
      '[data-collection-mini-qv]'
    );

  const overlay =
    section.querySelector(
      '[data-collection-mini-qv-overlay]'
    );

  const content =
    section.querySelector(
      '[data-collection-mini-qv-content]'
    );


  if (!modal || !overlay || !content) {
    return;
  }


  function money(cents) {

    return new Intl.NumberFormat(
      'fr-FR',
      {
        style: 'currency',
        currency: 'EUR'
      }
    ).format(cents / 100);

  }


  function escapeHTML(value) {

    const div =
      document.createElement('div');

    div.textContent =
      value == null
        ? ''
        : String(value);

    return div.innerHTML;

  }


  function openModal() {

    modal.classList.add('is-active');
    overlay.classList.add('is-active');

    modal.setAttribute(
      'aria-hidden',
      'false'
    );

  }


  function closeModal() {

    modal.classList.remove('is-active');
    overlay.classList.remove('is-active');

    modal.setAttribute(
      'aria-hidden',
      'true'
    );

  }


  function variantsHTML(product) {

    const variants =
      product.variants || [];


    if (
      variants.length === 1 &&
      variants[0].title === 'Default Title'
    ) {

      return `
        <input
          type="hidden"
          name="id"
          value="${variants[0].id}"
        >
      `;

    }


    const firstAvailable =
      variants.findIndex(
        variant => variant.available
      );


    return `

      <div class="collection-mini-qv__options">

        <p class="collection-mini-qv__option-label">
          Taille :
        </p>

        <div class="collection-mini-qv__variants">

          ${variants.map(
            (variant, index) => {

              const checked =
                index === firstAvailable
                  ? 'checked'
                  : '';

              const disabled =
                variant.available
                  ? ''
                  : 'disabled';


              return `

                <label
                  class="
                    collection-mini-qv__variant
                    ${variant.available ? '' : 'is-disabled'}
                  "
                >

                  <input
                    type="radio"
                    name="id"
                    value="${variant.id}"
                    ${checked}
                    ${disabled}
                  >

                  <span>
                    ${escapeHTML(variant.title)}
                  </span>

                </label>
              `;

            }
          ).join('')}

        </div>

      </div>
    `;

  }


  async function loadProduct(handle) {

    content.innerHTML = `
      <div class="collection-mini-qv__loading">
        CHARGEMENT
      </div>
    `;

    openModal();


    try {

      const response =
        await fetch(
          `/products/${handle}.js`,
          {
            headers: {
              Accept: 'application/json'
            }
          }
        );


      if (!response.ok) {
        throw new Error();
      }


      const product =
        await response.json();


      const image =
        product.featured_image ||
        product.images?.[0] ||
        '';


      content.innerHTML = `

        <div class="collection-mini-qv__media">

          ${
            image
              ? `
                <img
                  src="${escapeHTML(image)}"
                  class="collection-mini-qv__image"
                  alt="${escapeHTML(product.title)}"
                >
              `
              : ''
          }

        </div>


        <div class="collection-mini-qv__info">

          <h2 class="collection-mini-qv__title">
            ${escapeHTML(product.title)}
          </h2>

          <p class="collection-mini-qv__price">
            ${money(product.price)}
          </p>


          <form
            action="/cart/add"
            method="post"
            class="collection-mini-qv__form"
          >

            ${variantsHTML(product)}

            <input
              type="hidden"
              name="quantity"
              value="1"
            >

            <button
              type="submit"
              class="collection-mini-qv__submit"
            >
              AJOUTER AU PANIER
            </button>

          </form>


          <a
            href="${escapeHTML(product.url)}"
            class="collection-mini-qv__details"
          >
            VOIR LE PRODUIT
          </a>

        </div>
      `;


    } catch (error) {

      content.innerHTML = `
        <div class="collection-mini-qv__loading">
          PRODUIT INDISPONIBLE
        </div>
      `;

    }

  }


  section.addEventListener(
    'click',
    function (event) {

      const button =
        event.target.closest(
          '[data-collection-mini-quick-add]'
        );


      if (button) {

        event.preventDefault();
        event.stopPropagation();

        const handle =
          button.dataset.productHandle;

        if (handle) {
          loadProduct(handle);
        }

        return;
      }


      if (
        event.target.closest(
          '[data-collection-mini-qv-close]'
        )
      ) {

        closeModal();
        return;
      }


      if (event.target === overlay) {
        closeModal();
      }

    }
  );


  /*
    Le header.liquid gère déjà /cart/add :
    donc aucune redirection vers la page panier.
  */

  document.addEventListener(
    'submit',
    function (event) {

      if (
        event.target.matches(
          '#Collection001Pour-{{ section.id }} .collection-mini-qv__form'
        )
      ) {

        window.setTimeout(
          closeModal,
          100
        );

      }

    }
  );


  document.addEventListener(
    'keydown',
    function (event) {

      if (event.key === 'Escape') {
        closeModal();
      }

    }
  );

})();
</script>
