<footer
  id="FooterPour-{{ section.id }}"
  class="footer-pour"
>

  <div class="footer-pour__inner">

    <!-- =====================================================
     CLUB PRIVILÈGE
====================================================== -->

<div class="footer-pour__column footer-pour__newsletter">

{% assign newsletter_return_url = routes.root_url | append: '?newsletter_success=true#footer-newsletter' %}

{% form 'customer', return_to: newsletter_return_url, class: 'footer-pour__form', id: 'footer-newsletter' %}

    <input
      type="hidden"
      name="contact[tags]"
      value="club-privileges"
    >

  {% unless form.posted_successfully? %}
      <p class="footer-pour__heading">
        REJOIGNEZ LE CLUB PRIVILÈGE
      </p>

      <p class="footer-pour__newsletter-text">
        Inscrivez-vous au Club Privilège POUR pour recevoir nos prochaines collections et actualités POUR, ainsi qu'une réduction de 10 %.
      </p>

      <label class="footer-pour__marketing-consent">
        <input
          type="checkbox"
          name="contact[accepts_marketing]"
          value="true"
          required
        >

        <span>
          J'accepte de recevoir les actualités, collections et offres du Club POUR par e-mail.
        </span>
      </label>

      <div class="footer-pour__input-wrap">

        <input
          type="email"
          name="contact[email]"
          class="footer-pour__input"
          placeholder="E-mail"
          required
          autocomplete="email"
        >

      </div>

      <button
        type="submit"
        class="footer-pour__submit"
      >
        REJOINDRE LE CLUB
      </button>
    {% endunless %}

{% if form.posted_successfully? %}
  <p class="footer-pour__message footer-pour__message--success">
    <strong>BIENVENUE DANS LE CLUB POUR.</strong><br><br>
    Vous venez de recevoir un e-mail sur votre boîte mail avec votre réduction de 10 %.
  </p>
{% endif %}

    {% if form.errors %}
      <div class="footer-pour__message">
        {{ form.errors | default_errors }}
      </div>
    {% endif %}

  {% endform %}
<div
  class="footer-pour__message footer-pour__message--success"
  data-footer-newsletter-success
  hidden
>
  <strong>INSCRIPTION CONFIRMÉE</strong><br><br>
  Votre inscription au Club POUR a bien été prise en compte.<br>
  Surveillez votre boîte mail pour découvrir les prochains accès privés.
</div>
      <!-- RÉSEAUX SOCIAUX -->

      <div class="footer-pour__socials">

        {% if section.settings.instagram != blank %}
          <a
            href="{{ section.settings.instagram }}"
            target="_blank"
            rel="noopener"
          >
            INSTAGRAM
          </a>
        {% endif %}

        {% if section.settings.tiktok != blank %}
          <a
            href="{{ section.settings.tiktok }}"
            target="_blank"
            rel="noopener"
          >
            TIKTOK
          </a>
        {% endif %}

        {% if section.settings.pinterest != blank %}
          <a
            href="{{ section.settings.pinterest }}"
            target="_blank"
            rel="noopener"
          >
            PINTEREST
          </a>
        {% endif %}

      </div>

    </div>


    <!-- =====================================================
         AIDE
    ====================================================== -->

    <div class="footer-pour__column">

      <p class="footer-pour__heading">
        AIDE
      </p>

      <nav class="footer-pour__links">

        <a href="/pages/livraison">
          Livraison
        </a>

        <a href="/pages/guide-des-tailles">
          Guide des tailles
        </a>

        <a href="/pages/faq">
          FAQ
        </a>

      </nav>

    </div>


    <!-- =====================================================
         INFORMATIONS
    ====================================================== -->

    <div class="footer-pour__column">

      <p class="footer-pour__heading">
        INFORMATIONS
      </p>

      <nav class="footer-pour__links">

        <a href="/pages/collection-001">
          Collection 001
        </a>

        <a href="/pages/contact">
          Nous contacter
        </a>

      </nav>

    </div>


    <!-- =====================================================
         LÉGAL
    ====================================================== -->

    <div class="footer-pour__column">

      <p class="footer-pour__heading">
        LÉGAL
      </p>

      <nav class="footer-pour__links">

        <a href="/pages/mentions-legales">
          Mentions légales
        </a>

        <a href="/policies/terms-of-service">
          Conditions générales de vente
        </a>

        <a href="/policies/privacy-policy">
          Politique de confidentialité
        </a>

        <a href="/policies/refund-policy">
          Politique de remboursement
        </a>

        <a href="/policies/shipping-policy">
          Politique de livraison
        </a>

      </nav>

    </div>

  </div>


  <!-- =====================================================
       BAS DU FOOTER
  ====================================================== -->

  <div class="footer-pour__bottom">

    <div class="footer-pour__copyright">
      © {{ 'now' | date: '%Y' }} POUR
    </div>

   <a
  href="{{ routes.root_url }}"
  class="footer-pour__logo"
  aria-label="Retour à l'accueil"
>
  {% if section.settings.footer_logo != blank %}
    {{
      section.settings.footer_logo
      | image_url: width: 300
      | image_tag:
        class: 'footer-pour__logo-image',
        loading: 'lazy',
        alt: 'POUR'
    }}
  {% else %}
    P
  {% endif %}
</a>

    <div class="footer-pour__localization">

  {% if localization.available_countries.size > 1 %}

    {% form 'localization', class: 'footer-pour__localization-form footer-pour__country-form' %}

      <div class="footer-pour__selector">

        <button
          type="button"
          class="footer-pour__selector-button"
          data-footer-selector="country"
          aria-expanded="false"
        >
          <span>
            {{ localization.country.name | upcase }}
            /
            {{ localization.country.currency.iso_code }}
            {{ localization.country.currency.symbol }}
          </span>

          <span class="footer-pour__selector-arrow"></span>
        </button>


        <div
          class="footer-pour__selector-menu footer-pour__selector-menu--country"
          data-footer-menu="country"
        >

          {% for country in localization.available_countries %}

            <button
              type="submit"
              name="country_code"
              value="{{ country.iso_code }}"
              class="footer-pour__selector-option{% if country.iso_code == localization.country.iso_code %} is-active{% endif %}"
            >
              <span>{{ country.name }}</span>

              <span>
                {{ country.currency.iso_code }}
                {{ country.currency.symbol }}
              </span>
            </button>

          {% endfor %}

        </div>

      </div>

    {% endform %}

  {% endif %}


  {% if localization.available_languages.size > 1 %}

    {% form 'localization', class: 'footer-pour__localization-form footer-pour__language-form' %}

      <div class="footer-pour__selector">

        <button
          type="button"
          class="footer-pour__selector-button"
          data-footer-selector="language"
          aria-expanded="false"
        >
          <span>
            {{ localization.language.endonym_name | upcase }}
          </span>

          <span class="footer-pour__selector-arrow"></span>
        </button>


        <div
          class="footer-pour__selector-menu footer-pour__selector-menu--language"
          data-footer-menu="language"
        >

          {% for language in localization.available_languages %}

            <button
              type="submit"
              name="locale_code"
              value="{{ language.iso_code }}"
              class="footer-pour__selector-option{% if language.iso_code == localization.language.iso_code %} is-active{% endif %}"
            >
              {{ language.endonym_name }}
            </button>

          {% endfor %}

        </div>

      </div>

    {% endform %}

  {% endif %}

</div>

  </div>

</footer>


