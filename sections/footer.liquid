</style>
<script>


(function () {

  function initFooterLocalization() {

    const footer =
      document.getElementById(
        'FooterPour-{{ section.id }}'
      );

    if (!footer) return;

    const selectors =
      footer.querySelectorAll(
        '.footer-pour__selector'
      );

    function closeAll(exception) {

      selectors.forEach((selector) => {

        if (selector === exception) return;

        selector.classList.remove('is-open');

        const button =
          selector.querySelector(
            '.footer-pour__selector-button'
          );

        if (button) {
          button.setAttribute(
            'aria-expanded',
            'false'
          );
        }

      });

    }

    selectors.forEach((selector) => {

      const button =
        selector.querySelector(
          '.footer-pour__selector-button'
        );

      if (!button) return;

      button.addEventListener(
        'click',
        function (event) {

          event.preventDefault();
          event.stopPropagation();

          const opening =
            !selector.classList.contains(
              'is-open'
            );

          closeAll(selector);

          selector.classList.toggle(
            'is-open',
            opening
          );

          button.setAttribute(
            'aria-expanded',
            opening ? 'true' : 'false'
          );

        }
      );

    });

    document.addEventListener(
      'click',
      function (event) {

        if (!footer.contains(event.target)) {
          closeAll();
          return;
        }

        if (
          !event.target.closest(
            '.footer-pour__selector'
          )
        ) {
          closeAll();
        }

      }
    );

    document.addEventListener(
      'keydown',
      function (event) {

        if (event.key === 'Escape') {
          closeAll();
        }

      }
    );

  }


  function initFooterClubCaptcha() {

    const footer =
      document.getElementById(
        'FooterPour-{{ section.id }}'
      );

    if (!footer) return;

    const form =
      footer.querySelector(
        '.footer-pour__form'
      );

    if (!form || form.dataset.clubCaptchaReady === 'true') {
      return;
    }

    form.dataset.clubCaptchaReady = 'true';

    form.addEventListener(
  'submit',
  function () {

    /*
     * On laisse Shopify gérer entièrement le CAPTCHA.
     * Après le retour sur la page, l'URL contient
     * #footer-newsletter : on revient donc directement
     * sur le formulaire / message de confirmation.
     */

    setTimeout(function () {

      const newsletter = document.querySelector('#footer-newsletter');

      if (newsletter) {
        newsletter.scrollIntoView({
          behavior: 'smooth',
          block: 'center'
        });
      }

    }, 2000);

  }
);

  }

function initFooterNewsletterSuccess() {
  const successMessage = document.querySelector(
    '[data-footer-newsletter-success]'
  );

  if (!successMessage) return;

  const params = new URLSearchParams(window.location.search);

  if (params.get('newsletter_success') !== 'true') return;

  const form = document.querySelector('.footer-pour__form');

  if (form) {
    form.hidden = true;
  }

  successMessage.hidden = false;
}
 function initFooter() {
  initFooterLocalization();
  initFooterClubCaptcha();
  initFooterNewsletterSuccess();
}


  if (document.readyState === 'loading') {

    document.addEventListener(
      'DOMContentLoaded',
      initFooter
    );

  } else {

    initFooter();

  }


  document.addEventListener(
    'shopify:section:load',
    initFooter
  );

})();

</script>

