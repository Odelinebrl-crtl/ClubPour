<footer
  id="FooterPour-{{ section.id }}"
  class="footer-pour"
>

  <div class="footer-pour__inner">


    <!-- =====================================================
         COLONNE NEWSLETTER
    ====================================================== -->

    <div class="footer-pour__column footer-pour__newsletter">

      <p class="footer-pour__heading">
        NEWSLETTER
      </p>

      <p class="footer-pour__newsletter-text">
        Recevez nos prochaines collections, accès anticipés et actualités POUR.
      </p>

      {% form 'customer', class: 'footer-pour__form' %}

        <input
          type="hidden"
          name="contact[tags]"
          value="newsletter"
        >

        <div class="footer-pour__input-wrap">

          <input
            type="email"
            name="contact[email]"
            class="footer-pour__input"
            placeholder="VOTRE EMAIL"
            required
          >

        </div>

        <button
          type="submit"
          class="footer-pour__newsletter-button"
        >
          S’INSCRIRE
        </button>

      {% endform %}


      <!-- RÉSEAUX -->

      <div class="footer-pour__socials">

        {% if section.settings.instagram != blank %}
          <a
            href="{{ section.settings.instagram }}"
            target="_blank"
            rel="noopener"
          >
            INSTAGRAM
          </a>
        {% endif %}

        {% if section.settings.tiktok != blank %}
          <a
            href="{{ section.settings.tiktok }}"
            target="_blank"
            rel="noopener"
          >
            TIKTOK
          </a>
        {% endif %}

        {% if section.settings.pinterest != blank %}
          <a
            href="{{ section.settings.pinterest }}"
            target="_blank"
            rel="noopener"
          >
            PINTEREST
          </a>
        {% endif %}

      </div>

    </div>



    <!-- =====================================================
         AIDE
    ====================================================== -->

    <div class="footer-pour__column">

      <p class="footer-pour__heading">
        AIDE
      </p>

      <nav class="footer-pour__links">

        <a href="/pages/contact">
          Contact
        </a>

        <a href="/pages/faq">
          FAQ
        </a>

        <a href="/pages/livraison">
          Livraison
        </a>

        <a href="/pages/retours-echanges">
          Retours & échanges
        </a>

        <a href="/pages/guide-des-tailles">
          Guide des tailles
        </a>

        <a href="/pages/suivi-commande">
          Suivi de commande
        </a>

      </nav>

    </div>



    <!-- =====================================================
         INFORMATIONS LÉGALES
    ====================================================== -->

    <div class="footer-pour__column">

      <p class="footer-pour__heading">
        INFORMATIONS
      </p>

      <nav class="footer-pour__links">

        <a href="/pages/mentions-legales">
          Mentions légales
        </a>

        <a href="/policies/terms-of-service">
          Conditions générales de vente
        </a>

        <a href="/policies/privacy-policy">
          Politique de confidentialité
        </a>

        <a href="/pages/politique-cookies">
          Politique de cookies
        </a>

        <a href="/pages/retractation">
          Droit de rétractation
        </a>

      </nav>

    </div>



    <!-- =====================================================
         À PROPOS
    ====================================================== -->

    <div class="footer-pour__column footer-pour__about">

      <p class="footer-pour__heading">
        POUR
      </p>

      <p>
        POUR imagine des pièces inspirées par l’automobile,
        les destinations et les souvenirs qui accompagnent la route.
      </p>

      <nav class="footer-pour__links footer-pour__about-links">

        <a href="/pages/club-privileges?view=club-privileges">
          Club Privilèges
        </a>

        <a href="/pages/collection-001?view=collection-001">
          Collection 001
        </a>

        <a href="/pages/contact">
          Nous contacter
        </a>

      </nav>

    </div>

  </div>



  <!-- =====================================================
       BAS DU FOOTER
  ====================================================== -->

  <div class="footer-pour__bottom">

    <div class="footer-pour__copyright">
      © {{ 'now' | date: '%Y' }} POUR
    </div>


    <div class="footer-pour__bottom-links">

      <a href="/pages/mentions-legales">
        Mentions légales
      </a>

      <a href="/policies/terms-of-service">
        CGV
      </a>

      <a href="/policies/privacy-policy">
        Confidentialité
      </a>

    </div>


    <!-- MOYENS DE PAIEMENT -->

    {% if shop.enabled_payment_types.size > 0 %}

      <div class="footer-pour__payments">

        {% for type in shop.enabled_payment_types %}

          {{
            type
            | payment_type_svg_tag:
              class: 'footer-pour__payment-icon'
          }}

        {% endfor %}

      </div>

    {% endif %}

  </div>

</footer>



<style>

/* =========================================================
   FOOTER POUR
========================================================= */

#FooterPour-{{ section.id }} {
  width: 100%;

  background: #f5f5f3;
  color: #111111;

  font-family:
    "Helvetica Neue",
    Helvetica,
    Arial,
    sans-serif;

  border-top: 1px solid rgba(17,17,17,.08);
}


/* =========================================================
   STRUCTURE
========================================================= */

#FooterPour-{{ section.id }}
.footer-pour__inner {
  display: grid;

  grid-template-columns:
    1.25fr
    .8fr
    .9fr
    1.35fr;

  gap: clamp(50px, 7vw, 130px);

  padding:
    90px
    54px
    105px;

  box-sizing: border-box;
}


/* =========================================================
   TITRES COLONNES
========================================================= */

#FooterPour-{{ section.id }}
.footer-pour__heading {
  margin: 0 0 28px;

  font-size: 9px;
  font-weight: 400;

  line-height: 1;

  letter-spacing: .22em;

  text-transform: uppercase;
}


/* =========================================================
   LIENS
========================================================= */

#FooterPour-{{ section.id }}
.footer-pour__links {
  display: flex;

  flex-direction: column;

  align-items: flex-start;

  gap: 15px;
}


#FooterPour-{{ section.id }}
.footer-pour__links a,
#FooterPour-{{ section.id }}
.footer-pour__socials a,
#FooterPour-{{ section.id }}
.footer-pour__bottom-links a {
  color: rgba(17,17,17,.62);

  font-size: 12px;
  font-weight: 400;

  line-height: 1.35;

  text-decoration: none;

  transition:
    color .35s ease;
}


#FooterPour-{{ section.id }}
.footer-pour__links a:hover,
#FooterPour-{{ section.id }}
.footer-pour__socials a:hover,
#FooterPour-{{ section.id }}
.footer-pour__bottom-links a:hover {
  color: #111111;
}


/* =========================================================
   NEWSLETTER
========================================================= */

#FooterPour-{{ section.id }}
.footer-pour__newsletter-text {
  max-width: 340px;

  margin: 0 0 26px;

  color: rgba(17,17,17,.62);

  font-size: 12px;

  line-height: 1.65;
}


#FooterPour-{{ section.id }}
.footer-pour__form {
  width: 100%;

  max-width: 350px;
}


#FooterPour-{{ section.id }}
.footer-pour__input {
  width: 100%;
  height: 48px;

  padding: 0 14px;

  box-sizing: border-box;

  border:
    1px solid
    rgba(17,17,17,.18);

  border-radius: 0;

  outline: none;

  background: transparent;

  font-family:
    "Helvetica Neue",
    Helvetica,
    Arial,
    sans-serif;

  font-size: 10px;

  transition:
    border-color .35s ease;
}


#FooterPour-{{ section.id }}
.footer-pour__input:focus {
  border-color: #111111;
}


/* =========================================================
   BOUTON NEWSLETTER
========================================================= */

#FooterPour-{{ section.id }}
.footer-pour__newsletter-button {
  display: inline-flex;

  align-items: center;
  justify-content: center;

  min-width: 155px;
  height: 46px;

  margin-top: 16px;

  padding:
    0
    24px;

  border:
    1px solid
    #111111;

  background: #111111;

  color: #ffffff;

  font-size: 10px;
  font-weight: 400;

  letter-spacing: .15em;

  text-transform: uppercase;

  cursor: pointer;

  transition:
    background-color .6s cubic-bezier(.22,1,.36,1),
    color .55s cubic-bezier(.22,1,.36,1);
}


#FooterPour-{{ section.id }}
.footer-pour__newsletter-button:hover {
  background: transparent;

  color: #111111;
}


/* =========================================================
   RÉSEAUX
========================================================= */

#FooterPour-{{ section.id }}
.footer-pour__socials {
  display: flex;

  flex-wrap: wrap;

  gap: 20px;

  margin-top: 40px;
}


#FooterPour-{{ section.id }}
.footer-pour__socials a {
  font-size: 9px;

  letter-spacing: .12em;

  text-transform: uppercase;
}


/* =========================================================
   À PROPOS
========================================================= */

#FooterPour-{{ section.id }}
.footer-pour__about > p:not(.footer-pour__heading) {
  max-width: 390px;

  margin: 0;

  color: rgba(17,17,17,.62);

  font-size: 12px;

  line-height: 1.65;
}


#FooterPour-{{ section.id }}
.footer-pour__about-links {
  margin-top: 24px;
}


/* =========================================================
   BOTTOM
========================================================= */

#FooterPour-{{ section.id }}
.footer-pour__bottom {
  display: grid;

  grid-template-columns:
    1fr
    auto
    1fr;

  align-items: center;

  gap: 40px;

  min-height: 95px;

  padding:
    20px
    54px;

  box-sizing: border-box;

  border-top:
    1px solid
    rgba(17,17,17,.08);
}


#FooterPour-{{ section.id }}
.footer-pour__copyright {
  font-size: 9px;

  letter-spacing: .14em;

  text-transform: uppercase;

  color: rgba(17,17,17,.52);
}


#FooterPour-{{ section.id }}
.footer-pour__bottom-links {
  display: flex;

  gap: 22px;
}


#FooterPour-{{ section.id }}
.footer-pour__bottom-links a {
  font-size: 9px;

  text-transform: uppercase;

  letter-spacing: .08em;
}


/* =========================================================
   PAIEMENTS
========================================================= */

#FooterPour-{{ section.id }}
.footer-pour__payments {
  display: flex;

  align-items: center;
  justify-content: flex-end;

  flex-wrap: wrap;

  gap: 8px;
}


#FooterPour-{{ section.id }}
.footer-pour__payment-icon {
  width: auto;
  height: 24px;
}


/* =========================================================
   MOBILE
========================================================= */

@media screen and (max-width: 900px) {

  #FooterPour-{{ section.id }}
  .footer-pour__inner {
    grid-template-columns:
      repeat(2, minmax(0,1fr));

    gap:
      60px
      30px;

    padding:
      70px
      20px
      80px;
  }


  #FooterPour-{{ section.id }}
  .footer-pour__bottom {
    grid-template-columns: 1fr;

    gap: 25px;

    padding:
      30px
      20px;

    text-align: left;
  }


  #FooterPour-{{ section.id }}
  .footer-pour__payments {
    justify-content: flex-start;
  }

}


@media screen and (max-width: 600px) {

  #FooterPour-{{ section.id }}
  .footer-pour__inner {
    grid-template-columns: 1fr;
  }


  #FooterPour-{{ section.id }}
  .footer-pour__form {
    max-width: none;
  }

}

</style>



{% schema %}
{
  "name": "Footer POUR",

  "settings": [

    {
      "type": "url",
      "id": "instagram",
      "label": "Instagram"
    },

    {
      "type": "url",
      "id": "tiktok",
      "label": "TikTok"
    },

    {
      "type": "url",
      "id": "pinterest",
      "label": "Pinterest"
    }

  ],

  "presets": [
    {
      "name": "Footer POUR"
    }
  ]
}
{% endschema %}
