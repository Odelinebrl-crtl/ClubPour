<section
  class="club-final"
  id="club-final"
>

  <p class="club-final__eyebrow">
    CLUB POUR
  </p>

  <h2 class="club-final__title">
    PRENEZ UNE<br>
    LONGUEUR D’AVANCE.
  </h2>


  <form
    class="club-final__form"
    method="post"
    action="/contact#club-final"
    accept-charset="UTF-8"
  >

    <input type="hidden" name="form_type" value="customer">
    <input type="hidden" name="utf8" value="✓">

    <div class="club-final__email-wrap">

      <input
        type="email"
        name="contact[email]"
        class="club-final__email"
        placeholder="VOTRE EMAIL"
        required
        autocomplete="email"
      >

    </div>


    <button
      type="submit"
      class="club-final__submit"
    >

      REJOIGNEZ LE CLUB

      <span>
        →
