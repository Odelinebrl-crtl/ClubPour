<section
  id="ClubPrivilegesHero-{{ section.id }}"
  class="club-hero"
  data-club-hero
  style="
    --club-text-color: {{ section.settings.text_color }};
    --club-overlay: {{ section.settings.overlay | divided_by: 100.0 }};
  "
>

  <!-- IMAGE -->

  <div class="club-hero__media">

    {% if section.settings.image_desktop != blank %}

      <picture>

        {% if section.settings.image_mobile != blank %}
          <source
            media="(max-width: 768px)"
            srcset="{{ section.settings.image_mobile | image_url: width: 1200 }}"
          >
        {% endif %}

        <img
          src="{{ section.settings.image_desktop | image_url: width: 2400 }}"
          alt="{{ section.settings.image_desktop.alt | escape }}"
          class="club-hero__image"
          width="{{ section.settings.image_desktop.width }}"
          height="{{ section.settings.image_desktop.height }}"
          loading="eager"
        >

      </picture>

    {% else %}

      <div class="club-hero__placeholder">
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      </div>

    {% endif %}

  </div>


  <!-- OVERLAY -->

  <div class="club-hero__overlay"></div>


  <!-- CONTENU -->

  <div class="club-hero__content">

    {% if section.settings.eyebrow != blank %}
      <p class="club-hero__eyebrow">
        {{ section.settings.eyebrow }}
      </p>
    {% endif %}


    {% if section.settings.heading != blank %}
      <h1 class="club-hero__heading">
        {{ section.settings.heading }}
      </h1>
    {% endif %}


    <!-- ===================================================
         FORMULAIRE
         IMPORTANT :
         EXACTEMENT LES MÊMES CLASSES QUE LA HOME
    ==================================================== -->

    <form
      class="pour-hero__preorder"
      method="post"
      action="/contact#club-privileges"
      accept-charset="UTF-8"
      id="club-privileges-form"
    >

      <input
        type="hidden"
        name="form_type"
        value="customer"
      >

      <input
        type="hidden"
        name="utf8"
        value="✓"
      >


      <div class="pour-hero__email-wrap">

        <input
          class="pour-hero__email"
          type="email"
          name="contact[email]"
          placeholder="VOTRE EMAIL"
          required
          autocomplete="email"
          aria-label="Votre email"
        >

      </div>


      <button
        class="pour-hero__submit"
        type="submit"
      >

        <span class="pour-hero__submit-text">
          {{ section.settings.button_label }}
        </span>

        <span
          class="pour-hero__submit-arrow"
          aria-hidden="true"
        >
          →
        </span>

      </button>

    </form>


    {% if section.settings.launch_text != blank %}
      <p class="club-hero__launch">
        {{ section.settings.launch_text }}
      </p>
    {% endif %}

  </div>

</section>


{% style %}

/* =========================================================
   HERO CLUB PRIVILÈGES
========================================================= */

#ClubPrivilegesHero-{{ section.id }} {
  position: relative;

  width: 100%;
  height: calc(100svh + 40px);
  min-height: calc(100svh + 40px);

  margin: 0;
  padding: 0;

  overflow: hidden;

  background: #111111;

  color: var(--club-text-color);
}


/* =========================================================
   IMAGE
========================================================= */

#ClubPrivilegesHero-{{ section.id }} .club-hero__media,
#ClubPrivilegesHero-{{ section.id }} .club-hero__media picture {
  position: absolute;
  inset: 0;

  display: block;

  width: 100%;
  height: 100%;

  overflow: hidden;
}


#ClubPrivilegesHero-{{ section.id }} .club-hero__image {
  position: absolute;

  top: -7%;
  left: 0;

  display: block;

  width: 100%;
  height: 114%;

  max-width: none;

  object-fit: cover;
  object-position: center;

  transform: translate3d(0, 0, 0) scale(1.08);

  will-change: transform;
}


#ClubPrivilegesHero-{{ section.id }} .club-hero__placeholder,
#ClubPrivilegesHero-{{ section.id }} .club-hero__placeholder svg {
  width: 100%;
  height: 100%;
}


/* =========================================================
   OVERLAY
========================================================= */

#ClubPrivilegesHero-{{ section.id }} .club-hero__overlay {
  position: absolute;
  inset: 0;

  z-index: 1;

  background: rgba(
    0,
    0,
    0,
    var(--club-overlay)
  );

  pointer-events: none;
}


/* =========================================================
   CONTENU
========================================================= */

#ClubPrivilegesHero-{{ section.id }} .club-hero__content {
  position: absolute;

  left: 50%;
  bottom: 35px;

  z-index: 2;

  display: flex;
  flex-direction: column;
  align-items: center;

  width: min(100%, 1100px);

  padding: 40px;

  gap: 14px;

  text-align: center;

  color: var(--club-text-color);

  transform: translateX(-50%);
}


/* =========================================================
   PETIT TITRE
========================================================= */

#ClubPrivilegesHero-{{ section.id }} .club-hero__eyebrow {
  margin: 0;

  font-family:
    "Helvetica Neue",
    Helvetica,
    Arial,
    sans-serif;

  font-size: 11px;
  font-weight: 400;

  line-height: 1;

  letter-spacing: 0.18em;

  text-transform: uppercase;
}


/* =========================================================
   GRAND TITRE
========================================================= */

#ClubPrivilegesHero-{{ section.id }} .club-hero__heading {
  margin: 0;

  font-family:
    "Helvetica Neue",
    Helvetica,
    Arial,
    sans-serif;

  font-size: clamp(50px, 8vw, 130px);
  font-weight: 400;

  line-height: 0.8;

  letter-spacing: -0.07em;

  text-transform: uppercase;
}


/* =========================================================
   IMPORTANT

   ON NE REDÉFINIT PAS :
   .pour-hero__preorder
   .pour-hero__email-wrap
   .pour-hero__email
   .pour-hero__submit

   Ils viennent DIRECTEMENT de base.css,
   donc exactement le même rendu que la Home.
========================================================= */


/* =========================================================
   PETIT TEXTE SOUS FORMULAIRE
========================================================= */

#ClubPrivilegesHero-{{ section.id }} .club-hero__launch {
  margin: 0;

  font-family:
    "Helvetica Neue",
    Helvetica,
    Arial,
    sans-serif;

  font-size: 10px;
  font-weight: 400;

  line-height: 1.2;

  letter-spacing: 0.06em;

  text-transform: uppercase;

  opacity: 0.85;
}


/* =========================================================
   ANIMATION D'ENTRÉE
========================================================= */

#ClubPrivilegesHero-{{ section.id }}
.club-hero__eyebrow,

#ClubPrivilegesHero-{{ section.id }}
.club-hero__heading,

#ClubPrivilegesHero-{{ section.id }}
.pour-hero__preorder,

#ClubPrivilegesHero-{{ section.id }}
.club-hero__launch {

  opacity: 0;

  transform: translateY(-55px);

  transition:
    opacity 0.7s ease,
    transform 0.95s cubic-bezier(0.22, 1, 0.36, 1);
}


#ClubPrivilegesHero-{{ section.id }}.is-visible
.club-hero__eyebrow,

#ClubPrivilegesHero-{{ section.id }}.is-visible
.club-hero__heading,

#ClubPrivilegesHero-{{ section.id }}.is-visible
.pour-hero__preorder,

#ClubPrivilegesHero-{{ section.id }}.is-visible
.club-hero__launch {

  opacity: 1;

  transform: translateY(0);
}


#ClubPrivilegesHero-{{ section.id }}.is-visible
.club-hero__heading {
  transition-delay: 0.05s;
}


#ClubPrivilegesHero-{{ section.id }}.is-visible
.pour-hero__preorder {
  transition-delay: 0.10s;
}


#ClubPrivilegesHero-{{ section.id }}.is-visible
.club-hero__launch {
  transition-delay: 0.15s;
}


/* =========================================================
   MOBILE
========================================================= */

@media screen and (max-width: 768px) {

  #ClubPrivilegesHero-{{ section.id }} {
    height: 100svh;
    min-height: 100svh;
  }


  #ClubPrivilegesHero-{{ section.id }}
  .club-hero__content {
    bottom: 24px;

    width: 100%;

    padding: 24px 16px;
  }


  #ClubPrivilegesHero-{{ section.id }}
  .club-hero__heading {
    font-size: clamp(52px, 16vw, 82px);
  }


  /*
    Comme le formulaire Home n'est pas prévu
    verticalement sur mobile, on le gère ici.
  */

  #ClubPrivilegesHero-{{ section.id }}
  .pour-hero__preorder {
    width: 100%;
    height: auto;

    flex-direction: column;

    gap: 8px;
  }


  #ClubPrivilegesHero-{{ section.id }}
  .pour-hero__email-wrap,

  #ClubPrivilegesHero-{{ section.id }}
  .pour-hero__submit {
    width: 100%;
    height: 48px;
  }

}

{% endstyle %}


<script>
(() => {

  const hero =
    document.getElementById(
      'ClubPrivilegesHero-{{ section.id }}'
    );

  if (!hero) return;


  const image =
    hero.querySelector(
      '.club-hero__image'
    );


  /* =======================================================
     ANIMATION D'ENTRÉE
  ======================================================= */

  requestAnimationFrame(() => {

    requestAnimationFrame(() => {

      setTimeout(() => {

        hero.classList.add(
          'is-visible'
        );

      }, 100);

    });

  });


  /* =======================================================
     PARALLAX
  ======================================================= */

  if (!image) return;


  let ticking = false;


  function updateParallax() {

    const scrollY =
      window.scrollY;


    const heroTop =
      hero.getBoundingClientRect().top +
      scrollY;


    const heroHeight =
      hero.offsetHeight;


    const localScroll =
      Math.max(
        0,
        Math.min(
          scrollY - heroTop,
          heroHeight
        )
      );


    const translateY =
      localScroll * 0.22;


    image.style.transform =
      `translate3d(0, ${translateY}px, 0) scale(1.08)`;


    ticking = false;

  }


  function requestParallax() {

    if (ticking) return;


    ticking = true;


    requestAnimationFrame(
      updateParallax
    );

  }


  window.addEventListener(
    'scroll',
    requestParallax,
    {
      passive: true
    }
  );


  window.addEventListener(
    'resize',
    requestParallax
  );


  updateParallax();

})();
</script>


{% schema %}
{
  "name": "Hero Club Privilèges",

  "settings": [

    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Image desktop"
    },

    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Image mobile"
    },

    {
      "type": "text",
      "id": "eyebrow",
      "label": "Petit texte",
      "default": "CLUB POUR"
    },

    {
      "type": "text",
      "id": "heading",
      "label": "Grand titre",
      "default": "CLUB PRIVILÈGES"
    },

    {
      "type": "text",
      "id": "button_label",
      "label": "Texte du bouton",
      "default": "REJOIGNEZ LE CLUB"
    },

    {
      "type": "text",
      "id": "launch_text",
      "label": "Texte sous le formulaire",
      "default": "ACCÈS PRIVILÉGIÉ À L’UNIVERS POUR"
    },

    {
      "type": "color",
      "id": "text_color",
      "label": "Couleur du texte",
      "default": "#FFFFFF"
    },

    {
      "type": "range",
      "id": "overlay",

      "min": 0,
      "max": 80,
      "step": 5,

      "unit": "%",

      "label": "Assombrissement de l'image",

      "default": 10
    }

  ],

  "presets": [
    {
      "name": "Hero Club Privilèges"
    }
  ]
}
{% endschema %}
