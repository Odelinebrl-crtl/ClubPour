<style>

/* ============================================================
   BASE PAGE CLUB
============================================================ */

#shopify-section-{{ section.id }} {
  margin: 0;
  padding: 0;
}

#shopify-section-{{ section.id }} * {
  box-sizing: border-box;
}


/* ============================================================
   HERO
============================================================ */

#ClubPrivilegesHero-{{ section.id }} {
  position: relative;

  width: 100%;
  height: 100svh;
  min-height: 100svh;

  margin: 0;
  padding: 0;

  overflow: hidden;

  background: #111;

  color: var(--club-text-color);
}


#ClubPrivilegesHero-{{ section.id }} .club-hero__media {
  position: absolute;
  inset: 0;

  width: 100%;
  height: 100%;

  overflow: hidden;
}


#ClubPrivilegesHero-{{ section.id }} .club-hero__image {
  position: absolute;

  top: -7%;
  left: 0;

  width: 100%;
  height: 114%;

  display: block;

  object-fit: cover;
  object-position: center;

  transform: translate3d(0,0,0) scale(1.08);
}


#ClubPrivilegesHero-{{ section.id }} .club-hero__placeholder,
#ClubPrivilegesHero-{{ section.id }} .club-hero__placeholder svg {
  width: 100%;
  height: 100%;
}


#ClubPrivilegesHero-{{ section.id }} .club-hero__overlay {
  position: absolute;
  inset: 0;

  z-index: 1;

  background: rgba(0,0,0,var(--club-overlay));

  pointer-events: none;
}


#ClubPrivilegesHero-{{ section.id }} .club-hero__content {
  position: absolute;

  left: 50%;
  bottom: 35px;

  z-index: 2;

  display: flex;
  flex-direction: column;
  align-items: center;

  gap: 14px;

  width: min(100%, 1100px);

  padding: 40px;

  text-align: center;

  color: var(--club-text-color);

  transform: translateX(-50%);
}


#ClubPrivilegesHero-{{ section.id }} .club-hero__eyebrow {
  margin: 0;

  font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;

  font-size: 11px;
  font-weight: 400;

  line-height: 1;

  letter-spacing: .18em;

  text-transform: uppercase;
}


#ClubPrivilegesHero-{{ section.id }} .club-hero__heading {
  margin: 0;

  font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;

  font-size: clamp(50px, 8vw, 130px);
  font-weight: 400;

  line-height: .8;

  letter-spacing: -.07em;

  text-transform: uppercase;
}


#ClubPrivilegesHero-{{ section.id }} .club-hero__form {
  display: flex;
  align-items: stretch;

  width: min(100%, 520px);
  height: 48px;

  margin-top: 18px;
  margin-bottom: 12px;

  gap: 8px;
}


#ClubPrivilegesHero-{{ section.id }} .club-hero__email-wrap {
  flex: 1;

  display: flex;
  align-items: center;

  background: rgba(255,255,255,.15);

  border: 1px solid rgba(255,255,255,.65);

  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}


#ClubPrivilegesHero-{{ section.id }} .club-hero__email {
  width: 100%;
  height: 100%;

  padding: 0 16px;

  border: 0;
  outline: 0;

  background: transparent;

  color: #fff;

  font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;

  font-size: 11px;

  letter-spacing: .06em;

  text-transform: uppercase;
}


#ClubPrivilegesHero-{{ section.id }} .club-hero__email::placeholder {
  color: rgba(255,255,255,.78);
  opacity: 1;
}


#ClubPrivilegesHero-{{ section.id }} .club-hero__submit {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  gap: 12px;

  min-width: 200px;
  height: 48px;

  padding: 0 18px;

  border: 1px solid #fff;

  background: #fff;

  color: #111;

  font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;

  font-size: 11px;

  letter-spacing: .06em;

  text-transform: uppercase;

  cursor: pointer;
}


#ClubPrivilegesHero-{{ section.id }} .club-hero__submit:hover {
  background: #111;
  border-color: #111;

  color: #fff;
}


#ClubPrivilegesHero-{{ section.id }} .club-hero__launch {
  margin: 0;

  font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;

  font-size: 10px;

  letter-spacing: .06em;

  text-transform: uppercase;

  opacity: .85;
}



/* ============================================================
   COMMUN
============================================================ */

.club-section-label {
  margin: 0;

  font-size: 10px;

  letter-spacing: .18em;

  text-transform: uppercase;
}



/* ============================================================
   MANIFESTE
============================================================ */

.club-manifesto {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  min-height: 80vh;

  padding: 120px 40px;

  background: #fff;

  color: #111;

  text-align: center;
}


.club-manifesto__title {
  max-width: 1200px;

  margin: 45px 0 35px;

  font-size: clamp(48px, 7vw, 115px);
  font-weight: 400;

  line-height: .9;

  letter-spacing: -.06em;
}


.club-manifesto__text {
  max-width: 570px;

  margin: 0;

  font-size: 14px;

  line-height: 1.7;
}



/* ============================================================
   PRIVILÈGES
============================================================ */

.club-benefits {
  padding: 0 32px 120px;

  background: #fff;

  color: #111;
}


.club-benefits__header {
  display: flex;
  justify-content: space-between;

  padding: 25px 0;

  border-top: 1px solid #111;
}


.club-benefits__count {
  margin: 0;

  font-size: 10px;
}


.club-benefit {
  display: grid;

  grid-template-columns:
    80px
    minmax(300px, 1.1fr)
    minmax(300px, .8fr)
    40px;

  align-items: center;

  min-height: 145px;

  border-top: 1px solid rgba(17,17,17,.25);

  transition:
    background .3s ease,
    color .3s ease;
}


.club-benefit:last-child {
  border-bottom: 1px solid rgba(17,17,17,.25);
}


.club-benefit:hover {
  padding-left: 20px;
  padding-right: 20px;

  background: #111;

  color: #fff;
}


.club-benefit__number {
  font-size: 10px;
}


.club-benefit__title {
  margin: 0;

  font-size: clamp(28px, 3vw, 52px);
  font-weight: 400;

  letter-spacing: -.04em;
}


.club-benefit__description {
  max-width: 420px;

  margin: 0;

  font-size: 12px;

  line-height: 1.6;
}


.club-benefit__arrow {
  text-align: right;

  font-size: 20px;
}



/* ============================================================
   CLUB EXCLUSIVE
============================================================ */

.club-exclusive {
  display: grid;

  grid-template-columns: 1fr 1fr;

  min-height: 90vh;

  background: #111;

  color: #fff;
}


.club-exclusive__image {
  min-height: 90vh;

  overflow: hidden;
}


.club-exclusive__img,
.club-exclusive__placeholder,
.club-exclusive__placeholder svg {
  width: 100%;
  height: 100%;

  display: block;

  object-fit: cover;
}


.club-exclusive__content {
  display: flex;
  flex-direction: column;
  justify-content: center;

  padding: 70px;
}


.club-exclusive__eyebrow {
  margin: 0 0 55px;

  font-size: 10px;

  letter-spacing: .18em;
}


.club-exclusive__title {
  margin: 0;

  font-size: clamp(44px, 5vw, 90px);
  font-weight: 400;

  line-height: .9;

  letter-spacing: -.06em;
}


.club-exclusive__text {
  max-width: 480px;

  margin: 50px 0;

  font-size: 13px;

  line-height: 1.7;
}


.club-exclusive__link {
  display: inline-flex;

  align-items: center;

  gap: 20px;

  width: fit-content;

  padding-bottom: 8px;

  border-bottom: 1px solid #fff;

  color: #fff;

  font-size: 11px;

  letter-spacing: .08em;

  text-decoration: none;
}



/* ============================================================
   STATS
============================================================ */

.club-stats {
  display: grid;

  grid-template-columns: repeat(3, 1fr);

  background: #fff;

  color: #111;
}


.club-stat {
  display: flex;
  flex-direction: column;
  justify-content: space-between;

  min-height: 430px;

  padding: 35px;

  border-right: 1px solid rgba(17,17,17,.25);
}


.club-stat:last-child {
  border-right: 0;
}


.club-stat__big {
  margin: 0;

  font-size: clamp(55px, 6vw, 110px);
  font-weight: 400;

  line-height: .85;

  letter-spacing: -.07em;
}


.club-stat__small {
  margin: 0;

  font-size: 11px;

  line-height: 1.4;

  letter-spacing: .08em;
}



/* ============================================================
   EDITORIAL
============================================================ */

.club-editorial {
  position: relative;

  height: 85vh;
  min-height: 700px;

  overflow: hidden;

  background: #111;

  color: #fff;
}


.club-editorial__media,
.club-editorial__image,
.club-editorial__placeholder,
.club-editorial__placeholder svg {
  position: absolute;

  inset: 0;

  width: 100%;
  height: 100%;
}


.club-editorial__image {
  object-fit: cover;
}


.club-editorial__overlay {
  position: absolute;
  inset: 0;

  z-index: 1;

  background: rgba(0,0,0,.22);
}


.club-editorial__content {
  position: absolute;

  left: 35px;
  bottom: 35px;

  z-index: 2;
}


.club-editorial__eyebrow {
  margin: 0 0 20px;

  font-size: 10px;

  letter-spacing: .18em;
}


.club-editorial__title {
  margin: 0;

  font-size: clamp(75px, 10vw, 170px);
  font-weight: 400;

  line-height: .72;

  letter-spacing: -.07em;
}


.club-editorial__text {
  margin: 35px 0 0;

  font-size: 10px;

  letter-spacing: .12em;
}



/* ============================================================
   HOW
============================================================ */

.club-how {
  padding: 120px 32px;

  background: #fff;

  color: #111;
}


.club-how__header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;

  padding-bottom: 50px;
}


.club-how__heading {
  margin: 0;

  font-size: clamp(45px, 6vw, 95px);
  font-weight: 400;

  letter-spacing: -.06em;
}


.club-how__grid {
  display: grid;

  grid-template-columns: repeat(3, 1fr);

  border-top: 1px solid #111;
}


.club-how__item {
  min-height: 420px;

  padding: 30px;

  border-right: 1px solid rgba(17,17,17,.25);
}


.club-how__item:last-child {
  border-right: 0;
}


.club-how__number {
  display: block;

  margin-bottom: 110px;

  font-size: 10px;
}


.club-how__item h3 {
  margin: 0 0 30px;

  font-size: clamp(28px, 3vw, 48px);
  font-weight: 400;

  line-height: .95;

  letter-spacing: -.04em;
}


.club-how__item p {
  max-width: 330px;

  margin: 0;

  font-size: 12px;

  line-height: 1.6;
}



/* ============================================================
   CTA FINAL
============================================================ */

.club-final {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  min-height: 90vh;

  padding: 100px 30px;

  background: #111;

  color: #fff;

  text-align: center;
}


.club-final__eyebrow {
  margin: 0 0 40px;

  font-size: 10px;

  letter-spacing: .18em;
}


.club-final__title {
  margin: 0;

  font-size: clamp(60px, 9vw, 150px);
  font-weight: 400;

  line-height: .8;

  letter-spacing: -.07em;
}


.club-final__form {
  display: flex;

  width: min(100%, 600px);
  height: 50px;

  margin-top: 65px;

  gap: 8px;
}


.club-final__email-wrap {
  flex: 1;

  border: 1px solid rgba(255,255,255,.6);

  background: rgba(255,255,255,.12);

  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}


.club-final__email {
  width: 100%;
  height: 100%;

  padding: 0 16px;

  border: 0;
  outline: 0;

  background: transparent;

  color: #fff;

  font-size: 11px;

  letter-spacing: .06em;

  text-transform: uppercase;
}


.club-final__email::placeholder {
  color: rgba(255,255,255,.75);
}


.club-final__submit {
  min-width: 200px;

  border: 1px solid #fff;

  background: #fff;

  color: #111;

  font-size: 11px;

  letter-spacing: .06em;

  cursor: pointer;
