{% comment %}
  ============================================================
  CLUB POUR — PAGE CLUB PRIVILÈGES
  Hero + Manifeste + Privilèges + Exclusive + Stats
  + Editorial + Fonctionnement + CTA final
  ============================================================
{% endcomment %}


<section
  id="ClubPrivilegesHero-{{ section.id }}"
  class="club-hero"
  data-club-hero
  style="
    --club-text-color: {{ section.settings.text_color }};
    --club-overlay: {{ section.settings.overlay | divided_by: 100.0 }};
  "
>

  <div class="club-hero__media">

    {% if section.settings.image != blank %}

      {{
        section.settings.image
        | image_url: width: 2800
        | image_tag:
          class: 'club-hero__image',
          loading: 'eager'
      }}

    {% else %}

      <div class="club-hero__placeholder">
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      </div>

    {% endif %}

  </div>

  <div class="club-hero__overlay"></div>

  <div class="club-hero__content">

    {% if section.settings.eyebrow != blank %}
      <p class="club-hero__eyebrow">
        {{ section.settings.eyebrow }}
      </p>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h1 class="club-hero__heading">
        {{ section.settings.heading }}
      </h1>
    {% endif %}

    <form
      class="club-hero__form"
      method="post"
      action="/contact#club-privileges"
      accept-charset="UTF-8"
    >

      <input type="hidden" name="form_type" value="customer">
      <input type="hidden" name="utf8" value="✓">

      <div class="club-hero__email-wrap">

        <input
          type="email"
          name="contact[email]"
          class="club-hero__email"
          placeholder="VOTRE EMAIL"
          required
          autocomplete="email"
          aria-label="Votre email"
        >

      </div>

      <button
        type="submit"
        class="club-hero__submit"
      >

        <span class="club-hero__submit-text">
          REJOIGNEZ LE CLUB
        </span>

        <span class="club-hero__submit-arrow">
          →
        </span>

      </button>

    </form>

    {% if section.settings.launch_text != blank %}
      <p class="club-hero__launch">
        {{ section.settings.launch_text }}
      </p>
    {% endif %}

  </div>

</section>



{% comment %}
  ============================================================
  MANIFESTE
  ============================================================
{% endcomment %}

<section class="club-manifesto">

  <p class="club-section-label">
    CLUB POUR
  </p>

  <h2 class="club-manifesto__title">
    PLUS QU’UN ACCÈS.<br>
    UNE LONGUEUR D’AVANCE.
  </h2>

  <p class="club-manifesto__text">
    Le Club POUR vous ouvre les portes de notre univers avant tout le monde.
    Collections en avant-première, séries exclusives et privilèges réservés
    à nos membres.
  </p>

</section>



