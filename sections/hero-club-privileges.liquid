<script>
(() => {

  const root =
    document.querySelector(
      '#shopify-section-{{ section.id }}'
    );

  if (!root) return;


  /* ========================================================
     FORMULAIRES — ISOLATION DES DEUX INSCRIPTIONS

     Shopify utilise le même état `customer_posted` pour les
     formulaires customer présents sur la page. On mémorise donc
     explicitement quel formulaire l'utilisateur a soumis avant
     le passage éventuel par le captcha.
  ======================================================== */

  const formStateKey = 'clubPrivilegesSubmittedForm';
  const customerForms = root.querySelectorAll(
    '#club-hero-form, #club-final-form'
  );

  customerForms.forEach((form) => {
    const formName = form.id === 'club-hero-form' ? 'hero' : 'final';

    form.addEventListener('submit', () => {
      sessionStorage.setItem(formStateKey, formName);
    });

    const submitButton = form.querySelector('button[type="submit"]');

    if (submitButton) {
      submitButton.addEventListener('click', () => {
        sessionStorage.setItem(formStateKey, formName);
      });
    }
  });

  const params = new URLSearchParams(window.location.search);

  if (params.get('customer_posted') === 'true' && 'scrollRestoration' in history) {
    history.scrollRestoration = 'manual';
  }

  const submittedForm = sessionStorage.getItem(formStateKey);

  if (params.get('customer_posted') === 'true' && submittedForm) {
    const fields = root.querySelector(
      `[data-club-form-fields="${submittedForm}"]`
    );
    const success = root.querySelector(
      `[data-club-success="${submittedForm}"]`
    );

    if (fields) {
      fields.hidden = true;
    }

    if (success) {
      success.hidden = false;
    }

    sessionStorage.removeItem(formStateKey);
  }

  /* ========================================================
     DIRECTION DU SCROLL
  ======================================================== */

  let lastScrollY = window.scrollY;
  let scrollDirection = 'down';


  function updateScrollDirection() {

    const currentY = window.scrollY;

    if (currentY > lastScrollY + 2) {
      scrollDirection = 'down';
    }

    else if (currentY < lastScrollY - 2) {
      scrollDirection = 'up';
    }

    lastScrollY = currentY;

  }


  window.addEventListener(
    'scroll',
    updateScrollDirection,
    {
      passive: true
    }
  );


  /* ========================================================
     SCROLL REVEAL

     IMPORTANT :

     EN DESCENDANT :
     la section apparaît puis RESTE visible.
     Elle ne disparaît plus quand on atteint
     la section suivante.

     EN REMONTANT :
     lorsqu'on revient dans une section,
     l'animation est rejouée depuis le haut.
  ======================================================== */

  const revealSections =
    root.querySelectorAll(
      '[data-club-reveal]'
    );


  const revealObserver =
    new IntersectionObserver(

      (entries) => {

        entries.forEach((entry) => {

          const section = entry.target;

          const items =
            section.querySelectorAll(
              '.club-reveal-item'
            );


          if (entry.isIntersecting) {

            /*
              On prépare une nouvelle animation
              à chaque vraie ré-entrée dans la section.
            */

            items.forEach((item) => {

              item.classList.remove(
                'is-visible',
                'is-from-above',
                'is-from-below'
              );


              if (scrollDirection === 'up') {

                item.classList.add(
                  'is-from-above'
                );

              } else {

                item.classList.add(
                  'is-from-below'
                );

              }


              const delay =
                Number(
                  item.dataset.revealDelay || 0
                );


              item.style.transitionDelay =
                `${delay}ms`;

            });


            /*
              Double frame :
              évite que le navigateur saute
              directement à l'état visible.
            */

            requestAnimationFrame(() => {

              requestAnimationFrame(() => {

                items.forEach((item) => {

                  item.classList.add(
                    'is-visible'
                  );

                });

              });

            });

          }

          else {

            /*
              C'EST LA CORRECTION IMPORTANTE.

              Si on descend et que la section sort
              par le HAUT :
              on ne cache absolument rien.

              Donc les cartes Club Privilèges ne
              disparaissent plus lorsque le bloc
              "Certaines pièces..." arrive.
            */

            if (
              scrollDirection === 'up' &&
              entry.boundingClientRect.top > 0
            ) {

              /*
                La section est maintenant SOUS
                le viewport pendant qu'on remonte.

                On la réarme pour le prochain
                passage vers le bas.
              */

              items.forEach((item) => {

                item.classList.remove(
                  'is-visible'
                );

                item.classList.remove(
                  'is-from-above',
                  'is-from-below'
                );

                item.style.transitionDelay =
                  '0ms';

              });

            }

          }

        });

      },

      {
        threshold: 0.12,

        rootMargin:
          '-5% 0px -5% 0px'
      }

    );


  revealSections.forEach((section) => {

    revealObserver.observe(section);

  });



  /* ========================================================
     PARALLAX
  ======================================================== */

  const hero =
    root.querySelector(
      '[data-club-hero]'
    );


  const heroImage =
    hero
      ? hero.querySelector('.club-hero__image')
      : null;


  const exclusiveSection =
    root.querySelector(
      '.club-exclusive'
    );


  const exclusiveMedia =
    exclusiveSection
      ? exclusiveSection.querySelector(
          '.club-exclusive__video, .club-exclusive__fallback'
        )
      : null;


  const editorialSection =
    root.querySelector(
      '[data-club-parallax]'
    );


  const editorialImage =
    editorialSection
      ? editorialSection.querySelector(
          '.club-editorial__image'
        )
      : null;


  let parallaxTicking = false;


  /* ========================================================
     HERO PARALLAX
  ======================================================== */

  function updateHeroParallax() {

    if (
      !hero ||
      !heroImage
    ) {
      return;
    }


    const rect =
      hero.getBoundingClientRect();


    /*
      Pas la peine de calculer
      si le Hero est totalement sorti.
    */

    if (
      rect.bottom <= 0 ||
      rect.top >= window.innerHeight
    ) {
      return;
    }


    /*
      Lorsque l'on descend :
      l'image descend légèrement moins vite
      que la page.

      On limite volontairement à 95px
      pour ne jamais dévoiler le fond.
    */

    const travelled =
      Math.max(
        0,
        -rect.top
      );


    const movement =
      Math.min(
        travelled * 0.22,
        95
      );


    heroImage.style.transform =
      `translate3d(0, ${movement}px, 0) scale(1.08)`;

  }



  /* ========================================================
     CLUB EXCLUSIVE PARALLAX
  ======================================================== */

  function updateExclusiveParallax() {

    if (
      !exclusiveSection ||
      !exclusiveMedia
    ) {
      return;
    }


    const rect =
      exclusiveSection.getBoundingClientRect();


    const viewport =
      window.innerHeight;


    if (
      rect.bottom <= 0 ||
      rect.top >= viewport
    ) {
      return;
    }


    const progress =
      (viewport - rect.top) /
      (viewport + rect.height);


    /*
      Mouvement plus franc :
      environ -75px → +75px
    */

    const movement =
      (progress - 0.5) * 150;


    exclusiveMedia.style.transform =
      `translate3d(0, ${movement}px, 0) scale(1.04)`;

  }



  /* ========================================================
     BEFORE EVERYONE ELSE
     PARALLAX PLUS PRONONCÉ
  ======================================================== */

  function updateEditorialParallax() {

    if (
      !editorialSection ||
      !editorialImage
    ) {
      return;
    }


    const rect =
      editorialSection.getBoundingClientRect();


    const viewport =
      window.innerHeight;


    if (
      rect.bottom <= 0 ||
      rect.top >= viewport
    ) {
      return;
    }


    const progress =
      (viewport - rect.top) /
      (viewport + rect.height);


    /*
      Ancien code : 95px

      Nouveau :
      environ -110px → +110px.

      L'effet sera nettement perceptible.
    */

    const movement =
      (progress - 0.5) * 220;


    editorialImage.style.transform =
      `translate3d(0, ${movement}px, 0) scale(1.08)`;

  }



  /* ========================================================
     UPDATE GLOBAL
  ======================================================== */

  function updateParallax() {

    updateHeroParallax();

    updateExclusiveParallax();

    updateEditorialParallax();

    parallaxTicking = false;

  }


  function requestParallax() {

    if (parallaxTicking) {
      return;
    }


    parallaxTicking = true;


    requestAnimationFrame(
      updateParallax
    );

  }



  window.addEventListener(
    'scroll',
    requestParallax,
    {
      passive: true
    }
  );


  window.addEventListener(
    'resize',
    requestParallax
  );


  /*
    Position correcte dès le chargement.
  */

  updateParallax();

})();
</script>

