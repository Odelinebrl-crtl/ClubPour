{% comment %}
  ============================================================
  CLUB POUR — PAGE CLUB PRIVILÈGES
  ============================================================
{% endcomment %}


<!-- =========================================================
     HERO — CONSERVÉ
========================================================= -->

<section
  id="ClubPrivilegesHero-{{ section.id }}"
  class="club-hero"
  data-club-hero
  style="
    --club-text-color: {{ section.settings.text_color }};
    --club-overlay: {{ section.settings.overlay | divided_by: 100.0 }};
  "
>

  <div class="club-hero__media">

    {% if section.settings.image != blank %}

      {{
        section.settings.image
        | image_url: width: 2800
        | image_tag:
          class: 'club-hero__image',
          loading: 'eager'
      }}

    {% else %}

      <div class="club-hero__placeholder">
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      </div>

    {% endif %}

  </div>


  <div class="club-hero__overlay"></div>


  <div class="club-hero__content">

    {% if section.settings.eyebrow != blank %}
      <p class="club-hero__eyebrow">
        {{ section.settings.eyebrow }}
      </p>
    {% endif %}


    {% if section.settings.heading != blank %}
      <h1 class="club-hero__heading">
        {{ section.settings.heading }}
      </h1>
    {% endif %}


{% form 'customer', class: 'club-hero__form', id: 'club-hero-form' %}

  <div class="club-hero__form-fields" data-club-form-fields="hero">
    <input type="hidden" name="contact[tags]" value="club-privileges">

    <div class="club-hero__email-wrap">
      <input
        type="email"
        name="contact[email]"
        class="club-hero__email"
        placeholder="VOTRE EMAIL"
        required
        autocomplete="email"
        aria-label="Votre email"
      >
    </div>

    <button type="submit" class="club-hero__submit">
      <span>REJOIGNEZ LE CLUB</span>
      <span aria-hidden="true">→</span>
    </button>
  </div>

  <div class="club-form-error" data-club-form-error="hero" role="alert" hidden>
    {% if form.errors %}
      {{ form.errors | default_errors }}
    {% endif %}
  </div>

{% endform %}

{% if section.settings.launch_text != blank %}
  <p class="club-hero__launch">{{ section.settings.launch_text }}</p>
{% endif %}

<div class="club-form-success" data-club-success="hero" role="status" aria-live="polite" hidden>
  <p class="club-form-success__title">INSCRIPTION CONFIRMÉE</p>
  <p class="club-form-success__text">
    Votre inscription au Club POUR a bien été prise en compte.<br>
    Surveillez votre boîte mail pour découvrir les prochains accès privés.
  </p>
</div>

</section>



<!-- =========================================================
     01 — MANIFESTE
========================================================= -->

<section
  class="club-manifesto club-scroll-section"
  data-club-reveal
>

  <div class="club-manifesto__inner">

    <p
      class="club-kicker club-reveal-item"
      data-reveal-delay="0"
    >
      CLUB POUR
    </p>


    <h2
      class="club-manifesto__title club-reveal-item"
      data-reveal-delay="80"
    >
      PLUS QU’UN ACCÈS.<br>
      UNE LONGUEUR D’AVANCE.
    </h2>


    <p
      class="club-manifesto__text club-reveal-item"
      data-reveal-delay="160"
    >
      Le Club POUR vous ouvre les portes de notre univers avant tout le monde.
      Collections en avant-première, séries exclusives et privilèges
      réservés à nos membres.
    </p>

  </div>

</section>



<!-- =========================================================
     02 — PRIVILÈGES
========================================================= -->

<section
  class="club-benefits club-scroll-section"
  data-club-reveal
>

  <div class="club-benefits__intro">

    <p class="club-kicker club-reveal-item">
      CLUB PRIVILÈGES
    </p>

    <h2
      class="club-benefits__heading club-reveal-item"
      data-reveal-delay="80"
    >
      POUR CEUX QUI<br>
      VEULENT PASSER<br>
      EN PREMIER.
    </h2>

  </div>


  <div class="club-benefits__grid">


    <!-- 01 -->

    <article
      class="club-benefit-card club-reveal-item"
      data-reveal-delay="0"
    >

      <div class="club-benefit-card__top">
        <span>01</span>
        <span>EARLY ACCESS</span>
      </div>

      <div class="club-benefit-card__bottom">

        <h3>
          AVANT-<br>
          PREMIÈRE
        </h3>

        <p>
          Découvrez et commandez nos nouveaux drops avant leur lancement
          officiel.
        </p>

      </div>

    </article>


    <!-- 02 -->

    <article
      class="club-benefit-card club-reveal-item"
      data-reveal-delay="70"
    >

      <div class="club-benefit-card__top">
        <span>02</span>
        <span>MEMBERS ONLY</span>
      </div>

      <div class="club-benefit-card__bottom">

        <h3>
          CLUB<br>
          EXCLUSIVES
        </h3>

        <p>
          Des séries limitées imaginées uniquement pour les membres du
          Club POUR.
        </p>

      </div>

    </article>


    <!-- 03 -->

    <article
      class="club-benefit-card club-reveal-item"
      data-reveal-delay="140"
    >

      <div class="club-benefit-card__top">
        <span>03</span>
        <span>PRIVATE SALES</span>
      </div>

      <div class="club-benefit-card__bottom">

        <h3>
          VENTES<br>
          PRIVÉES
        </h3>

        <p>
          Accédez à des offres et périodes de soldes exclusivement
          réservées au Club.
        </p>

      </div>

    </article>


    <!-- 04 -->

    <article
      class="club-benefit-card club-reveal-item"
      data-reveal-delay="210"
    >

      <div class="club-benefit-card__top">
        <span>04</span>
        <span>PRIORITY</span>
      </div>

      <div class="club-benefit-card__bottom">

        <h3>
          ACCÈS<br>
          PRIORITAIRE
        </h3>

        <p>
          Soyez prioritaire sur certaines pièces, restocks et quantités
          limitées.
        </p>

      </div>

    </article>


  </div>

</section>



<!-- =========================================================
     03 — CLUB EXCLUSIVE / VIDÉO
========================================================= -->

<section
  class="club-exclusive club-scroll-section"
  data-club-reveal
>

  <div
    class="club-exclusive__media club-reveal-item"
    data-reveal-delay="0"
  >

    {% if section.settings.exclusive_video != blank %}

      {{
        section.settings.exclusive_video
        | video_tag:
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          playsinline: true,
          class: 'club-exclusive__video'
      }}

    {% elsif section.settings.exclusive_image != blank %}

      {{
        section.settings.exclusive_image
        | image_url: width: 1800
        | image_tag:
          class: 'club-exclusive__fallback',
          loading: 'lazy'
      }}

    {% else %}

      <div class="club-exclusive__placeholder">
        {{ 'lifestyle-2' | placeholder_svg_tag }}
      </div>

    {% endif %}

  </div>


  <div class="club-exclusive__content">

    <p
      class="club-kicker club-reveal-item"
      data-reveal-delay="70"
    >
      CLUB EXCLUSIVE — 001
    </p>


    <h2
      class="club-exclusive__title club-reveal-item"
      data-reveal-delay="140"
    >
      CERTAINES PIÈCES<br>
      NE SERONT JAMAIS<br>
      MISES EN VENTE.
    </h2>


    <p
      class="club-exclusive__text club-reveal-item"
      data-reveal-delay="210"
    >
      Des séries produites en quantités limitées, imaginées exclusivement
      pour les membres du Club POUR.
    </p>


    <p
      class="club-exclusive__signature club-reveal-item"
      data-reveal-delay="280"
    >
      MEMBERS ONLY
    </p>

  </div>

</section>



<!-- =========================================================
     04 — STATS
========================================================= -->

<section
  class="club-stats club-scroll-section"
  data-club-reveal
>

  <div class="club-stats__header">

    <p class="club-kicker club-reveal-item">
      THE CLUB
    </p>

    <p
      class="club-stats__intro club-reveal-item"
      data-reveal-delay="80"
    >
      L'AVANTAGE D'ÊTRE<br>
      TOUJOURS UN TEMPS D'AVANCE.
    </p>

  </div>


  <div class="club-stats__grid">


    <article
      class="club-stat club-reveal-item"
      data-reveal-delay="0"
    >

      <p class="club-stat__value">
        48H
      </p>

      <div>
        <span>01</span>

        <p>
          D’ACCÈS EN<br>
          AVANT-PREMIÈRE
        </p>
      </div>

    </article>


    <article
      class="club-stat club-reveal-item"
      data-reveal-delay="100"
    >

      <p class="club-stat__value club-stat__value--word">
        LIMITED
      </p>

      <div>
        <span>02</span>

        <p>
          SÉRIES RÉSERVÉES<br>
          AU CLUB
        </p>
      </div>

    </article>


    <article
      class="club-stat club-reveal-item"
      data-reveal-delay="200"
    >

      <p class="club-stat__value club-stat__value--word">
        PRIVATE
      </p>

      <div>
        <span>03</span>

        <p>
          OFFRES &<br>
          VENTES PRIVÉES
        </p>
      </div>

    </article>


  </div>

</section>



<!-- =========================================================
     05 — BEFORE EVERYONE ELSE / PARALLAX
========================================================= -->

<section
  class="club-editorial club-scroll-section"
  data-club-reveal
  data-club-parallax
>

  <div class="club-editorial__media">

    {% if section.settings.editorial_image != blank %}

      {{
        section.settings.editorial_image
        | image_url: width: 3000
        | image_tag:
          class: 'club-editorial__image',
          loading: 'lazy'
      }}

    {% else %}

      <div class="club-editorial__placeholder">
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      </div>

    {% endif %}

  </div>


  <div class="club-editorial__overlay"></div>


  <div class="club-editorial__content">

    <p class="club-editorial__eyebrow club-reveal-item">
      CLUB POUR
    </p>


    <h2
      class="club-editorial__title club-reveal-item"
      data-reveal-delay="100"
    >
      BEFORE<br>
      EVERYONE<br>
      ELSE.
    </h2>


    <p
      class="club-editorial__text club-reveal-item"
      data-reveal-delay="200"
    >
      LES MEMBRES DU CLUB PASSENT EN PREMIER.
    </p>

  </div>

</section>



<!-- =========================================================
     06 — COMMENT ÇA MARCHE
========================================================= -->

<section
  class="club-how club-scroll-section"
  data-club-reveal
>

  <div class="club-how__intro">

    <p class="club-kicker club-reveal-item">
      LE CLUB
    </p>


    <h2
      class="club-how__heading club-reveal-item"
      data-reveal-delay="80"
    >
      COMMENT<br>
      ÇA MARCHE ?
    </h2>

  </div>


  <div class="club-how__cards">


    <article
      class="club-how-card club-reveal-item"
      data-reveal-delay="0"
    >

      <div class="club-how-card__number">
        01
      </div>

      <div class="club-how-card__content">

        <p class="club-how-card__eyebrow">
          JOIN
        </p>

        <h3>
          REJOIGNEZ<br>
          LE CLUB
        </h3>

        <p>
          Inscrivez-vous simplement avec votre adresse email.
        </p>

      </div>

    </article>


    <article
      class="club-how-card club-reveal-item"
      data-reveal-delay="100"
    >

      <div class="club-how-card__number">
        02
      </div>

      <div class="club-how-card__content">

        <p class="club-how-card__eyebrow">
          DISCOVER
        </p>

        <h3>
          RECEVEZ<br>
          VOTRE ACCÈS
        </h3>

        <p>
          Nous vous prévenons dès qu’un nouvel accès privé est disponible.
        </p>

      </div>

    </article>


    <article
      class="club-how-card club-reveal-item"
      data-reveal-delay="200"
    >

      <div class="club-how-card__number">
        03
      </div>

      <div class="club-how-card__content">

        <p class="club-how-card__eyebrow">
          ENJOY
        </p>

        <h3>
          PROFITEZ DES<br>
          PRIVILÈGES
        </h3>

        <p>
          Avant-premières, exclusivités, ventes privées et accès prioritaires.
        </p>

      </div>

    </article>


  </div>

</section>



<!-- =========================================================
     07 — CTA FINAL
========================================================= -->

<section
  class="club-final club-scroll-section"
  id="club-final"
  data-club-reveal
>

  <p class="club-final__eyebrow club-reveal-item">
    CLUB POUR
  </p>


  <h2
    class="club-final__title club-reveal-item"
    data-reveal-delay="80"
  >
    PRENEZ UNE<br>
    LONGUEUR D’AVANCE.
  </h2>


{% form 'customer', class: 'club-final__form', id: 'club-final-form' %}

  <div class="club-final__form-fields" data-club-form-fields="final">
    <input type="hidden" name="contact[tags]" value="club-privileges">

    <div class="club-final__email-wrap">
      <input
        type="email"
        name="contact[email]"
        class="club-final__email"
        placeholder="VOTRE EMAIL"
        required
        autocomplete="email"
        aria-label="Votre email"
      >
    </div>

    <button
      type="submit"
      class="club-final__submit"
    >
      <span>REJOIGNEZ LE CLUB</span>
      <span aria-hidden="true">→</span>
    </button>
  </div>

  <div class="club-form-error" data-club-form-error="final" role="alert" hidden>
    {% if form.errors %}
      {{ form.errors | default_errors }}
    {% endif %}
  </div>

{% endform %}

<div class="club-form-success club-form-success--final" data-club-success="final" role="status" aria-live="polite" hidden>
  <p class="club-form-success__title">INSCRIPTION CONFIRMÉE</p>
  <p class="club-form-success__text">
    Votre inscription au Club POUR a bien été prise en compte.<br>
    Surveillez votre boîte mail pour découvrir les prochains accès privés.
  </p>
</div>


  <p
    class="club-final__small club-reveal-item"
    data-reveal-delay="220"
  >
    ACCÈS GRATUIT — RÉSERVÉ AUX MEMBRES INSCRITS
  </p>

</section>



<style>

/* =========================================================
   VARIABLES / BASE
========================================================= */

#shopify-section-{{ section.id }} {
  --club-cream: #FAF9F6;
  --club-white: #FFFFFF;
  --club-black: #111111;
  --club-grey: #777777;
  --club-border: rgba(17, 17, 17, 0.13);

  margin: 0;
  padding: 0;
}


#shopify-section-{{ section.id }} * {
  box-sizing: border-box;
}


#shopify-section-{{ section.id }} .club-scroll-section {
  color: var(--club-black);
}

.club-kicker {
  margin: 0;

  font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;

  font-size: 10px;
  font-weight: 400;

  line-height: 1;

  letter-spacing: .19em;

  text-transform: uppercase;
}



/* =========================================================
   HERO — ON CONSERVE LE DESIGN
========================================================= */

#ClubPrivilegesHero-{{ section.id }} {
  position: relative;

  overflow-anchor: none;

  width: 100%;
  height: 100svh;
  min-height: 100svh;

  margin: 0;
  padding: 0;

  overflow: hidden;

  background: #111;

  color: var(--club-text-color);
}


#ClubPrivilegesHero-{{ section.id }} .club-hero__media {
  position: absolute;
  inset: 0;

  width: 100%;
  height: 100%;

  overflow: hidden;
}


#ClubPrivilegesHero-{{ section.id }} .club-hero__image {
  position: absolute;

  top: -7%;
  left: 0;

  display: block;

  width: 100%;
  height: 114%;

  object-fit: cover;
  object-position: center;

  transform: translate3d(0, 0, 0) scale(1.08);

  transform-origin: center center;

  will-change: transform;
}


#ClubPrivilegesHero-{{ section.id }} .club-hero__placeholder,
#ClubPrivilegesHero-{{ section.id }} .club-hero__placeholder svg {
  width: 100%;
  height: 100%;
}


#ClubPrivilegesHero-{{ section.id }} .club-hero__overlay {
  position: absolute;
  inset: 0;

  z-index: 1;

  background: rgba(0,0,0,var(--club-overlay));

  pointer-events: none;
}


#ClubPrivilegesHero-{{ section.id }} .club-hero__content {
  position: absolute;

  left: 50%;
  bottom: 35px;

  z-index: 2;

  display: flex;
  flex-direction: column;
  align-items: center;

  gap: 14px;

  width: min(100%,1100px);

  padding: 40px;

  text-align: center;

  color: var(--club-text-color);

  transform: translateX(-50%);
}


#ClubPrivilegesHero-{{ section.id }} .club-hero__eyebrow {
  margin: 0;

  font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;

  font-size: 11px;

  letter-spacing: .18em;

  text-transform: uppercase;
}


#ClubPrivilegesHero-{{ section.id }} .club-hero__heading {
  margin: 0;

  font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;

  font-size: clamp(50px,8vw,130px);
  font-weight: 400;

  line-height: .8;

  letter-spacing: -.07em;

  text-transform: uppercase;
}


#ClubPrivilegesHero-{{ section.id }} .club-hero__form {
  width: min(100%, 520px);
  margin: 18px auto 12px;
}

#ClubPrivilegesHero-{{ section.id }} .club-hero__form-fields {
  display: flex;
  align-items: stretch;
  width: 100%;
  height: 48px;
  gap: 8px;
}



#ClubPrivilegesHero-{{ section.id }} .club-hero__email-wrap {
  flex: 1;

  display: flex;
  align-items: center;

  background: rgba(255,255,255,.15);

  border: 1px solid rgba(255,255,255,.65);

  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}


#ClubPrivilegesHero-{{ section.id }} .club-hero__email {
  width: 100%;
  height: 100%;

  padding: 0 16px;

  border: 0;
  outline: 0;

  background: transparent;

  color: #fff;

  font-size: 11px;

  letter-spacing: .06em;

  text-transform: uppercase;
}


#ClubPrivilegesHero-{{ section.id }} .club-hero__email::placeholder {
  color: rgba(255,255,255,.78);

  opacity: 1;
}


#ClubPrivilegesHero-{{ section.id }} .club-hero__submit {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  gap: 12px;

  min-width: 200px;
  height: 48px;

  padding: 0 18px;

  border: 1px solid #fff;

  background-color: #fff;
  color: #111;

  font-size: 11px;

  letter-spacing: .06em;

  text-transform: uppercase;

  cursor: pointer;

  transition:
    background-color .55s cubic-bezier(.22, 1, .36, 1),
    color .45s cubic-bezier(.22, 1, .36, 1),
    border-color .55s cubic-bezier(.22, 1, .36, 1);
}

#ClubPrivilegesHero-{{ section.id }} .club-hero__submit:hover {
  background-color: #111;
  border-color: #111;
  color: #fff;
}


#ClubPrivilegesHero-{{ section.id }} .club-hero__launch {
  margin: 16px 0 0;

  font-size: 10px;

  line-height: 1.4;

  letter-spacing: .06em;

  text-transform: uppercase;

  opacity: .85;
}



/* =========================================================
   ANIMATIONS SCROLL RÉPÉTÉES
========================================================= */

.club-reveal-item {
  opacity: 0;

  transform: translate3d(0, 55px, 0);

  transition:
    opacity .75s ease,
    transform 1s cubic-bezier(.22,1,.36,1);

  will-change: opacity, transform;
}


.club-reveal-item.is-from-above {
  transform: translate3d(0,-55px,0);
}


.club-reveal-item.is-from-below {
  transform: translate3d(0,55px,0);
}


.club-reveal-item.is-visible {
  opacity: 1;

  transform: translate3d(0,0,0);
}



/* =========================================================
   MANIFESTE
========================================================= */

.club-manifesto {
background: #FFFFFF;
  min-height: 82vh;

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 130px 40px;
}


.club-manifesto__inner {
  width: min(100%,1300px);

  text-align: center;
}


.club-manifesto__title {
  margin: 48px 0 40px;

  font-size: clamp(55px,7vw,120px);
  font-weight: 400;

  line-height: .89;

  letter-spacing: -.065em;
}


.club-manifesto__text {
  width: min(100%,600px);

  margin: 0 auto;

  font-size: 14px;

  line-height: 1.75;

  color: #525252;
}



/* =========================================================
   PRIVILÈGES — NOUVEAU DESIGN
========================================================= */

.club-benefits {
  padding: 130px 32px 150px;
 background: #FAF9F6;
}


.club-benefits__intro {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  width: 100%;

  margin-bottom: 90px;

  text-align: center;
}


.club-benefits__heading {
  max-width: 980px;

  margin: 28px auto 0;

  font-size: clamp(55px, 6vw, 105px);
  font-weight: 400;

  line-height: .86;

  letter-spacing: -.065em;

  text-align: center;
}
.club-benefits__intro .club-kicker {
  width: 100%;

  margin: 0;

  text-align: center;
}

.club-benefits__grid {
  display: grid;

  grid-template-columns: repeat(2,1fr);

  gap: 18px;
}


.club-benefit-card {
  min-height: 470px;

  display: flex;
  flex-direction: column;
  justify-content: space-between;

  padding: 30px;

  background: rgba(255,255,255,.48);

  border: 1px solid var(--club-border);

  transition:
    transform .45s cubic-bezier(.22,1,.36,1),
    background .35s ease;
}


.club-benefit-card:hover {
  transform: translateY(-8px);

  background: rgba(255,255,255,.76);
}


.club-benefit-card__top {
  display: flex;
  justify-content: space-between;

  font-size: 9px;

  letter-spacing: .12em;

  text-transform: uppercase;

  color: #6f6f6f;
}


.club-benefit-card__bottom h3 {
  margin: 0 0 30px;

  font-size: clamp(42px,4.2vw,76px);
  font-weight: 400;

  line-height: .88;

  letter-spacing: -.055em;
}


.club-benefit-card__bottom p {
  width: min(100%,370px);

  margin: 0;

  font-size: 12px;

