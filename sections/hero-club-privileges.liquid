<section
  id="ClubPrivilegesHero-{{ section.id }}"
  class="club-hero"
  data-club-hero
  style="
    --club-text-color: {{ section.settings.text_color }};
    --club-overlay: {{ section.settings.overlay | divided_by: 100.0 }};
  "
>

  <div class="club-hero__media">

    {% if section.settings.image != blank %}

      {{
        section.settings.image
        | image_url: width: 2800
        | image_tag:
          class: 'club-hero__image',
          loading: 'eager'
      }}

    {% else %}

      <div class="club-hero__placeholder">
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      </div>

    {% endif %}

  </div>


  <div class="club-hero__overlay"></div>


  <div class="club-hero__content">

    {% if section.settings.eyebrow != blank %}
      <p class="club-hero__eyebrow">
        {{ section.settings.eyebrow }}
      </p>
    {% endif %}


    {% if section.settings.heading != blank %}
      <h1 class="club-hero__heading">
        {{ section.settings.heading }}
      </h1>
    {% endif %}


    <form
      class="club-hero__form"
      method="post"
      action="/contact#club-privileges"
    >

      <input
        type="hidden"
        name="form_type"
        value="customer"
      >

      <input
        type="hidden"
        name="utf8"
        value="✓"
      >


      <div class="club-hero__email-wrap">

        <input
          type="email"
          name="contact[email]"
          class="club-hero__email"
          placeholder="VOTRE EMAIL"
          required
          autocomplete="email"
        >

      </div>


      <button
        type="submit"
        class="club-hero__submit"
      >

        <span class="club-hero__submit-text">
          REJOIGNEZ LE CLUB
        </span>

        <span class="club-hero__submit-arrow">
          →
        </span>

      </button>

    </form>


    {% if section.settings.launch_text != blank %}
      <p class="club-hero__launch">
        {{ section.settings.launch_text }}
      </p>
    {% endif %}

  </div>

</section>


{% style %}

/* =========================================================
   HERO CLUB PRIVILÈGES
========================================================= */

#ClubPrivilegesHero-{{ section.id }} {
  position: relative;

  width: 100%;
  max-width: none;

  height: calc(100svh + 40px);
  min-height: calc(100svh + 40px);

  margin: 0;
  padding: 0;

  overflow: hidden;

  background: #111111;

  color: var(--club-text-color);
}


/* =========================================================
   MEDIA
========================================================= */

#ClubPrivilegesHero-{{ section.id }} .club-hero__media,
#ClubPrivilegesHero-{{ section.id }} .club-hero__media picture {
  position: absolute;
  inset: 0;

  display: block;

  width: 100%;
  height: 100%;

  overflow: hidden;
}


/* =========================================================
   IMAGE + PARALLAX
========================================================= */

#ClubPrivilegesHero-{{ section.id }} .club-hero__image {
  position: absolute;

  top: -7%;
  left: 0;

  display: block;

  width: 100%;
  height: 114%;

  object-fit: cover;
  object-position: center;

  transform: translate3d(0, 0, 0) scale(1.08);

  transform-origin: center center;

  will-change: transform;

  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}


/* =========================================================
   PLACEHOLDER
========================================================= */

#ClubPrivilegesHero-{{ section.id }} .club-hero__placeholder,
#ClubPrivilegesHero-{{ section.id }} .club-hero__placeholder svg {
  width: 100%;
  height: 100%;
}


/* =========================================================
   OVERLAY
========================================================= */

#ClubPrivilegesHero-{{ section.id }} .club-hero__overlay {
  position: absolute;
  inset: 0;

  z-index: 1;

  background:
    rgba(
      0,
      0,
      0,
      var(--club-overlay)
    );

  pointer-events: none;
}


/* =========================================================
   CONTENU
========================================================= */

#ClubPrivilegesHero-{{ section.id }} .club-hero__content {
  position: absolute;

  left: 50%;
  bottom: 35px;

  z-index: 2;

  display: flex;
  flex-direction: column;
  align-items: center;

  gap: 14px;

  width: min(100%, 1000px);

  padding: 40px;

  text-align: center;

  color: var(--club-text-color);

  transform: translateX(-50%);

  opacity: 0;
  visibility: hidden;

  translate: 0 -90px;

  transition:
    opacity 0.65s ease,
    translate 0.95s cubic-bezier(0.22, 1, 0.36, 1);

  will-change: opacity, translate;
}


/* =========================================================
   CONTENU VISIBLE
========================================================= */

#ClubPrivilegesHero-{{ section.id }}.is-content-visible
.club-hero__content {
  opacity: 1;
  visibility: visible;

  translate: 0 0;
}


/* =========================================================
   PETIT TITRE
========================================================= */

#ClubPrivilegesHero-{{ section.id }} .club-hero__eyebrow {
  margin: 0;

  font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;

  font-size: 11px;
  font-weight: 400;

  line-height: 1;

  letter-spacing: 0.18em;

  text-transform: uppercase;

  color: inherit;
}


/* =========================================================
   GRAND TITRE
========================================================= */

#ClubPrivilegesHero-{{ section.id }} .club-hero__heading {
  margin: 0;

  font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;

  font-size: clamp(50px, 8vw, 130px);
  font-weight: 400;

  line-height: 0.8;

  letter-spacing: -0.07em;

  text-transform: uppercase;

  color: inherit;
}


/* =========================================================
   FORMULAIRE
========================================================= */

#ClubPrivilegesHero-{{ section.id }} .club-hero__form {
  display: flex;
  align-items: stretch;

  width: min(100%, 520px);
  height: 48px;

  margin-top: 18px;
  margin-bottom: 12px;

  gap: 8px;
}


/* =========================================================
   EMAIL
========================================================= */

#ClubPrivilegesHero-{{ section.id }} .club-hero__email-wrap {
  flex: 1;

  display: flex;
  align-items: center;

  background: rgba(255, 255, 255, 0.15);

  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);

  border: 1px solid rgba(255, 255, 255, 0.65);

  transition:
    background 0.25s ease,
    border-color 0.25s ease;
}


#ClubPrivilegesHero-{{ section.id }}
.club-hero__email-wrap:focus-within {
  background: rgba(255, 255, 255, 0.22);

  border-color: #ffffff;
}


#ClubPrivilegesHero-{{ section.id }} .club-hero__email {
  width: 100%;
  height: 100%;

  padding: 0 16px;

  font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;

  font-size: 11px;
  font-weight: 400;

  letter-spacing: 0.06em;

  color: #ffffff;

  background: transparent;

  border: 0;
  outline: 0;

  text-transform: uppercase;
}


#ClubPrivilegesHero-{{ section.id }}
.club-hero__email::placeholder {
  color: rgba(255, 255, 255, 0.78);

  opacity: 1;
}


/* =========================================================
   BOUTON
========================================================= */

#ClubPrivilegesHero-{{ section.id }} .club-hero__submit {
  position: relative;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  gap: 12px;

  min-width: 185px;
  height: 48px;

  padding: 0 18px;

  font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;

  font-size: 11px;
  font-weight: 400;

  letter-spacing: 0.06em;

  color: #111111;

  background: #ffffff;

  border: 1px solid #ffffff;

  cursor: pointer;

  text-transform: uppercase;

  transition:
    background 0.3s ease,
    color 0.3s ease,
    border-color 0.3s ease;
}


#ClubPrivilegesHero-{{ section.id }} .club-hero__submit:hover {
  background: #111111;

  color: #ffffff;

  border-color: #111111;
}


#ClubPrivilegesHero-{{ section.id }} .club-hero__submit-text,
#ClubPrivilegesHero-{{ section.id }} .club-hero__submit-arrow {
  position: relative;

  z-index: 1;
}


/* =========================================================
   PETIT TEXTE BAS
========================================================= */

#ClubPrivilegesHero-{{ section.id }} .club-hero__launch {
  margin: 0;

  font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;

  font-size: 10px;
  font-weight: 400;

  line-height: 1.2;

  letter-spacing: 0.06em;

  text-transform: uppercase;

  color: inherit;

  opacity: 0.85;
}


/* =========================================================
   MOBILE
========================================================= */

@media screen and (max-width: 768px) {

  #ClubPrivilegesHero-{{ section.id }} {
    height: 100svh;
    min-height: 100svh;
  }


  #ClubPrivilegesHero-{{ section.id }} .club-hero__content {
    bottom: 24px;

    width: 100%;

    padding: 24px 16px;
  }


  #ClubPrivilegesHero-{{ section.id }} .club-hero__heading {
    font-size: clamp(52px, 16vw, 82px);
  }


  #ClubPrivilegesHero-{{ section.id }} .club-hero__form {
    width: 100%;
    height: auto;

    flex-direction: column;

    gap: 8px;
  }


  #ClubPrivilegesHero-{{ section.id }} .club-hero__email-wrap,
  #ClubPrivilegesHero-{{ section.id }} .club-hero__submit {
    width: 100%;
    height: 48px;
  }


  #ClubPrivilegesHero-{{ section.id }} .club-hero__submit {
    min-width: 0;
  }

}

{% endstyle %}


<script>
(() => {

  const hero = document.getElementById(
    'ClubPrivilegesHero-{{ section.id }}'
  );

  if (!hero) return;


  const image =
    hero.querySelector('.club-hero__image');


  /* =======================================================
     ANIMATION D'ENTRÉE DU CONTENU
  ======================================================= */

  window.requestAnimationFrame(() => {

    window.requestAnimationFrame(() => {

      window.setTimeout(() => {

        hero.classList.add(
          'is-content-visible'
        );

      }, 120);

    });

  });


  /* =======================================================
     PARALLAX
  ======================================================= */

  if (!image) return;


  let ticking = false;


  function updateParallax() {

    const scrollY =
      window.scrollY;


    const heroTop =
      hero.getBoundingClientRect().top
      + scrollY;


    const heroHeight =
      hero.offsetHeight;


    const localScroll =
      Math.max(
        0,
        Math.min(
          scrollY - heroTop,
          heroHeight
        )
      );


    const translateY =
      localScroll * 0.22;


    image.style.transform =
      `translate3d(0, ${translateY}px, 0) scale(1.08)`;


    ticking = false;

  }


  function requestParallax() {

    if (ticking) return;

    ticking = true;


    window.requestAnimationFrame(() => {

      updateParallax();

    });

  }


  window.addEventListener(
    'scroll',
    requestParallax,
    {
      passive: true
    }
  );


  window.addEventListener(
    'resize',
    requestParallax
  );


  updateParallax();

})();
</script>


{% schema %}
{
  "name": "Hero Club Privilèges",

  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Petit titre",
      "default": "CLUB POUR — ACCÈS MEMBRES"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "CLUB PRIVILÈGES"
    },
    {
      "type": "text",
      "id": "launch_text",
      "label": "Petit texte sous le formulaire",
      "default": "ACCÈS PRIVILÉGIÉ À L’UNIVERS POUR"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Couleur du texte",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "overlay",
      "label": "Assombrissement de l'image",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "%",
      "default": 10
    }
  ],

  "presets": [
    {
      "name": "Hero Club Privilèges"
    }
  ]
}
{% endschema %}
