
<article class="pour-article">
  <div class="pour-article__container">

    {% assign journal_url = article.blog.url | default: '/blogs/journal-pour' %}

    <a href="{{ journal_url }}" class="pour-article__back">
      <span>←</span> Retour au Journal POUR
    </a>

    <header class="pour-article__header">
      <span class="pour-article__eyebrow">CLUB POUR — JOURNAL</span>

      <h1>{{ article.title }}</h1>

      <div class="pour-article__meta">
        {% if article.published_at %}
          {{ article.published_at | date: "%d.%m.%Y" }}
        {% endif %}
        {% if article.author != blank %}
          <span class="pour-article__meta-separator">·</span>
          {{ article.author }}
        {% endif %}
      </div>
    </header>

    {% if article.image != blank %}
      <div class="pour-article__image">
        {{
          article.image
          | image_url: width: 1800
          | image_tag:
            loading: 'eager',
            alt: article.title
        }}
      </div>
    {% endif %}

    <div class="pour-article__content rte" id="PourArticleContent">
      {{ article.content }}
    </div>

    <div class="pour-article__footer">
      <a href="{{ journal_url }}">
        <span>←</span> RETOUR AU JOURNAL POUR
      </a>
    </div>

  </div>
</article>

<style>
  .pour-article {
    background: #fff;
    color: #171717;
    padding: 48px 32px 100px;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
  }

  .pour-article * {
    box-sizing: border-box;
  }

  .pour-article__container {
    max-width: 1100px;
    margin: 0 auto;
  }

  /* NAVIGATION HAUTE */

  .pour-article__back {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 75px;
    color: #777;
    text-decoration: none;
    font-size: 11px;
    letter-spacing: .025em;
    transition: color .25s ease;
  }

  .pour-article__back:hover {
    color: #111;
  }

  .pour-article__back span {
    font-size: 16px;
    font-weight: 300;
  }

  /* EN-TÊTE */

  .pour-article__header {
    max-width: 820px;
    margin: 0 auto 48px;
    text-align: center;
  }

  .pour-article__eyebrow {
    display: block;
    margin-bottom: 25px;
    font-size: 9px;
    letter-spacing: .22em;
    color: #888;
  }

  .pour-article__header h1 {
    margin: 0;
    font-size: clamp(28px, 3.5vw, 43px);
    line-height: 1.2;
    font-weight: 400;
    letter-spacing: -.035em;
  }

  .pour-article__meta {
    margin-top: 22px;
    color: #999;
    font-size: 10px;
    letter-spacing: .04em;
  }

  .pour-article__meta-separator {
    padding: 0 5px;
  }

  /* IMAGE */

  .pour-article__image {
    max-width: 960px;
    margin: 0 auto 75px;
    overflow: hidden;
  }

  .pour-article__image img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  /* CONTENU */

  .pour-article__content {
    max-width: 760px;
    margin: 0 auto;
    color: #444;
    font-size: 14px;
    line-height: 1.95;
    font-weight: 400;
  }

  .pour-article__content p {
    margin: 0 0 23px;
  }

  .pour-article__content h2 {
    margin: 65px 0 23px;
    color: #171717;
    font-size: 21px;
    line-height: 1.4;
    font-weight: 400;
    letter-spacing: -.02em;
  }

  .pour-article__content h3 {
    margin: 38px 0 15px;
    color: #171717;
    font-size: 16px;
    line-height: 1.5;
    font-weight: 500;
  }

  .pour-article__content a {
    color: #171717;
    text-underline-offset: 3px;
  }

  .pour-article__content img {
    max-width: 100%;
    height: auto;
  }

  /* FAQ ACCORDÉON */

  .pour-article__faq {
    margin-top: 18px;
  }

  .pour-article__faq-item {
    border-top: 1px solid #e8e8e8;
  }

  .pour-article__faq-item:last-child {
    border-bottom: 1px solid #e8e8e8;
  }

  .pour-article__faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 21px 0;
    cursor: pointer;
    list-style: none;
    color: #171717;
    font-size: 13px;
    line-height: 1.6;
    font-weight: 400;
  }

  .pour-article__faq-item summary::-webkit-details-marker {
    display: none;
  }

  .pour-article__faq-item summary::after {
    content: "+";
    flex-shrink: 0;
    font-size: 19px;
    font-weight: 300;
    color: #888;
  }

  .pour-article__faq-item[open] summary::after {
    content: "−";
  }

  .pour-article__faq-answer {
    padding: 0 35px 20px 0;
    color: #777;
    font-size: 13px;
    line-height: 1.9;
  }

  .pour-article__faq-answer p:last-child {
    margin-bottom: 0;
  }

  /* NAVIGATION BASSE */

  .pour-article__footer {
    max-width: 760px;
    margin: 90px auto 0;
    padding-top: 25px;
    border-top: 1px solid #e8e8e8;
    text-align: left;
  }

  .pour-article__footer a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #777;
    text-decoration: none;
    font-size: 10px;
    letter-spacing: .12em;
    transition: color .25s ease;
  }

  .pour-article__footer a:hover {
    color: #111;
  }

  .pour-article__footer span {
    font-size: 16px;
  }

  /* MOBILE */

  @media screen and (max-width: 749px) {
    .pour-article {
      padding: 32px 20px 65px;
    }

    .pour-article__back {
      margin-bottom: 48px;
    }

    .pour-article__header {
      margin-bottom: 32px;
    }

    .pour-article__header h1 {
      font-size: 29px;
    }

    .pour-article__eyebrow {
      margin-bottom: 18px;
    }

    .pour-article__image {
      margin-bottom: 42px;
    }

    .pour-article__content {
      font-size: 13px;
      line-height: 1.85;
    }

    .pour-article__content h2 {
      margin-top: 45px;
      font-size: 19px;
    }

    .pour-article__content h3 {
      font-size: 15px;
    }

    .pour-article__faq-item summary {
      font-size: 12px;
      padding: 18px 0;
    }

    .pour-article__footer {
      margin-top: 65px;
    }
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const content = document.getElementById('PourArticleContent');
  if (!content) return;

  const headings = Array.from(content.querySelectorAll('h2'));

  headings.forEach(function (heading) {
    const title = heading.textContent.trim();

    if (!/faq|questions fréquentes|questions souvent posées/i.test(title)) {
      return;
    }

    const faq = document.createElement('div');
    faq.className = 'pour-article__faq';

    heading.insertAdjacentElement('afterend', faq);

    let current = faq.nextElementSibling;

    while (current && current.tagName !== 'H2') {
      const next = current.nextElementSibling;

      if (current.tagName === 'H3') {
        const details = document.createElement('details');
        details.className = 'pour-article__faq-item';

        const summary = document.createElement('summary');
        summary.textContent = current.textContent.trim();

        const answer = document.createElement('div');
        answer.className = 'pour-article__faq-answer';

        details.appendChild(summary);
        details.appendChild(answer);
        faq.appendChild(details);

        current.remove();

        let sibling = next;

        while (sibling && sibling.tagName !== 'H3' && sibling.tagName !== 'H2') {
          const following = sibling.nextElementSibling;
          answer.appendChild(sibling);
          sibling = following;
        }

        current = sibling;
      } else {
        current = next;
      }
    }
  });
});
</script>

{% schema %}
{
  "name": "Article POUR",
  "settings": [],
  "presets": [
    {
      "name": "Article POUR"
    }
  ]
}
{% endschema %}
