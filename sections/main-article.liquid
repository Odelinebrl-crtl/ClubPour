
<article class="pour-article">
  <div class="pour-article__container">

    <a href="/pages/journal" class="pour-article__back">
      <span>←</span>
      <span class="pour-article__back-label">Retour au Journal POUR</span>
    </a>

    <header class="pour-article__header">
      <span class="pour-article__eyebrow">CLUB POUR · JOURNAL</span>

      <h1>{{ article.title }}</h1>

      <div class="pour-article__meta">
        {% if article.published_at %}
          {{ article.published_at | date: "%d.%m.%Y" }}
        {% endif %}
        {% if article.author != blank %}
          · {{ article.author }}
        {% endif %}
      </div>
    </header>

    {% if article.image != blank %}
      <div class="pour-article__image">
        {{
          article.image
          | image_url: width: 1600
          | image_tag: loading: 'eager', alt: article.title
        }}
      </div>
    {% endif %}

    <div class="pour-article__content rte" id="PourArticleContent">
      {{ article.content }}
    </div>

    <div class="pour-article__footer">
      <a href="/pages/journal">
        <span>←</span>
        RETOUR AUX ARTICLES
      </a>
    </div>

  </div>
</article>

<style>
  .pour-article {
    background: #fff;
    color: #171717;
    padding: 55px 32px 100px;
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: 300;
  }

  .pour-article *,
  .pour-article *::before,
  .pour-article *::after {
    box-sizing: border-box;
  }

  .pour-article__container {
    max-width: 1100px;
    margin: 0 auto;
  }

  /* RETOUR AU JOURNAL */

  .pour-article__back {
    display: inline-flex;
    align-items: center;
    gap: 9px;
      margin-top: 35px;
    margin-bottom: 75px;
    color: #777;
    text-decoration: none;
    font-family: var(--font-heading-family);
    font-size: 11px;
    font-weight: 300;
    letter-spacing: .035em;
    transition: color .25s ease;
  }

  .pour-article__back-label {
    position: relative;
    padding-bottom: 6px;
  }

  .pour-article__back-label::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 1px;
    background: #cfcfcf;
    transform: scaleX(1);
    transform-origin: left;
    transition: transform .3s ease, background .3s ease;
  }

  .pour-article__back:hover {
    color: #171717;
  }

  .pour-article__back:hover .pour-article__back-label::after {
    background: #171717;
    transform: scaleX(.65);
  }

  .pour-article__back > span:first-child {
    font-size: 15px;
    font-weight: 300;
  }

  /* EN-TÊTE */

  .pour-article__header {
    max-width: 820px;
    margin: 0 auto 48px;
    text-align: center;
  }

  .pour-article__eyebrow {
    display: block;
    margin-bottom: 24px;
    color: #999;
    font-size: 9px;
    font-weight: 300;
    letter-spacing: .24em;
  }

  .pour-article__header h1 {
    margin: 0;
    color: #171717;
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-size: clamp(30px, 4vw, 45px);
    font-weight: 300;
    line-height: 1.2;
    letter-spacing: -.035em;
  }

  .pour-article__meta {
    margin-top: 20px;
    color: #999;
    font-family: var(--font-heading-family);
    font-size: 10px;
    font-weight: 300;
    letter-spacing: .08em;
  }

  /* IMAGE */

  .pour-article__image {
    max-width: 960px;
    margin: 0 auto 70px;
    overflow: hidden;
  }

  .pour-article__image img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  /* CONTENU */

  .pour-article__content {
    max-width: 740px;
    margin: 0 auto;
    color: #555;
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-size: 14px;
    font-weight: 300;
    line-height: 1.95;
  }

  .pour-article__content p {
    margin: 0 0 22px;
    font-weight: 300;
  }

  .pour-article__content h2 {
    margin: 58px 0 22px;
    color: #171717;
    font-family: var(--font-heading-family);
    font-size: 22px;
    font-weight: 300;
    line-height: 1.4;
    letter-spacing: -.025em;
  }

  .pour-article__content h3 {
    margin: 35px 0 13px;
    color: #171717;
    font-family: var(--font-heading-family);
    font-size: 15px;
    font-weight: 300;
    line-height: 1.5;
  }

  .pour-article__content a {
    color: #171717;
    text-underline-offset: 4px;
  }

  .pour-article__content img {
    max-width: 100%;
    height: auto;
  }

  .pour-article__content strong,
  .pour-article__content b {
    font-weight: 400;
  }

  /* FAQ */

  .pour-article__faq {
    margin-top: 12px;
  }

  .pour-article__faq-item {
    margin: 0;
    border-top: 1px solid #eaeaea;
  }

  .pour-article__faq-item:last-child {
    border-bottom: 1px solid #eaeaea;
  }

  .pour-article__faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 19px 0;
    color: #222;
    font-family: var(--font-heading-family);
    font-size: 13px;
    font-weight: 300;
    line-height: 1.6;
    cursor: pointer;
    list-style: none;
  }

  .pour-article__faq-item summary::-webkit-details-marker {
    display: none;
  }

  .pour-article__faq-item summary::after {
    content: "+";
    flex-shrink: 0;
    color: #888;
    font-family: var(--font-heading-family);
    font-size: 18px;
    font-weight: 300;
    transition: transform .25s ease;
  }

  .pour-article__faq-item[open] summary::after {
    content: "−";
  }

  .pour-article__faq-answer {
    padding: 0 35px 19px 0;
    color: #777;
    font-size: 13px;
    font-weight: 300;
    line-height: 1.85;
  }

  .pour-article__faq-answer p {
    margin-bottom: 12px;
  }

  .pour-article__faq-answer p:last-child {
    margin-bottom: 0;
  }

  /* BAS DE PAGE */

  .pour-article__footer {
    max-width: 740px;
    margin: 75px auto 0;
    padding-top: 23px;
    border-top: 1px solid #eaeaea;
  }

  .pour-article__footer a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #777;
    font-family: var(--font-heading-family);
    font-size: 10px;
    font-weight: 300;
    letter-spacing: .13em;
    text-decoration: none;
    transition: color .25s ease;
  }

  .pour-article__footer a:hover {
    color: #171717;
  }

  .pour-article__footer a span {
    font-size: 15px;
  }

  /* MOBILE */

  @media screen and (max-width: 749px) {
    .pour-article {
      padding: 35px 20px 65px;
    }

    .pour-article__back {
      margin-bottom: 52px;
    }

    .pour-article__header {
      margin-bottom: 32px;
    }

    .pour-article__header h1 {
      font-size: 29px;
    }

    .pour-article__eyebrow {
      margin-bottom: 18px;
    }

    .pour-article__image {
      margin-bottom: 40px;
    }

    .pour-article__content {
      font-size: 13px;
      line-height: 1.85;
    }

    .pour-article__content h2 {
      margin-top: 43px;
      font-size: 19px;
    }

    .pour-article__content h3 {
      font-size: 14px;
    }

    .pour-article__faq-item summary {
      padding: 17px 0;
      font-size: 12px;
    }

    .pour-article__faq-answer {
      padding-right: 20px;
      font-size: 12px;
    }

    .pour-article__footer {
      margin-top: 58px;
    }
  }
</style>

<script>
(function () {
  function initPourArticleFAQ() {
    const content = document.getElementById('PourArticleContent');
    if (!content || content.dataset.faqInitialized === 'true') return;

    const paragraphs = Array.from(content.children);

    const faqHeading = paragraphs.find(function (element) {
      return element.tagName === 'P' &&
        /^(questions fréquentes|faq|questions souvent posées)$/i
          .test(element.textContent.trim());
    });

    if (!faqHeading) return;

    const faq = document.createElement('div');
    faq.className = 'pour-article__faq';
    faqHeading.insertAdjacentElement('afterend', faq);

    let current = faq.nextElementSibling;

    while (current) {
      const next = current.nextElementSibling;

      if (current.tagName === 'H2' ||
          (current.tagName === 'P' &&
           /^<strong|^<b/i.test(current.innerHTML.trim()) &&
           !current.querySelector('strong, b'))) {
        break;
      }

      const question = current.tagName === 'P'
        ? current.querySelector('strong, b')
        : null;

      if (question) {
        const details = document.createElement('details');
        details.className = 'pour-article__faq-item';

        const summary = document.createElement('summary');
        summary.textContent = question.textContent.trim();

        const answer = document.createElement('div');
        answer.className = 'pour-article__faq-answer';

        details.appendChild(summary);
        details.appendChild(answer);
        faq.appendChild(details);

        current.remove();

        let sibling = next;

        while (sibling &&
               sibling.tagName !== 'H2' &&
               !(sibling.tagName === 'P' &&
                 sibling.querySelector('strong, b'))) {
          const following = sibling.nextElementSibling;
          answer.appendChild(sibling);
          sibling = following;
        }

        current = sibling;
      } else {
        current = next;
      }
    }

    faqHeading.remove();
    content.dataset.faqInitialized = 'true';
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPourArticleFAQ);
  } else {
    initPourArticleFAQ();
  }

  document.addEventListener('shopify:section:load', initPourArticleFAQ);
})();
</script>

{% schema %}
{
  "name": "Article POUR",
  "settings": [],
  "presets": [
    {
      "name": "Article POUR"
    }
  ]
}
{% endschema %}
