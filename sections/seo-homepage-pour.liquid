/* FAQ SEO — HOMEPAGE CLUB POUR */

.pour-home-seo__faq {
  max-width: 760px;
  margin: 65px auto 0;
  text-align: left;
}

.pour-home-seo__faq-title {
  margin: 0 0 28px;
  text-align: center;
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 2px;
  color: #333;
}

.pour-home-seo__faq-item {
  border-bottom: 1px solid #e8e8e8;
}

.pour-home-seo__faq-item:first-of-type {
  border-top: 1px solid #e8e8e8;
}

.pour-home-seo__faq-item summary {
  position: relative;
  padding: 20px 35px 20px 0;
  cursor: pointer;
  list-style: none;
  font-size: 14px;
  line-height: 1.9;
  font-weight: 400;
  color: #000000;
}

.pour-home-seo__faq-item summary::-webkit-details-marker {
  display: none;
}

.pour-home-seo__faq-item summary::after {
  content: "+";
  position: absolute;
  right: 5px;
  top: 50%;
  transform: translateY(-50%);
  font-size: 19px;
  font-weight: 300;
  color: #999;
}

.pour-home-seo__faq-item[open] summary::after {
  content: "−";
}

.pour-home-seo__faq-answer {
  padding: 0 25px 18px 0;
}

.pour-home-seo__faq-answer p {
  margin: 0;
  font-size: 13px;
  line-height: 1.9;
  color: #777;
}

@media (max-width: 768px) {
  .pour-home-seo__faq {
    margin-top: 45px;
  }

  .pour-home-seo__faq-title {
    font-size: 10px;
    letter-spacing: 1.5px;
    margin-bottom: 22px;
  }

.pour-home-seo__faq-item summary {
  font-size: 12px;
  line-height: 1.8;
  font-weight: 400;
  padding: 17px 30px 17px 0;
}

  .pour-home-seo__faq-answer p {
    font-size: 12px;
    line-height: 1.8;
  }
}

