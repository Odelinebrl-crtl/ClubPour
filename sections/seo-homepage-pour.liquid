
{% if request.locale.iso_code == 'fr' %}

<section class="pour-home-seo" aria-labelledby="pour-home-seo-title">

  <div class="pour-home-seo__inner">

    <p class="pour-home-seo__eyebrow">
      CLUB POUR — CULTURE AUTOMOBILE
    </p>

   <h2 id="pour-home-seo-title" class="vetements-grid__heading">
  Une marque de vêtements inspirée de la culture automobile
</h2>

    
<div class="pour-home-seo__content">

  <p>
    CLUB POUR est une <strong>marque de vêtements inspirée de la culture automobile</strong>.
    À travers une vision contemporaine du vestiaire, la marque imagine des pièces qui associent
    design, esthétique automobile et culture racing.
  </p>

  <p>
    Découvrez une sélection de <strong>t-shirts voiture</strong>, de
    <strong>t-shirts auto</strong> et de <strong>t-shirts automobile</strong> imaginés pour celles et
    ceux qui partagent une passion pour l'univers automobile.
    Chaque modèle puise son inspiration dans les lignes,
    les silhouettes et l'histoire de l'automobile.
  </p>

  <p>
    Du <strong>t-shirt racing</strong> au <strong>t-shirt voiture vintage</strong>, CLUB POUR
    revisite les codes du vêtement automobile à travers
    des créations au caractère affirmé. Une approche du
    style automobile pensée pour s'intégrer naturellement
    au quotidien.
  </p>

</div>


    <div class="pour-home-seo__signature">
      <span></span>
      <p>DESIGN — CULTURE AUTOMOBILE — CLUB POUR</p>
      <span></span>
    </div>

  </div>

</section>

{% endif %}


<style>
  .pour-home-seo {
    width: 100%;
    padding: 76px 30px 82px;
    background: #ffffff;
    color: #111111;
    box-sizing: border-box;
  }

  .pour-home-seo__inner {
    width: 100%;
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
  }

  .pour-home-seo .vetements-grid__heading {
    margin-bottom: 38px !important;
  }

  .pour-home-seo__eyebrow {
    margin: 0 0 24px;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-size: 10px;
    font-weight: 400;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: rgba(17,17,17,.48);
  }

  .pour-home-seo__content {
    max-width: 850px;
    margin: 0 auto;
    text-align: center;
  }

  .pour-home-seo__content p {
    margin: 0 0 18px;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.9;
    letter-spacing: .015em;
    color: #666666;
  }

  .pour-home-seo__content strong {
    color: #444444;
    font-weight: 400;
  }

  .pour-home-seo__signature {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    margin-top: 38px;
  }

  .pour-home-seo__signature span {
    display: block;
    width: 35px;
    height: 1px;
    background: #dedede;
  }

  .pour-home-seo__signature p {
    margin: 0;
    font-size: 8px;
    letter-spacing: .17em;
    font-weight: 400;
    color: #777777;
  }

  @media screen and (max-width: 768px) {

    .pour-home-seo {
      padding: 54px 22px 60px;
    }

    .pour-home-seo .vetements-grid__heading {
      margin-bottom: 28px !important;
    }

    .pour-home-seo__eyebrow {
      font-size: 9px;
      margin-bottom: 20px;
    }

    .pour-home-seo__content {
      max-width: 100%;
    }

    .pour-home-seo__content p {
      font-size: 12px;
      line-height: 1.8;
      margin-bottom: 18px;
    }

    .pour-home-seo__signature {
      margin-top: 30px;
      gap: 12px;
    }

    .pour-home-seo__signature p {
      font-size: 7px;
    }

  }
</style>


