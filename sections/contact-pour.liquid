  font-size: 18px;
  font-weight: 400;

  text-transform: uppercase;
}


#ContactPour-{{ section.id }}
.contact-pour__help-card p {
  max-width: 460px;

  margin: 0;

  font-size: 13px;

  line-height: 1.55;

  color: rgba(17,17,17,.62);
}


/* =========================================================
   MOBILE
========================================================= */

