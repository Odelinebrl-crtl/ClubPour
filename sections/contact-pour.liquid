  font-size: clamp(72px, 10vw, 160px);
  font-weight: 400;
  line-height: .85;
  letter-spacing: -.065em;
  text-transform: uppercase;
}

#ContactPour-{{ section.id }} .contact-pour__lead {
  max-width: 570px;
  margin: 42px 0 0;
  font-size: 14px;
  line-height: 1.6;
  color: rgba(17,17,17,.68);
}

#ContactPour-{{ section.id }} .contact-pour__main {
  display: grid;
  grid-template-columns: minmax(280px, .72fr) minmax(0, 1.28fr);
  gap: clamp(70px, 8vw, 150px);
  width: 100%;
  padding: 90px 54px 120px;
  border-top: 1px solid rgba(17,17,17,.12);
}

#ContactPour-{{ section.id }} .contact-pour__infos {
  display: flex;
  flex-direction: column;
  gap: 42px;
}

#ContactPour-{{ section.id }} .contact-pour__info-block {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

#ContactPour-{{ section.id }} .contact-pour__label {
  margin: 0;
  font-size: 9px;
  letter-spacing: .18em;
  color: rgba(17,17,17,.48);
  text-transform: uppercase;
}

#ContactPour-{{ section.id }} .contact-pour__info-link,
#ContactPour-{{ section.id }} .contact-pour__info-text {
  margin: 0;
