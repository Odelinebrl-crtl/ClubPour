
<section
  id="ContactPour-{{ section.id }}"
  class="contact-pour"
>
  <div class="contact-pour__intro">
    <p class="contact-pour__eyebrow">
      {{ 'contact_pour.eyebrow' | t }}
    </p>
    <h1 class="contact-pour__title">
      {{ 'contact_pour.title' | t }}
    </h1>
    <p class="contact-pour__lead">
      {{ 'contact_pour.lead' | t }}
    </p>
  </div>

  <div class="contact-pour__main">
    <div class="contact-pour__infos">
      <div class="contact-pour__info-block">
        <p class="contact-pour__label">
          {{ 'contact_pour.email_label' | t }}
        </p>
        <a
          href="mailto:{{ section.settings.email }}"
          class="contact-pour__info-link"
        >
          {{ section.settings.email }}
        </a>
      </div>

      {% if section.settings.phone != blank %}
        <div class="contact-pour__info-block">
          <p class="contact-pour__label">
            {{ 'contact_pour.phone_label' | t }}
          </p>
          <a
            href="tel:{{ section.settings.phone | replace: ' ', '' }}"
            class="contact-pour__info-link"
          >
            {{ section.settings.phone }}
          </a>
        </div>
      {% endif %}

      <div class="contact-pour__info-block">
        <p class="contact-pour__label">
          {{ 'contact_pour.hours_label' | t }}
        </p>
        <p class="contact-pour__info-text">
          {{ 'contact_pour.hours_value' | t }}
        </p>
      </div>

      <div class="contact-pour__info-block">
        <p class="contact-pour__label">
          {{ 'contact_pour.response_time_label' | t }}
        </p>
        <p class="contact-pour__info-text">
          {{ 'contact_pour.response_time_value' | t }}
        </p>
      </div>

      {% if section.settings.address != blank %}
        <div class="contact-pour__info-block">
          <p class="contact-pour__label">
            {{ 'contact_pour.address_label' | t }}
          </p>
          <p class="contact-pour__info-text">
            {{ section.settings.address }}
          </p>
        </div>
      {% endif %}
    </div>

    <div class="contact-pour__form-wrap">
      <form
        id="ContactPourForm-{{ section.id }}"
        class="contact-pour__form"
      >
        <div class="contact-pour__row">
          <div class="contact-pour__field">
            <label for="ContactFirstName-{{ section.id }}">
              {{ 'contact_pour.first_name' | t }}
            </label>
            <input
              id="ContactFirstName-{{ section.id }}"
              type="text"
              name="first_name"
              autocomplete="given-name"
              required
            >
          </div>

          <div class="contact-pour__field">
            <label for="ContactLastName-{{ section.id }}">
              {{ 'contact_pour.last_name' | t }}
            </label>
            <input
              id="ContactLastName-{{ section.id }}"
              type="text"
              name="last_name"
              autocomplete="family-name"
              required
            >
          </div>
        </div>

        <div class="contact-pour__row">
          <div class="contact-pour__field">
            <label for="ContactEmail-{{ section.id }}">
              {{ 'contact_pour.email_label' | t }}
            </label>
            <input
              id="ContactEmail-{{ section.id }}"
              type="email"
              name="email"
              autocomplete="email"
              required
            >
          </div>

          <div class="contact-pour__field">
            <label for="ContactPhone-{{ section.id }}">
              {{ 'contact_pour.phone_label' | t }}
            </label>
            <input
              id="ContactPhone-{{ section.id }}"
              type="tel"
              name="phone"
              autocomplete="tel"
            >
          </div>
        </div>

        <div class="contact-pour__field">
          <label for="ContactReason-{{ section.id }}">
            {{ 'contact_pour.reason_label' | t }}
          </label>
          <select
            id="ContactReason-{{ section.id }}"
            name="reason"
            data-contact-reason
            required
          >
            <option value="">
              {{ 'contact_pour.reason_placeholder' | t }}
            </option>
            <option value="general">
              {{ 'contact_pour.reason_general' | t }}
            </option>
            <option value="product">
              {{ 'contact_pour.reason_product' | t }}
            </option>
            <option value="order_tracking">
              {{ 'contact_pour.reason_order_tracking' | t }}
            </option>
            <option value="return">
              {{ 'contact_pour.reason_return' | t }}
            </option>
            <option value="exchange">
              {{ 'contact_pour.reason_exchange' | t }}
            </option>
            <option value="delivery_issue">
              {{ 'contact_pour.reason_delivery_issue' | t }}
            </option>
            <option value="other">
              {{ 'contact_pour.reason_other' | t }}
            </option>
          </select>
        </div>

        <div
          class="contact-pour__field contact-pour__order-field"
          data-order-field
        >
          <label for="ContactOrder-{{ section.id }}">
            {{ 'contact_pour.order_number' | t }}
          </label>
          <input
            id="ContactOrder-{{ section.id }}"
            type="text"
            name="order_number"
            placeholder="#1001"
          >
        </div>

        <div class="contact-pour__field">
          <label for="ContactMessage-{{ section.id }}">
            {{ 'contact_pour.message' | t }}
          </label>
          <textarea
            id="ContactMessage-{{ section.id }}"
            name="message"
            rows="7"
            required
          ></textarea>
        </div>

        <button
          type="submit"
          class="contact-pour__submit"
        >
          <span>{{ 'contact_pour.submit' | t }}</span>
          <span aria-hidden="true">→</span>
        </button>

        <div
          class="contact-pour__success"
          id="ContactPourSuccess-{{ section.id }}"
          role="status"
          aria-live="polite"
          hidden
        >
          {{ 'contact_pour.success' | t }}
        </div>

        <div
          class="contact-pour__error"
          id="ContactPourError-{{ section.id }}"
          role="alert"
          aria-live="assertive"
          hidden
        >
          Une erreur est survenue lors de l’envoi. Réessaie dans quelques instants.
        </div>
      </form>
    </div>
  </div>

  <div class="contact-pour__help">
    <div class="contact-pour__help-header">
      <p class="contact-pour__eyebrow">
        {{ 'contact_pour.help_kicker' | t }}
      </p>
      <h2 class="contact-pour__help-title">
        {{ 'contact_pour.help_title' | t }}
      </h2>
    </div>

    <div class="contact-pour__help-grid">
      <div class="contact-pour__help-card">
        <span class="contact-pour__help-number">01</span>
        <h3>{{ 'contact_pour.help_order_title' | t }}</h3>
        <p>{{ 'contact_pour.help_order_text' | t }}</p>
      </div>

      <div class="contact-pour__help-card">
        <span class="contact-pour__help-number">02</span>
        <h3>{{ 'contact_pour.help_returns_title' | t }}</h3>
        <p>{{ 'contact_pour.help_returns_text' | t }}</p>
      </div>

      <div class="contact-pour__help-card">
        <span class="contact-pour__help-number">03</span>
        <h3>{{ 'contact_pour.help_products_title' | t }}</h3>
        <p>{{ 'contact_pour.help_products_text' | t }}</p>
      </div>

      <div class="contact-pour__help-card">
        <span class="contact-pour__help-number">04</span>
        <h3>{{ 'contact_pour.help_delivery_title' | t }}</h3>
        <p>{{ 'contact_pour.help_delivery_text' | t }}</p>
      </div>
    </div>
  </div>
</section>

<style>
