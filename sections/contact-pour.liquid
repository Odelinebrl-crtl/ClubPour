<section
  id="ContactPour-{{ section.id }}"
  class="contact-pour"
>

  <!-- =====================================================
       INTRO
  ====================================================== -->

  <div class="contact-pour__intro">

    <p class="contact-pour__eyebrow">
      POUR — SERVICE CLIENT
    </p>

    <h1 class="contact-pour__title">
      CONTACT
    </h1>

    <p class="contact-pour__lead">
      Une question sur une commande, un produit ou un retour ?
      Notre équipe est là pour vous répondre.
    </p>

  </div>


  <!-- =====================================================
       CONTENU PRINCIPAL
  ====================================================== -->

  <div class="contact-pour__main">


    <!-- ===================================================
         INFOS
    ==================================================== -->

    <div class="contact-pour__infos">

      <div class="contact-pour__info-block">

        <p class="contact-pour__label">
          EMAIL
        </p>

        <a
          href="mailto:{{ section.settings.email }}"
          class="contact-pour__info-link"
        >
          {{ section.settings.email }}
        </a>

      </div>


      {% if section.settings.phone != blank %}

        <div class="contact-pour__info-block">

          <p class="contact-pour__label">
            TÉLÉPHONE
          </p>

          <a
            href="tel:{{ section.settings.phone | replace: ' ', '' }}"
            class="contact-pour__info-link"
          >
            {{ section.settings.phone }}
          </a>

        </div>

      {% endif %}


      <div class="contact-pour__info-block">

        <p class="contact-pour__label">
          HORAIRES
        </p>

        <p class="contact-pour__info-text">
          {{ section.settings.hours }}
        </p>

      </div>


      <div class="contact-pour__info-block">

        <p class="contact-pour__label">
          DÉLAI DE RÉPONSE
        </p>

        <p class="contact-pour__info-text">
          {{ section.settings.response_time }}
        </p>

      </div>


      {% if section.settings.address != blank %}

        <div class="contact-pour__info-block">

          <p class="contact-pour__label">
            ADRESSE
          </p>

          <p class="contact-pour__info-text">
            {{ section.settings.address }}
          </p>

        </div>

      {% endif %}

    </div>



    <!-- ===================================================
         FORMULAIRE
    ==================================================== -->

    <div class="contact-pour__form-wrap">

      {% form 'contact', id: 'ContactPourForm' %}

        {% if form.posted_successfully? %}

          <div class="contact-pour__success">
            Votre demande a bien été envoyée. Nous reviendrons vers vous rapidement.
          </div>

        {% endif %}


        {{ form.errors | default_errors }}


        <!-- NOM / PRÉNOM -->

        <div class="contact-pour__row">

          <div class="contact-pour__field">

            <label for="ContactFirstName-{{ section.id }}">
              PRÉNOM
            </label>

            <input
              id="ContactFirstName-{{ section.id }}"
              type="text"
              name="contact[Prénom]"
              autocomplete="given-name"
              required
            >

          </div>


          <div class="contact-pour__field">

            <label for="ContactLastName-{{ section.id }}">
              NOM
            </label>

            <input
              id="ContactLastName-{{ section.id }}"
              type="text"
              name="contact[Nom]"
              autocomplete="family-name"
              required
            >

          </div>

        </div>



        <!-- EMAIL / TÉLÉPHONE -->

        <div class="contact-pour__row">

          <div class="contact-pour__field">

            <label for="ContactEmail-{{ section.id }}">
              EMAIL
            </label>

            <input
              id="ContactEmail-{{ section.id }}"
              type="email"
              name="contact[email]"
              autocomplete="email"
              required
            >

          </div>


          <div class="contact-pour__field">

            <label for="ContactPhone-{{ section.id }}">
              TÉLÉPHONE
            </label>

            <input
              id="ContactPhone-{{ section.id }}"
              type="tel"
              name="contact[Téléphone]"
              autocomplete="tel"
            >

          </div>

        </div>



        <!-- TYPE DE DEMANDE -->

        <div class="contact-pour__field">

          <label for="ContactReason-{{ section.id }}">
            MOTIF DE LA DEMANDE
          </label>

          <select
            id="ContactReason-{{ section.id }}"
            name="contact[Motif]"
            data-contact-reason
            required
          >
            <option value="">
              Sélectionnez une option
            </option>

            <option value="Question générale">
              Question générale
            </option>

            <option value="Question produit">
              Question produit
            </option>

            <option value="Suivi de commande">
              Suivi de commande
            </option>

            <option value="Retour">
              Retour
            </option>

            <option value="Échange">
              Échange
            </option>

            <option value="Problème de livraison">
              Problème de livraison
            </option>

            <option value="Autre">
              Autre
            </option>
          </select>

        </div>



        <!-- NUMÉRO DE COMMANDE -->

        <div
          class="contact-pour__field contact-pour__order-field"
          data-order-field
        >

          <label for="ContactOrder-{{ section.id }}">
            NUMÉRO DE COMMANDE
          </label>

          <input
            id="ContactOrder-{{ section.id }}"
            type="text"
            name="contact[Numéro de commande]"
            placeholder="#1001"
          >

        </div>



        <!-- MESSAGE -->

        <div class="contact-pour__field">

          <label for="ContactMessage-{{ section.id }}">
            MESSAGE
          </label>

          <textarea
            id="ContactMessage-{{ section.id }}"
            name="contact[body]"
            rows="7"
            required
          ></textarea>

        </div>



        <!-- BOUTON -->

        <button
          type="submit"
          class="contact-pour__submit"
        >
          <span>
            ENVOYER
          </span>

          <span aria-hidden="true">
            →
          </span>
        </button>

      {% endform %}

    </div>

  </div>



  <!-- =====================================================
       AIDE RAPIDE
  ====================================================== -->

  <div class="contact-pour__help">

    <div class="contact-pour__help-header">

      <p class="contact-pour__eyebrow">
        BESOIN D’AIDE ?
      </p>

      <h2 class="contact-pour__help-title">
        LES DEMANDES LES PLUS COURANTES.
      </h2>

    </div>


    <div class="contact-pour__help-grid">


      <div class="contact-pour__help-card">

        <span class="contact-pour__help-number">
          01
        </span>

        <h3>
          SUIVI DE COMMANDE
        </h3>

        <p>
          Retrouvez les informations concernant la préparation,
          l’expédition et la livraison de votre commande.
        </p>

      </div>


      <div class="contact-pour__help-card">

        <span class="contact-pour__help-number">
          02
        </span>

        <h3>
          RETOURS & ÉCHANGES
        </h3>

        <p>
          Une taille ne convient pas ou vous souhaitez effectuer
          un retour ? Sélectionnez directement la demande dans le formulaire.
        </p>

      </div>


      <div class="contact-pour__help-card">

        <span class="contact-pour__help-number">
          03
        </span>

        <h3>
          PRODUITS
        </h3>

        <p>
          Coupe, taille, entretien ou disponibilité :
          contactez-nous pour toute question liée à nos pièces.
        </p>

      </div>


      <div class="contact-pour__help-card">

        <span class="contact-pour__help-number">
          04
        </span>

        <h3>
          LIVRAISON
        </h3>

        <p>
          Une question sur les délais, les pays desservis
          ou votre colis ? Notre équipe peut vous accompagner.
        </p>

      </div>

    </div>

  </div>

</section>

/* =========================================================
   CONTACT — HEADER BLANC AU TOP UNIQUEMENT
========================================================= */

body:has(#ContactPour-{{ section.id }}) .site-header {
  background: #ffffff !important;

  backdrop-filter: none !important;
  -webkit-backdrop-filter: none !important;

  transition:
    background .35s ease,
    backdrop-filter .35s ease;
}

body:has(#ContactPour-{{ section.id }}) .site-header.is-contact-scrolled {
  background: rgba(255, 255, 255, 0.82) !important;

  backdrop-filter: blur(5px) saturate(120%) !important;
  -webkit-backdrop-filter: blur(5px) saturate(120%) !important;
}
