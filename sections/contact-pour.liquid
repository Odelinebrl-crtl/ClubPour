</style>


<script>

(function () {

  function initContactPour() {

    const section =
      document.getElementById(
        'ContactPour-{{ section.id }}'
      );

    if (!section) return;


    const reason =
      section.querySelector(
        '[data-contact-reason]'
      );


    const orderField =
      section.querySelector(
        '[data-order-field]'
      );


    if (
      !reason ||
      !orderField
    ) {
      return;
    }


    function updateOrderField() {

      const value =
        reason.value;


      const needsOrderNumber =
        [
          'Suivi de commande',
          'Retour',
          'Échange',
          'Problème de livraison'
        ].includes(value);


      orderField.classList.toggle(
        'is-visible',
        needsOrderNumber
      );

    }


    reason.addEventListener(
      'change',
      updateOrderField
    );


    updateOrderField();

  }


  if (
    document.readyState === 'loading'
  ) {

    document.addEventListener(
      'DOMContentLoaded',
      initContactPour
    );

  } else {

    initContactPour();
initContactHeaderScroll();

  }


  document.addEventListener(
    'shopify:section:load',
    initContactPour
  );
function initContactHeaderScroll() {

  const section =
    document.getElementById(
      'ContactPour-{{ section.id }}'
    );

  if (!section) return;


  const header =
    document.querySelector('.site-header');

  if (!header) return;


  function updateContactHeader() {

    header.classList.toggle(
      'is-contact-scrolled',
      window.scrollY > 10
    );

  }


  window.addEventListener(
    'scroll',
    updateContactHeader,
    {
      passive: true
    }
  );


  updateContactHeader();

}

})();

</script>


{% schema %}
{
  "name": "Contact POUR",

  "settings": [

    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "contact@pour-store.com"
    },

    {
      "type": "text",
      "id": "phone",
      "label": "Téléphone"
    },

    {
      "type": "text",
      "id": "hours",
      "label": "Horaires",
      "default": "Lundi — Vendredi · 9h — 18h"
    },

    {
      "type": "text",
      "id": "response_time",
      "label": "Délai de réponse",
      "default": "Sous 24 à 48 heures ouvrées"
    },

    {
      "type": "textarea",
      "id": "address",
      "label": "Adresse"
    }

  ],

  "presets": [
    {
      "name": "Contact POUR"
    }
  ]
}
{% endschema %}
