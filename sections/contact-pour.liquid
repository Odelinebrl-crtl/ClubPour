    padding: 120px 15px 70px;
  }

  #ContactPour-{{ section.id }} .contact-pour__title {
    font-size: clamp(56px, 17vw, 88px);
  }

  #ContactPour-{{ section.id }} .contact-pour__main {
    grid-template-columns: 1fr;
    gap: 65px;
    padding: 70px 18px 85px;
  }

  #ContactPour-{{ section.id }} .contact-pour__row {
    grid-template-columns: 1fr;
    gap: 0;
  }

  #ContactPour-{{ section.id }} .contact-pour__help {
    padding: 80px 18px 90px;
  }

  #ContactPour-{{ section.id }} .contact-pour__help-grid {
    grid-template-columns: 1fr;
  }
}

body:has(#ContactPour-{{ section.id }}) .main-page-title,
body:has(#ContactPour-{{ section.id }}) .page-title,
body:has(#ContactPour-{{ section.id }}) h1:not(.contact-pour__title) {
  display: none !important;
}
</style>

<script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js"></script>

<script>
(function () {
  const section = document.getElementById('ContactPour-{{ section.id }}');
  if (!section || section.dataset.contactInitialized === 'true') return;
  section.dataset.contactInitialized = 'true';

  const form = section.querySelector('.contact-pour__form');
  if (!form) return;

  const success = section.querySelector('.contact-pour__success');
  const error = section.querySelector('.contact-pour__error');
  const button = form.querySelector('[type="submit"]');
  const buttonText = button ? button.querySelector('span') : null;

  // Remplace ces 3 valeurs par tes identifiants EmailJS
  const SERVICE_ID = 'TON_SERVICE_ID';
  const TEMPLATE_ID = 'TON_TEMPLATE_ID';
  const PUBLIC_KEY = 'TA_PUBLIC_KEY';

  const reason = form.querySelector('[data-contact-reason]');
  const orderField = form.querySelector('[data-order-field]');

  function updateOrderField() {
    if (!reason || !orderField) return;

    const needsOrderNumber = [
      'order_tracking',
      'return',
      'exchange',
      'delivery_issue'
    ].includes(reason.value);

    orderField.classList.toggle('is-visible', needsOrderNumber);
  }

  if (reason) {
    reason.addEventListener('change', updateOrderField);
    updateOrderField();
  }

  function updateContactHeader() {
    const header = document.querySelector('.site-header');
    if (!header) return;

    header.classList.toggle('is-contact-scrolled', window.scrollY > 70);
  }

  window.addEventListener('scroll', updateContactHeader, { passive: true });
  updateContactHeader();

  if (!window.emailjs) {
    console.error('EmailJS n’a pas pu être chargé.');
    return;
  }

  emailjs.init({ publicKey: PUBLIC_KEY });

  form.addEventListener('submit', async function (event) {
    event.preventDefault();

    if (!form.reportValidity()) return;

    if (success) success.hidden = true;
    if (error) error.hidden = true;

    const originalText = buttonText ? buttonText.textContent : '';

    if (button) button.disabled = true;
    if (buttonText) buttonText.textContent = 'ENVOI EN COURS…';

    const selectedReason = reason && reason.selectedIndex >= 0
      ? reason.options[reason.selectedIndex].text.trim()
      : '';

    const orderInput = form.querySelector('[name="order_number"]');

    const templateParams = {
      first_name: form.querySelector('[name="first_name"]').value.trim(),
      last_name: form.querySelector('[name="last_name"]').value.trim(),
      email: form.querySelector('[name="email"]').value.trim(),
      phone: form.querySelector('[name="phone"]').value.trim(),
      reason: selectedReason,
      order_number: orderInput ? orderInput.value.trim() : '',
      message: form.querySelector('[name="message"]').value.trim()
    };

    try {
      await emailjs.send(SERVICE_ID, TEMPLATE_ID, templateParams);

      form.reset();
      updateOrderField();

      if (success) {
        success.hidden = false;
        success.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    } catch (err) {
      console.error('Erreur EmailJS :', err);

      if (error) {
        error.hidden = false;
        error.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    } finally {
      if (button) button.disabled = false;
      if (buttonText) buttonText.textContent = originalText;
    }
  });
})();
</script>

{% schema %}
{
  "name": "Contact POUR",
  "settings": [
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "contact@pour-store.com"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Téléphone"
    },
    {
      "type": "text",
      "id": "hours",
      "label": "Horaires",
      "default": "Lundi — Vendredi · 9h — 18h"
    },
    {
      "type": "text",
      "id": "response_time",
      "label": "Délai de réponse",
      "default": "Sous 24 à 48 heures ouvrées"
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "Adresse"
    }
  ],
  "presets": [
    {
      "name": "Contact POUR"
    }
  ]
}
{% endschema %}
