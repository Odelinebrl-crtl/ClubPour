#ContactPour-{{ section.id }} .contact-pour__help-card {
  min-height: 280px;
  padding: 28px;
  border: 1px solid rgba(17,17,17,.12);
  background: #ffffff;
}

#ContactPour-{{ section.id }} .contact-pour__help-number {
  display: block;
  margin-bottom: 78px;
  font-size: 9px;
  color: rgba(17,17,17,.45);
}

#ContactPour-{{ section.id }} .contact-pour__help-card h3 {
  margin: 0 0 18px;
  font-size: 18px;
  font-weight: 400;
  text-transform: uppercase;
}

#ContactPour-{{ section.id }} .contact-pour__help-card p {
  max-width: 460px;
  margin: 0;
  font-size: 13px;
