<section
  id="ClothingHero-{{ section.id }}"
  class="clothing-hero"
  data-clothing-hero
  data-autoplay="{{ section.settings.autoplay }}"
  data-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
>

  <!-- =========================
       SLIDES
  ========================== -->

  <div class="clothing-hero__slides">

    {% for block in section.blocks %}

      <article
        class="clothing-hero__slide{% if forloop.first %} is-active{% endif %}"
        data-clothing-slide
        {{ block.shopify_attributes }}
      >

        {% if block.settings.image != blank %}

          {{
            block.settings.image
            | image_url: width: 2600
            | image_tag:
              class: 'clothing-hero__image',
              loading: 'eager'
          }}

        {% else %}

          <div class="clothing-hero__placeholder">
            {{ 'lifestyle-1' | placeholder_svg_tag }}
          </div>

        {% endif %}


        <!-- Overlay facultatif -->

        <div
          class="clothing-hero__overlay"
          style="
            opacity: {{ block.settings.overlay | divided_by: 100.0 }};
          "
        ></div>


        <!-- =========================
             TEXTE HAUT DROITE
        ========================== -->

        <div class="clothing-hero__content">

          {% if block.settings.heading != blank %}
            <h2 class="clothing-hero__heading">
              {{ block.settings.heading }}
            </h2>
          {% endif %}


          {% if block.settings.subtitle != blank %}
            <div class="clothing-hero__subtitle">
              {{ block.settings.subtitle }}
            </div>
          {% endif %}


          {% if block.settings.link_label != blank %}
            <a
              href="{{ block.settings.link }}"
              class="clothing-hero__link"
            >
              {{ block.settings.link_label }}
            </a>
          {% endif %}

        </div>

      </article>

    {% endfor %}

  </div>


  <!-- =========================
       PETIT FIL D'ARIANE
  ========================== -->

  {% if section.settings.breadcrumb != blank %}
    <div class="clothing-hero__breadcrumb">
      {{ section.settings.breadcrumb }}
    </div>
  {% endif %}


  <!-- =========================
       PAGINATION
  ========================== -->

  {% if section.blocks.size > 1 %}

    <div class="clothing-hero__pagination">

      {% for block in section.blocks %}

        <button
          type="button"
          class="clothing-hero__pagination-item{% if forloop.first %} is-active{% endif %}"
          data-clothing-dot="{{ forloop.index0 }}"
          aria-label="Afficher le visuel {{ forloop.index }}"
        >
          {{ forloop.index | prepend: '0' }}
        </button>

      {% endfor %}

    </div>

  {% endif %}

</section>


{% schema %}
{
  "name": "Hero Vêtements",

  "settings": [
    {
      "type": "text",
      "id": "breadcrumb",
      "label": "Fil d’Ariane",
      "default": "ACCUEIL / VÊTEMENTS"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Défilement automatique",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Temps entre les images",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    }
  ],

  "blocks": [
    {
      "type": "slide",
      "name": "Visuel",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Grand titre",
          "default": "COLLECTION 001"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Sous-titre",
          "default": "DÉCOUVREZ NOS PREMIÈRES PIÈCES."
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Texte du lien",
          "default": "DÉCOUVRIR"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Lien"
        },
        {
          "type": "range",
          "id": "overlay",
          "label": "Assombrissement",
          "min": 0,
          "max": 60,
          "step": 5,
          "unit": "%",
          "default": 0
        }
      ]
    }
  ],

  "max_blocks": 8,

  "presets": [
    {
      "name": "Hero Vêtements",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}
