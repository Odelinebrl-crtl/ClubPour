<section
  id="ClothingHero-{{ section.id }}"
  class="clothing-hero"
  data-clothing-hero
  data-autoplay="{{ section.settings.autoplay }}"
  data-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
>

  <div class="clothing-hero__slides">

    {% for i in (1..5) %}

      {% assign image_key = 'image_' | append: i %}
      {% assign title_key = 'title_' | append: i %}
      {% assign subtitle_key = 'subtitle_' | append: i %}
      {% assign link_key = 'link_' | append: i %}

      {% assign slide_image = section.settings[image_key] %}
      {% assign slide_title = section.settings[title_key] %}
      {% assign slide_subtitle = section.settings[subtitle_key] %}
      {% assign slide_link = section.settings[link_key] %}

      {% if slide_image != blank %}

        <article
          class="clothing-hero__slide{% if i == 1 %} is-active{% endif %}"
          data-clothing-slide
        >

          {{
            slide_image
            | image_url: width: 2600
            | image_tag:
              class: 'clothing-hero__image',
              loading: 'eager'
          }}

          <div class="clothing-hero__content">

            {% if slide_title != blank %}
              <h2 class="clothing-hero__heading">
                {{ slide_title }}
              </h2>
            {% endif %}

            {% if slide_subtitle != blank %}
              <div class="clothing-hero__subtitle">
                {{ slide_subtitle }}
              </div>
            {% endif %}

            {% if slide_link != blank %}
              <a
                href="{{ slide_link }}"
                class="clothing-hero__link"
              >
                DÉCOUVRIR
              </a>
            {% endif %}

          </div>

        </article>

      {% endif %}

    {% endfor %}

  </div>


  <!-- FIL D'ARIANE -->

  <div class="clothing-hero__breadcrumb">
    ACCUEIL / VÊTEMENTS
  </div>


  <!-- PAGINATION -->

  <div class="clothing-hero__pagination">

    {% for i in (1..5) %}

      {% assign image_key = 'image_' | append: i %}
      {% assign slide_image = section.settings[image_key] %}

      {% if slide_image != blank %}

        <button
          type="button"
          class="clothing-hero__pagination-item{% if i == 1 %} is-active{% endif %}"
          data-clothing-dot
          aria-label="Afficher le visuel {{ i }}"
        >
          0{{ i }}
        </button>

      {% endif %}

    {% endfor %}

  </div>

</section>


