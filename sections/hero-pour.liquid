<section
  id="Hero-{{ section.id }}"
  class="pour-hero"
  style="
    --hero-text-color: {{ section.settings.text_color }};
    --hero-overlay: {{ section.settings.overlay | divided_by: 100.0 }};
  "
>
 <div class="pour-hero__media">

  {% if section.settings.image_desktop != blank %}

    <picture>

      {% if section.settings.image_mobile != blank %}
        <source
          media="(max-width: 768px)"
          srcset="{{ section.settings.image_mobile | image_url: width: 1200 }}"
        >
      {% endif %}

      <img
        src="{{ section.settings.image_desktop | image_url: width: 2400 }}"
        alt="{{ section.settings.image_desktop.alt | escape }}"
        class="pour-hero__image"
        width="{{ section.settings.image_desktop.width }}"
        height="{{ section.settings.image_desktop.height }}"
        loading="eager"
      >

    </picture>

  {% else %}

    <div class="pour-hero__placeholder">
      {{ 'lifestyle-1' | placeholder_svg_tag }}
    </div>

  {% endif %}

</div>

  <div class="pour-hero__overlay"></div>

  <div class="pour-hero__content pour-hero__content--{{ section.settings.content_position }}">

  {% if section.settings.eyebrow != blank %}
    <p class="pour-hero__eyebrow">
      {{ section.settings.eyebrow }}
    </p>
  {% endif %}


  <form
  class="pour-hero__preorder"
  method="post"
  action="/contact#pour-preorder"
  accept-charset="UTF-8"
  id="pour-preorder"
>
  <input type="hidden" name="form_type" value="customer">
  <input type="hidden" name="utf8" value="✓">

  <div class="pour-hero__email-wrap">
    <input
      class="pour-hero__email"
      type="email"
      name="contact[email]"
      placeholder="VOTRE EMAIL"
      required
      autocomplete="email"
      aria-label="Votre email"
    >
  </div>

  <button
    class="pour-hero__submit"
    type="submit"
  >
   <span class="pour-hero__submit-text">
  {{ section.settings.button_label }}
</span>

    <span class="pour-hero__submit-arrow" aria-hidden="true">
      →
    </span>
  </button>
</form>

  {% if section.settings.launch_text != blank %}
    <p class="pour-hero__launch">
      {{ section.settings.launch_text }}
    </p>
  {% endif %}

</div>
</section>

{% schema %}
{
  "name": "Hero POUR",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Image desktop"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Image mobile"
    },
    {
  "type": "text",
  "id": "eyebrow",
  "label": "Petit texte",
  "default": "POUR COMMENCER — COLLECTION 001"
},
{
  "type": "text",
  "id": "button_label",
  "label": "Texte du bouton",
  "default": "PRÉCOMMANDEZ"
},
{
  "type": "text",
  "id": "launch_text",
  "label": "Texte lancement",
  "default": "LANCEMENT OFFICIEL 01/12/2026"
},
    {
      "type": "select",
      "id": "content_position",
      "label": "Position du contenu",
      "options": [
        {
          "value": "bottom-left",
          "label": "Bas gauche"
        },
        {
          "value": "bottom-center",
          "label": "Bas centre"
        },
        {
          "value": "center",
          "label": "Centre"
        }
      ],
   "default": "bottom-left"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Couleur du texte",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Assombrissement de l'image",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "Hero POUR"
    }
  ]
}
{% endschema %}
