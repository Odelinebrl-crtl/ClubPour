<section
  id="Hero-{{ section.id }}"
  class="pour-hero"
  style="
    --hero-text-color: {{ section.settings.text_color }};
    --hero-overlay: {{ section.settings.overlay | divided_by: 100.0 }};
  "
>
 <div class="pour-hero__media">

  {% if section.settings.image_desktop != blank %}

    <picture>

      {% if section.settings.image_mobile != blank %}
        <source
          media="(max-width: 768px)"
          srcset="{{ section.settings.image_mobile | image_url: width: 2000 }}"
        >
      {% endif %}

      <img
        src="{{ section.settings.image_desktop | image_url: width: 4000 }}"
        alt="{{ section.settings.image_desktop.alt | escape }}"
        class="pour-hero__image"
        width="{{ section.settings.image_desktop.width }}"
        height="{{ section.settings.image_desktop.height }}"
        loading="eager"
      >

    </picture>

  {% else %}

    <div class="pour-hero__placeholder">
      {{ 'lifestyle-1' | placeholder_svg_tag }}
    </div>

  {% endif %}

</div>

  <div class="pour-hero__overlay"></div>

  <div class="pour-hero__content pour-hero__content--{{ section.settings.content_position }}">

 {% if section.settings.eyebrow != blank %}
  <p class="pour-hero__eyebrow">
    {{ section.settings.eyebrow }}
  </p>
{% endif %}

{% if section.settings.hero_title != blank %}
  <h1 class="pour-hero__heading">
    <span class="pour-hero__heading-sub">L'AUTOMOBILE,</span>
    <span class="pour-hero__heading-main">AUTREMENT PORTÉE.</span>
  </h1>
{% endif %}

<a
  href="{{ pages['boutique'].url }}"
  class="pour-hero__submit"
>
  <span class="pour-hero__submit-text">
    {{ section.settings.button_label }}
  </span>
</a>

  {% if section.settings.launch_text != blank %}
    <p class="pour-hero__launch">
      {{ section.settings.launch_text }}
    </p>
  {% endif %}

</div>
</section>



<div class="pour-hero-banner">
  <div class="pour-hero-banner__inner">

    <div class="pour-hero-banner__promo">
      {{ 'hero.prelaunch_banner' | t }}
    </div>

    <div class="pour-hero-banner__details">

      <div class="pour-hero-banner__item">
        <svg viewBox="0 0 40 40" aria-hidden="true">
          <path d="M5 31 C8 25 10 19 12 12 C15 10 18 7 23 6 C27 5 31 7 34 10 C31 15 29 20 26 25 C21 30 14 33 5 31Z"
            fill="none" stroke="currentColor" stroke-width="1.1"
            stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M6 32 C15 24 23 16 32 8"
            fill="none" stroke="currentColor" stroke-width="1.1"
            stroke-linecap="round"/>
        </svg>
        <span>COTON BIOLOGIQUE 200 GSM</span>
      </div>

      <span class="pour-hero-banner__separator"></span>

      <div class="pour-hero-banner__item">
        <svg viewBox="0 0 40 40" aria-hidden="true">
          <path d="M13.5 3.5
            L17 5.5 L21 4.5 L24 6.5 L28.5 6
            L30 10 L34 12 L33 16 L36 19
            L33.5 23 L34 27 L30 29.5
            L28 34 L23.5 33 L20 36
            L16.5 33.5 L12 34.5 L10 30
            L6 28 L7 23.5 L4.5 20
            L7 16 L6.5 12 L10.5 10
            L11 6.5 Z"
            fill="none" stroke="currentColor" stroke-width="1.1"
            stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span>IMPRIMÉ EN FRANCE</span>
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero POUR",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Image desktop"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Image mobile"
    },
    {
  "type": "text",
  "id": "eyebrow",
  "label": "Petit texte",
  "default": "POUR COMMENCER — COLLECTION 001"
},
{
  "type": "text",
  "id": "hero_title",
  "label": "Grand titre",
  "default": "POUR"
},
{
  "type": "text",
  "id": "button_label",
  "label": "Texte du bouton",
  "default": "ACHETER"
},
{
  "type": "text",
  "id": "launch_text",
  "label": "Texte lancement",
  "default": "LANCEMENT OFFICIEL 01/11/2026"
},
{
  "type": "text",
  "id": "prelaunch_banner",
  "label": "Bandeau pré-lancement",
  "default": "LES EXPÉDITIONS DÉBUTERONT À PARTIR DU 10 NOVEMBRE."
},
    {
      "type": "select",
      "id": "content_position",
      "label": "Position du contenu",
      "options": [
        {
          "value": "bottom-left",
          "label": "Bas gauche"
        },
        {
          "value": "bottom-center",
          "label": "Bas centre"
        },
        {
          "value": "center",
          "label": "Centre"
        }
      ],
   "default": "bottom-left"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Couleur du texte",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Assombrissement de l'image",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "Hero POUR"
    }
  ]
}
{% endschema %}
