{% schema %}
{
  "name": "Hero POUR",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Image desktop"
    },
    {
  "type": "header",
  "content": "Photos ordinateur"
},
{
  "type": "image_picker",
  "id": "image_desktop_1",
  "label": "Photo ordinateur 1"
},
{
  "type": "image_picker",
  "id": "image_desktop_2",
  "label": "Photo ordinateur 2"
},
{
  "type": "image_picker",
  "id": "image_desktop_3",
  "label": "Photo ordinateur 3"
},
{
  "type": "image_picker",
  "id": "image_desktop_4",
  "label": "Photo ordinateur 4"
},
{
  "type": "image_picker",
  "id": "image_desktop_5",
  "label": "Photo ordinateur 5"
},

{
  "type": "range",
  "id": "desktop_zoom_1",
  "label": "Zoom photo 1",
  "min": 100,
  "max": 200,
  "step": 5,
  "unit": "%",
  "default": 130
},
{
  "type": "range",
  "id": "desktop_x_1",
  "label": "Position horizontale photo 1",
  "min": 0,
  "max": 100,
  "step": 5,
  "unit": "%",
  "default": 50
},
{
  "type": "range",
  "id": "desktop_y_1",
  "label": "Position verticale photo 1",
  "min": 0,
  "max": 100,
  "step": 5,
  "unit": "%",
  "default": 50
},
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Image mobile"
    },

{
  "type": "image_picker",
  "id": "image_mobile_1",
  "label": "Photo mobile 1 (60 %)"
},
{
  "type": "image_picker",
  "id": "image_mobile_2",
  "label": "Photo mobile 2 (40 %)"
},

    {
  "type": "text",
  "id": "eyebrow",
  "label": "Petit texte",
  "default": "POUR COMMENCER — COLLECTION 001"
},
{
  "type": "text",
  "id": "hero_title",
  "label": "Grand titre",
  "default": "POUR"
},
{
  "type": "text",
  "id": "button_label",
  "label": "Texte du bouton",
  "default": "ACHETER"
},
{
  "type": "text",
  "id": "launch_text",
  "label": "Texte lancement",
  "default": "LANCEMENT OFFICIEL 01/11/2026"
},
{
  "type": "text",
  "id": "prelaunch_banner",
  "label": "Bandeau pré-lancement",
  "default": "LES EXPÉDITIONS DÉBUTERONT À PARTIR DU 10 NOVEMBRE."
},
    {
      "type": "select",
      "id": "content_position",
      "label": "Position du contenu",
      "options": [
        {
          "value": "bottom-left",
          "label": "Bas gauche"
        },
        {
          "value": "bottom-center",
          "label": "Bas centre"
        },
        {
          "value": "center",
          "label": "Centre"
        }
      ],
   "default": "bottom-left"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Couleur du texte",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Assombrissement de l'image",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "Hero POUR"
    }
  ]
}
{% endschema %}
