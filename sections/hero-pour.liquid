{% schema %}
{
  "name": "Hero POUR",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Image desktop"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Image mobile"
    },
    {
  "type": "text",
  "id": "eyebrow",
  "label": "Petit texte",
  "default": "POUR COMMENCER — COLLECTION 001"
},
{
  "type": "text",
  "id": "hero_title",
  "label": "Grand titre",
  "default": "POUR"
},
{
  "type": "text",
  "id": "button_label",
  "label": "Texte du bouton",
  "default": "ACHETER"
},
{
  "type": "text",
  "id": "launch_text",
  "label": "Texte lancement",
  "default": "LANCEMENT OFFICIEL 01/11/2026"
},
{
  "type": "text",
  "id": "prelaunch_banner",
  "label": "Bandeau pré-lancement",
  "default": "LES EXPÉDITIONS DÉBUTERONT À PARTIR DU 10 NOVEMBRE."
},
    {
      "type": "select",
      "id": "content_position",
      "label": "Position du contenu",
      "options": [
        {
          "value": "bottom-left",
          "label": "Bas gauche"
        },
        {
          "value": "bottom-center",
          "label": "Bas centre"
        },
        {
          "value": "center",
          "label": "Centre"
        }
      ],
   "default": "bottom-left"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Couleur du texte",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Assombrissement de l'image",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "Hero POUR"
    }
  ]
}
{% endschema %}
