<section
  id="Hero-{{ section.id }}"
class="pour-hero{% if section.settings.image_mobile_1 != blank and section.settings.image_mobile_2 != blank %} pour-hero--split-mobile{% endif %}{% if section.settings.image_desktop_1 != blank and section.settings.image_desktop_2 != blank and section.settings.image_desktop_3 != blank and section.settings.image_desktop_4 != blank and section.settings.image_desktop_5 != blank %} pour-hero--five-desktop{% endif %}"
  style="
    --hero-text-color: {{ section.settings.text_color }};
    --hero-overlay: {{ section.settings.overlay | divided_by: 100.0 }};
  "
>
 <div class="pour-hero__media">

  {% if section.settings.image_desktop != blank %}

    <picture>

      {% if section.settings.image_mobile != blank %}
        <source
          media="(max-width: 768px)"
          srcset="{{ section.settings.image_mobile | image_url: width: 3000 }}"
        >
      {% endif %}

      <img
        src="{{ section.settings.image_desktop | image_url: width: 5760 }}"
        alt="{{ section.settings.image_desktop.alt | escape }}"
        class="pour-hero__image"
        width="{{ section.settings.image_desktop.width }}"
        height="{{ section.settings.image_desktop.height }}"
        loading="eager"
      >

    </picture>

  {% else %}

    <div class="pour-hero__placeholder">
      {{ 'lifestyle-1' | placeholder_svg_tag }}
    </div>

  {% endif %}


</div>

{% if section.settings.image_desktop_1 != blank
  and section.settings.image_desktop_2 != blank
  and section.settings.image_desktop_3 != blank
  and section.settings.image_desktop_4 != blank
  and section.settings.image_desktop_5 != blank
%}
 
<div class="pour-hero__desktop-gallery">

  {% for i in (1..5) %}
    {% assign image_key = 'image_desktop_' | append: i %}
    {% assign zoom_key = 'desktop_zoom_' | append: i %}
    {% assign x_key = 'desktop_x_' | append: i %}
    {% assign y_key = 'desktop_y_' | append: i %}

    {% assign hero_image = section.settings[image_key] %}
    {% assign zoom = section.settings[zoom_key] | default: 130 %}
    {% assign pos_x = section.settings[x_key] | default: 50 %}
    {% assign pos_y = section.settings[y_key] | default: 50 %}

    {% if hero_image != blank %}
      <div class="pour-hero__desktop-image">
        {{
          hero_image
          | image_url: width: 1800
          | image_tag:
            widths: '600, 900, 1200, 1500, 1800',
            sizes: '20vw',
            loading: 'eager'
        }}

        <style>
          #Hero-{{ section.id }} .pour-hero__desktop-image:nth-child({{ i }}) img {
            width: {{ zoom }}%;
            height: {{ zoom }}%;
            max-width: none;
            object-fit: cover;
            object-position: {{ pos_x }}% {{ pos_y }}%;
            left: {{ 50 | minus: zoom | divided_by: 2 }}%;
            top: {{ 50 | minus: zoom | divided_by: 2 }}%;
          }
        </style>
      </div>
    {% endif %}
  {% endfor %}

</div>

{% endif %}

{% if section.settings.image_mobile_1 != blank and section.settings.image_mobile_2 != blank %}

  <div class="pour-hero__mobile-split">

    <div class="pour-hero__mobile-image pour-hero__mobile-image--first">
      {{
        section.settings.image_mobile_1
        | image_url: width: 2400
        | image_tag:
          widths: '750, 1100, 1500, 2000, 2400',
          sizes: '100vw',
          loading: 'eager'
      }}
    </div>

    <div class="pour-hero__mobile-image pour-hero__mobile-image--second">
      {{
        section.settings.image_mobile_2
        | image_url: width: 2400
        | image_tag:
          widths: '750, 1100, 1500, 2000, 2400',
          sizes: '100vw',
          loading: 'eager'
      }}
    </div>

  </div>
{% endif %}

  <div class="pour-hero__overlay"></div>

  <div class="pour-hero__content pour-hero__content--{{ section.settings.content_position }}">

 {% if section.settings.eyebrow != blank %}
  <p class="pour-hero__eyebrow">
    {{ section.settings.eyebrow }}
  </p>
{% endif %}

{% if section.settings.hero_title != blank %}
  <h1 class="pour-hero__heading">
    <span class="pour-hero__heading-sub">L'AUTOMOBILE,</span>
    <span class="pour-hero__heading-main">AUTREMENT PORTÉE.</span>
  </h1>
{% endif %}

<a
  href="{{ pages['boutique'].url }}"
  class="pour-hero__submit"
>
  <span class="pour-hero__submit-text">
    {{ section.settings.button_label }}
  </span>
</a>

  {% if section.settings.launch_text != blank %}
    <p class="pour-hero__launch">
      {{ section.settings.launch_text }}
    </p>
  {% endif %}

</div>
</section>




<!-- BANDEAU BLACK FRIDAY -->
<div class="pour-hero-banner">
  <span>{{ 'hero.prelaunch_banner' | t }}</span>
</div>

<!-- BANDEAU QUALITÉ -->
