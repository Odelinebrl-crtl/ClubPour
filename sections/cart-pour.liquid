<section
  id="CartPour-{{ section.id }}"
  class="cart-pour"
>

  <div class="cart-pour__inner">

    <div class="cart-pour__header">
      <p class="cart-pour__eyebrow">
        {{ 'cart_pour.eyebrow' | t }}
      </p>

      <h1 class="cart-pour__title">
        {{ 'cart_pour.title' | t }}
      </h1>
    </div>

    {% if cart.item_count > 0 %}

      <form
        action="{{ routes.cart_url }}"
        method="post"
        class="cart-pour__layout"
        novalidate
      >

        <div class="cart-pour__products">

          <div class="cart-pour__products-head">
            <span>
              {{ 'cart_pour.products' | t }}
            </span>

            <span>
              {{ cart.item_count }}
              {% if cart.item_count > 1 %}
                {{ 'cart_pour.article_plural' | t }}
              {% else %}
                {{ 'cart_pour.article_singular' | t }}
              {% endif %}
            </span>
          </div>

          {% for item in cart.items %}
            <article class="cart-pour__item">

              <a
                href="{{ item.url }}"
                class="cart-pour__item-media"
              >
                {% if item.image != blank %}
                  {{
                    item.image
                    | image_url: width: 900
                    | image_tag:
                      class: 'cart-pour__item-image',
                      loading: 'lazy',
                      alt: item.product.title
                  }}
                {% endif %}
              </a>

              <div class="cart-pour__item-content">

                <div class="cart-pour__item-top">
                  <div>
                    <a
                      href="{{ item.url }}"
                      class="cart-pour__item-title"
                    >
                      {{ item.product.title }}
                    </a>

                    {% unless item.product.has_only_default_variant %}
                      <div class="cart-pour__variants">
                        {% for option in item.options_with_values %}
                          <p>
                            <span>
                              {{ option.name }} :
                            </span>
                            {{ option.value }}
                          </p>
                        {% endfor %}
                      </div>
                    {% endunless %}
                  </div>

                  <div class="cart-pour__item-price">
                    {% if item.original_line_price != item.final_line_price %}
                      <s>
                        {{ item.original_line_price | money }}
                      </s>
                    {% endif %}

                    <span>
                      {% if cart.currency.iso_code == 'EUR' %}
  {{ item.final_line_price | money_without_currency | append: ' €' }}
{% else %}
  {{ item.final_line_price | money }}
{% endif %}
                    </span>
                  </div>
                </div>

                <div class="cart-pour__item-bottom">

                  <div class="cart-pour__quantity">
                    <a
                      href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | minus: 1 }}"
                      class="cart-pour__quantity-button"
                      aria-label="{{ 'cart_pour.decrease' | t }}"
                    >−</a>

                    <span class="cart-pour__quantity-value">
                      {{ item.quantity }}
                    </span>

                    <a
                      href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | plus: 1 }}"
                      class="cart-pour__quantity-button"
                      aria-label="{{ 'cart_pour.increase' | t }}"
                    >+</a>
                  </div>

                  <a
                    href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0"
                    class="cart-pour__remove"
                  >
                    {{ 'cart_pour.remove' | t }}
                  </a>
                </div>

              </div>
            </article>
          {% endfor %}

          <div class="cart-pour__continue">
  <a href="{{ pages.boutique.url }}">
    {{ 'cart_pour.continue' | t }}
  </a>
</div>

        </div>

        <aside class="cart-pour__summary">

          <p class="cart-pour__summary-eyebrow">
            {{ 'cart_pour.summary' | t }}
          </p>


{% if request.locale.iso_code == 'fr' and localization.country.iso_code == 'FR' and cart.currency.iso_code == 'EUR' %}

<div class="cart-pour__delivery-timeline" data-cart-pour-timeline>

  <div class="cart-pour__delivery-step">
    <span class="cart-pour__delivery-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 4h2l2.2 11.2a2 2 0 0 0 2 1.6h8.5a2 2 0 0 0 1.9-1.4L22 9H6"/>
        <circle cx="10" cy="21" r="1"/>
        <circle cx="18" cy="21" r="1"/>
      </svg>
    </span>
    <strong>COMMANDE</strong>
    <span data-cart-pour-order></span>
  </div>

  <div class="cart-pour__delivery-step">
    <span class="cart-pour__delivery-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 6h11v12H3z"/>
        <path d="M14 10h4l3 4v4h-7z"/>
        <circle cx="7.5" cy="19" r="1.5"/>
        <circle cx="17.5" cy="19" r="1.5"/>
      </svg>
    </span>
    <strong>EXPÉDITION</strong>
    <span data-cart-pour-dispatch></span>
  </div>

  <div class="cart-pour__delivery-step">
    <span class="cart-pour__delivery-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
        <path d="m12 3 9 5v8l-9 5-9-5V8z"/>
        <path d="m3 8 9 5 9-5M12 13v8M7.5 5.5l9 5"/>
      </svg>
    </span>
    <strong>LIVRAISON</strong>
    <span data-cart-pour-arrival></span>
  </div>

</div>

<p class="cart-pour__delivery-note">
  Délais estimatifs pour la France métropolitaine
</p>

{% endif %}

{% if request.locale.iso_code == 'fr' and localization.country.iso_code == 'FR' and cart.currency.iso_code == 'EUR' %}

  {% assign free_shipping_threshold = 10000 %}
  {% assign free_shipping_remaining = free_shipping_threshold | minus: cart.total_price %}
  {% assign free_shipping_progress = cart.total_price | times: 100.0 | divided_by: free_shipping_threshold | at_most: 100 %}
{% assign free_shipping_remaining_money = free_shipping_remaining | money_without_currency | append: ' €' %}

<a
  class="cart-pour__google-rating"
  href="{{ section.settings.google_review_url }}"
  target="_blank"
  rel="noopener noreferrer"
>
  <span class="cart-pour__google-stars">★★★★★</span>
  <span>{{ section.settings.google_rating }}/5</span>
  <span class="cart-pour__google-count">
    ({{ section.settings.google_review_count }} avis)
  </span>
</a>

  <div class="cart-pour__free-shipping">

    <p class="cart-pour__free-shipping-text">

      {% if cart.total_price >= free_shipping_threshold %}

        {{ 'cart_pour.free_shipping_unlocked' | t }}

      {% else %}

        {{ 'cart_pour.free_shipping_remaining' | t: amount: free_shipping_remaining_money }}

      {% endif %}

    </p>

    <div class="cart-pour__free-shipping-track">

      <div
        class="cart-pour__free-shipping-progress"
        style="width: {{ free_shipping_progress }}%;"
      ></div>

    </div>

    <div class="cart-pour__free-shipping-labels">

      <span>0 €</span>

      <span>100 €</span>

    </div>

  </div>

{% endif %}

<div class="cart-pour__summary-line">
  <span>
    {{ 'cart_pour.subtotal' | t }}
  </span>

  <span>
   {% if cart.currency.iso_code == 'EUR' %}
  {{ cart.total_price | money_without_currency | append: ' €' }}
{% else %}
  {{ cart.total_price | money }}
{% endif %}
  </span>
</div>
{% if request.locale.iso_code == 'fr' and localization.country.iso_code == 'FR' and cart.currency.iso_code == 'EUR' %}
  <div
    class="cart-pour__summary-line cart-pour__delivery-from"
    {% if cart.total_price >= free_shipping_threshold %}
      hidden
    {% endif %}
  >
    <span>FRAIS DE LIVRAISON À PARTIR DE</span>
    <span>4,42 €</span>
  </div>
{% endif %}
          <p class="cart-pour__shipping">
            {{ 'cart_pour.shipping_note' | t }}
          </p>

          <button
            type="submit"
            name="checkout"
            class="cart-pour__checkout"
          >
            <span>{{ 'cart_pour.checkout' | t }}</span>
            <span aria-hidden="true">→</span>
          </button>

<div class="cart-pour__payment-icons">
  {% for type in shop.enabled_payment_types %}
    <span class="cart-pour__payment-icon">
      {{ type | payment_type_svg_tag }}
    </span>
  {% endfor %}
</div>

          <div class="cart-pour__reassurance">
            <div>
              <span class="cart-pour__reassurance-label">
                {{ 'cart_pour.payment_label' | t }}
              </span>
              <span>{{ 'cart_pour.secure_payment' | t }}</span>
            </div>

            <div>
              <span class="cart-pour__reassurance-label">
                {{ 'cart_pour.delivery_label' | t }}
              </span>
              <span>{{ 'cart_pour.tracking_available' | t }}</span>
            </div>

            <div>
              <span class="cart-pour__reassurance-label">
                {{ 'cart_pour.returns_label' | t }}
              </span>
              <span>{{ 'cart_pour.return_policy' | t }}</span>
            </div>
          </div>

        </aside>

      </form>

    {% else %}

      <div class="cart-pour__empty">
        <p class="cart-pour__empty-title">
          {{ 'cart_pour.empty_title' | t }}
        </p>

        <p class="cart-pour__empty-text">
          {{ 'cart_pour.empty_text' | t }}
        </p>

        <a
          href="{{ routes.root_url }}pages/boutique"
          class="cart-pour__empty-button"
        >
          <span>{{ 'cart_pour.empty_button' | t }}</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>

    {% endif %}

  </div>

</section>

<style>

/* =========================================================
   CART POUR
========================================================= */

#CartPour-{{ section.id }} {
  width: 100%;

  padding:
    115px
    54px
    130px;

  box-sizing: border-box;

  background: #ffffff;
  color: #111111;

  font-family:
    "Helvetica Neue",
    Helvetica,
    Arial,
    sans-serif;
}


/* =========================================================
   CONTENEUR
========================================================= */

#CartPour-{{ section.id }}
.cart-pour__inner {
  width: 100%;

  max-width: 1450px;

  margin: 0 auto;
}


/* =========================================================
   HEADER
========================================================= */

#CartPour-{{ section.id }}
.cart-pour__header {
  margin-bottom: 85px;
}


#CartPour-{{ section.id }}
.cart-pour__eyebrow {
  margin: 0 0 22px;

  font-size: 9px;
  font-weight: 400;

  line-height: 1;

  letter-spacing: .22em;

  text-transform: uppercase;

  color: rgba(17,17,17,.45);
}


#CartPour-{{ section.id }}
.cart-pour__title {
  margin: 0;

  font-size:
    clamp(
      58px,
      8vw,
      118px
    );

  font-weight: 400;

  line-height: .9;

  letter-spacing: -.06em;

  text-transform: uppercase;
}


/* =========================================================
   LAYOUT
========================================================= */

#CartPour-{{ section.id }}
.cart-pour__layout {
  display: grid;

  grid-template-columns:
    minmax(0,1.5fr)
    minmax(320px,.5fr);

  align-items: start;

  gap:
    clamp(
      70px,
      9vw,
      150px
    );
}


/* =========================================================
   LISTE PRODUITS
========================================================= */

#CartPour-{{ section.id }}
.cart-pour__products-head {
  display: flex;

  align-items: center;
  justify-content: space-between;

  padding-bottom: 18px;

  border-bottom:
    1px solid
    rgba(17,17,17,.13);

  font-size: 9px;
  font-weight: 400;

  letter-spacing: .14em;

  text-transform: uppercase;

  color: rgba(17,17,17,.52);
}


/* =========================================================
   PRODUIT
========================================================= */

#CartPour-{{ section.id }}
.cart-pour__item {
  display: grid;

  grid-template-columns:
    185px
    minmax(0,1fr);

  gap: 32px;

  padding:
    32px
    0;

  border-bottom:
    1px solid
    rgba(17,17,17,.10);
}


/* IMAGE */

#CartPour-{{ section.id }}
.cart-pour__item-media {
  display: block;

  width: 185px;

  overflow: hidden;

  text-decoration: none;
}


#CartPour-{{ section.id }}
.cart-pour__item-image {
  display: block;

  width: 100%;
  height: auto;

  transition:
    transform .65s cubic-bezier(.22,1,.36,1);
}


#CartPour-{{ section.id }}
.cart-pour__item-media:hover
.cart-pour__item-image {
  transform: scale(1.02);
}


/* =========================================================
   INFOS PRODUIT
========================================================= */

#CartPour-{{ section.id }}
.cart-pour__item-content {
  display: flex;

  flex-direction: column;

  justify-content: space-between;

  min-width: 0;
}


#CartPour-{{ section.id }}
.cart-pour__item-top {
  display: flex;

  justify-content: space-between;

  gap: 30px;
}


#CartPour-{{ section.id }}
.cart-pour__item-title {
  display: inline-block;

  margin: 0;

  color: #111111;

  font-size:
    clamp(
      20px,
      2vw,
      30px
    );

  font-weight: 400;

  line-height: 1;

  letter-spacing: -.03em;

  text-transform: uppercase;

  text-decoration: none;
}


/* VARIANTES */

#CartPour-{{ section.id }}
.cart-pour__variants {
  margin-top: 15px;
}


#CartPour-{{ section.id }}
.cart-pour__variants p {
  margin: 5px 0 0;

  font-size: 10px;

  color: rgba(17,17,17,.56);
}


#CartPour-{{ section.id }}
.cart-pour__variants span {
  text-transform: uppercase;
}


/* PRIX */

#CartPour-{{ section.id }}
.cart-pour__item-price {
  display: flex;

  flex-direction: column;

  align-items: flex-end;

  gap: 4px;

  flex-shrink: 0;

  font-size: 11px;
}


#CartPour-{{ section.id }}
.cart-pour__item-price s {
  color: rgba(17,17,17,.38);
}


/* =========================================================
   QUANTITÉ
========================================================= */

#CartPour-{{ section.id }}
.cart-pour__item-bottom {
  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 25px;

  margin-top: 35px;
}


#CartPour-{{ section.id }}
.cart-pour__quantity {
  display: inline-grid;

  grid-template-columns:
    34px
    34px
    34px;

  align-items: center;

  height: 34px;

  border:
    1px solid
    rgba(17,17,17,.20);
}


#CartPour-{{ section.id }}
.cart-pour__quantity-button,
#CartPour-{{ section.id }}
.cart-pour__quantity-value {
  display: flex;

  align-items: center;
  justify-content: center;

  width: 34px;
  height: 34px;

  color: #111111;

  font-size: 12px;

  line-height: 1;

  text-decoration: none;
}


#CartPour-{{ section.id }}
.cart-pour__quantity-button {
  transition:
    background-color .3s ease;
}


#CartPour-{{ section.id }}
.cart-pour__quantity-button:hover {
  background: rgba(17,17,17,.05);
}


/* SUPPRIMER */

#CartPour-{{ section.id }}
.cart-pour__remove {
  position: relative;

  padding-bottom: 4px;

  color: rgba(17,17,17,.55);

  font-size: 9px;

  letter-spacing: .10em;

  text-transform: uppercase;

  text-decoration: none;
}


#CartPour-{{ section.id }}
.cart-pour__remove::after {
  content: "";

  position: absolute;

  left: 0;
  bottom: 0;

  width: 100%;
  height: 1px;

  background: currentColor;

  transition:
    transform .4s cubic-bezier(.22,1,.36,1);

  transform-origin: left;
}


#CartPour-{{ section.id }}
.cart-pour__remove:hover::after {
  transform: scaleX(.45);
}


/* =========================================================
   CONTINUER ACHATS
========================================================= */

#CartPour-{{ section.id }}
.cart-pour__continue {
  padding-top: 28px;
}


#CartPour-{{ section.id }}
.cart-pour__continue a {
  color: rgba(17,17,17,.55);

  font-size: 9px;

  letter-spacing: .10em;

  text-transform: uppercase;

  text-decoration: none;

  transition:
    color .3s ease;
}


#CartPour-{{ section.id }}
.cart-pour__continue a:hover {
  color: #111111;
}


/* =========================================================
   RÉCAPITULATIF
========================================================= */

#CartPour-{{ section.id }}
.cart-pour__summary {
  position: sticky;

  top: 110px;

  padding-top: 3px;
}


#CartPour-{{ section.id }}
.cart-pour__summary-eyebrow {
  margin: 0 0 25px;

  padding-bottom: 18px;

  border-bottom:
    1px solid
    rgba(17,17,17,.13);

  font-size: 9px;

  letter-spacing: .14em;

  text-transform: uppercase;

  color: rgba(17,17,17,.52);
}
/* =========================================================
   LIVRAISON OFFERTE
========================================================= */

#CartPour-{{ section.id }}
.cart-pour__free-shipping {
  margin:
    0
    0
    28px;
}


#CartPour-{{ section.id }}
.cart-pour__free-shipping-text {
  margin: 0 0 12px;

  font-size: 11px;

  line-height: 1.5;

  color: #111111;
}


#CartPour-{{ section.id }}
.cart-pour__free-shipping-track {
  width: 100%;

  height: 5px;

  overflow: hidden;

  border-radius: 999px;

  background: rgba(17,17,17,.10);
}


#CartPour-{{ section.id }}
.cart-pour__free-shipping-progress {
  height: 100%;

  min-width: 0;

  border-radius: 999px;

  background: linear-gradient(
    90deg,
    #39FF88 0%,
    #00CFFF 50%,
    #003B8F 100%
  );

  transition:
    width .5s ease;
}
/* =========================================================
   LABELS JAUGE LIVRAISON OFFERTE
========================================================= */

#CartPour-{{ section.id }}
.cart-pour__free-shipping-labels {
  display: flex;

  align-items: center;
  justify-content: space-between;

  margin-top: 8px;

  font-size: 9px;

  line-height: 1;

  color: rgba(17,17,17,.55);
}
#CartPour-{{ section.id }}
.cart-pour__summary-line {
  display: flex;

  align-items: center;
  justify-content: space-between;

  gap: 25px;

  font-size: 11px;

  text-transform: uppercase;
}
#CartPour-{{ section.id }}
.cart-pour__delivery-from {
  margin-top: 9px;
}
#CartPour-{{ section.id }}
.cart-pour__delivery-from[hidden] {
  display: none !important;
}
#CartPour-{{ section.id }}
.cart-pour__shipping {
  margin:
    24px
    0
    0;

  max-width: 320px;

  font-size: 11px;

  line-height: 1.55;

  color: rgba(17,17,17,.55);
}


/* =========================================================
   CHECKOUT
========================================================= */

#CartPour-{{ section.id }}
.cart-pour__checkout,
#CartPour-{{ section.id }}
.cart-pour__empty-button {
  display: flex;

  align-items: center;
  justify-content: space-between;

  gap: 30px;

  width: 100%;
  min-height: 54px;

  margin-top: 32px;

  padding:
    0
    22px;

  box-sizing: border-box;

  border:
    1px solid
    #111111;

  border-radius: 0;

  background: #111111;

  color: #ffffff;

  font-family: inherit;

  font-size: 10px;
  font-weight: 400;

  letter-spacing: .11em;

  text-transform: uppercase;

  text-decoration: none;

  cursor: pointer;

  transition:
    background-color .55s cubic-bezier(.22,1,.36,1),
    color .55s cubic-bezier(.22,1,.36,1);
}


#CartPour-{{ section.id }}
.cart-pour__checkout:hover,
#CartPour-{{ section.id }}
.cart-pour__empty-button:hover {
  background: #ffffff;

  color: #111111;
}


/* =========================================================
   RASSURANCE
========================================================= */

#CartPour-{{ section.id }}
.cart-pour__reassurance {
  display: flex;

  flex-direction: column;

  gap: 17px;

  margin-top: 35px;

  padding-top: 25px;

  border-top:
    1px solid
    rgba(17,17,17,.10);
}


#CartPour-{{ section.id }}
.cart-pour__reassurance > div {
  display: flex;

  flex-direction: column;

  gap: 5px;

  font-size: 10px;

  line-height: 1.4;

  color: rgba(17,17,17,.55);
}


#CartPour-{{ section.id }}
.cart-pour__reassurance-label {
  font-size: 8px;

  letter-spacing: .13em;

  text-transform: uppercase;

  color: #111111;
}


/* =========================================================
   PANIER VIDE
========================================================= */

#CartPour-{{ section.id }}
.cart-pour__empty {
  display: flex;

  flex-direction: column;

  align-items: center;

  justify-content: center;

  min-height: 420px;

  padding-bottom: 60px;

  text-align: center;
}


#CartPour-{{ section.id }}
.cart-pour__empty-title {
  margin: 0;

  font-size:
    clamp(
      32px,
      4vw,
      58px
    );

  font-weight: 400;

  line-height: 1;

  letter-spacing: -.04em;
}


#CartPour-{{ section.id }}
.cart-pour__empty-text {
  max-width: 440px;

  margin:
    24px
    auto
    0;

  font-size: 12px;

  line-height: 1.6;

  color: rgba(17,17,17,.58);
}


#CartPour-{{ section.id }}
.cart-pour__empty-button {
  width: auto;

  min-width: 240px;
}


/* =========================================================
   MOBILE
========================================================= */

@media screen and (max-width: 850px) {

  #CartPour-{{ section.id }} {
    padding:
      85px
      18px
      100px;
  }


  #CartPour-{{ section.id }}
  .cart-pour__header {
    margin-bottom: 55px;
  }


  #CartPour-{{ section.id }}
  .cart-pour__layout {
    grid-template-columns: 1fr;

    gap: 70px;
  }


  #CartPour-{{ section.id }}
  .cart-pour__summary {
    position: static;
  }

}


@media screen and (max-width: 600px) {

  #CartPour-{{ section.id }}
  .cart-pour__item {
    grid-template-columns:
      115px
      minmax(0,1fr);

    gap: 18px;
  }


  #CartPour-{{ section.id }}
  .cart-pour__item-media {
    width: 115px;
  }


  #CartPour-{{ section.id }}
  .cart-pour__item-top {
    flex-direction: column;

    gap: 16px;
  }


  #CartPour-{{ section.id }}
  .cart-pour__item-price {
