<script>
(function () {

  const timeline = document.querySelector(
    '#CartPour-{{ section.id }} [data-cart-pour-timeline]'
  );

  if (!timeline) return;

  function addDays(date, days) {
    const result = new Date(date);
    result.setDate(result.getDate() + days);
    return result;
  }

  function formatDate(date) {
    return new Intl.DateTimeFormat('fr-FR', {
      day: '2-digit',
      month: 'short'
    }).format(date).replace('.', '').toUpperCase();
  }

  const today = new Date();
  today.setHours(12, 0, 0, 0);

  const dispatch = addDays(today, 3);
  const arrivalStart = addDays(dispatch, 2);
  const arrivalEnd = addDays(dispatch, 5);

  const orderElement = timeline.querySelector(
    '[data-cart-pour-order]'
  );

  const dispatchElement = timeline.querySelector(
    '[data-cart-pour-dispatch]'
  );

  const arrivalElement = timeline.querySelector(
    '[data-cart-pour-arrival]'
  );

  if (orderElement) {
    orderElement.textContent = "Aujourd'hui";
  }

  if (dispatchElement) {
    dispatchElement.textContent =
      'À partir du ' + formatDate(dispatch);
  }

  if (arrivalElement) {
    arrivalElement.textContent =
      formatDate(arrivalStart) + ' – ' + formatDate(arrivalEnd);
  }

})();
</script>


