
{% paginate collection.products by 24 %}

<section class="main-collection-basic">
  <div class="collection-header">
    <h1>{{ collection.title | escape }}</h1>

    {% if collection.description != blank %}
      <div class="collection-description">
        {{ collection.description }}
      </div>
    {% endif %}
  </div>

  {% if collection.products.size > 0 %}
    <div class="collection-grid">
      {% for product in collection.products %}
        <article class="collection-card">
          <a href="{{ product.url }}">
            {% if product.featured_image %}
              {{
                product.featured_image
                | image_url: width: 900
                | image_tag:
                  loading: 'lazy',
                  alt: product.title
              }}
            {% endif %}

            <h2>{{ product.title | escape }}</h2>
          </a>

          <p>{{ product.price | money }}</p>
        </article>
      {% endfor %}
    </div>
  {% else %}
    <p>Aucun produit dans cette collection pour le moment.</p>
  {% endif %}

  {% if paginate.pages > 1 %}
    <nav class="collection-pagination">
      {% if paginate.previous %}
        <a href="{{ paginate.previous.url }}">Précédent</a>
      {% endif %}

      <span>Page {{ paginate.current_page }} / {{ paginate.pages }}</span>

      {% if paginate.next %}
        <a href="{{ paginate.next.url }}">Suivant</a>
      {% endif %}
    </nav>
  {% endif %}
</section>

{% endpaginate %}

<style>
  .main-collection-basic {
    max-width: 1440px;
    margin: 0 auto;
    padding: 50px 5%;
  }

  .collection-header {
    margin-bottom: 40px;
  }

  .collection-header h1 {
    font-size: 32px;
    margin-bottom: 20px;
  }

  .collection-description {
    max-width: 850px;
    line-height: 1.7;
  }

  .collection-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 25px 18px;
  }

  .collection-card a {
    color: inherit;
    text-decoration: none;
  }

  .collection-card img {
    display: block;
    width: 100%;
    height: auto;
  }

  .collection-card h2 {
    font-size: 15px;
    margin: 12px 0 6px;
  }

  .collection-card p {
    margin: 0;
  }

  .collection-pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
    margin-top: 45px;
  }

  @media screen and (max-width: 749px) {
    .main-collection-basic {
      padding: 30px 16px;
    }

    .collection-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 25px 12px;
    }

    .collection-header h1 {
      font-size: 25px;
    }
  }
</style>

{% schema %}
{
  "name": "Collection produits",
  "settings": [],
  "presets": [
    {
      "name": "Collection produits"
    }
  ]
}
{% endschema %}
