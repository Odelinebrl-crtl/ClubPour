
<div class="pour-password">

  {% if section.settings.background_image != blank %}
    <div
      class="pour-password__background"
      style="--pour-password-image: url('{{ section.settings.background_image | image_url: width: 2400 }}');"
    ></div>
  {% else %}
    <div class="pour-password__background"></div>
  {% endif %}

  <div class="pour-password__overlay"></div>


  <main class="pour-password__content">

    <div class="pour-password__brand">

      {% if section.settings.logo_image != blank %}

        <img
          src="{{ section.settings.logo_image | image_url: width: 800 }}"
          alt="{{ shop.name }}"
          loading="eager"
          width="{{ section.settings.logo_image.width }}"
          height="{{ section.settings.logo_image.height }}"
        >

      {% else %}

        <span>POUR</span>

      {% endif %}

    </div>


    <div class="pour-password__eyebrow">
      {{ 'password_page.eyebrow' | t }}
    </div>


    <h1 class="pour-password__title">
      {{ 'password_page.title' | t }}
    </h1>


    <p class="pour-password__text">
      {{ 'password_page.text' | t }}
    </p>


    {% form 'customer',
      id: 'PourPasswordNewsletter',
      class: 'pour-password__form'
    %}

      {% if form.posted_successfully? %}

        <div class="pour-password__success">
          {{ 'password_page.success' | t }}
        </div>

      {% else %}

        <div class="pour-password__field">

          <input
            type="email"
            name="contact[email]"
            id="PourPasswordEmail"
            autocomplete="email"
            placeholder="{{ 'password_page.email_placeholder' | t }}"
            required
          >

        </div>


        <input
          type="hidden"
          name="contact[tags]"
          value="prelaunch"
        >


        <label class="pour-password__consent">

          <input
            type="checkbox"
            name="contact[accepts_marketing]"
            value="true"
            required
          >

          <span>
            {{ 'password_page.consent' | t }}
          </span>

        </label>


        <button
          type="submit"
          class="pour-password__submit"
        >
          {{ 'password_page.submit' | t }}
          <span aria-hidden="true">→</span>
        </button>

      {% endif %}

    {% endform %}

  </main>


  <!-- ACCÈS PRIVÉ -->

  <div class="pour-password__private">

    <button
      type="button"
      class="pour-password__private-trigger"
      aria-expanded="false"
      aria-controls="PourPasswordPrivateAccess"
    >
      {{ 'password_page.private_access' | t }}
    </button>


    <div
      id="PourPasswordPrivateAccess"
      class="pour-password__private-panel"
      hidden
    >

      {% form 'storefront_password', class: 'pour-password__password-form' %}

        {% if form.errors %}

          <p class="pour-password__password-error">
            {{ form.errors | default_errors }}
          </p>

        {% endif %}


        <input
          type="password"
          name="password"
          placeholder="{{ 'password_page.password_placeholder' | t }}"
          autocomplete="current-password"
          required
        >


        <button type="submit">
          {{ 'password_page.password_submit' | t }}
          <span aria-hidden="true">→</span>
        </button>

      {% endform %}

    </div>

  </div>


  <!-- LANGUE -->

  <div class="pour-password__language">

    {% form 'localization', id: 'PourPasswordLanguageForm' %}

      <label for="PourPasswordLanguage">
        {{ 'password_page.language' | t }}
      </label>


      <select
        id="PourPasswordLanguage"
        name="language_code"
        onchange="this.form.submit()"
      >

        {% for language in localization.available_languages %}

          <option
            value="{{ language.iso_code }}"
            {% if language.iso_code == localization.language.iso_code %}
              selected
            {% endif %}
          >
            {{ language.endonym_name }}
          </option>

        {% endfor %}

      </select>

    {% endform %}

  </div>

</div>


<style>

  html,
  body {
    margin: 0 !important;
    padding: 0 !important;
    width: 100%;
    min-height: 100%;
  }


  html {
    background: #111;
  }


  body {
    overflow-x: hidden;
  }


  .pour-password {
    position: relative;
    width: 100%;
    min-height: 100svh;
    overflow: hidden;
    background: #111;
    color: #FAF9F6;

    display: flex;
    align-items: center;
    justify-content: center;

    font-family:
      Helvetica Neue,
      Helvetica,
      Arial,
      sans-serif;
  }


  /* =========================
     IMAGE DE FOND
  ========================= */

  .pour-password__background {
    position: absolute;
    inset: -30px;

    background-image: var(--pour-password-image);
    background-size: cover;
    background-position: center;

    filter: blur(10px);
    transform: scale(1.06);

    z-index: 0;
  }


  /* =========================
     VOILE
  ========================= */

  .pour-password__overlay {
    position: absolute;
    inset: 0;

    background:
      linear-gradient(
        180deg,
        rgba(0, 0, 0, 0.35) 0%,
        rgba(0, 0, 0, 0.48) 45%,
        rgba(0, 0, 0, 0.68) 100%
      );

    z-index: 1;
  }


  /* =========================
     CONTENU CENTRAL
  ========================= */

  .pour-password__content {
    position: relative;
    z-index: 2;

    width: min(720px, calc(100% - 40px));

    text-align: center;

    display: flex;
    flex-direction: column;
    align-items: center;

    padding: 80px 0 120px;
  }


  /* =========================
     LOGO
  ========================= */

  .pour-password__brand {
    display: flex;
    justify-content: center;
    align-items: center;

    margin-bottom: 42px;
  }


  .pour-password__brand img {
    display: block;

    width: 80px;
    height: auto;

    max-width: 60vw;
    object-fit: contain;
  }


  .pour-password__brand span {
    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size: 76px;
    line-height: 0.8;

    letter-spacing: -0.08em;
  }


  /* =========================
     PETIT TITRE
  ========================= */

  .pour-password__eyebrow {
    font-size: 10px;
    letter-spacing: 0.24em;

    text-transform: uppercase;

    margin-bottom: 22px;

    opacity: 0.72;
  }


  /* =========================
     GRAND TITRE
  ========================= */

  .pour-password__title {
    margin: 0;

    font-size: clamp(48px, 8vw, 96px);

    line-height: 0.9;

    letter-spacing: -0.055em;

    font-weight: 400;

    text-transform: uppercase;
  }


  /* =========================
     DESCRIPTION
  ========================= */

  .pour-password__text {
    max-width: 520px;

    margin: 30px auto 42px;

    font-size: 15px;

    line-height: 1.55;

    font-weight: 400;

    opacity: 0.86;
  }


  /* =========================
     FORMULAIRE
  ========================= */

  .pour-password__form {
    width: min(580px, 100%);
  }


  .pour-password__field input {
    width: 100%;

    height: 58px;

    padding: 0 20px;

    box-sizing: border-box;

    border:
      1px solid
      rgba(250, 249, 246, 0.45);

    background:
      rgba(250, 249, 246, 0.10);

    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);

    color: #FAF9F6;

    outline: none;

    font-family: inherit;

    font-size: 11px;

    letter-spacing: 0.12em;

    text-transform: uppercase;
  }


  .pour-password__field input::placeholder {
    color:
      rgba(250, 249, 246, 0.78);
  }


  .pour-password__field input:focus {
    border-color:
      rgba(250, 249, 246, 0.85);
  }


  /* =========================
     CONSENTEMENT
  ========================= */

  .pour-password__consent {
    display: flex;

    align-items: flex-start;

    gap: 10px;

    margin: 16px 0 20px;

    text-align: left;

    font-size: 10px;

    line-height: 1.45;

    opacity: 0.72;

    cursor: pointer;
  }


  .pour-password__consent input {
    margin-top: 2px;

    flex: 0 0 auto;

    accent-color: #FAF9F6;
  }


  /* =========================
     BOUTON
  ========================= */

  .pour-password__submit {
    width: 100%;

    height: 58px;

    border:
      1px solid
      #FAF9F6;

    background: #FAF9F6;

    color: #111;

    cursor: pointer;

    font-family: inherit;

    font-size: 10px;

    font-weight: 500;

    letter-spacing: 0.16em;

    text-transform: uppercase;

    display: flex;

    align-items: center;

    justify-content: center;

    gap: 16px;

    transition:
      opacity 0.2s ease;
  }


  .pour-password__submit:hover {
    opacity: 0.88;
  }


  .pour-password__submit span {
    font-size: 15px;
  }


  /* =========================
     CONFIRMATION
  ========================= */

  .pour-password__success {
    border:
      1px solid
      rgba(250, 249, 246, 0.35);

    background:
      rgba(250, 249, 246, 0.10);

    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);

    padding: 22px;

    font-size: 11px;

    line-height: 1.5;

    letter-spacing: 0.08em;

    text-transform: uppercase;
  }


  /* =========================
     ACCÈS PRIVÉ
  ========================= */

  .pour-password__private {
    position: absolute;

    left: 28px;
    bottom: 28px;

    z-index: 3;
  }


  .pour-password__private-trigger {
    border: 0;

    background: transparent;

    color: #FAF9F6;

    padding: 0;

    cursor: pointer;

    font-family: inherit;

    font-size: 9px;

    letter-spacing: 0.14em;

    text-transform: uppercase;

    opacity: 0.5;
  }


  .pour-password__private-trigger:hover {
    opacity: 0.9;
  }


  .pour-password__private-panel {
    margin-top: 12px;

    width: 260px;

    padding: 14px;

    box-sizing: border-box;

    background:
      rgba(0, 0, 0, 0.65);

    border:
      1px solid
      rgba(250, 249, 246, 0.2);

    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
  }


  .pour-password__password-form {
    display: flex;

    gap: 8px;
  }


  .pour-password__password-form input {
    min-width: 0;

    flex: 1;

    height: 38px;

    box-sizing: border-box;

    border:
      1px solid
      rgba(250, 249, 246, 0.3);

    background: transparent;

    color: #FAF9F6;

    padding: 0 10px;

    font-family: inherit;

    font-size: 10px;

    outline: none;
  }


  .pour-password__password-form button {
    height: 38px;

    border: 0;

    background: #FAF9F6;

    color: #111;

    padding: 0 12px;

    cursor: pointer;

    font-family: inherit;

    font-size: 9px;

    letter-spacing: 0.08em;

    text-transform: uppercase;
  }


  .pour-password__password-error {
    margin: 0 0 10px;

    font-size: 9px;

    line-height: 1.4;

    color: #FAF9F6;
  }


  /* =========================
     LANGUE
  ========================= */

  .pour-password__language {
    position: absolute;

    right: 28px;
    bottom: 28px;

    z-index: 3;
  }


  .pour-password__language form {
    display: flex;

    align-items: center;

    gap: 8px;
  }


  .pour-password__language label {
    font-size: 9px;

    letter-spacing: 0.12em;

    text-transform: uppercase;

    opacity: 0.5;
  }


  .pour-password__language select {
    appearance: none;
    -webkit-appearance: none;

    border: 0;

    background: transparent;

    color: #FAF9F6;

    font-family: inherit;

    font-size: 9px;

    letter-spacing: 0.1em;

    text-transform: uppercase;

    cursor: pointer;

    outline: none;
  }


  .pour-password__language select option {
    color: #111;

    background: #FAF9F6;
  }


  /* =========================
     MOBILE
  ========================= */
@media screen and (max-width: 768px) {

  .pour-password {
    min-height: 100svh;
    min-height: 100dvh;
  }


  @media screen and (max-width: 768px) {

  /* =========================
     PAGE MOBILE
  ========================= */

