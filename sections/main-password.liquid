    font-size: 8px !important;
    line-height: 1.4 !important;

    letter-spacing: 0.18em !important;

    margin-bottom: 16px !important;
  }


  /* =========================
     GRAND TITRE
  ========================= */

  .pour-password__title {
    width: 100% !important;
    max-width: 100% !important;

    margin: 0 !important;

    font-size: clamp(40px, 12vw, 58px) !important;

    line-height: 0.92 !important;

    letter-spacing: -0.055em !important;

    word-break: normal !important;
    overflow-wrap: normal !important;
  }


  /* =========================
     TEXTE
  ========================= */

  .pour-password__text {
    width: 100% !important;
    max-width: 330px !important;

    margin:
      22px
      auto
      30px !important;

    font-size: 14px !important;
    line-height: 1.5 !important;
  }


  /* =========================
     FORMULAIRE
  ========================= */

  .pour-password__form {
    display: block !important;

    width: 100% !important;
    max-width: none !important;

    margin: 0 !important;
  }


  /* =========================
     CHAMP EMAIL
  ========================= */

  .pour-password__field {
    display: block !important;

    width: 100% !important;

    margin: 0 !important;
  }

  .pour-password__field input {
    display: block !important;

    width: 100% !important;
    min-width: 100% !important;
    max-width: none !important;

    height: 62px !important;

    margin: 0 !important;
    padding: 0 18px !important;

    box-sizing: border-box !important;

    font-size: 12px !important;
    line-height: 1 !important;

    letter-spacing: 0.08em !important;
  }

  .pour-password__field input::placeholder {
    font-size: 12px !important;
  }


  /* =========================
     CHECKBOX
  ========================= */

  .pour-password__consent {
    display: flex !important;

    width: 100% !important;

    margin:
      14px
      0
      18px !important;

    padding: 0 !important;

    gap: 9px !important;

    align-items: flex-start !important;

    font-size: 10px !important;
    line-height: 1.5 !important;
  }

  .pour-password__consent input {
    flex: 0 0 15px !important;

    width: 15px !important;
    min-width: 15px !important;
    max-width: 15px !important;

    height: 15px !important;

    margin:
      1px
      0
      0 !important;
  }


  /* =========================
     BOUTON
  ========================= */

  .pour-password__submit {
    display: flex !important;

    width: 100% !important;
    min-width: 100% !important;
    max-width: none !important;

    height: 62px !important;

    margin: 0 !important;
    padding: 0 16px !important;

    box-sizing: border-box !important;

    font-size: 10px !important;

    letter-spacing: 0.11em !important;

    white-space: nowrap !important;
  }


  /* =========================
     MESSAGE SUCCÈS
  ========================= */

  .pour-password__success {
    width: 100% !important;

    box-sizing: border-box !important;

    padding: 20px !important;

    font-size: 10px !important;
    line-height: 1.5 !important;
  }


  /* =========================
     BARRE BASSE
     ACCÈS PRIVÉ + LANGUE
  ========================= */

  .pour-password__private,
  .pour-password__language {
    position: fixed !important;

    bottom: 20px !important;

    top: auto !important;

    height: 20px !important;

    margin: 0 !important;
    padding: 0 !important;

    display: flex !important;

    align-items: center !important;

    z-index: 20 !important;
  }


  .pour-password__private {
    left: 18px !important;
  }


  .pour-password__language {
    right: 18px !important;
  }


  .pour-password__private-trigger {
    display: flex !important;

    align-items: center !important;

    height: 20px !important;

    margin: 0 !important;
    padding: 0 !important;

    font-size: 8px !important;
    line-height: 20px !important;

    letter-spacing: 0.10em !important;
  }


  .pour-password__language form {
    display: flex !important;

    align-items: center !important;

    height: 20px !important;

    margin: 0 !important;
    padding: 0 !important;

    gap: 6px !important;
  }


  .pour-password__language label {
