<script>
  document.addEventListener('DOMContentLoaded', function () {
    const countdown = document.querySelector('.pour-password__countdown');

    if (!countdown) return;

    const endValue = countdown.getAttribute('data-countdown-end');

    if (!endValue) return;

    const endDate = new Date(endValue).getTime();

    if (Number.isNaN(endDate)) return;

    const daysElement = countdown.querySelector('[data-countdown-days]');
    const hoursElement = countdown.querySelector('[data-countdown-hours]');
    const minutesElement = countdown.querySelector('[data-countdown-minutes]');
    const secondsElement = countdown.querySelector('[data-countdown-seconds]');

    function updateCountdown() {
      const now = Date.now();
      const difference = endDate - now;

      if (difference <= 0) {
        daysElement.textContent = '00';
        hoursElement.textContent = '00';
        minutesElement.textContent = '00';
        secondsElement.textContent = '00';
        return;
      }

      const totalSeconds = Math.floor(difference / 1000);

      const days = Math.floor(totalSeconds / 86400);
      const hours = Math.floor((totalSeconds % 86400) / 3600);
      const minutes = Math.floor((totalSeconds % 3600) / 60);
      const seconds = totalSeconds % 60;

      daysElement.textContent = String(days).padStart(2, '0');
      hoursElement.textContent = String(hours).padStart(2, '0');
      minutesElement.textContent = String(minutes).padStart(2, '0');
      secondsElement.textContent = String(seconds).padStart(2, '0');
    }

    updateCountdown();

    setInterval(updateCountdown, 1000);
  });
</script>
<script>

  document.addEventListener(
    'DOMContentLoaded',
    function () {

      const trigger =
        document.querySelector(
          '.pour-password__private-trigger'
        );

      const panel =
        document.querySelector(
          '#PourPasswordPrivateAccess'
        );


      if (!trigger || !panel) return;


      trigger.addEventListener(
        'click',
        function () {

          const isOpen =
            trigger.getAttribute(
              'aria-expanded'
            ) === 'true';


          trigger.setAttribute(
            'aria-expanded',
            String(!isOpen)
          );


          panel.hidden = isOpen;

        }
      );

    }
  );

</script>


