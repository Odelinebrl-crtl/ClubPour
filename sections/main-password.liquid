  }


  .pour-password__password-form {
    display: flex !important;

    width: 100% !important;

    gap: 8px !important;
  }


  .pour-password__password-form input {
    width: auto !important;
    min-width: 0 !important;

    flex: 1 1 auto !important;

    height: 40px !important;

    font-size: 11px !important;
  }


  .pour-password__password-form button {
    flex: 0 0 auto !important;

    height: 40px !important;

    font-size: 8px !important;

    padding:
      0
      10px !important;
  }

}
</style>


<script>

  document.addEventListener(
    'DOMContentLoaded',
    function () {

      const trigger =
        document.querySelector(
          '.pour-password__private-trigger'
        );

      const panel =
        document.querySelector(
          '#PourPasswordPrivateAccess'
        );


      if (!trigger || !panel) return;


      trigger.addEventListener(
        'click',
        function () {

          const isOpen =
            trigger.getAttribute(
              'aria-expanded'
            ) === 'true';


          trigger.setAttribute(
            'aria-expanded',
            String(!isOpen)
          );


          panel.hidden = isOpen;

        }
      );

    }
  );

</script>


