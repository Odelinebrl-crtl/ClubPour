
<div class="pour-password">

  {% if section.settings.background_image != blank %}
    <div
      class="pour-password__background"
      style="--pour-password-image: url('{{ section.settings.background_image | image_url: width: 2400 }}');"
    ></div>
  {% else %}
    <div class="pour-password__background"></div>
  {% endif %}

  <div class="pour-password__overlay"></div>


  <main class="pour-password__content">

    <div class="pour-password__brand">

      {% if section.settings.logo_image != blank %}

        <img
          src="{{ section.settings.logo_image | image_url: width: 800 }}"
          alt="{{ shop.name }}"
          loading="eager"
          width="{{ section.settings.logo_image.width }}"
          height="{{ section.settings.logo_image.height }}"
        >

      {% else %}

        <span>POUR</span>

      {% endif %}

    </div>


    <h1 class="pour-password__title">
      {{ 'password_page.title' | t }}
    </h1>


    <p class="pour-password__text">
      {{ 'password_page.text' | t }}
    </p>
<!-- COMPTE À REBOURS -->
<div
  class="pour-password__countdown"
  data-countdown-end="{{ section.settings.countdown_end | escape }}"
  aria-label="Countdown"
>
  <div class="pour-password__countdown-unit">
    <span class="pour-password__countdown-number" data-countdown-days>00</span>
    <span class="pour-password__countdown-label">
      {{ 'password_page.countdown_days' | t }}
    </span>
  </div>

  <span class="pour-password__countdown-separator" aria-hidden="true">:</span>

  <div class="pour-password__countdown-unit">
    <span class="pour-password__countdown-number" data-countdown-hours>00</span>
    <span class="pour-password__countdown-label">
      {{ 'password_page.countdown_hours' | t }}
    </span>
  </div>

  <span class="pour-password__countdown-separator" aria-hidden="true">:</span>

  <div class="pour-password__countdown-unit">
    <span class="pour-password__countdown-number" data-countdown-minutes>00</span>
    <span class="pour-password__countdown-label">
      {{ 'password_page.countdown_minutes' | t }}
    </span>
  </div>

  <span class="pour-password__countdown-separator" aria-hidden="true">:</span>

  <div class="pour-password__countdown-unit">
    <span class="pour-password__countdown-number" data-countdown-seconds>00</span>
    <span class="pour-password__countdown-label">
      {{ 'password_page.countdown_seconds' | t }}
    </span>
  </div>
</div>

    {% form 'customer',
      id: 'PourPasswordNewsletter',
      class: 'pour-password__form'
    %}

      {% if form.posted_successfully? %}

        <div class="pour-password__success">
          {{ 'password_page.success' | t }}
        </div>

      {% else %}

        <div class="pour-password__field">

          <input
            type="email"
            name="contact[email]"
            id="PourPasswordEmail"
            autocomplete="email"
            placeholder="{{ 'password_page.email_placeholder' | t }}"
            required
          >

        </div>


        <input
  type="hidden"
  name="contact[tags]"
  value="prelaunch,prelaunch-{{ localization.language.iso_code }}"
>


        <label class="pour-password__consent">

          <input
            type="checkbox"
            name="contact[accepts_marketing]"
            value="true"
            required
          >

          <span>
            {{ 'password_page.consent' | t }}
          </span>

        </label>


        <button
          type="submit"
          class="pour-password__submit"
        >
          {{ 'password_page.submit' | t }}
          <span aria-hidden="true">→</span>
        </button>

      {% endif %}

    {% endform %}

  </main>


  <!-- ACCÈS PRIVÉ -->

  <div class="pour-password__private">

    <button
      type="button"
      class="pour-password__private-trigger"
      aria-expanded="false"
      aria-controls="PourPasswordPrivateAccess"
    >
      {{ 'password_page.private_access' | t }}
    </button>


    <div
      id="PourPasswordPrivateAccess"
      class="pour-password__private-panel"
      hidden
    >

      {% form 'storefront_password', class: 'pour-password__password-form' %}

        {% if form.errors %}

          <p class="pour-password__password-error">
            {{ form.errors | default_errors }}
          </p>

        {% endif %}


        <input
          type="password"
          name="password"
          placeholder="{{ 'password_page.password_placeholder' | t }}"
          autocomplete="current-password"
          required
        >


        <button type="submit">
          {{ 'password_page.password_submit' | t }}
          <span aria-hidden="true">→</span>
        </button>

      {% endform %}

    </div>

  </div>


  <!-- LANGUE -->

  <div class="pour-password__language">

    {% form 'localization', id: 'PourPasswordLanguageForm' %}

      <label for="PourPasswordLanguage">
        {{ 'password_page.language' | t }}
      </label>


      <select
        id="PourPasswordLanguage"
        name="language_code"
        onchange="this.form.submit()"
      >

        {% for language in localization.available_languages %}

          <option
            value="{{ language.iso_code }}"
            {% if language.iso_code == localization.language.iso_code %}
              selected
            {% endif %}
          >
            {{ language.endonym_name }}
          </option>

        {% endfor %}

      </select>

    {% endform %}

  </div>

</div>


