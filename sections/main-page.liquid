<section class="main-page">
  <div class="main-page__inner">

    {% unless page.handle == 'journal-pour' %}
  {% unless page.title contains 'Journal' %}
  {% if page.title != blank %}
    <h1>{{ page.title }}</h1>
  {% endif %}
{% endunless %}
{% endunless %}

    {% if page.content != blank %}
      <div class="main-page__content">
        {{ page.content }}
      </div>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "Page",
  "settings": []
}
{% endschema %}
