<section class="main-page">
  <div class="main-page__inner">

    {% if page.title != blank %}
      <h1>{{ page.title }}</h1>
    {% endif %}

    {% if page.content != blank %}
      <div class="main-page__content">
        {{ page.content }}
      </div>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "Page",
  "settings": []
}
{% endschema %}
