<style>
  .faq-pour {
    --faq-black: #111111;
    --faq-grey: #666666;
    --faq-line: #e5e5e5;
    --faq-white: #ffffff;
    background: var(--faq-white);
    color: var(--faq-black);
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
  }

  .faq-pour__intro {
    width: min(100% - 48px, 1180px);
    margin: 0 auto;
    padding: 90px 0 70px;
    border-bottom: 1px solid var(--faq-black);
  }

  .faq-pour__eyebrow {
    margin: 0 0 22px;
    font-size: 10px;
    font-weight: 400;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .faq-pour__title {
    margin: 0;
    font-size: clamp(42px, 7vw, 92px);
    font-weight: 400;
    line-height: .95;
    letter-spacing: -.045em;
  }

  .faq-pour__lead {
    max-width: 600px;
    margin: 28px 0 0;
    color: var(--faq-grey);
    font-size: 13px;
    font-weight: 400;
    line-height: 1.7;
  }

  .faq-pour__layout {
    width: min(100% - 48px, 1180px);
    margin: 0 auto;
    padding: 55px 0 120px;
    display: grid;
    grid-template-columns: 190px minmax(0, 760px);
    gap: 80px;
    align-items: start;
  }

  .faq-pour__categories {
    position: sticky;
    top: 30px;
  }

  .faq-pour__categories-title {
    margin: 0 0 18px;
    font-size: 9px;
    font-weight: 400;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .faq-pour__category-link {
    display: block;
    padding: 7px 0;
    color: var(--faq-black);
    font-size: 10px;
    line-height: 1.35;
    text-decoration: none;
    transition: opacity .2s ease;
  }

  .faq-pour__category-link:hover {
    opacity: .45;
  }

  .faq-pour__category {
    scroll-margin-top: 35px;
  }

  .faq-pour__category + .faq-pour__category {
    margin-top: 70px;
  }

  .faq-pour__category-title {
    margin: 0 0 18px;
    font-size: 10px;
    font-weight: 400;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .faq-pour__item {
    margin: 0;
    border-top: 1px solid var(--faq-line);
  }

  .faq-pour__item:last-child {
    border-bottom: 1px solid var(--faq-line);
  }

  .faq-pour__question {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    width: 100%;
    padding: 22px 0;
    color: var(--faq-black);
    font-size: 12px;
    font-weight: 400;
    line-height: 1.45;
    cursor: pointer;
    list-style: none;
  }

  .faq-pour__question::-webkit-details-marker {
    display: none;
  }

  .faq-pour__question::after,
  .faq-pour__question::before {
    content: "";
    flex: 0 0 auto;
    width: 13px;
    height: 1px;
    background: var(--faq-black);
    transition: transform .25s ease;
  }

  .faq-pour__question::before {
    position: absolute;
    right: 0;
  }

  .faq-pour__question::after {
    transform: rotate(90deg);
  }

  .faq-pour__item[open] .faq-pour__question::after {
    transform: rotate(0deg);
  }

  .faq-pour__answer {
    max-width: 650px;
    padding: 0 45px 25px 0;
    color: var(--faq-grey);
    font-size: 11px;
    font-weight: 400;
    line-height: 1.7;
  }

  .faq-pour__answer p {
    margin: 0;
  }

  .faq-pour__answer p + p {
    margin-top: 10px;
  }

  .faq-pour__answer a {
    color: var(--faq-black);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .faq-pour__contact {
    margin-top: 90px;
    padding-top: 28px;
    border-top: 1px solid var(--faq-black);
  }

  .faq-pour__contact-label {
    margin: 0 0 12px;
    font-size: 9px;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .faq-pour__contact-text {
    max-width: 600px;
    margin: 0;
    color: var(--faq-grey);
    font-size: 11px;
    line-height: 1.7;
  }

  .faq-pour__contact-link {
    display: inline-block;
    margin-top: 18px;
    color: var(--faq-black);
    font-size: 10px;
    letter-spacing: .08em;
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: 1px solid var(--faq-black);
    padding-bottom: 4px;
  }

  @media screen and (max-width: 768px) {
    .faq-pour__intro {
      width: min(100% - 40px, 1180px);
     padding: 85px 0 45px;
    }

    .faq-pour__title {
      font-size: clamp(42px, 15vw, 68px);
    }

    .faq-pour__lead {
      margin-top: 22px;
      font-size: 11px;
    }

    .faq-pour__layout {
      width: min(100% - 40px, 1180px);
      padding: 35px 0 80px;
      display: block;
    }

    .faq-pour__categories {
      position: static;
      display: flex;
      gap: 14px;
      overflow-x: auto;
      margin-bottom: 55px;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--faq-line);
      scrollbar-width: none;
    }

    .faq-pour__categories::-webkit-scrollbar {
      display: none;
    }

    .faq-pour__categories-title {
      display: none;
    }

    .faq-pour__category-link {
      flex: 0 0 auto;
      padding: 0;
      font-size: 9px;
      white-space: nowrap;
    }

    .faq-pour__category + .faq-pour__category {
      margin-top: 55px;
    }

    .faq-pour__category-title {
      margin-bottom: 14px;
      font-size: 9px;
    }

    .faq-pour__question {
      padding: 18px 0;
      font-size: 11px;
    }

    .faq-pour__answer {
      padding: 0 35px 22px 0;
      font-size: 10px;
      line-height: 1.65;
    }

    .faq-pour__contact {
      margin-top: 65px;
    }
  }
</style>

