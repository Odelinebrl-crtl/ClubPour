{% if customer and customer.metafields.custom.club_privilege_access.value == true %}

<section
  id="ClubPrivilegeGrid-{{ section.id }}"
  class="club-privilege-grid"
>

  <div class="club-privilege-grid__inner">

    <!-- =========================
         TITRES
    ========================== -->

    <div class="club-privilege-grid__header">

     <p class="club-privilege-grid__eyebrow">
  {{ 'pour_club.collection.eyebrow' | t }}
</p>

<h2 class="club-privilege-grid__heading">
  {{ 'pour_club.collection.title' | t }}
</h2>

<p class="club-privilege-grid__intro">
  {{ 'pour_club.collection.intro' | t }}
</p>

    </div>


    <!-- =========================
         PRODUITS
    ========================== -->

        <!-- =========================
         IMAGE CLUB PRIVILÈGE
    ========================== -->

    {% if section.settings.club_image != blank %}
      <div class="club-privilege-grid__hero">
        {{
          section.settings.club_image
          | image_url: width: 2400
          | image_tag:
            class: 'club-privilege-grid__hero-image',
            loading: 'lazy',
            alt: section.settings.heading
        }}
      </div>
    {% endif %}

    <div class="club-privilege-grid__products">

      {% for block in section.blocks %}

        {% assign featured_product = block.settings.product %}

        {% if featured_product != blank %}

          <article
            class="club-privilege-card"
            {{ block.shopify_attributes }}
          >

            <!-- =========================
                 IMAGE
            ========================== -->

            <div class="club-privilege-card__media">

              <a
                href="{{ featured_product.url }}"
                class="club-privilege-card__media-link"
                aria-label="{{ featured_product.title }}"
              >

                <!-- IMAGE PRINCIPALE -->

                {% if block.settings.image_primary != blank %}

                  {{
                    block.settings.image_primary
                    | image_url: width: 1400
                    | image_tag:
                      class: 'club-privilege-card__image club-privilege-card__image--primary',
                      loading: 'lazy',
                      alt: featured_product.title
                  }}

                {% elsif featured_product.featured_image != blank %}

                  {{
                    featured_product.featured_image
                    | image_url: width: 1400
                    | image_tag:
                      class: 'club-privilege-card__image club-privilege-card__image--primary',
                      loading: 'lazy',
                      alt: featured_product.title
                  }}

                {% endif %}


                <!-- IMAGE AU SURVOL -->

                {% if block.settings.image_hover != blank %}

                  {{
                    block.settings.image_hover
                    | image_url: width: 1400
                    | image_tag:
                      class: 'club-privilege-card__image club-privilege-card__image--hover',
                      loading: 'lazy',
                      alt: featured_product.title
                  }}

                {% elsif featured_product.images.size > 1 %}

                  {{
                    featured_product.images[1]
                    | image_url: width: 1400
                    | image_tag:
                      class: 'club-privilege-card__image club-privilege-card__image--hover',
                      loading: 'lazy',
                      alt: featured_product.title
                  }}

                {% endif %}

              </a>


              <!-- =========================
                   QUICK ADD +
              ========================== -->

              <button
                type="button"
                class="club-privilege-card__quick-add"
                data-club-privilege-quick-add
                data-product-handle="{{ featured_product.handle }}"
                aria-label="{{ 'pour_products.quick_add_aria' | t }} {{ featured_product.title }}"
              ></button>

            </div>


            <!-- =========================
                 INFOS
            ========================== -->

            <a
              href="{{ featured_product.url }}"
              class="club-privilege-card__info-link"
            >

              <div class="club-privilege-card__info">

                <div class="club-privilege-card__info-row">

                  <h3 class="club-privilege-card__title">
                    {{ featured_product.title }}
                  </h3>

                  <div class="club-privilege-card__price">
                    {{ featured_product.price | money }}
                  </div>

                </div>


                <!-- NOM DE LA COULEUR -->

                {% if featured_product.metafields.custom.color_name.value != blank %}

                  <div class="club-privilege-card__color-name">
                    {{ featured_product.metafields.custom.color_name.value }}
                  </div>

                {% endif %}


                <!-- =========================
                     PASTILLES DE COULEURS
                ========================== -->

                <div
                  class="club-privilege-card__color-swatches"
                  style="
                    display: flex !important;
                    align-items: center !important;
                    gap: 5px !important;
                    margin-top: 8px !important;
                    width: 100% !important;
                    min-height: 11px !important;
                  "
                >

                  {% assign current_color = featured_product.metafields.custom.couleur.value %}

                  {% if current_color != blank %}

                    <span
                      class="club-privilege-card__color-swatch"
                      style="
                        display: block !important;
                        width: 11px !important;
                        min-width: 11px !important;
                        height: 11px !important;
                        min-height: 11px !important;
                        flex: 0 0 11px !important;
                        border-radius: 50% !important;
                        border: 1px solid #d5d5d5 !important;
                        background-color: {{ current_color }} !important;
                        opacity: 1 !important;
                        visibility: visible !important;
                      "
                      aria-label="{{ featured_product.metafields.custom.color_name.value }}"
                    ></span>

                  {% endif %}


                  {% assign color_products = featured_product.metafields.custom.couleurs.value %}

                  {% if color_products != blank %}

                    {% for color_product in color_products %}

                      {% assign color_value = color_product.metafields.custom.couleur.value %}

                      {% if color_value != blank %}

                        <a
                          href="{{ color_product.url }}"
                          class="club-privilege-card__color-swatch"
                          style="
                            display: block !important;
                            width: 11px !important;
                            min-width: 11px !important;
                            height: 11px !important;
                            min-height: 11px !important;
                            flex: 0 0 11px !important;
                            border-radius: 50% !important;
                            border: 1px solid #d5d5d5 !important;
                            background-color: {{ color_value }} !important;
                            opacity: 1 !important;
                            visibility: visible !important;
                          "
                          aria-label="{{ color_product.metafields.custom.color_name.value }}"
                        ></a>

                      {% endif %}

                    {% endfor %}

                  {% endif %}

                </div>

              </div>

            </a>

          </article>

        {% endif %}

      {% endfor %}

    </div>

  </div>


  <!-- =====================================================
       QUICK VIEW OVERLAY
  ====================================================== -->

  <div
    class="club-privilege-qv__overlay"
    data-club-privilege-qv-overlay
  ></div>


  <!-- =====================================================
       QUICK VIEW MODAL
  ====================================================== -->

  <div
    class="club-privilege-qv"
    data-club-privilege-qv
    aria-hidden="true"
  >

    <button
      type="button"
      class="club-privilege-qv__close"
      data-club-privilege-qv-close
      aria-label="{{ 'pour_products.close' | t }}"
    ></button>

    <div
      class="club-privilege-qv__inner"
      data-club-privilege-qv-content
    ></div>

  </div>

</section>


<style>

/* =========================================================
   CLUB PRIVILÈGE — STRUCTURE GÉNÉRALE
========================================================= */

#ClubPrivilegeGrid-{{ section.id }} {
  width: 100%;
  margin: 0;
  padding: 0;
}

#ClubPrivilegeGrid-{{ section.id }}
.club-privilege-grid__inner {
  width: 100%;
  margin: 0 auto;
}


/* =========================================================
   HEADER
   Même logique visuelle que la grille de référence
========================================================= */

#ClubPrivilegeGrid-{{ section.id }}
.club-privilege-grid__header {
  width: 100%;
  padding: 140px 54px 65px;
  box-sizing: border-box;
  text-align: center;
}

#ClubPrivilegeGrid-{{ section.id }}
.club-privilege-grid__eyebrow {
  margin: 0 0 8px;

  font-size: 9px;
  line-height: 1.2;

  font-weight: 400;

  letter-spacing: .20em;

  text-transform: uppercase;

  color: rgba(17,17,17,.38);
}

#ClubPrivilegeGrid-{{ section.id }}
.club-privilege-grid__heading {
  margin: 0;

  font-size: 25px;
  line-height: 1;

  font-weight: 400;

  letter-spacing: -.02em;

  text-transform: uppercase;

  color: #111111;
}

#ClubPrivilegeGrid-{{ section.id }}
.club-privilege-grid__intro {
  margin: 14px 0 0;

  font-size: 11px;
  line-height: 1.5;

  font-weight: 400;

  letter-spacing: .02em;

  color: rgba(17,17,17,.55);
}
#ClubPrivilegeGrid-{{ section.id }}
.club-privilege-grid__hero {
  position: relative;
  width: 100%;
  height: 70vh;
  min-height: 500px;
  max-height: 850px;
  overflow: hidden;
  margin: 0 0 20px;
}

#ClubPrivilegeGrid-{{ section.id }}
.club-privilege-grid__hero-image {
  display: block;
  width: 100%;
  height: 140%;
  max-width: none;
  object-fit: cover;
  object-position: center;
  transform: translate3d(0, -20%, 0);
  will-change: transform;
}
@media screen and (max-width: 750px) {

  #ClubPrivilegeGrid-{{ section.id }}
  .club-privilege-grid__hero {
    height: 60svh;
    min-height: 420px;
    max-height: none;
    margin-bottom: 45px;
  }

}
/* =========================================================
   GRILLE PRODUITS
   4 PRODUITS PAR LIGNE
   Jusqu'à 20 produits = 5 lignes
========================================================= */

#ClubPrivilegeGrid-{{ section.id }}
.club-privilege-grid__products {
  display: grid;

  grid-template-columns: repeat(4, 1fr);

  column-gap: 45px;
  row-gap: 58px;

  width: 100%;

 padding: 0 50px 70px;
}


/* =========================================================
   CARTE PRODUIT
========================================================= */

#ClubPrivilegeGrid-{{ section.id }}
.club-privilege-card {
  position: relative;

  min-width: 0;

  margin: 0;
  padding: 0;
}


/* =========================================================
   IMAGE
========================================================= */

#ClubPrivilegeGrid-{{ section.id }}
.club-privilege-card__media {
  position: relative;

  width: 100%;

  overflow: hidden;

  background: #ffffff;
}

#ClubPrivilegeGrid-{{ section.id }}
.club-privilege-card__media-link {
  position: relative;

  display: block;

  width: 100%;

  overflow: hidden;

  background: #ffffff;
}


/* IMAGE PRINCIPALE */

#ClubPrivilegeGrid-{{ section.id }}
.club-privilege-card__image--primary {
  position: relative;
  z-index: 1;
  display: block;

  width: 102%;
  max-width: none;

  height: auto;

  margin-left: -5%;

  opacity: 1;

  transition: opacity .45s cubic-bezier(.22, 1, .36, 1);
}

/* IMAGE HOVER */

#ClubPrivilegeGrid-{{ section.id }}
.club-privilege-card__image--hover {
  position: absolute;

  top: 0;
  left: -5%;

  z-index: 2;

  display: block;

  width: 102%;
  max-width: none;

  height: auto;

  object-fit: contain;
  object-position: center;

  background: transparent;

  opacity: 0;

  pointer-events: none;

  transition: opacity .45s cubic-bezier(.22, 1, .36, 1);
}


/* HOVER DESKTOP */

@media (hover: hover) {

  #ClubPrivilegeGrid-{{ section.id }}
  .club-privilege-card__media:hover
  .club-privilege-card__image--primary {
   opacity: .15;
  }

  #ClubPrivilegeGrid-{{ section.id }}
  .club-privilege-card__media:hover
  .club-privilege-card__image--hover {
    opacity: 1;
  }

}


/* =========================================================
   QUICK ADD +
========================================================= */

#ClubPrivilegeGrid-{{ section.id }}
.club-privilege-card__quick-add {
  position: absolute;

  right: 8px;
  bottom: 8px;

  z-index: 30;

  width: 28px;
  height: 28px;

  min-width: 28px;
  min-height: 28px;

  padding: 0;
  margin: 0;

  border: 0;

  background: #ffffff;

  cursor: pointer;

  opacity: 0;
  visibility: hidden;

  transform: translateY(3px);

  transition:
    opacity .18s ease,
    visibility .18s ease,
    transform .25s cubic-bezier(.22,1,.36,1);

  appearance: none;
  -webkit-appearance: none;
}

#ClubPrivilegeGrid-{{ section.id }}
.club-privilege-card__quick-add::before {
  content: "";

  position: absolute;

  top: 50%;
  left: 50%;

  width: 10px;
  height: 1px;

  background: #111111;

  transform:
    translate(-50%, -50%);
}

#ClubPrivilegeGrid-{{ section.id }}
.club-privilege-card__quick-add::after {
  content: "";

  position: absolute;

  top: 50%;
  left: 50%;

  width: 1px;
  height: 10px;

  background: #111111;

  transform:
    translate(-50%, -50%);
}

#ClubPrivilegeGrid-{{ section.id }}
.club-privilege-card__media:hover
.club-privilege-card__quick-add {
  opacity: 1;
  visibility: visible;

  transform: translateY(0);
}


/* =========================================================
   INFORMATIONS PRODUIT
========================================================= */

#ClubPrivilegeGrid-{{ section.id }}
.club-privilege-card__info-link {
  display: block;
  width: 100%;
  margin: 0;
  padding: 0;
  color: inherit;
  text-decoration: none;
}

#ClubPrivilegeGrid-{{ section.id }}
.club-privilege-card__info {
  width: 100%;

  padding-top: 0px;

  transform: translateY(-10px);
}


/* TITRE + PRIX SUR LA MÊME LIGNE */

#ClubPrivilegeGrid-{{ section.id }}
.club-privilege-card__info-row {
  display: flex;

  align-items: baseline;
  justify-content: space-between;

  gap: 15px;

  width: 100%;
}

#ClubPrivilegeGrid-{{ section.id }}
.club-privilege-card__title {
  min-width: 0;

  margin: 0;

  font-size: 12px;
  line-height: 1.3;

  font-weight: 400;

  letter-spacing: 0;

  text-transform: uppercase;

  color: #111111;
}

#ClubPrivilegeGrid-{{ section.id }}
.club-privilege-card__price {
  flex-shrink: 0;

  font-size: 12px;
  line-height: 1.3;

  font-weight: 400;

  color: #666666;

  white-space: nowrap;
}


/* NOM COULEUR */

#ClubPrivilegeGrid-{{ section.id }}
.club-privilege-card__color-name {
  margin-top: 5px;

  font-size: 10px;
  line-height: 1.3;

  font-weight: 400;

  color: #777777;

  text-transform: uppercase;
}


/* =========================================================
   PASTILLES DE COULEURS
========================================================= */

#ClubPrivilegeGrid-{{ section.id }}
.club-privilege-card__color-swatches {
  display: flex !important;

  align-items: center !important;

  gap: 5px !important;

  width: 100% !important;

  min-height: 11px !important;

  margin-top: 8px !important;
}

#ClubPrivilegeGrid-{{ section.id }}
.club-privilege-card__color-swatch {
  display: block !important;

  width: 11px !important;
  min-width: 11px !important;

  height: 11px !important;
  min-height: 11px !important;

  flex: 0 0 11px !important;

  border-radius: 50% !important;

  border: 1px solid #d5d5d5 !important;

  opacity: 1 !important;

  visibility: visible !important;

  box-sizing: border-box !important;
}


/* =========================================================
   QUICK VIEW — OVERLAY
========================================================= */

#ClubPrivilegeGrid-{{ section.id }}
.club-privilege-qv__overlay {
  position: fixed;

  inset: 0;

  z-index: 100000;

  background: rgba(0,0,0,.38);

  opacity: 0;
  visibility: hidden;

  pointer-events: none;

  transition:
    opacity .3s ease,
    visibility .3s ease;
}

#ClubPrivilegeGrid-{{ section.id }}
.club-privilege-qv__overlay.is-active {
  opacity: 1;
  visibility: visible;

  pointer-events: auto;
}


/* =========================================================
   QUICK VIEW — MODALE
========================================================= */

#ClubPrivilegeGrid-{{ section.id }}
.club-privilege-qv {
  position: fixed;

  top: 50%;
  left: 50%;

  z-index: 100001;

  width: min(960px, calc(100vw - 80px));

  max-height: calc(100vh - 70px);

  overflow-y: auto;

  background: #ffffff;

  opacity: 0;
  visibility: hidden;

  pointer-events: none;

  transform:
    translate(-50%, -47%);

  transition:
    opacity .3s ease,
    visibility .3s ease,
    transform .45s cubic-bezier(.22,1,.36,1);
}

#ClubPrivilegeGrid-{{ section.id }}
.club-privilege-qv.is-active {
  opacity: 1;
  visibility: visible;

  pointer-events: auto;

  transform:
    translate(-50%, -50%);
}


/* =========================================================
   CROIX
========================================================= */

#ClubPrivilegeGrid-{{ section.id }}
.club-privilege-qv__close {
  position: absolute;

  top: 24px;
  right: 24px;

  z-index: 10;

  width: 28px;
  height: 28px;

  padding: 0;

  border: 0;

  background: transparent;

  cursor: pointer;
}

#ClubPrivilegeGrid-{{ section.id }}
.club-privilege-qv__close::before,
#ClubPrivilegeGrid-{{ section.id }}
.club-privilege-qv__close::after {
  content: "";

  position: absolute;

  top: 50%;
  left: 50%;

  width: 18px;
  height: 1px;

  background: #111111;
}

#ClubPrivilegeGrid-{{ section.id }}
.club-privilege-qv__close::before {
  transform:
    translate(-50%, -50%)
    rotate(45deg);
}

#ClubPrivilegeGrid-{{ section.id }}
.club-privilege-qv__close::after {
  transform:
    translate(-50%, -50%)
    rotate(-45deg);
}


/* =========================================================
   CONTENU MODALE
========================================================= */

#ClubPrivilegeGrid-{{ section.id }}
.club-privilege-qv__inner {
  display: grid;

  grid-template-columns:
    minmax(0,1fr)
    minmax(320px,.9fr);

  align-items: center;

  min-height: 570px;

  padding:
    65px
    70px;
}

#ClubPrivilegeGrid-{{ section.id }}
.club-privilege-qv__media {
  display: flex;

  align-items: center;
  justify-content: center;
}

#ClubPrivilegeGrid-{{ section.id }}
.club-privilege-qv__image {
  display: block;

  width: 100%;
  max-width: 430px;

  max-height: 470px;

  object-fit: contain;
}

#ClubPrivilegeGrid-{{ section.id }}
.club-privilege-qv__info {
  padding-left: 50px;
}

#ClubPrivilegeGrid-{{ section.id }}
.club-privilege-qv__title {
  margin: 0;

  font-size: 16px;
  font-weight: 400;

  letter-spacing: .1em;

  text-transform: uppercase;
}

#ClubPrivilegeGrid-{{ section.id }}
.club-privilege-qv__price {
  margin-top: 15px;

  font-size: 13px;

  color: rgba(17,17,17,.55);
}


/* =========================================================
   VARIANTES
========================================================= */

#ClubPrivilegeGrid-{{ section.id }}
.club-privilege-qv__options {
  margin-top: 32px;
}

#ClubPrivilegeGrid-{{ section.id }}
.club-privilege-qv__option-label {
  margin: 0 0 12px;

  font-size: 11px;
}

#ClubPrivilegeGrid-{{ section.id }}
.club-privilege-qv__variants {
  display: flex;

  flex-wrap: wrap;

  gap: 8px;
}

#ClubPrivilegeGrid-{{ section.id }}
.club-privilege-qv__variant {
  position: relative;
}

#ClubPrivilegeGrid-{{ section.id }}
.club-privilege-qv__variant input {
  position: absolute;

  opacity: 0;

  pointer-events: none;
}

#ClubPrivilegeGrid-{{ section.id }}
.club-privilege-qv__variant span {
  display: flex;

  align-items: center;
  justify-content: center;

  min-width: 46px;
  height: 42px;

  padding: 0 13px;

  border:
    1px solid
    rgba(17,17,17,.18);

  font-size: 11px;

  cursor: pointer;
}

#ClubPrivilegeGrid-{{ section.id }}
.club-privilege-qv__variant
input:checked + span {
  border: 1px solid #111111;
}

#ClubPrivilegeGrid-{{ section.id }}
.club-privilege-qv__variant.is-disabled span {
  opacity: .3;

  cursor: not-allowed;
}


/* =========================================================
   AJOUT AU PANIER
========================================================= */

#ClubPrivilegeGrid-{{ section.id }}
.club-privilege-qv__submit {
  display: flex;

  align-items: center;
  justify-content: center;

  width: 100%;
  height: 50px;

  margin-top: 30px;

  border: 1px solid #111111;

  background: #111111;

  color: #ffffff;

  font-size: 10px;

  letter-spacing: .15em;

  text-transform: uppercase;

  cursor: pointer;
}

#ClubPrivilegeGrid-{{ section.id }}
.club-privilege-qv__details {
  display: inline-block;

  margin-top: 22px;

  padding-bottom: 4px;

  border-bottom: 1px solid currentColor;

  color: #111111;

  font-size: 9px;

  text-decoration: none;

  text-transform: uppercase;
}


/* =========================================================
   LOADING
========================================================= */

#ClubPrivilegeGrid-{{ section.id }}
.club-privilege-qv__loading {
  grid-column: 1 / -1;

  display: flex;

  align-items: center;
  justify-content: center;

  min-height: 440px;

  font-size: 9px;

  letter-spacing: .15em;

  text-transform: uppercase;
}


/* =========================================================
   TABLET
========================================================= */

@media screen and (max-width: 1100px) {

  #ClubPrivilegeGrid-{{ section.id }}
  .club-privilege-grid__products {
    grid-template-columns:
      repeat(3, minmax(0,1fr));

    padding-left: 30px;
    padding-right: 30px;
  }

}


/* =========================================================
   MOBILE
========================================================= */

@media screen and (max-width: 750px) {

  #ClubPrivilegeGrid-{{ section.id }}
  .club-privilege-grid__header {
   padding-top: 100px;
    padding-bottom: 42px;
  }

  #ClubPrivilegeGrid-{{ section.id }}
  .club-privilege-grid__eyebrow {
    font-size: 9px;
  }

  #ClubPrivilegeGrid-{{ section.id }}
  .club-privilege-grid__heading {
    font-size: 23px;
  }

  #ClubPrivilegeGrid-{{ section.id }}
  .club-privilege-grid__products {
    grid-template-columns:
      repeat(2, minmax(0,1fr));

    column-gap: 5px;
    row-gap: 38px;

    padding:
      0 12px
      45px;
  }

  #ClubPrivilegeGrid-{{ section.id }}
  .club-privilege-card__info {
    padding-top: 10px;
  }

  #ClubPrivilegeGrid-{{ section.id }}
  .club-privilege-card__title,
  #ClubPrivilegeGrid-{{ section.id }}
  .club-privilege-card__price {
    font-size: 10px;
  }

  #ClubPrivilegeGrid-{{ section.id }}
  .club-privilege-card__color-name {
    font-size: 9px;
  }

  #ClubPrivilegeGrid-{{ section.id }}
  .club-privilege-card__quick-add {
    opacity: 1;
    visibility: visible;

    transform: none;
  }


  /* QUICK VIEW MOBILE */

  #ClubPrivilegeGrid-{{ section.id }}
  .club-privilege-qv {
    width: calc(100vw - 28px);

    max-height:
      calc(100svh - 32px);

    overflow-y: auto;
  }

  #ClubPrivilegeGrid-{{ section.id }}
  .club-privilege-qv__inner {
    grid-template-columns: 1fr;

    min-height: 0;

    padding:
      42px 18px 24px;
  }

  #ClubPrivilegeGrid-{{ section.id }}
  .club-privilege-qv__image {
    width: auto;

    max-width: 68%;

    max-height: 30svh;
  }

  #ClubPrivilegeGrid-{{ section.id }}
  .club-privilege-qv__info {
    padding: 22px 0 0;
  }

  #ClubPrivilegeGrid-{{ section.id }}
  .club-privilege-qv__options {
    margin-top: 22px;
  }

  #ClubPrivilegeGrid-{{ section.id }}
  .club-privilege-qv__submit {
    height: 44px;

    margin-top: 22px;
  }

  #ClubPrivilegeGrid-{{ section.id }}
  .club-privilege-qv__close {
    top: 14px;
    right: 14px;
  }

}

</style>


<script>
(function () {

  const section =
    document.getElementById(
      'ClubPrivilegeGrid-{{ section.id }}'
    );

  if (!section) {
    return;
  }


  const modal =
    section.querySelector(
      '[data-club-privilege-qv]'
    );

  const overlay =
    section.querySelector(
      '[data-club-privilege-qv-overlay]'
    );

  const content =
    section.querySelector(
      '[data-club-privilege-qv-content]'
    );


  if (!modal || !overlay || !content) {
    return;
  }


  function formatMoney(cents) {

    return new Intl.NumberFormat(
      'fr-FR',
      {
        style: 'currency',
        currency: 'EUR'
      }
    ).format(cents / 100);

  }


  function escapeHTML(value) {

    const div =
      document.createElement('div');

    div.textContent =
      value == null
        ? ''
        : String(value);

    return div.innerHTML;

  }


  function openQuickView() {

    modal.classList.add(
      'is-active'
    );

    overlay.classList.add(
      'is-active'
    );

    modal.setAttribute(
      'aria-hidden',
      'false'
    );

  }


  function closeQuickView() {

    modal.classList.remove(
      'is-active'
    );

    overlay.classList.remove(
      'is-active'
    );

    modal.setAttribute(
      'aria-hidden',
      'true'
    );

  }


  function buildVariants(product) {

    const variants =
      product.variants || [];


    if (!variants.length) {
      return '';
    }


    if (
      variants.length === 1 &&
      variants[0].title === 'Default Title'
    ) {

      return `
        <input
          type="hidden"
          name="id"
          value="${variants[0].id}"
        >
      `;

    }


    const firstAvailable =
      variants.findIndex(
        variant => variant.available
      );


    return `

      <div class="club-privilege-qv__options">

        <p class="club-privilege-qv__option-label">
          {{ 'pour_products.size' | t }} :
        </p>

        <div class="club-privilege-qv__variants">

          ${variants.map(
            (variant, index) => {

              const checked =
                index === firstAvailable
                  ? 'checked'
                  : '';

              const disabled =
                variant.available
                  ? ''
                  : 'disabled';


              return `

                <label
                  class="
                    club-privilege-qv__variant
                    ${variant.available ? '' : 'is-disabled'}
                  "
                >

                  <input
                    type="radio"
                    name="id"
                    value="${variant.id}"
                    ${checked}
                    ${disabled}
                  >

                  <span>
                    ${escapeHTML(variant.title)}
                  </span>

                </label>

              `;

            }
          ).join('')}

        </div>

      </div>

    `;

  }


  async function loadProduct(handle) {

    content.innerHTML = `

      <div class="club-privilege-qv__loading">
        {{ 'pour_products.loading' | t }}
      </div>

    `;


    openQuickView();


    try {

      const response =
        await fetch(
          `/products/${handle}.js`,
          {
            headers: {
              Accept: 'application/json'
            }
          }
        );


      if (!response.ok) {
        throw new Error();
      }


      const product =
        await response.json();


      const image =
        product.featured_image ||
        product.images?.[0] ||
        '';


      content.innerHTML = `

        <div class="club-privilege-qv__media">

          ${
            image
              ? `
                <img
                  src="${escapeHTML(image)}"
                  class="club-privilege-qv__image"
                  alt="${escapeHTML(product.title)}"
                >
              `
              : ''
          }

        </div>


        <div class="club-privilege-qv__info">

          <h2 class="club-privilege-qv__title">
            ${escapeHTML(product.title)}
          </h2>


          <p class="club-privilege-qv__price">
            ${formatMoney(product.price)}
          </p>


          <form
            action="/cart/add"
            method="post"
            class="club-privilege-qv__form"
          >

            ${buildVariants(product)}


            <input
              type="hidden"
              name="quantity"
              value="1"
            >


            <button
              type="submit"
              class="club-privilege-qv__submit"
            >
              {{ 'pour_products.preorder' | t }}
            </button>

          </form>


          <a
            href="${escapeHTML(window.Shopify.routes.root + 'products/' + product.handle)}"
            class="club-privilege-qv__details"
          >
            {{ 'pour_common.view_product' | t }}
          </a>

        </div>

      `;


    } catch (error) {

      content.innerHTML = `

        <div class="club-privilege-qv__loading">
          {{ 'pour_products.unavailable' | t }}
        </div>

      `;

    }

  }


  section.addEventListener(
    'click',
    function (event) {

      const quickButton =
        event.target.closest(
          '[data-club-privilege-quick-add]'
        );


      if (quickButton) {

        event.preventDefault();
        event.stopPropagation();

        const handle =
          quickButton.dataset.productHandle;

        if (handle) {
          loadProduct(handle);
        }

        return;
      }


      if (
        event.target.closest(
          '[data-club-privilege-qv-close]'
        )
      ) {

        closeQuickView();

        return;
      }


      if (
        event.target === overlay
      ) {

        closeQuickView();

      }

    }
  );


  document.addEventListener(
    'submit',
    function (event) {

      if (
        event.target.matches(
          '#ClubPrivilegeGrid-{{ section.id }} .club-privilege-qv__form'
        )
      ) {

        /*
          Ton header.liquid intercepte ensuite /cart/add
          et ouvre ton drawer panier à droite.
        */

        window.setTimeout(
          closeQuickView,
          100
        );

      }

    }
  );


  document.addEventListener(
    'keydown',
    function (event) {

      if (event.key === 'Escape') {
        closeQuickView();
      }

    }
  );

})();
  
</script>
<script>
document.addEventListener('DOMContentLoaded', function () {

  const hero = document.querySelector(
    '#ClubPrivilegeGrid-{{ section.id }} .club-privilege-grid__hero'
  );

  const image = document.querySelector(
    '#ClubPrivilegeGrid-{{ section.id }} .club-privilege-grid__hero-image'
  );

  if (!hero || !image) return;


  function parallax() {

    const rect = hero.getBoundingClientRect();

    const distance =
      window.innerHeight - rect.top;

    const progress =
      distance /
      (window.innerHeight + rect.height);

    const movement =
      (progress - 0.5) * 35;

    image.style.transform =
      `translate3d(0, ${movement}%, 0)`;

  }

  window.addEventListener(
    'scroll',
    parallax,
    { passive: true }
  );

  window.addEventListener(
    'resize',
    parallax
  );

  parallax();

});
</script>

