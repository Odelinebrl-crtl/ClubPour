{% comment %}
  CLUB POUR — Collection éditoriale SEO
  Affichage automatique des produits de la collection Shopify.
{% endcomment %}

<section id="PourEditorial-{{ section.id }}" class="pour-editorial">

  <div class="pour-editorial__intro">
    {% if section.settings.eyebrow != blank %}
      <p class="pour-editorial__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {% endif %}

    <h1 id="pour-editorial-title-{{ section.id }}" class="vetements-grid__heading">
      {{ section.settings.heading | default: collection.title | escape }}
    </h1>

    {% if section.settings.intro != blank %}
      <div class="pour-editorial__text">
        {{ section.settings.intro }}
      </div>
    {% elsif collection.description != blank %}
      <div class="pour-editorial__text">
        {{ collection.description }}
      </div>
    {% endif %}
  </div>

  <div class="pour-editorial__products">
    {% paginate collection.products by 24 %}
      {% for product in collection.products %}
        <article class="pour-editorial__card">

         
<div class="pour-editorial__media">

  <a class="pour-editorial__image-link" href="{{ product.url }}">
    {% if product.featured_image %}
      {{
        product.featured_image
        | image_url: width: 1200
        | image_tag:
          class: 'pour-editorial__image pour-editorial__image--primary',
          loading: 'lazy',
          alt: product.featured_image.alt | default: product.title
      }}
    {% endif %}

    {% if product.images.size > 1 %}
      {{
        product.images[1]
        | image_url: width: 1200
        | image_tag:
          class: 'pour-editorial__image pour-editorial__image--hover',
          loading: 'lazy',
          alt: product.images[1].alt | default: product.title
      }}
    {% endif %}
  </a>

  <button
    type="button"
    class="pour-editorial__quick"
    data-quick-add
    data-product-handle="{{ product.handle }}"
    aria-label="Choisir une taille pour {{ product.title | escape }}"
  >
    CHOISIR MA TAILLE
  </button>

</div>


          <a class="pour-editorial__info" href="{{ product.url }}">
            <div class="pour-editorial__info-row">
              <h2 class="pour-editorial__product-title">{{ product.title | escape }}</h2>
              <span class="pour-editorial__price">{{ product.price | money }}</span>
            </div>

            {% if product.metafields.custom.color_name.value != blank %}
              <p class="pour-editorial__color">
                {{ product.metafields.custom.color_name.value | escape }}
              </p>
            {% endif %}

            {% assign current_color = product.metafields.custom.couleur.value %}
            {% assign color_products = product.metafields.custom.couleurs.value %}

            {% if current_color != blank or color_products != blank %}
              <div class="pour-editorial__swatches">
                {% if current_color != blank %}
                  <span
                    class="pour-editorial__swatch"
                    style="background-color: {{ current_color }};"
                    aria-label="{{ product.metafields.custom.color_name.value | escape }}"
                  ></span>
                {% endif %}

                {% if color_products != blank %}
                  {% for color_product in color_products %}
                    {% assign color_value = color_product.metafields.custom.couleur.value %}
                    {% if color_value != blank %}
                      <span
                        class="pour-editorial__swatch"
                        style="background-color: {{ color_value }};"
                        aria-label="{{ color_product.metafields.custom.color_name.value | escape }}"
                      ></span>
                    {% endif %}
                  {% endfor %}
                {% endif %}
              </div>
            {% endif %}
          </a>

        </article>
      {% endfor %}

      {% if paginate.pages > 1 %}
        <nav class="pour-editorial__pagination" aria-label="Pagination">
          {% if paginate.previous %}
            <a href="{{ paginate.previous.url }}">PRÉCÉDENT</a>
          {% endif %}
          <span>{{ paginate.current_page }} / {{ paginate.pages }}</span>
          {% if paginate.next %}
            <a href="{{ paginate.next.url }}">SUIVANT</a>
          {% endif %}
        </nav>
      {% endif %}
    {% endpaginate %}
  </div>


{% if request.locale.iso_code == 'fr' %}

<section class="pour-collection-seo" aria-labelledby="pour-collection-seo-title">
  <div class="pour-collection-seo__inner">

    <p class="pour-collection-seo__eyebrow">
      CLUB POUR — L'UNIVERS DU VÊTEMENT AUTOMOBILE
    </p>

    <h2 id="pour-collection-seo-title" class="vetements-grid__heading">
      Le t-shirt voiture, une autre vision de la culture automobile
    </h2>

    <div class="pour-collection-seo__content">

      <p>
        Le <strong>t-shirt voiture</strong> est bien plus qu'un vêtement inspiré
        de l'automobile. Il traduit une culture, une esthétique et une passion
        pour les lignes, les silhouettes et l'histoire des voitures.
        Chez CLUB POUR, cette inspiration devient un véritable univers graphique.
      </p>

      <p>
        Notre collection de <strong>t-shirts automobile</strong> rassemble
        des créations originales inspirées de différentes références de la
        culture auto. Chaque modèle possède son propre caractère, entre
        esthétique vintage, influences racing et regard contemporain sur
        le vêtement.
      </p>

      <p>
        À travers nos <strong>t-shirts auto</strong>, nous proposons une
        approche du vestiaire automobile qui dépasse les codes traditionnels
        du merchandising. Des pièces pensées pour être portées au quotidien,
        par les passionnés de voitures comme par celles et ceux qui apprécient
        simplement leur esthétique.
      </p>

      <p>
        Nos créations sont réalisées en <strong>100 % coton biologique
        de 200 GSM</strong>. Du t-shirt racing aux inspirations vintage,
        chaque pièce s'inscrit dans une vision singulière de la mode automobile.
      </p>

    </div>

    <div class="pour-collection-seo__faq">

      <p class="pour-collection-seo__eyebrow">
        QUESTIONS SUR LES T-SHIRTS VOITURE
      </p>

      <details class="pour-collection-seo__faq-item">
        <summary>Où acheter un t-shirt voiture original ?</summary>
        <div class="pour-collection-seo__faq-answer">
          <p>
            CLUB POUR propose une collection de t-shirts voiture aux
            inspirations automobiles et racing. Chaque modèle présente
            un univers graphique distinct, imaginé pour celles et ceux
            qui souhaitent intégrer la culture automobile à leur vestiaire.
          </p>
        </div>
      </details>

      <details class="pour-collection-seo__faq-item">
        <summary>Quelle est la différence entre un t-shirt auto et un t-shirt racing ?</summary>
        <div class="pour-collection-seo__faq-answer">
          <p>
            Le t-shirt auto fait référence à l'univers automobile dans
            son ensemble, tandis que le t-shirt racing s'inspire plus
            particulièrement de la compétition, du sport mécanique
            et de leurs codes graphiques.
          </p>
        </div>
      </details>

      <details class="pour-collection-seo__faq-item">
        <summary>Les t-shirts voiture CLUB POUR sont-ils mixtes ?</summary>
        <div class="pour-collection-seo__faq-answer">
          <p>
            Les t-shirts CLUB POUR sont pensés pour être portés par tous.
            Les tailles et les informations de coupe sont disponibles
            sur chaque fiche produit afin de vous aider à choisir
            le modèle qui vous correspond.
          </p>
        </div>
      </details>

      <details class="pour-collection-seo__faq-item">
        <summary>En quelle matière sont fabriqués les t-shirts CLUB POUR ?</summary>
        <div class="pour-collection-seo__faq-answer">
          <p>
            Nos t-shirts sont conçus en 100 % coton biologique avec
            un grammage de 200 GSM. Une matière choisie pour accompagner
            notre approche du vêtement et de la culture automobile.
          </p>
        </div>
      </details>

      <details class="pour-collection-seo__faq-item">
        <summary>Comment porter un t-shirt automobile au quotidien ?</summary>
        <div class="pour-collection-seo__faq-answer">
          <p>
            Un t-shirt automobile peut facilement s'intégrer à une tenue
            quotidienne. Associé à un jean, un pantalon ample ou une pièce
            plus structurée, il apporte une référence graphique à votre style
            sans renoncer à la simplicité.
          </p>
        </div>
      </details>

    </div>

    <div class="pour-collection-seo__signature">
      <span></span>
      <p>DESIGN — CULTURE AUTOMOBILE — CLUB POUR</p>
      <span></span>
    </div>

  </div>
</section>

{% endif %}

</section>

<style>
  #PourEditorial-{{ section.id }} {
    width: 100%;
    box-sizing: border-box;
    padding: 85px 56px 90px;
    background: #fff;
  }

  #PourEditorial-{{ section.id }} *,
  #PourEditorial-{{ section.id }} *::before,
  #PourEditorial-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  /* INTRODUCTION — même traitement éditorial que le SEO de la page d'accueil */
  #PourEditorial-{{ section.id }} .pour-editorial__intro {
    width: 100%;
    max-width: 900px;
    margin: 0 auto 76px;
    padding-top: 28px;
    text-align: center;
  }

  #PourEditorial-{{ section.id }} .pour-editorial__eyebrow {
    margin: 0 0 22px;
    color: #999;
    font-size: 10px;
    line-height: 1.5;
    font-weight: 400;
    letter-spacing: 3px;
    text-align: center;
    text-transform: uppercase;
  }

  #PourEditorial-{{ section.id }} .vetements-grid__heading {
    margin: 0 0 38px !important;
    color: #111;
    text-align: center;
  }

  #PourEditorial-{{ section.id }} .pour-editorial__text {
    width: 100%;
    max-width: 850px;
    margin: 0 auto;
    color: #666;
    font-size: 14px;
    line-height: 1.9;
    font-weight: 400;
    letter-spacing: normal;
    text-align: center;
    text-transform: none;
  }

  #PourEditorial-{{ section.id }} .pour-editorial__text p {
    margin: 0 0 18px;
  }

  #PourEditorial-{{ section.id }} .pour-editorial__text p:last-child {
    margin-bottom: 0;
  }

  #PourEditorial-{{ section.id }} .pour-editorial__text strong {
    color: #333;
    font-weight: 500;
  }

  /* GRILLE PRODUITS */
  #PourEditorial-{{ section.id }} .pour-editorial__products {
    display: grid;
    width: 100%;
    max-width: 1600px;
    margin: 0 auto;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    column-gap: 18px;
    row-gap: 42px;
  }

  #PourEditorial-{{ section.id }} .pour-editorial__card {
    min-width: 0;
  }

  
#PourEditorial-{{ section.id }} .pour-editorial__media {
  display: block;
  position: relative;
  overflow: hidden;
  background: #f5f5f5;
}

#PourEditorial-{{ section.id }} .pour-editorial__image-link {
  display: block;
  position: relative;
  color: inherit;
  text-decoration: none;
}

#PourEditorial-{{ section.id }} .pour-editorial__image {
  display: block;
  width: 100%;
  height: auto;
}

#PourEditorial-{{ section.id }} .pour-editorial__image--hover {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0;
  transition: opacity .3s ease;
}

#PourEditorial-{{ section.id }} .pour-editorial__image--primary {
  transition: opacity .3s ease;
}

#PourEditorial-{{ section.id }} .pour-editorial__media:hover .pour-editorial__image--primary {
  opacity: 0;
}

#PourEditorial-{{ section.id }} .pour-editorial__media:hover .pour-editorial__image--hover {
  opacity: 1;
}

#PourEditorial-{{ section.id }} .pour-editorial__quick {
  position: absolute;
  z-index: 2;
  right: 8px;
  bottom: 8px;
  padding: 10px 13px;
  border: 0;
  background: #fff;
  color: #111;
  font-family: inherit;
  font-size: 8px;
  font-weight: 400;
  letter-spacing: .08em;
  cursor: pointer;
  opacity: 0;
  transform: translateY(3px);
  transition: opacity .25s ease, transform .25s ease;
}

#PourEditorial-{{ section.id }} .pour-editorial__media:hover .pour-editorial__quick {
  opacity: 1;
  transform: translateY(0);
}

@media (max-width: 749px) {
  #PourEditorial-{{ section.id }} .pour-editorial__quick {
    opacity: 1;
    transform: none;
    font-size: 7px;
    padding: 8px 9px;
  }
}


  #PourEditorial-{{ section.id }} .pour-editorial__info {
    display: block;
    margin-top: 12px;
    color: inherit;
    text-decoration: none;
  }

  #PourEditorial-{{ section.id }} .pour-editorial__info-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
  }

  #PourEditorial-{{ section.id }} .pour-editorial__product-title {
    margin: 0 !important;
    font-size: 12px !important;
    line-height: 1.4;
    font-weight: 400 !important;
    text-transform: uppercase;
  }

  #PourEditorial-{{ section.id }} .pour-editorial__price {
    flex-shrink: 0;
    font-size: 12px;
    font-weight: 400;
  }

  #PourEditorial-{{ section.id }} .pour-editorial__color {
    margin: 7px 0 0;
    font-size: 10px;
    font-weight: 400;
  }

  #PourEditorial-{{ section.id }} .pour-editorial__swatches {
    display: flex;
    gap: 5px;
    margin-top: 8px;
  }

  #PourEditorial-{{ section.id }} .pour-editorial__swatch {
    display: block;
    width: 11px;
    height: 11px;
    flex: 0 0 11px;
    border: 1px solid #d5d5d5;
    border-radius: 50%;
  }

  /* TEXTE ÉDITORIAL SOUS LES PRODUITS */
  #PourEditorial-{{ section.id }} .pour-editorial__content {
    width: 100%;
    max-width: 900px;
    margin: 110px auto 20px;
    text-align: center;
  }

  #PourEditorial-{{ section.id }} .pour-editorial__content .vetements-grid__heading {
    margin-bottom: 38px !important;
  }

  #PourEditorial-{{ section.id }} .pour-editorial__pagination {
    grid-column: 1 / -1;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 22px;
    margin-top: 30px;
    font-size: 10px;
    letter-spacing: .08em;
  }

  #PourEditorial-{{ section.id }} .pour-editorial__pagination a {
    color: inherit;
    text-decoration: none;
  }

  #PourEditorial-{{ section.id }} .pour-editorial__signature {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    margin-top: 42px;
    color: #999;
  }

  #PourEditorial-{{ section.id }} .pour-editorial__signature span {
    display: block;
    width: 35px;
    height: 1px;
    background: #ddd;
  }

  #PourEditorial-{{ section.id }} .pour-editorial__signature p {
    margin: 0;
    color: #999;
    font-size: 9px;
    line-height: 1.5;
    font-weight: 400;
    letter-spacing: 2px;
  }

  @media (max-width: 749px) {
    #PourEditorial-{{ section.id }} {
      padding: 60px 22px 65px;
    }

    #PourEditorial-{{ section.id }} .pour-editorial__intro {
      margin-bottom: 48px;
      padding-top: 20px;
    }

    #PourEditorial-{{ section.id }} .pour-editorial__eyebrow {
      margin-bottom: 18px;
      font-size: 9px;
      letter-spacing: 2px;
    }

    #PourEditorial-{{ section.id }} .vetements-grid__heading {
      margin-bottom: 28px !important;
    }

    #PourEditorial-{{ section.id }} .pour-editorial__text {
      font-size: 12px;
      line-height: 1.8;
    }

    #PourEditorial-{{ section.id }} .pour-editorial__text p {
      margin-bottom: 15px;
    }

    #PourEditorial-{{ section.id }} .pour-editorial__products {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 28px 12px;
    }

    #PourEditorial-{{ section.id }} .pour-editorial__product-title,
    #PourEditorial-{{ section.id }} .pour-editorial__price {
      font-size: 10px !important;
      font-weight: 400 !important;
    }

    #PourEditorial-{{ section.id }} .pour-editorial__quick {
      opacity: 1;
      transform: none;
      font-size: 7px;
      padding: 8px 9px;
    }

    #PourEditorial-{{ section.id }} .pour-editorial__content {
      margin-top: 75px;
    }

    #PourEditorial-{{ section.id }} .pour-editorial__signature {
      gap: 10px;
      margin-top: 35px;
    }

    #PourEditorial-{{ section.id }} .pour-editorial__signature span {
      width: 20px;
    }

    #PourEditorial-{{ section.id }} .pour-editorial__signature p {
      font-size: 8px;
      letter-spacing: 1.5px;
    }
  }


