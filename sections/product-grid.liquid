<section
  id="PourProducts-{{ section.id }}"
  class="pour-products"
>

  <div class="pour-products__inner">

    <!-- =========================
         TITRES
    ========================== -->

    <div class="pour-products__header">

      {% if section.settings.subtitle != blank %}
        <p class="pour-products__eyebrow">
          {{ section.settings.subtitle }}
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="pour-products__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

    </div>


    <!-- =========================
         CARROUSEL PRODUITS
    ========================== -->

    <div
      class="pour-products__carousel"
      data-pour-products-carousel
    >

      <!-- FLÈCHE GAUCHE -->

      <button
        type="button"
        class="pour-products__arrow pour-products__arrow--prev"
        data-pour-products-prev
        aria-label="Produits précédents"
      >
        ‹
      </button>


      <!-- =========================
           TRACK PRODUITS
      ========================== -->

      <div
        class="pour-products__grid"
        data-pour-products-track
      >

        {% for block in section.blocks %}

          {% assign featured_product = block.settings.product %}

          {% if featured_product != blank %}

            <article
              class="pour-product"
              {{ block.shopify_attributes }}
            >

              <!-- =========================================
                   ZONE IMAGE
              ========================================== -->

              <div class="pour-product__media">


                <a
                  href="{{ featured_product.url }}"
                  class="pour-product__media-link"
                  aria-label="{{ featured_product.title }}"
                >

                  <!-- IMAGE PRINCIPALE -->

                  {% if block.settings.image_primary != blank %}

                    {{
                      block.settings.image_primary
                      | image_url: width: 1400
                      | image_tag:
                        class: 'pour-product__image pour-product__image--primary',
                        loading: 'lazy',
                        alt: featured_product.title
                    }}

                  {% elsif featured_product.featured_image != blank %}

                    {{
                      featured_product.featured_image
                      | image_url: width: 1400
                      | image_tag:
                        class: 'pour-product__image pour-product__image--primary',
                        loading: 'lazy',
                        alt: featured_product.title
                    }}

                  {% endif %}


                  <!-- IMAGE AU SURVOL -->

                  {% if block.settings.image_secondary != blank %}

                    {{
                      block.settings.image_secondary
                      | image_url: width: 1400
                      | image_tag:
                        class: 'pour-product__image pour-product__image--secondary',
                        loading: 'lazy',
                        alt: featured_product.title
                    }}

                  {% elsif featured_product.images.size > 1 %}

                    {{
                      featured_product.images[1]
                      | image_url: width: 1400
                      | image_tag:
                        class: 'pour-product__image pour-product__image--secondary',
                        loading: 'lazy',
                        alt: featured_product.title
                    }}

                  {% endif %}

                </a>


                <!-- =========================================
                     QUICK ADD +
                ========================================== -->

                <button
                  type="button"
                  class="pour-product__quick-add"
                  data-pour-quick-add
                  data-product-handle="{{ featured_product.handle }}"
                  aria-label="Ajouter rapidement {{ featured_product.title }}"
                ></button>

              </div>


              <!-- =========================================
                   INFORMATIONS PRODUIT
              ========================================== -->

              <a
                href="{{ featured_product.url }}"
                class="pour-product__info-link"
              >

                <div class="pour-product__info">

                  <h3 class="pour-product__title">
                    {{ featured_product.title }}
                  </h3>

                  <div class="pour-product__price">
                    {{ featured_product.price | money }}
                  </div>

                </div>

              </a>

            </article>

          {% endif %}

        {% endfor %}

      </div>


      <!-- FLÈCHE DROITE -->

      <button
        type="button"
        class="pour-products__arrow pour-products__arrow--next"
        data-pour-products-next
        aria-label="Produits suivants"
      >
        ›
      </button>

    </div>

  </div>


  <!-- =====================================================
       QUICK VIEW OVERLAY
  ====================================================== -->

  <div
    class="pour-qv__overlay"
    data-pour-qv-overlay
  ></div>


  <!-- =====================================================
       QUICK VIEW MODAL
  ====================================================== -->

  <div
    class="pour-qv"
    data-pour-qv
    aria-hidden="true"
  >

    <button
      type="button"
      class="pour-qv__close"
      data-pour-qv-close
      aria-label="Fermer"
    ></button>

    <div
      class="pour-qv__inner"
      data-pour-qv-content
    ></div>

  </div>

</section>


<style>

/* =========================================================
   HOVER IMAGE
========================================================= */

#PourProducts-{{ section.id }} .pour-product__media {
  position: relative;
  overflow: hidden;
}

#PourProducts-{{ section.id }} .pour-product__media-link {
  position: relative;
  display: block;
  width: 100%;
}

#PourProducts-{{ section.id }} .pour-product__image--primary {
  position: relative;
  z-index: 1;

  display: block;

  width: 100%;
  height: auto;

  opacity: 1;
}

#PourProducts-{{ section.id }} .pour-product__image--secondary {
  position: absolute;
  inset: 0;

  z-index: 2;

  display: block;

  width: 100%;
  height: 100%;

  object-fit: cover;
  object-position: center;

  opacity: 0;

  pointer-events: none;

  transition:
    opacity .25s cubic-bezier(.22,1,.36,1);
}

#PourProducts-{{ section.id }}
.pour-product__media:hover
.pour-product__image--secondary {
  opacity: 1;
}


/* =========================================================
   QUICK ADD +
========================================================= */

#PourProducts-{{ section.id }}
.pour-product__quick-add {
  position: absolute;

  right: 8px;
  bottom: 8px;

  z-index: 30;

  width: 28px;
  height: 28px;

  min-width: 28px;
  min-height: 28px;

  padding: 0;
  margin: 0;

  border: 0;
  border-radius: 0;

  background: #ffffff;

  cursor: pointer;

  opacity: 0;
  visibility: hidden;

  transform: translateY(3px);

  transition:
    opacity .18s ease,
    visibility .18s ease,
    transform .25s cubic-bezier(.22,1,.36,1);

  appearance: none;
  -webkit-appearance: none;
}


/* trait horizontal */

#PourProducts-{{ section.id }}
.pour-product__quick-add::before {
  content: "";

  position: absolute;

  top: 50%;
  left: 50%;

  width: 10px;
  height: 1px;

  background: #111111;

  transform:
    translate(-50%, -50%);
}


/* trait vertical */

#PourProducts-{{ section.id }}
.pour-product__quick-add::after {
  content: "";

  position: absolute;

  top: 50%;
  left: 50%;

  width: 1px;
  height: 10px;

  background: #111111;

  transform:
    translate(-50%, -50%);
}


/* apparition seulement au hover */

#PourProducts-{{ section.id }}
.pour-product__media:hover
.pour-product__quick-add {
  opacity: 1;
  visibility: visible;

  transform: translateY(0);
}


/* =========================================================
   LIENS INFOS
========================================================= */

#PourProducts-{{ section.id }}
.pour-product__info-link {
  display: block;

  color: inherit;
  text-decoration: none;
}


/* =========================================================
   QUICK VIEW — OVERLAY
========================================================= */

#PourProducts-{{ section.id }}
.pour-qv__overlay {
  position: fixed;
  inset: 0;

  z-index: 100000;

  background: rgba(0,0,0,.38);

  opacity: 0;
  visibility: hidden;

  pointer-events: none;

  transition:
    opacity .3s ease,
    visibility .3s ease;
}

#PourProducts-{{ section.id }}
.pour-qv__overlay.is-active {
  opacity: 1;
  visibility: visible;

  pointer-events: auto;
}


/* =========================================================
   QUICK VIEW — MODALE
========================================================= */

#PourProducts-{{ section.id }}
.pour-qv {
  position: fixed;

  top: 50%;
  left: 50%;

  z-index: 100001;

  width: min(960px, calc(100vw - 80px));

  max-height: calc(100vh - 70px);

  overflow-y: auto;

  background: #ffffff;

  opacity: 0;
  visibility: hidden;

  pointer-events: none;

  transform:
    translate(-50%, -47%);

  transition:
    opacity .3s ease,
    visibility .3s ease,
    transform .45s cubic-bezier(.22,1,.36,1);
}

#PourProducts-{{ section.id }}
.pour-qv.is-active {
  opacity: 1;
  visibility: visible;

  pointer-events: auto;

  transform:
    translate(-50%, -50%);
}


/* =========================================================
   CROIX
========================================================= */

#PourProducts-{{ section.id }}
.pour-qv__close {
  position: absolute;

  top: 24px;
  right: 24px;

  z-index: 10;

  width: 28px;
  height: 28px;

  padding: 0;

  border: 0;

  background: transparent;

  cursor: pointer;
}

#PourProducts-{{ section.id }}
.pour-qv__close::before,
#PourProducts-{{ section.id }}
.pour-qv__close::after {
  content: "";

  position: absolute;

  top: 50%;
  left: 50%;

  width: 18px;
  height: 1px;

  background: #111111;
}

#PourProducts-{{ section.id }}
.pour-qv__close::before {
  transform:
    translate(-50%, -50%)
    rotate(45deg);
}

#PourProducts-{{ section.id }}
.pour-qv__close::after {
  transform:
    translate(-50%, -50%)
    rotate(-45deg);
}


/* =========================================================
   CONTENU MODALE
========================================================= */

#PourProducts-{{ section.id }}
.pour-qv__inner {
  display: grid;

  grid-template-columns:
    minmax(0,1fr)
    minmax(320px,.9fr);

  align-items: center;

  min-height: 570px;

  padding:
    65px
    70px;
}

#PourProducts-{{ section.id }}
.pour-qv__media {
  display: flex;

  align-items: center;
  justify-content: center;
}

#PourProducts-{{ section.id }}
.pour-qv__image {
  display: block;

  width: 100%;
  max-width: 430px;

  max-height: 470px;

  object-fit: contain;
}

#PourProducts-{{ section.id }}
.pour-qv__info {
  padding-left: 50px;
}

#PourProducts-{{ section.id }}
.pour-qv__title {
  margin: 0;

  font-size: 16px;
  font-weight: 400;

  letter-spacing: .1em;

  text-transform: uppercase;
}

#PourProducts-{{ section.id }}
.pour-qv__price {
  margin-top: 15px;

  font-size: 13px;

  color: rgba(17,17,17,.55);
}


/* =========================================================
   VARIANTES
========================================================= */

#PourProducts-{{ section.id }}
.pour-qv__options {
  margin-top: 32px;
}

#PourProducts-{{ section.id }}
.pour-qv__option-label {
  margin: 0 0 12px;

  font-size: 11px;
}

#PourProducts-{{ section.id }}
.pour-qv__variants {
  display: flex;
  flex-wrap: wrap;

  gap: 8px;
}

#PourProducts-{{ section.id }}
.pour-qv__variant {
  position: relative;
}

#PourProducts-{{ section.id }}
.pour-qv__variant input {
  position: absolute;

  opacity: 0;

  pointer-events: none;
}

#PourProducts-{{ section.id }}
.pour-qv__variant span {
  display: flex;

  align-items: center;
  justify-content: center;

  min-width: 46px;
  height: 42px;

  padding: 0 13px;

  border:
    1px solid
    rgba(17,17,17,.18);

  font-size: 11px;

  cursor: pointer;
}

#PourProducts-{{ section.id }}
.pour-qv__variant
input:checked + span {
  border: 1px solid #111111;
  box-shadow: none;
}


/* =========================================================
   BOUTON AJOUT PANIER
========================================================= */

#PourProducts-{{ section.id }}
.pour-qv__submit {
  display: flex;

  align-items: center;
  justify-content: center;

  width: 100%;
  height: 50px;

  margin-top: 30px;

  border:
    1px solid
    #111111;

  background: #111111;

  color: #ffffff;

  font-size: 10px;

  letter-spacing: .15em;

  text-transform: uppercase;

  cursor: pointer;
}

#PourProducts-{{ section.id }}
.pour-qv__details {
  display: inline-block;

  margin-top: 22px;

  padding-bottom: 4px;

  border-bottom:
    1px solid
    currentColor;

  color: #111111;

  font-size: 9px;

  text-decoration: none;

  text-transform: uppercase;
}


/* =========================================================
   LOADING
========================================================= */

#PourProducts-{{ section.id }}
.pour-qv__loading {
  grid-column: 1 / -1;

  display: flex;

  align-items: center;
  justify-content: center;

  min-height: 440px;

  font-size: 9px;

  letter-spacing: .15em;

  text-transform: uppercase;
}


/* =========================================================
   MOBILE
========================================================= */

@media screen and (max-width: 750px) {

  #PourProducts-{{ section.id }}
  .pour-qv {
    width: calc(100vw - 24px);

    max-height:
      calc(100vh - 24px);
  }

  #PourProducts-{{ section.id }}
  .pour-qv__inner {
    grid-template-columns: 1fr;

    min-height: 0;

    padding:
      60px
      22px
      35px;
  }

  #PourProducts-{{ section.id }}
  .pour-qv__image {
    max-height: 300px;
  }

  #PourProducts-{{ section.id }}
  .pour-qv__info {
    padding: 30px 0 0;
  }

}

</style>


<script>
(function () {

  const section =
    document.getElementById(
      'PourProducts-{{ section.id }}'
    );

  if (!section) {
    return;
  }


  const modal =
    section.querySelector(
      '[data-pour-qv]'
    );

  const overlay =
    section.querySelector(
      '[data-pour-qv-overlay]'
    );

  const content =
    section.querySelector(
      '[data-pour-qv-content]'
    );


  if (!modal || !overlay || !content) {
    return;
  }


  function formatMoney(cents) {

    return new Intl.NumberFormat(
      'fr-FR',
      {
        style: 'currency',
        currency: 'EUR'
      }
    ).format(cents / 100);

  }


  function escapeHTML(value) {

    const div =
      document.createElement('div');

    div.textContent =
      value == null
        ? ''
        : String(value);

    return div.innerHTML;

  }


  function openQuickView() {

    modal.classList.add(
      'is-active'
    );

    overlay.classList.add(
      'is-active'
    );

    modal.setAttribute(
      'aria-hidden',
      'false'
    );

  }


  function closeQuickView() {

    modal.classList.remove(
      'is-active'
    );

    overlay.classList.remove(
      'is-active'
    );

    modal.setAttribute(
      'aria-hidden',
      'true'
    );

  }


  function buildVariants(product) {

    const variants =
      product.variants || [];


    if (!variants.length) {
      return '';
    }


    if (
      variants.length === 1 &&
      variants[0].title === 'Default Title'
    ) {

      return `
        <input
          type="hidden"
          name="id"
          value="${variants[0].id}"
        >
      `;

    }


    const firstAvailable =
      variants.findIndex(
        variant => variant.available
      );


    return `

      <div class="pour-qv__options">

        <p class="pour-qv__option-label">
          Taille :
        </p>

        <div class="pour-qv__variants">

          ${variants.map(
            (variant, index) => {

              const checked =
                index === firstAvailable
                  ? 'checked'
                  : '';

              const disabled =
                variant.available
                  ? ''
                  : 'disabled';


              return `

                <label
                  class="
                    pour-qv__variant
                    ${variant.available ? '' : 'is-disabled'}
                  "
                >

                  <input
                    type="radio"
                    name="id"
                    value="${variant.id}"
                    ${checked}
                    ${disabled}
                  >

                  <span>
                    ${escapeHTML(variant.title)}
                  </span>

                </label>
              `;

            }
          ).join('')}

        </div>

      </div>
    `;

  }


  async function loadProduct(handle) {

    content.innerHTML = `

      <div class="pour-qv__loading">
        CHARGEMENT
      </div>

    `;


    openQuickView();


    try {

      const response =
        await fetch(
          `/products/${handle}.js`,
          {
            headers: {
              Accept: 'application/json'
            }
          }
        );


      if (!response.ok) {
        throw new Error();
      }


      const product =
        await response.json();


      const image =
        product.featured_image ||
        product.images?.[0] ||
        '';


      content.innerHTML = `

        <div class="pour-qv__media">

          ${
            image
              ? `
                <img
                  src="${escapeHTML(image)}"
                  class="pour-qv__image"
                  alt="${escapeHTML(product.title)}"
                >
              `
              : ''
          }

        </div>


        <div class="pour-qv__info">

          <h2 class="pour-qv__title">
            ${escapeHTML(product.title)}
          </h2>


          <p class="pour-qv__price">
            ${formatMoney(product.price)}
          </p>


          <form
            action="/cart/add"
            method="post"
            class="pour-qv__form"
          >

            ${buildVariants(product)}


            <input
              type="hidden"
              name="quantity"
              value="1"
            >


            <button
              type="submit"
              class="pour-qv__submit"
            >
              AJOUTER AU PANIER
            </button>

          </form>


          <a
            href="${escapeHTML(product.url)}"
            class="pour-qv__details"
          >
            VOIR LE PRODUIT
          </a>

        </div>
      `;


    } catch (error) {

      content.innerHTML = `

        <div class="pour-qv__loading">
          PRODUIT INDISPONIBLE
        </div>

      `;

    }

  }


  section.addEventListener(
    'click',
    function (event) {

      const quickButton =
        event.target.closest(
          '[data-pour-quick-add]'
        );


      if (quickButton) {

        event.preventDefault();
        event.stopPropagation();

        const handle =
          quickButton.dataset.productHandle;

        if (handle) {
          loadProduct(handle);
        }

        return;
      }


      if (
        event.target.closest(
          '[data-pour-qv-close]'
        )
      ) {

        closeQuickView();

        return;
      }


      if (
        event.target === overlay
      ) {

        closeQuickView();

      }

    }
  );


  document.addEventListener(
  'submit',
  function (event) {

    const form = event.target;

    if (!form.matches('.pour-qv__form')) {
      return;
    }

    /* Ferme immédiatement la Quick View */
    closeQuickView();

  },
  true
);


  document.addEventListener(
    'keydown',
    function (event) {

      if (event.key === 'Escape') {
        closeQuickView();
      }

    }
  );

})();
</script>


