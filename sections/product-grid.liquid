<section
  id="PourProducts-{{ section.id }}"
  class="pour-products"
>

  <div class="pour-products__inner">

    <!-- =========================
         TITRES
    ========================== -->

    <div class="pour-products__header">

      {% if section.settings.subtitle != blank %}
        <p class="pour-products__eyebrow">
          {{ section.settings.subtitle }}
        </p>
      {% endif %}

   {% if section.settings.heading != blank %}
  <h2 class="vetements-grid__heading">
    {{ section.settings.heading }}
  </h2>
{% endif %}

    </div>


    <!-- =========================
         FILTRES COLLECTION
    ========================== -->

    <div class="pour-products__filters" data-pour-products-filters>

      <button
        type="button"
        class="pour-products__filter is-active"
        data-filter="all"
        aria-pressed="true"
      >
        TOUT
      </button>
<button
  type="button"
  class="pour-products__filter"
  data-filter="nouveaute"
  aria-pressed="false"
>
  NOUVEAUTÉ
</button>
      <button
        type="button"
        class="pour-products__filter"
        data-filter="mediterraneen"
        aria-pressed="false"
      >
        MÉDITERRANÉEN
      </button>

      <button
        type="button"
        class="pour-products__filter"
        data-filter="signature"
        aria-pressed="false"
      >
        SIGNATURE
      </button>

      <button
        type="button"
        class="pour-products__filter"
        data-filter="racine"
        aria-pressed="false"
      >
        RACING
      </button>

    </div>

    <!-- =========================
         CARROUSEL PRODUITS
    ========================== -->

    <div
      class="pour-products__carousel"
      data-pour-products-carousel
    >

      <!-- FLÈCHE GAUCHE -->

      <button
        type="button"
        class="pour-products__arrow pour-products__arrow--prev"
        data-pour-products-prev
        aria-label="{{ 'pour_products.previous' | t }}"
      >
        ‹
      </button>


      <!-- =========================
           TRACK PRODUITS
      ========================== -->

      <div
        class="pour-products__grid"
        data-pour-products-track
      >

        {% for block in section.blocks %}

          {% assign featured_product = block.settings.product %}

          {% if featured_product != blank %}

        
<article
  class="pour-product"
  data-categories="{% if block.settings.category_mediterraneen %}mediterraneen,{% endif %}{% if block.settings.category_signature %}signature,{% endif %}{% if block.settings.category_racing %}racine,{% endif %}{% if block.settings.category_nouveaute %}nouveaute,{% endif %}"
  {{ block.shopify_attributes }}
>


              <!-- =========================================
                   ZONE IMAGE
              ========================================== -->

              <div class="pour-product__media">
{% if block.settings.show_new_badge %}
  <span class="pour-product__badge">
    NOUVEAUTÉ
  </span>
{% endif %}
                <a
                  href="{{ featured_product.url }}"
                  class="pour-product__media-link"
                  aria-label="{{ featured_product.title }}"
                >

                  <!-- IMAGE PRINCIPALE -->

                  {% if block.settings.image_primary != blank %}

                    {{
                      block.settings.image_primary
                      | image_url: width: 1600
                      | image_tag:
                        class: 'pour-product__image pour-product__image--primary',
                        loading: 'lazy',
                        alt: featured_product.title
                    }}

                  {% elsif featured_product.featured_image != blank %}

                    {{
                      featured_product.featured_image
                      | image_url: width: 1600
                      | image_tag:
                        class: 'pour-product__image pour-product__image--primary',
                        loading: 'lazy',
                        alt: featured_product.title
                    }}

                  {% endif %}


                  <!-- IMAGE AU SURVOL -->

                  {% if block.settings.image_secondary != blank %}

                    {{
                      block.settings.image_secondary
                      | image_url: width: 1600
                      | image_tag:
                        class: 'pour-product__image pour-product__image--secondary',
                        loading: 'lazy',
                        alt: featured_product.title
                    }}

                  {% elsif featured_product.images.size > 1 %}

                    {{
                      featured_product.images[1]
                      | image_url: width: 1600
                      | image_tag:
                        class: 'pour-product__image pour-product__image--secondary',
                        loading: 'lazy',
                        alt: featured_product.title
                    }}

                  {% endif %}

                </a>


                <!-- =========================================
                     QUICK ADD +
                ========================================== -->

                <button
  type="button"
  class="pour-product__quick-add"
  data-quick-add
  data-product-handle="{{ featured_product.handle }}"
  aria-label="{{ 'pour_products.choose_size' | t }} - {{ featured_product.title }}"
>
  {{ 'pour_products.choose_size' | t }}
</button>

              </div>


              <!-- =========================================
                   INFORMATIONS PRODUIT
              ========================================== -->

             <a
  href="{{ featured_product.url }}"
  class="pour-product__info-link"
>

  <div class="pour-product__info">

    <div class="pour-product__info-row">

      <h3 class="pour-product__title">
        {{ featured_product.title }}
      </h3>

    <div class="pour-product__price">
  <span class="pour-product__price-current">
    {{ featured_product.price | money }}
  </span>

  {% if featured_product.compare_at_price > featured_product.price %}
    <span class="pour-product__price-compare">
      {{ featured_product.compare_at_price | money }}
    </span>
  {% endif %}
</div>

    </div>

    {% if featured_product.metafields.custom.color_name.value != blank %}
      <p class="pour-product__color-name">
        {{ featured_product.metafields.custom.color_name.value }}
      </p>
    {% endif %}

    <div class="pour-product__color-swatches">

  {% assign current_color = featured_product.metafields.custom.couleur.value %}

  {% if current_color != blank %}
    <span
      class="pour-product__color-swatch is-current"
      style="background-color: {{ current_color }};"
      aria-label="{{ featured_product.metafields.custom.color_name.value }}"
    ></span>
  {% endif %}

  {% if block.settings.show_second_color %}
    <span
      class="pour-product__color-swatch"
      style="background-color: {{ block.settings.second_color }};"
      aria-label="Deuxième coloris"
    ></span>
  {% endif %}

</div>

  </div>

</a>

            </article>

          {% endif %}

        {% endfor %}

      </div>


      <!-- FLÈCHE DROITE -->

      <button
        type="button"
        class="pour-products__arrow pour-products__arrow--next"
        data-pour-products-next
        aria-label="{{ 'pour_products.next' | t }}"
      >
        ›
      </button>

       </div>

    <!-- BOUTON ACHETER -->

    <div class="pour-products__cta">
      <a
        href="{{ pages['boutique'].url }}"
        class="pour-hero__submit"
      >
       <span class="pour-hero__submit-text">
  {{ 'collection_001.discover_collection' | t }}
</span>
      </a>
    </div>

  </div>

</section>


<style>

/* =========================================================
   HOVER IMAGE
========================================================= */

#PourProducts-{{ section.id }} .pour-product__media {
  position: relative;
  overflow: hidden;
}

#PourProducts-{{ section.id }} .pour-product__media-link {
  position: relative;
  display: block;
  width: 100%;
}

#PourProducts-{{ section.id }} .pour-product__image--primary {
  position: relative;
  z-index: 1;

  display: block;

  width: 100%;
  height: auto;

  opacity: 1;
}

#PourProducts-{{ section.id }} .pour-product__image--secondary {
  position: absolute;
  inset: 0;

  z-index: 2;

  display: block;

  width: 100%;
  height: 100%;

  object-fit: cover;
  object-position: center;

  opacity: 0;

  pointer-events: none;

  transition:
    opacity .25s cubic-bezier(.22,1,.36,1);
}

#PourProducts-{{ section.id }}
.pour-product__media:hover
.pour-product__image--secondary {
  opacity: 1;
}


/* =========================================================
   QUICK ADD +
========================================================= */

#PourProducts-{{ section.id }}
.pour-product__quick-add {
  position: absolute;

  right: 8px;
  bottom: 8px;

  z-index: 30;

  width: 28px;
  height: 28px;

  min-width: 28px;
  min-height: 28px;

  padding: 0;
  margin: 0;

  border: 0;
  border-radius: 0;

  background: #ffffff;

  cursor: pointer;

  opacity: 0;
  visibility: hidden;

  transform: translateY(3px);

  transition:
    opacity .18s ease,
    visibility .18s ease,
    transform .25s cubic-bezier(.22,1,.36,1);

  appearance: none;
  -webkit-appearance: none;
}


/* trait horizontal */


/* apparition seulement au hover */

#PourProducts-{{ section.id }}
.pour-product__media:hover
.pour-product__quick-add {
  opacity: 1;
  visibility: visible;

  transform: translateY(0);
}


/* =========================================================
   LIENS INFOS
========================================================= */
#PourProducts-{{ section.id }} .pour-product__info-link {
  display: block;
  color: inherit;
  text-decoration: none;
}
/* =========================================================
   PASTILLES COULEUR — ESPACE ET CONTOURS
========================================================= */
#PourProducts-{{ section.id }} .pour-product__info {
  padding-bottom: 8px;
  overflow: visible;
}
#PourProducts-{{ section.id }} .pour-product__color-swatches {
  display: flex;
  align-items: center;
  gap: 8px;
  padding-bottom: 4px;
  overflow: visible;
}
#PourProducts-{{ section.id }} .pour-product__color-swatch {
  flex-shrink: 0;
  border: 1px solid #D9D9D9;
}
/* Pastille noire : contour noir */
#PourProducts-{{ section.id }} .pour-product__color-swatch[style*="#000000"],
#PourProducts-{{ section.id }} .pour-product__color-swatch[style*="#000"] {
  border-color: #000000;
}

/* BOUTON ACHETER SOUS LES PRODUITS */

#PourProducts-{{ section.id }} .pour-products__cta {
  display: flex;
  justify-content: center;
  align-items: center;

  width: 100%;

  margin-top: 35px;
}
/* BOUTON ACHETER — NOIR FIXE */

/* BOUTON — TRANSITION DOUCE */

#PourProducts-{{ section.id }} .pour-products__cta .pour-hero__submit {
  background: #111111;
  color: #ffffff;
  border: 1px solid #111111;
  transition:
    background-color 0.45s ease,
    color 0.45s ease,
    border-color 0.45s ease,
    box-shadow 0.45s ease;
}

#PourProducts-{{ section.id }} .pour-products__cta .pour-hero__submit:hover {
  background: #ffffff;
  color: #111111;
  border-color: #111111;
  box-shadow: 0 0 8px rgba(255, 255, 255, 0.35);
}

/* QUICK ADD — CHOISIR MA TAILLE */

#PourProducts-{{ section.id }} .pour-product__quick-add {
  position: absolute !important;
  right: 8px !important;
  bottom: 8px !important;
  z-index: 30 !important;

  display: flex !important;
  align-items: center !important;
  justify-content: center !important;

  width: max-content !important;
  min-width: 112px !important;
  max-width: none !important;
  height: 32px !important;
  min-height: 32px !important;

  padding: 0 10px !important;
  margin: 0 !important;

  background: #ffffff !important;
  color: #111111 !important;
  border: none !important;
  border-radius: 0 !important;

  font-family: "Helvetica Neue", Helvetica, Arial, sans-serif !important;
  font-size: 8px !important;
  font-weight: 400 !important;
  letter-spacing: 0.05em !important;
  line-height: 1 !important;

  white-space: nowrap !important;
  overflow: visible !important;
  text-align: center !important;

  cursor: pointer;
  appearance: none !important;
  -webkit-appearance: none !important;
}

/* Suppression définitive du + */

#PourProducts-{{ section.id }} .pour-product__quick-add::before,
#PourProducts-{{ section.id }} .pour-product__quick-add::after {
  content: none !important;
  display: none !important;
}
#PourProducts-{{ section.id }} .pour-product__price-current {
  color: #111111;
}
/* PRIX BARRÉ */

#PourProducts-{{ section.id }} .pour-product__price {
  display: flex;
  align-items: baseline;
  gap: 7px;
}

#PourProducts-{{ section.id }} .pour-product__price-compare {
  font-size: 11px;
  font-weight: 400;
  color: #999999;
  text-decoration: line-through;
}

/* =========================================================
   FILTRES COLLECTION 001
========================================================= */

#PourProducts-{{ section.id }} .pour-products__filters {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 10px;
  width: 100%;
  margin: 25px 0 30px;
}

#PourProducts-{{ section.id }} .pour-products__filter {
  appearance: none;
  -webkit-appearance: none;
  border: 1px solid #D9D9D9;
  border-radius: 0;
  background: #FFFFFF;
  color: #111111;
  padding: 10px 17px;
  font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
  font-size: 10px;
  font-weight: 400;
  letter-spacing: 0.12em;
  line-height: 1;
  cursor: pointer;
  transition:
    background-color 0.25s ease,
    color 0.25s ease,
    border-color 0.25s ease;
}

#PourProducts-{{ section.id }} .pour-products__filter.is-active {
  background: #000000;
  color: #FFFFFF;
  border-color: #000000;
}

#PourProducts-{{ section.id }} .pour-product.is-filtered-out {
  display: none !important;
}

/* MOBILE */

@media screen and (max-width: 768px) {
  #PourProducts-{{ section.id }} .pour-products__filters {
    gap: 6px;
    margin: 20px 0 22px;
    padding: 0 8px;
    box-sizing: border-box;
  }

  #PourProducts-{{ section.id }} .pour-products__filter {
    padding: 9px 10px;
    font-size: 8px;
    letter-spacing: 0.07em;
  }
}
/* BADGE NOUVEAUTÉ */
#PourProducts-{{ section.id }} .pour-product__badge {
  position: absolute;
  top: 10px;
  right: 10px;
  z-index: 10;

  padding: 6px 8px;

  background: #D9D9D9;
  color: #FFFFFF;

  font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
  font-size: 8px;
  font-weight: 400;
  letter-spacing: 0.10em;
  line-height: 1;

  white-space: nowrap;
  pointer-events: none;
}
</style>


<script>
document.addEventListener('DOMContentLoaded', function () {
  const section = document.querySelector(
    '#PourProducts-{{ section.id }}'
  );

  if (!section || section.dataset.filtersInitialized === 'true') return;

  section.dataset.filtersInitialized = 'true';

  const buttons = section.querySelectorAll(
    '[data-pour-products-filters] [data-filter]'
  );

  const products = section.querySelectorAll(
    '.pour-products__grid .pour-product'
  );

  const track = section.querySelector('[data-pour-products-track]');

  buttons.forEach(function (button) {
    button.addEventListener('click', function () {
      const selectedCategory = button.dataset.filter;

      buttons.forEach(function (item) {
        const isActive = item === button;

        item.classList.toggle('is-active', isActive);
        item.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      });

      products.forEach(function (product) {
const productCategories = product.dataset.categories
  .split(',')
  .filter(Boolean);

const shouldDisplay =
  selectedCategory === 'all' ||
  productCategories.includes(selectedCategory);
        product.classList.toggle(
          'is-filtered-out',
          !shouldDisplay
        );
      });

      if (track) {
        track.scrollLeft = 0;
        track.dispatchEvent(new Event('scroll', { bubbles: true }));
      }
    });
  });
});
</script>


