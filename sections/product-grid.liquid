<section
  id="PourProducts-{{ section.id }}"
  class="pour-products"
>

  <div class="pour-products__inner">

    <!-- =========================
         TITRES
    ========================== -->

    <div class="pour-products__header">

      {% if section.settings.subtitle != blank %}
        <p class="pour-products__eyebrow">
          {{ section.settings.subtitle }}
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="pour-products__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

    </div>


    <!-- =========================
         CARROUSEL PRODUITS
    ========================== -->

    <div
      class="pour-products__carousel"
      data-pour-products-carousel
    >

      <!-- FLÈCHE GAUCHE -->

      <button
        type="button"
        class="pour-products__arrow pour-products__arrow--prev"
        data-pour-products-prev
        aria-label="{{ 'pour_products.previous' | t }}"
      >
        ‹
      </button>


      <!-- =========================
           TRACK PRODUITS
      ========================== -->

      <div
        class="pour-products__grid"
        data-pour-products-track
      >

        {% for block in section.blocks %}

          {% assign featured_product = block.settings.product %}

          {% if featured_product != blank %}

            <article
              class="pour-product"
              {{ block.shopify_attributes }}
            >

              <!-- =========================================
                   ZONE IMAGE
              ========================================== -->

              <div class="pour-product__media">


                <a
                  href="{{ featured_product.url }}"
                  class="pour-product__media-link"
                  aria-label="{{ featured_product.title }}"
                >

                  <!-- IMAGE PRINCIPALE -->

                  {% if block.settings.image_primary != blank %}

                    {{
                      block.settings.image_primary
                      | image_url: width: 1400
                      | image_tag:
                        class: 'pour-product__image pour-product__image--primary',
                        loading: 'lazy',
                        alt: featured_product.title
                    }}

                  {% elsif featured_product.featured_image != blank %}

                    {{
                      featured_product.featured_image
                      | image_url: width: 1400
                      | image_tag:
                        class: 'pour-product__image pour-product__image--primary',
                        loading: 'lazy',
                        alt: featured_product.title
                    }}

                  {% endif %}


                  <!-- IMAGE AU SURVOL -->

                  {% if block.settings.image_secondary != blank %}

                    {{
                      block.settings.image_secondary
                      | image_url: width: 1400
                      | image_tag:
                        class: 'pour-product__image pour-product__image--secondary',
                        loading: 'lazy',
                        alt: featured_product.title
                    }}

                  {% elsif featured_product.images.size > 1 %}

                    {{
                      featured_product.images[1]
                      | image_url: width: 1400
                      | image_tag:
                        class: 'pour-product__image pour-product__image--secondary',
                        loading: 'lazy',
                        alt: featured_product.title
                    }}

                  {% endif %}

                </a>


                <!-- =========================================
                     QUICK ADD +
                ========================================== -->

                <button
                  type="button"
                  class="pour-product__quick-add"
                 data-quick-add
                  data-product-handle="{{ featured_product.handle }}"
                  aria-label="{{ 'pour_products.quick_add_aria' | t }} {{ featured_product.title }}"
                ></button>

              </div>


              <!-- =========================================
                   INFORMATIONS PRODUIT
              ========================================== -->

             <a
  href="{{ featured_product.url }}"
  class="pour-product__info-link"
>

  <div class="pour-product__info">

    <div class="pour-product__info-row">

      <h3 class="pour-product__title">
        {{ featured_product.title }}
      </h3>

      <div class="pour-product__price">
        {{ featured_product.price | money }}
      </div>

    </div>

    {% if featured_product.metafields.custom.color_name.value != blank %}
      <p class="pour-product__color-name">
        {{ featured_product.metafields.custom.color_name.value }}
      </p>
    {% endif %}

    <div class="pour-product__color-swatches">

      {% assign current_color = featured_product.metafields.custom.couleur.value %}

      {% if current_color != blank %}
        <span
          class="pour-product__color-swatch is-current"
          style="background-color: {{ current_color }};"
          aria-label="{{ featured_product.metafields.custom.color_name.value }}"
        ></span>
      {% endif %}

      {% assign color_products = featured_product.metafields.custom.couleurs.value %}

      {% if color_products != blank %}
        {% for color_product in color_products %}

          {% assign color_value = color_product.metafields.custom.couleur.value %}

          {% if color_value != blank %}
            <a
              href="{{ color_product.url }}"
              class="pour-product__color-swatch"
              style="background-color: {{ color_value }};"
              aria-label="{{ color_product.metafields.custom.color_name.value }}"
            ></a>
          {% endif %}

        {% endfor %}
      {% endif %}

    </div>

  </div>

</a>

            </article>

          {% endif %}

        {% endfor %}

      </div>


      <!-- FLÈCHE DROITE -->

      <button
        type="button"
        class="pour-products__arrow pour-products__arrow--next"
        data-pour-products-next
        aria-label="{{ 'pour_products.next' | t }}"
      >
        ›
      </button>

    </div>

  </div>



</section>


<style>

/* =========================================================
   HOVER IMAGE
========================================================= */

#PourProducts-{{ section.id }} .pour-product__media {
  position: relative;
  overflow: hidden;
}

#PourProducts-{{ section.id }} .pour-product__media-link {
  position: relative;
  display: block;
  width: 100%;
}

#PourProducts-{{ section.id }} .pour-product__image--primary {
  position: relative;
  z-index: 1;

  display: block;

  width: 100%;
  height: auto;

  opacity: 1;
}

#PourProducts-{{ section.id }} .pour-product__image--secondary {
  position: absolute;
  inset: 0;

  z-index: 2;

  display: block;

  width: 100%;
  height: 100%;

  object-fit: cover;
  object-position: center;

  opacity: 0;

  pointer-events: none;

  transition:
    opacity .25s cubic-bezier(.22,1,.36,1);
}

#PourProducts-{{ section.id }}
.pour-product__media:hover
.pour-product__image--secondary {
  opacity: 1;
}


/* =========================================================
   QUICK ADD +
========================================================= */

#PourProducts-{{ section.id }}
.pour-product__quick-add {
  position: absolute;

  right: 8px;
  bottom: 8px;

  z-index: 30;

  width: 28px;
  height: 28px;

  min-width: 28px;
  min-height: 28px;

  padding: 0;
  margin: 0;

  border: 0;
  border-radius: 0;

  background: #ffffff;

  cursor: pointer;

  opacity: 0;
  visibility: hidden;

  transform: translateY(3px);

  transition:
    opacity .18s ease,
    visibility .18s ease,
    transform .25s cubic-bezier(.22,1,.36,1);

  appearance: none;
  -webkit-appearance: none;
}


/* trait horizontal */

#PourProducts-{{ section.id }}
.pour-product__quick-add::before {
  content: "";

  position: absolute;

  top: 50%;
  left: 50%;

  width: 10px;
  height: 1px;

  background: #111111;

  transform:
    translate(-50%, -50%);
}


/* trait vertical */

#PourProducts-{{ section.id }}
.pour-product__quick-add::after {
  content: "";

  position: absolute;

  top: 50%;
  left: 50%;

  width: 1px;
  height: 10px;

  background: #111111;

  transform:
    translate(-50%, -50%);
}


/* apparition seulement au hover */

#PourProducts-{{ section.id }}
.pour-product__media:hover
.pour-product__quick-add {
  opacity: 1;
  visibility: visible;

  transform: translateY(0);
}


/* =========================================================
   LIENS INFOS
========================================================= */

#PourProducts-{{ section.id }}
.pour-product__info-link {
  display: block;

  color: inherit;
  text-decoration: none;
}



</style>



{% schema %}
{
  "name": "Produits POUR",

  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Petit titre",
      "default": "PORSCHE AUTOMOBILE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "COLLECTION 001"
    }
  ],

  "blocks": [
    {
      "type": "product_card",
      "name": "Produit",

      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Produit Shopify"
        },
        {
          "type": "image_picker",
          "id": "image_primary",
          "label": "Image principale personnalisée"
        },
        {
          "type": "image_picker",
          "id": "image_secondary",
          "label": "Image au survol personnalisée"
        }
      ]
    }
  ],

  "max_blocks": 8,

  "presets": [
    {
      "name": "Produits POUR",

      "blocks": [
        {
          "type": "product_card"
        },
        {
          "type": "product_card"
        },
        {
          "type": "product_card"
        },
        {
          "type": "product_card"
        },
        {
          "type": "product_card"
        },
        {
          "type": "product_card"
        },
        {
          "type": "product_card"
        },
        {
          "type": "product_card"
        }
      ]
    }
  ]
}
{% endschema %}
