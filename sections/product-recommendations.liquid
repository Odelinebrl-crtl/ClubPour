<div
  class="product-page-pour__style-with"
  data-product-recommendations
>

  {% if recommendations.performed? and recommendations.products_count > 0 %}

    <div class="product-page-pour__style-with-heading">
      TU AIMERAIS PEUT-ÊTRE AUSSI
    </div>

    <div class="product-page-pour__style-with-grid">

      {% for style_product in recommendations.products limit: 4 %}

        <article class="product-page-pour__style-with-card">

          <div class="product-page-pour__style-with-media">

            <a
              href="{{ style_product.url }}"
              class="product-page-pour__style-with-media-link"
              aria-label="{{ style_product.title }}"
            >

              {% if style_product.featured_image != blank %}

                {{
                  style_product.featured_image
                  | image_url: width: 1800
                  | image_tag:
                    class: 'product-page-pour__style-with-image product-page-pour__style-with-image--primary',
                    loading: 'lazy',
                    alt: style_product.title
                }}

              {% endif %}

              {% if style_product.images.size > 1 %}

                {{
                  style_product.images[1]
                  | image_url: width: 1800
                  | image_tag:
                    class: 'product-page-pour__style-with-image product-page-pour__style-with-image--hover',
                    loading: 'lazy',
                    alt: style_product.title
                }}

              {% endif %}

            </a>

            <!-- QUICK ADD + -->

            <button
              type="button"
              class="product-page-pour__style-with-quick-add"
              data-quick-add
              data-product-handle="{{ style_product.handle }}"
              aria-label="Ajouter rapidement {{ style_product.title }}"
            ></button>

          </div>

          <a
            href="{{ style_product.url }}"
            class="product-page-pour__style-with-info"
          >

            <div class="product-page-pour__style-with-details">

              <div class="product-page-pour__style-with-info-row">

                <div class="product-page-pour__style-with-title">
                  {{ style_product.title }}
                </div>

                <div class="product-page-pour__style-with-price">
                  {{ style_product.price | money }}
                </div>

              </div>

              <div class="product-page-pour__style-with-color-name">
                {{ style_product.metafields.custom.color_name.value }}
              </div>

              <div class="product-page-pour__style-with-swatches">

                {% assign current_color =
                  style_product.metafields.custom.couleur.value
                %}

                {% if current_color != blank %}

                  <span
                    class="product-page-pour__style-with-swatch"
                    style="background-color: {{ current_color }};"
                    aria-label="{{ style_product.metafields.custom.color_name.value }}"
                  ></span>

                {% endif %}

                {% assign color_products =
                  style_product.metafields.custom.couleurs.value
                %}

                {% if color_products != blank %}

                  {% for color_product in color_products %}

                    {% assign color_value =
                      color_product.metafields.custom.couleur.value
                    %}

                    {% if color_value != blank %}

                      <span
                        class="product-page-pour__style-with-swatch"
                        style="background-color: {{ color_value }};"
                        aria-label="{{ color_product.metafields.custom.color_name.value }}"
                      ></span>

                    {% endif %}

                  {% endfor %}

                {% endif %}

              </div>

            </div>

          </a>

        </article>

      {% endfor %}

    </div>

  {% endif %}

</div>
