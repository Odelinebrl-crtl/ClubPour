{
  "name": "Produit POUR",

  "settings": [

    {
      "type": "textarea",
      "id": "composition",
      "label": "Texte composition",
      "default": "100 % coton biologique. Coupe premium. Matière épaisse et confortable."
    },

    {
      "type": "textarea",
      "id": "care",
      "label": "Texte entretien",
      "default": "Lavage à 30°C sur l’envers. Ne pas sécher en machine. Repassage doux."
    },


    {
      "type": "header",
      "content": "Voir aussi — Produit 01"
    },

    {
      "type": "product",
      "id": "related_product_1",
      "label": "Produit 01"
    },

    {
      "type": "image_picker",
      "id": "related_image_1",
      "label": "Image personnalisée 01"
    },


    {
      "type": "header",
      "content": "Voir aussi — Produit 02"
    },

    {
      "type": "product",
      "id": "related_product_2",
      "label": "Produit 02"
    },

    {
      "type": "image_picker",
      "id": "related_image_2",
      "label": "Image personnalisée 02"
    },


    {
      "type": "header",
      "content": "Voir aussi — Produit 03"
    },

    {
      "type": "product",
      "id": "related_product_3",
      "label": "Produit 03"
    },

    {
      "type": "image_picker",
      "id": "related_image_3",
      "label": "Image personnalisée 03"
    },


    {
      "type": "header",
      "content": "Voir aussi — Produit 04"
    },

    {
      "type": "product",
      "id": "related_product_4",
      "label": "Produit 04"
    },

    {
      "type": "image_picker",
      "id": "related_image_4",
      "label": "Image personnalisée 04"
    },


    {
      "type": "header",
      "content": "Voir aussi — Produit 05"
    },

    {
      "type": "product",
      "id": "related_product_5",
      "label": "Produit 05"
    },

    {
      "type": "image_picker",
      "id": "related_image_5",
      "label": "Image personnalisée 05"
    }

  ]
}
{% endschema %}
