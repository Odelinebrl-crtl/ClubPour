  overflow-x: auto;
}

.pour-size-guide__table {
  width: 100%;

  border-collapse: collapse;

  font-size: 11px;
}

.pour-size-guide__table th,
.pour-size-guide__table td {
  padding: 17px 10px;

  border-bottom: 1px solid #e5e5e5;

  text-align: center;

  font-weight: 400;
}

.pour-size-guide__table tbody th {
  padding-left: 0;

  text-align: left;

  font-size: 10px;

  letter-spacing: .05em;
}

/* =========================================================
   GUIDE DES TAILLES — SÉLECTION
========================================================= */

.pour-size-guide__size-column {
  padding: 0 !important;
}

.pour-size-guide__size-button {
  display: flex;
  align-items: center;
  justify-content: center;

  width: 100%;
  min-width: 55px;
  height: 52px;

  padding: 0 10px;

  border: 0;

  background: transparent;
  color: #111111;

  font-family:
    "Helvetica Neue",
    Helvetica,
    Arial,
    sans-serif;

  font-size: 11px;
  font-weight: 400;

  cursor: pointer;

  transition:
    background .2s ease;
}

.pour-size-guide__size-button:hover {
