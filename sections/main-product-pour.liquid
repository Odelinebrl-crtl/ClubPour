    width: 100%;
  }

  .pour-size-guide__header {
    padding: 25px 20px;
  }

  .pour-size-guide__body {
    padding: 35px 20px 50px;
  }

  .pour-size-guide__table th,
  .pour-size-guide__table td {
    padding:
      15px
      8px;
  }

}
/* =========================================================
   VOIR AUSSI — FLÈCHES DESKTOP
========================================================= */

.product-page-pour__related-carousel {
  position: relative;
}

.product-page-pour__related-arrow {
  display: none;
}

@media screen and (min-width: 769px) {

  .product-page-pour__related-carousel.has-five-products
  .product-page-pour__related-arrow {
    position: absolute;
    top: 50%;
    z-index: 10;

    display: flex;
    align-items: center;
    justify-content: center;

    width: 44px;
height: 44px;

    padding: 0;

    border: 1px solid rgba(17, 17, 17, 0.10);
    border-radius: 50%;

    background: rgba(255, 255, 255, 0.96);
    color: #111111;

    font-size: 20px;
    font-weight: 300;
    line-height: 1;

    cursor: pointer;

    transform: translateY(-50%);

    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.06);

    transition:
      background .25s ease,
      transform .25s ease,
      box-shadow .25s ease;
  }

  .product-page-pour__related-arrow--prev {
  left: -21px;
}

.product-page-pour__related-arrow--next {
  right: -21px;
}

  .product-page-pour__related-arrow:hover {
    background: #ffffff;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.10);
  }
.product-page-pour__related-arrow:disabled {
  opacity: 0.28;
  cursor: default;
  pointer-events: none;
  box-shadow: none;
}
}
</style>
<script>
(function () {

  const carousel =
    document.querySelector(
      '.product-page-pour__related-carousel'
    );

  if (!carousel) return;


  const grid =
    carousel.querySelector(
      '[data-related-grid]'
    );

  const prev =
    carousel.querySelector(
      '[data-related-prev]'
    );

  const next =
    carousel.querySelector(
      '[data-related-next]'
    );


  if (!grid || !prev || !next) return;


  const cards =
    grid.querySelectorAll(
      '.product-page-pour__related-card'
    );


  /* =========================================================
     FLÈCHES UNIQUEMENT S'IL Y A 5 PRODUITS
  ========================================================= */

  if (cards.length === 5) {

    carousel.classList.add(
      'has-five-products'
    );

  }


  /* =========================================================
     ÉTAT DES FLÈCHES

     Début = gauche transparente
     Fin   = droite transparente
  ========================================================= */

  function updateArrows() {

    const maxScroll =
      grid.scrollWidth - grid.clientWidth;

    const currentScroll =
      grid.scrollLeft;


    prev.disabled =
      currentScroll <= 2;


    next.disabled =
      currentScroll >= maxScroll - 2;

  }


  /* =========================================================
     FLÈCHE DROITE
  ========================================================= */

  next.addEventListener(
    'click',
    function () {

      const card =
        grid.querySelector(
          '.product-page-pour__related-card'
        );

      if (!card) return;


      grid.scrollBy({
        left:
          card.getBoundingClientRect().width + 28,

        behavior: 'smooth'
      });

    }
  );


  /* =========================================================
     FLÈCHE GAUCHE
  ========================================================= */

  prev.addEventListener(
    'click',
    function () {

      const card =
        grid.querySelector(
          '.product-page-pour__related-card'
        );

      if (!card) return;


      grid.scrollBy({
        left:
          -(card.getBoundingClientRect().width + 28),

        behavior: 'smooth'
      });

    }
  );


  /* =========================================================
     MISE À JOUR AUTOMATIQUE DES FLÈCHES
  ========================================================= */

  grid.addEventListener(
    'scroll',
    updateArrows,
    { passive: true }
  );


  window.addEventListener(
    'resize',
    updateArrows
  );


  /* État initial */
  updateArrows();


})();
</script>
<script>
(function () {

  const guide =
  document.querySelector(
    '[data-pour-size-guide]'
  );

const openButton =
  document.querySelector(
    '[data-pour-size-guide-open]'
  );

if (!guide || !openButton) {
  return;
}

const productForm =
  document.querySelector(
    '.product-page-pour__form'
  );

const addButton =
  guide.querySelector(
    '[data-size-guide-add]'
  );

const addButtonText =
  guide.querySelector(
    '[data-size-guide-add-text]'
  );

const variants =
  {{ product.variants | json }};

  function openSizeGuide() {

    guide.classList.add(
      'is-active'
    );

    guide.setAttribute(
      'aria-hidden',
      'false'
    );

  }


  function closeSizeGuide() {

    guide.classList.remove(
      'is-active'
    );

    guide.setAttribute(
      'aria-hidden',
      'true'
    );

  }

/* =========================================================
   SÉLECTION D'UNE TAILLE
========================================================= */

guide.addEventListener(
  'click',
  function (event) {

    const sizeButton =
      event.target.closest(
        '[data-size-guide-size]'
      );

    if (!sizeButton) {
      return;
    }


    const selectedSize =
      sizeButton.dataset.size;

    const selectedIndex =
      sizeButton.dataset.sizeIndex;


    /* =========================================
       SURBRILLANCE DE LA COLONNE
    ========================================= */

    guide
      .querySelectorAll(
        '[data-size-guide-column]'
      )
      .forEach(
        function (element) {

          element.classList.toggle(
            'is-selected',
            element.dataset.sizeGuideColumn ===
              selectedIndex
          );

        }
      );


    guide
      .querySelectorAll(
        '[data-size-guide-size]'
      )
      .forEach(
        function (button) {

          button.classList.toggle(
            'is-selected',
            button === sizeButton
          );

        }
      );


    /* =========================================
       SYNCHRONISE AVEC LE VRAI FORMULAIRE
    ========================================= */

    if (!productForm) {
      return;
    }


    const optionInputs =
      Array.from(
        productForm.querySelectorAll(
          'input[name^="options["]'
        )
      );


    let sizeInput =
      optionInputs.find(
        function (input) {

          const name =
            input.name.toLowerCase();

          return (
            input.value === selectedSize &&
            (
              name.includes('taille') ||
              name.includes('size')
            )
          );

        }
      );


    /*
     * Sécurité si Shopify utilise
     * un autre nom pour l'option.
     */
    if (!sizeInput) {

      sizeInput =
        optionInputs.find(
          function (input) {
            return input.value === selectedSize;
          }
        );

    }


    if (!sizeInput) {
      return;
    }


    sizeInput.checked = true;


    sizeInput.dispatchEvent(
      new Event(
        'change',
        {
          bubbles: true
        }
      )
    );


    /* =========================================
       RÉCUPÈRE LA VARIANTE APRÈS SYNCHRONISATION
    ========================================= */

    window.setTimeout(
      function () {

        const variantIdInput =
          productForm.querySelector(
            '[data-product-variant-id]'
          );


        if (!variantIdInput) {
          return;
        }


        const selectedVariant =
          variants.find(
            function (variant) {

              return String(variant.id) ===
                String(variantIdInput.value);

            }
          );


        if (
          !selectedVariant ||
          !selectedVariant.available
        ) {

          addButton.disabled = true;

          addButtonText.textContent =
            'TAILLE ÉPUISÉE';

          return;
        }


        addButton.disabled = false;


        const price =
          new Intl.NumberFormat(
            'fr-FR',
            {
              style: 'currency',
              currency: 'EUR'
            }
          ).format(
            selectedVariant.price / 100
          );


        addButtonText.textContent =
          'AJOUTER AU PANIER — ' + price;

      },
      0
    );

  }
);
/* =========================================================
   AJOUT AU PANIER DEPUIS LE GUIDE
========================================================= */

if (addButton && productForm) {

  addButton.addEventListener(
    'click',
    function () {

      if (addButton.disabled) {
        return;
      }

      const realSubmitButton =
        productForm.querySelector(
          '.product-page-pour__add'
        );

      if (!realSubmitButton) {
        return;
      }

      closeSizeGuide();

      productForm.requestSubmit(
        realSubmitButton
      );

    }
  );

}
  openButton.addEventListener(
    'click',
    openSizeGuide
  );


  guide.addEventListener(
    'click',
    function (event) {

      if (
        event.target.closest(
          '[data-pour-size-guide-close]'
        )
      ) {
        closeSizeGuide();
      }

    }
  );


  document.addEventListener(
    'keydown',
    function (event) {

      if (
        event.key === 'Escape' &&
        guide.classList.contains('is-active')
      ) {
        closeSizeGuide();
      }

    }
  );

})();
</script>
</section>
<script>
(function () {

  const productSection =
    document.querySelector(
      '.product-page-pour[data-product-page]'
    );

  if (!productSection) return;

  const form =
    productSection.querySelector(
      '.product-page-pour__form'
    );

  if (!form) return;

  const variantInput =
    form.querySelector(
      '[data-product-variant-id]'
    );

  const variants =
    {{ product.variants | json }};


  function updateVariant() {

    const selectedOptions =
      Array.from(
        form.querySelectorAll(
          'input[name^="options["]:checked'
        )
      ).map(
        input => input.value
      );


    const matchingVariant =
      variants.find(
        variant =>
          variant.options.every(
            (option, index) =>
              option === selectedOptions[index]
          )
      );


    if (!matchingVariant) {
      return;
    }


    variantInput.value =
      matchingVariant.id;


    const submitButton =
      form.querySelector(
        '.product-page-pour__add'
      );


    if (submitButton) {

      submitButton.disabled =
        !matchingVariant.available;

      submitButton.textContent =
        matchingVariant.available
          ? 'AJOUTER AU PANIER'
          : 'ÉPUISÉ';

    }

  }


  form.addEventListener(
    'change',
    function (event) {

      if (
        event.target.matches(
          'input[name^="options["]'
        )
      ) {
        updateVariant();
      }

    }
  );


  updateVariant();

})();
</script>

