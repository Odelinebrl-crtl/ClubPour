<script>
(function () {

  const carousel =
    document.querySelector(
      '.product-page-pour__related-carousel'
    );

  if (!carousel) return;


  const grid =
    carousel.querySelector(
      '[data-related-grid]'
    );

  const prev =
    carousel.querySelector(
      '[data-related-prev]'
    );

  const next =
    carousel.querySelector(
      '[data-related-next]'
    );


  if (!grid || !prev || !next) return;


  const cards =
    grid.querySelectorAll(
      '.product-page-pour__related-card'
    );


  /* =========================================================
     FLÈCHES UNIQUEMENT S'IL Y A 5 PRODUITS
  ========================================================= */

  if (cards.length === 5) {

    carousel.classList.add(
      'has-five-products'
    );

  }


  /* =========================================================
     ÉTAT DES FLÈCHES

     Début = gauche transparente
     Fin   = droite transparente
  ========================================================= */

  function updateArrows() {

    const maxScroll =
      grid.scrollWidth - grid.clientWidth;

    const currentScroll =
      grid.scrollLeft;


    prev.disabled =
      currentScroll <= 2;


    next.disabled =
      currentScroll >= maxScroll - 2;

  }


  /* =========================================================
     FLÈCHE DROITE
  ========================================================= */

  next.addEventListener(
    'click',
    function () {

      const card =
        grid.querySelector(
          '.product-page-pour__related-card'
        );

      if (!card) return;


      grid.scrollBy({
        left:
          card.getBoundingClientRect().width + 28,

        behavior: 'smooth'
      });

    }
  );


  /* =========================================================
     FLÈCHE GAUCHE
  ========================================================= */

  prev.addEventListener(
    'click',
    function () {

      const card =
        grid.querySelector(
          '.product-page-pour__related-card'
        );

      if (!card) return;


      grid.scrollBy({
        left:
          -(card.getBoundingClientRect().width + 28),

        behavior: 'smooth'
      });

    }
  );


  /* =========================================================
     MISE À JOUR AUTOMATIQUE DES FLÈCHES
  ========================================================= */

  grid.addEventListener(
    'scroll',
    updateArrows,
    { passive: true }
  );


  window.addEventListener(
    'resize',
    updateArrows
  );


  /* État initial */
  updateArrows();


})();
</script>
<script>
(function () {

  const guide =
  document.querySelector(
    '[data-pour-size-guide]'
  );

const openButton =
  document.querySelector(
    '[data-pour-size-guide-open]'
  );

if (!guide || !openButton) {
  return;
}

const productForm =
  document.querySelector(
    '.product-page-pour__form'
  );

const addButton =
  guide.querySelector(
    '[data-size-guide-add]'
  );

const addButtonText =
  guide.querySelector(
    '[data-size-guide-add-text]'
  );

const variants =
  {{ product.variants | json }};

  function openSizeGuide() {

    guide.classList.add(
      'is-active'
    );

    guide.setAttribute(
      'aria-hidden',
      'false'
    );

  }


  function closeSizeGuide() {

    guide.classList.remove(
      'is-active'
    );

    guide.setAttribute(
      'aria-hidden',
      'true'
    );

  }

/* =========================================================
   SÉLECTION D'UNE TAILLE
========================================================= */

guide.addEventListener(
  'click',
  function (event) {

    const sizeButton =
      event.target.closest(
        '[data-size-guide-size]'
      );

    if (!sizeButton) {
      return;
    }


    const selectedSize =
      sizeButton.dataset.size;

    const selectedIndex =
      sizeButton.dataset.sizeIndex;


    /* =========================================
       SURBRILLANCE DE LA COLONNE
    ========================================= */

    guide
      .querySelectorAll(
        '[data-size-guide-column]'
      )
      .forEach(
        function (element) {

          element.classList.toggle(
            'is-selected',
            element.dataset.sizeGuideColumn ===
              selectedIndex
          );

        }
      );


    guide
      .querySelectorAll(
        '[data-size-guide-size]'
      )
      .forEach(
        function (button) {

          button.classList.toggle(
            'is-selected',
            button === sizeButton
          );

        }
      );


    /* =========================================
       SYNCHRONISE AVEC LE VRAI FORMULAIRE
    ========================================= */

    if (!productForm) {
      return;
    }


    const optionInputs =
      Array.from(
        productForm.querySelectorAll(
          'input[name^="options["]'
        )
      );


    let sizeInput =
      optionInputs.find(
        function (input) {

          const name =
            input.name.toLowerCase();

          return (
            input.value === selectedSize &&
            (
              name.includes('taille') ||
              name.includes('size')
            )
          );

        }
      );


    /*
     * Sécurité si Shopify utilise
     * un autre nom pour l'option.
     */
    if (!sizeInput) {

      sizeInput =
        optionInputs.find(
          function (input) {
            return input.value === selectedSize;
          }
        );

    }


    if (!sizeInput) {
      return;
    }


    sizeInput.checked = true;


    sizeInput.dispatchEvent(
      new Event(
        'change',
        {
          bubbles: true
        }
      )
    );


    /* =========================================
       RÉCUPÈRE LA VARIANTE APRÈS SYNCHRONISATION
    ========================================= */

    window.setTimeout(
      function () {

        const variantIdInput =
          productForm.querySelector(
            '[data-product-variant-id]'
          );


        if (!variantIdInput) {
          return;
        }


        const selectedVariant =
          variants.find(
            function (variant) {

              return String(variant.id) ===
                String(variantIdInput.value);

            }
          );


        if (
          !selectedVariant ||
          !selectedVariant.available
        ) {

          addButton.disabled = true;

          addButtonText.textContent =
            'TAILLE ÉPUISÉE';

          return;
        }


        addButton.disabled = false;


        const price =
          new Intl.NumberFormat(
            'fr-FR',
            {
              style: 'currency',
              currency: 'EUR'
            }
          ).format(
            selectedVariant.price / 100
          );


        addButtonText.textContent =
          'PRÉCOMANDEZ — ' + price;

      },
      0
    );

  }
);
/* =========================================================
   AJOUT AU PANIER DEPUIS LE GUIDE
========================================================= */

if (addButton && productForm) {

  addButton.addEventListener(
    'click',
    function () {

      if (addButton.disabled) {
        return;
      }

      const realSubmitButton =
        productForm.querySelector(
          '.product-page-pour__add'
        );

      if (!realSubmitButton) {
        return;
      }

      closeSizeGuide();

      productForm.requestSubmit(
        realSubmitButton
      );

    }
  );

}
  openButton.addEventListener(
    'click',
    openSizeGuide
  );


  guide.addEventListener(
    'click',
    function (event) {

      if (
        event.target.closest(
          '[data-pour-size-guide-close]'
        )
      ) {
        closeSizeGuide();
      }

    }
  );


  document.addEventListener(
    'keydown',
    function (event) {

      if (
        event.key === 'Escape' &&
        guide.classList.contains('is-active')
      ) {
        closeSizeGuide();
      }

    }
  );

})();
</script>
</section>
<script>
(function () {

  const productSection =
    document.querySelector(
      '.product-page-pour[data-product-page]'
    );

  if (!productSection) return;

  const form =
    productSection.querySelector(
      '.product-page-pour__form'
    );

  if (!form) return;

  const variantInput =
    form.querySelector(
      '[data-product-variant-id]'
    );

  const variants =
    {{ product.variants | json }};


  function updateVariant() {

    const selectedOptions =
      Array.from(
        form.querySelectorAll(
          'input[name^="options["]:checked'
        )
      ).map(
        input => input.value
      );


    const matchingVariant =
      variants.find(
        variant =>
          variant.options.every(
            (option, index) =>
              option === selectedOptions[index]
          )
      );


    if (!matchingVariant) {
      return;
    }


    variantInput.value =
      matchingVariant.id;


    const submitButton =
      form.querySelector(
        '.product-page-pour__add'
      );


    if (submitButton) {

      submitButton.disabled =
        !matchingVariant.available;

      submitButton.textContent =
        matchingVariant.available
          ? 'PRÉCOMANDEZ'
          : 'ÉPUISÉ';

    }

  }


  form.addEventListener(
    'change',
    function (event) {

      if (
        event.target.matches(
          'input[name^="options["]'
        )
      ) {
        updateVariant();
      }

    }
  );


  updateVariant();

})();
</script>


<script>
(function () {

  const gallery = document.querySelector(
    '[data-mobile-product-gallery]'
  );

  const counter = document.querySelector(
    '[data-mobile-gallery-current]'
  );

  if (!gallery) return;

  const originalSlides = Array.from(
    gallery.querySelectorAll(
      '[data-mobile-product-slide]'
    )
  );

  if (originalSlides.length < 2) return;


  /*
   * =====================================================
   * CLONES
   * =====================================================
   */

  const firstClone =
    originalSlides[0].cloneNode(true);

  const lastClone =
    originalSlides[
      originalSlides.length - 1
    ].cloneNode(true);

  firstClone.dataset.carouselClone = 'first';
  lastClone.dataset.carouselClone = 'last';


  gallery.insertBefore(
    lastClone,
    originalSlides[0]
  );

  gallery.appendChild(
    firstClone
  );


  /*
   * =====================================================
   * TOUTES LES SLIDES
   * =====================================================
   */

  const allSlides = Array.from(
    gallery.querySelectorAll(
      '[data-mobile-product-slide]'
    )
  );


  /*
   * =====================================================
   * POSITION INITIALE
   * =====================================================
   */

  function goToPosition(position) {

    /*
     * On coupe temporairement le snap
     * pour que le repositionnement soit
     * absolument instantané.
     */

    gallery.style.scrollSnapType = 'none';
    gallery.style.scrollBehavior = 'auto';

    gallery.scrollLeft =
      position * gallery.clientWidth;

    /*
     * On force le navigateur à appliquer
     * immédiatement le changement.
     */

    void gallery.offsetWidth;

    /*
     * On remet le comportement normal
     * au frame suivant.
     */

    requestAnimationFrame(() => {

      gallery.style.scrollSnapType =
        'x mandatory';

      gallery.style.scrollBehavior =
        '';

    });

  }


  /*
   * On commence sur la vraie première image.
   *
   * [clone dernière] [1] [2] [3] [clone première]
   *                  ↑
   */

  requestAnimationFrame(() => {
    goToPosition(1);
  });


  /*
   * =====================================================
   * COMPTEUR
   * =====================================================
   */

  function updateCounter() {

    const width =
      gallery.clientWidth;

    if (!width) return;

    const position =
      Math.round(
        gallery.scrollLeft / width
      );

    let realIndex =
      position - 1;


    if (
      realIndex < 0
    ) {
      realIndex =
        originalSlides.length - 1;
    }


    if (
      realIndex >= originalSlides.length
    ) {
      realIndex = 0;
    }


    if (counter) {
      counter.textContent =
        String(realIndex + 1);
    }

  }


  /*
   * =====================================================
   * CARROUSEL INFINI
   * =====================================================
   */

  let ticking = false;

  function handleScroll() {

    if (ticking) return;

    ticking = true;


    requestAnimationFrame(() => {

      ticking = false;


      const width =
        gallery.clientWidth;

      if (!width) return;


      const position =
        Math.round(
          gallery.scrollLeft / width
        );


      /*
       * =================================================
       * CLONE PREMIÈRE IMAGE
       *
       * [dernière] [1] [2] [1 clone]
       *                         ↑
       *
       * → retour IMMÉDIAT sur la vraie 1
       * =================================================
       */

      if (
        position ===
        allSlides.length - 1
      ) {

        goToPosition(1);

        updateCounter();

        return;
      }


      /*
       * =================================================
       * CLONE DERNIÈRE IMAGE
       *
       * [clone dernière] [1] [2] [dernière]
       *        ↑
       *
       * → retour IMMÉDIAT sur la vraie dernière
       * =================================================
       */

      if (
        position === 0
      ) {

        goToPosition(
          originalSlides.length
        );

        updateCounter();

        return;
      }


      updateCounter();

    });

  }


  gallery.addEventListener(
    'scroll',
    handleScroll,
    {
      passive: true
    }
  );


  /*
   * =====================================================
   * COMPTEUR INITIAL
   * =====================================================
   */

  updateCounter();


  /*
   * =====================================================
   * RESIZE
   * =====================================================
   */

  window.addEventListener(
    'resize',
    () => {

      const width =
        gallery.clientWidth;

      if (!width) return;

      const position =
        Math.round(
          gallery.scrollLeft / width
        );

      gallery.style.scrollSnapType =
        'none';

      gallery.scrollLeft =
        position * width;

      requestAnimationFrame(() => {

        gallery.style.scrollSnapType =
          'x mandatory';

      });

    }
  );


})();
</script>

