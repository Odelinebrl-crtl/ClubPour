<section class="product-page-pour" data-product-page>

 <div class="product-page-pour__breadcrumb">

  <a
    href="/pages/boutique?view=vetements"
    class="product-page-pour__breadcrumb-link"
  >
    BOUTIQUE
  </a>

  <span class="product-page-pour__breadcrumb-separator">
    /
  </span>

  <a
    href="/pages/collection-001?view=collection-001"
    class="product-page-pour__breadcrumb-link"
  >
    COLLECTION 001
  </a>

  <span class="product-page-pour__breadcrumb-separator">
    /
  </span>

  <span class="product-page-pour__breadcrumb-current">
    {{ product.title }}
  </span>

</div>


  <div class="product-page-pour__top">

    <!-- GALERIE -->
    <div class="product-page-pour__gallery">

      {% if product.images.size > 0 %}

        <div class="product-page-pour__main-media">
          <img
            src="{{ product.featured_image | image_url: width: 1800 }}"
            alt="{{ product.featured_image.alt | escape }}"
            class="product-page-pour__main-image"
            data-main-product-image
            width="{{ product.featured_image.width }}"
            height="{{ product.featured_image.height }}"
          >
        </div>

        {% if product.images.size > 1 %}
          <div class="product-page-pour__thumbs">

            {% for image in product.images %}
              <button
                type="button"
                class="product-page-pour__thumb{% if forloop.first %} is-active{% endif %}"
                data-product-thumb
                data-image="{{ image | image_url: width: 1800 }}"
                aria-label="Voir l'image {{ forloop.index }}"
              >
                <img
                  src="{{ image | image_url: width: 400 }}"
                  alt="{{ image.alt | escape }}"
                  loading="lazy"
                  width="{{ image.width }}"
                  height="{{ image.height }}"
                >
              </button>
            {% endfor %}

          </div>
        {% endif %}

      {% endif %}

    </div>

    <!-- INFOS PRODUIT -->
    <div class="product-page-pour__info">

      <div class="product-page-pour__info-inner">

        <h1 class="product-page-pour__title">
          {{ product.title }}
        </h1>

        {% if product.metafields.custom.subtitle != blank %}
          <p class="product-page-pour__subtitle">
            {{ product.metafields.custom.subtitle }}
          </p>
        {% endif %}

        <div class="product-page-pour__price">
          {{ product.selected_or_first_available_variant.price | money }}
        </div>

        {% form 'product', product, class: 'product-page-pour__form' %}

          <input
            type="hidden"
            name="id"
            value="{{ product.selected_or_first_available_variant.id }}"
            data-product-variant-id
          >

          {% unless product.has_only_default_variant %}

            {% for option in product.options_with_values %}
              <div class="product-page-pour__option">

                <p class="product-page-pour__option-label">
                  {{ option.name }}
                </p>

                <div class="product-page-pour__option-values">

                  {% for value in option.values %}
                    <label class="product-page-pour__option-value">

                      <input
                        type="radio"
                        name="options[{{ option.name | escape }}]"
                        value="{{ value | escape }}"
                        {% if option.selected_value == value %}checked{% endif %}
                      >

                      <span>
                        {{ value }}
                      </span>

                    </label>
                  {% endfor %}

                </div>

              </div>
            {% endfor %}

          {% endunless %}

          <div class="product-page-pour__buy-row">

            <div class="product-page-pour__quantity">

              <button type="button" data-qty-minus>
                −
              </button>

              <input
                type="number"
                name="quantity"
                value="1"
                min="1"
                data-qty-input
              >

              <button type="button" data-qty-plus>
                +
              </button>

            </div>

            <button
              type="submit"
              class="product-page-pour__add"
              {% unless product.selected_or_first_available_variant.available %}
                disabled
              {% endunless %}
            >
              {% if product.selected_or_first_available_variant.available %}
                AJOUTER AU PANIER
              {% else %}
                ÉPUISÉ
              {% endif %}
            </button>

          </div>

        {% endform %}

        {% if product.description != blank %}
          <div class="product-page-pour__description">
            {{ product.description }}
          </div>
        {% endif %}
  <!-- DETAILS -->
  <div class="product-page-pour__details">

    <div class="product-page-pour__details-title">
      CONÇU POUR ÊTRE PORTÉ, REPORTÉ, VÉCU.
    </div>

    <div class="product-page-pour__tabs">

      <button
        class="product-page-pour__tab is-active"
        data-product-tab="composition"
      >
        COMPOSITION
      </button>

      <button
        class="product-page-pour__tab"
        data-product-tab="entretien"
      >
        ENTRETIEN
      </button>

    </div>

    <div class="product-page-pour__tab-content is-active" data-product-panel="composition">
      {% if section.settings.composition != blank %}
        {{ section.settings.composition }}
      {% else %}
        100 % coton biologique. Coupe premium. Matière épaisse et confortable.
      {% endif %}
    </div>

    <div class="product-page-pour__tab-content" data-product-panel="entretien">
      {% if section.settings.care != blank %}
        {{ section.settings.care }}
      {% else %}
        Lavage à 30°C sur l’envers. Ne pas sécher en machine. Repassage doux.
      {% endif %}
    </div>

  </div>
      </div>

    </div>

  </div>


 <!-- =====================================================
     VOIR AUSSI — 5 PRODUITS PERSONNALISABLES
===================================================== -->

<div class="product-page-pour__related">

  <div class="product-page-pour__related-heading">
    VOIR AUSSI
  </div>

<div class="product-page-pour__related-carousel">

  <button
    type="button"
    class="product-page-pour__related-arrow product-page-pour__related-arrow--prev"
    data-related-prev
    aria-label="Produits précédents"
  >
    ‹
  </button>

  <div
    class="product-page-pour__related-grid"
    data-related-grid
  >

    {% for i in (1..5) %}

      {% assign product_key = 'related_product_' | append: i %}
      {% assign image_key = 'related_image_' | append: i %}

     {% assign related_product = section.settings[product_key] %}
{% assign custom_image = section.settings[image_key] %}

{% if related_product == blank %}
  {% assign fallback_index = i | minus: 1 %}
  {% assign related_product = collections.all.products[fallback_index] %}
{% endif %}

{% if related_product != blank and related_product.id != product.id %}
        <div class="product-page-pour__related-card">

          <div class="product-page-pour__related-media">

            <a
              href="{{ related_product.url }}"
              class="product-page-pour__related-media-link"
              aria-label="{{ related_product.title }}"
            >

              {% if custom_image != blank %}

                {{
                  custom_image
                  | image_url: width: 1200
                  | image_tag:
                    class: 'product-page-pour__related-image product-page-pour__related-image--primary',
                    loading: 'lazy',
                    alt: related_product.title
                }}

              {% elsif related_product.featured_image != blank %}

                {{
                  related_product.featured_image
                  | image_url: width: 1200
                  | image_tag:
                    class: 'product-page-pour__related-image product-page-pour__related-image--primary',
                    loading: 'lazy',
                    alt: related_product.title
                }}

              {% endif %}

            </a>


            <!-- QUICK ADD + -->

            <button
              type="button"
              class="product-page-pour__related-quick-add"
              data-product-related-quick-add
              data-product-handle="{{ related_product.handle }}"
              aria-label="Ajouter rapidement {{ related_product.title }}"
            ></button>

          </div>


          <a
            href="{{ related_product.url }}"
            class="product-page-pour__related-info"
          >

            <div class="product-page-pour__related-title">
              {{ related_product.title }}
            </div>

            <div class="product-page-pour__related-price">
              {{ related_product.price | money }}
            </div>

          </a>

        </div>

      {% endif %}

    {% endfor %}

      </div>

  <button
    type="button"
    class="product-page-pour__related-arrow product-page-pour__related-arrow--next"
    data-related-next
    aria-label="Produits suivants"
  >
    ›
  </button>

</div>

</div>
<!-- FIN VOIR AUSSI -->

<style>
/* =========================================================
   VOIR AUSSI — FLÈCHES DESKTOP
========================================================= */

.product-page-pour__related-carousel {
  position: relative;
}

.product-page-pour__related-arrow {
  display: none;
}

@media screen and (min-width: 769px) {

  .product-page-pour__related-carousel.has-five-products
  .product-page-pour__related-arrow {
    position: absolute;
    top: 50%;
    z-index: 10;

    display: flex;
    align-items: center;
    justify-content: center;

    width: 44px;
height: 44px;

    padding: 0;

    border: 1px solid rgba(17, 17, 17, 0.10);
    border-radius: 50%;

    background: rgba(255, 255, 255, 0.96);
    color: #111111;

    font-size: 20px;
    font-weight: 300;
    line-height: 1;

    cursor: pointer;

    transform: translateY(-50%);

    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.06);

    transition:
      background .25s ease,
      transform .25s ease,
      box-shadow .25s ease;
  }

  .product-page-pour__related-arrow--prev {
  left: -21px;
}

.product-page-pour__related-arrow--next {
  right: -21px;
}

  .product-page-pour__related-arrow:hover {
    background: #ffffff;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.10);
  }

}
</style>
<script>
(function () {

  const carousel =
    document.querySelector(
      '.product-page-pour__related-carousel'
    );

  if (!carousel) return;

  const grid =
    carousel.querySelector(
      '[data-related-grid]'
    );

  const prev =
    carousel.querySelector(
      '[data-related-prev]'
    );

  const next =
    carousel.querySelector(
      '[data-related-next]'
    );

  if (!grid || !prev || !next) return;


  const cards =
    grid.querySelectorAll(
      '.product-page-pour__related-card'
    );


  /* Les flèches existent uniquement avec 5 produits */

  if (cards.length === 5) {
    carousel.classList.add(
      'has-five-products'
    );
  }


  next.addEventListener(
    'click',
    function () {

      const card =
        grid.querySelector(
          '.product-page-pour__related-card'
        );

      if (!card) return;

      grid.scrollBy({
        left:
          card.getBoundingClientRect().width + 28,
        behavior: 'smooth'
      });

    }
  );


  prev.addEventListener(
    'click',
    function () {

      const card =
        grid.querySelector(
          '.product-page-pour__related-card'
        );

      if (!card) return;

      grid.scrollBy({
        left:
          -(card.getBoundingClientRect().width + 28),
        behavior: 'smooth'
      });

    }
  );

})();
</script>
<!-- QUICK VIEW VOIR AUSSI -->

<div
  class="product-related-qv__overlay"
  data-product-related-qv-overlay
></div>

<div
  class="product-related-qv"
  data-product-related-qv
  aria-hidden="true"
>

  <button
    type="button"
    class="product-related-qv__close"
    data-product-related-qv-close
    aria-label="Fermer"
  ></button>

  <div
    class="product-related-qv__content"
    data-product-related-qv-content
  ></div>

</div>


</section>
<script>
(function () {

  const productSection =
    document.querySelector(
      '.product-page-pour[data-product-page]'
    );

  if (!productSection) return;

  const form =
    productSection.querySelector(
      '.product-page-pour__form'
    );

  if (!form) return;

  const variantInput =
    form.querySelector(
      '[data-product-variant-id]'
    );

  const variants =
    {{ product.variants | json }};


  function updateVariant() {

    const selectedOptions =
      Array.from(
        form.querySelectorAll(
          'input[name^="options["]:checked'
        )
      ).map(
        input => input.value
      );


    const matchingVariant =
      variants.find(
        variant =>
          variant.options.every(
            (option, index) =>
              option === selectedOptions[index]
          )
      );


    if (!matchingVariant) {
      return;
    }


    variantInput.value =
      matchingVariant.id;


    const submitButton =
      form.querySelector(
        '.product-page-pour__add'
      );


    if (submitButton) {

      submitButton.disabled =
        !matchingVariant.available;

      submitButton.textContent =
        matchingVariant.available
          ? 'AJOUTER AU PANIER'
          : 'ÉPUISÉ';

    }

  }


  form.addEventListener(
    'change',
    function (event) {

      if (
        event.target.matches(
          'input[name^="options["]'
        )
      ) {
        updateVariant();
      }

    }
  );


  updateVariant();

})();
</script>
<script>
(function () {

  const section =
    document.querySelector(
      '.product-page-pour[data-product-page]'
    );

  if (!section) return;


  const modal =
    section.querySelector(
      '[data-product-related-qv]'
    );

  const overlay =
    section.querySelector(
      '[data-product-related-qv-overlay]'
    );

  const content =
    section.querySelector(
      '[data-product-related-qv-content]'
    );

  if (!modal || !overlay || !content) {
    return;
  }


  function formatMoney(cents) {

    return new Intl.NumberFormat(
      'fr-FR',
      {
        style: 'currency',
        currency: 'EUR'
      }
    ).format(cents / 100);

  }


  function openModal() {

    modal.classList.add('is-active');
    overlay.classList.add('is-active');

    modal.setAttribute(
      'aria-hidden',
      'false'
    );

  }


  function closeModal() {

    modal.classList.remove('is-active');
    overlay.classList.remove('is-active');

    modal.setAttribute(
      'aria-hidden',
      'true'
    );

  }


function buildVariants(product) {

  const variants = product.variants || [];

  /* PRODUIT SANS DÉCLINAISON */
  if (
    variants.length === 1 &&
    variants[0].title === 'Default Title'
  ) {
    return `
      <input
        type="hidden"
        name="id"
        value="${variants[0].id}"
        data-qv-variant-id
      >
    `;
  }


  const firstAvailable =
    variants.find(v => v.available) || variants[0];


  /* =====================================================
     RÉCUPÉRATION DIRECTE DES VALEURS DEPUIS LES VARIANTES
     Exemple :
     Marron / XS
     Marron / S
     Blanc / XS
  ===================================================== */

  const parsedVariants = variants.map(variant => {

    const parts = variant.title
      .split(' / ')
      .map(part => part.trim());

    return {
      variant: variant,
      color: parts[0] || '',
      size: parts[1] || ''
    };

  });


  const colors = [
    ...new Set(
      parsedVariants
        .map(item => item.color)
        .filter(Boolean)
    )
  ];


  const sizes = [
    ...new Set(
      parsedVariants
        .map(item => item.size)
        .filter(Boolean)
    )
  ];


  const firstParsed =
    parsedVariants.find(
      item => item.variant.id === firstAvailable.id
    ) || parsedVariants[0];


  return `

    <input
      type="hidden"
      name="id"
      value="${firstAvailable.id}"
      data-qv-variant-id
    >


    ${
      colors.length > 0
        ? `

          <div class="product-related-qv__options">

            <p class="product-related-qv__label">
              COULEUR
            </p>

            <div class="product-related-qv__variants">

              ${colors.map(color => `

                <label class="product-related-qv__variant">

                  <input
                    type="radio"
                    name="qv-color"
                    value="${color}"
                    data-qv-color
                    ${
                      color === firstParsed.color
                        ? 'checked'
                        : ''
                    }
                  >

                  <span>
                    ${color}
                  </span>

                </label>

              `).join('')}

            </div>

          </div>

        `
        : ''
    }


    ${
      sizes.length > 0
        ? `

          <div class="product-related-qv__options">

            <p class="product-related-qv__label">
              TAILLE
            </p>

            <div class="product-related-qv__variants">

              ${sizes.map(size => `

                <label class="product-related-qv__variant">

                  <input
                    type="radio"
                    name="qv-size"
                    value="${size}"
                    data-qv-size
                    ${
                      size === firstParsed.size
                        ? 'checked'
                        : ''
                    }
                  >

                  <span>
                    ${size}
                  </span>

                </label>

              `).join('')}

            </div>

          </div>

        `
        : ''
    }

  `;

}

  async function loadProduct(handle) {

    content.innerHTML =
      '<div class="product-related-qv__loading">CHARGEMENT</div>';

    openModal();


    try {

      const response =
        await fetch(
          `/products/${handle}.js`
        );


      if (!response.ok) {
        throw new Error();
      }


      const product =
        await response.json();


      const image =
        product.featured_image ||
        product.images?.[0] ||
        '';


      content.innerHTML = `

        <div class="product-related-qv__media">

          ${
            image
              ? `
                <img
                  src="${image}"
                  class="product-related-qv__image"
                  alt="${product.title}"
                >
              `
              : ''
          }

        </div>


        <div class="product-related-qv__info">

          <h2 class="product-related-qv__title">
            ${product.title}
          </h2>

          <p class="product-related-qv__price">
            ${formatMoney(product.price)}
          </p>


          <form
            action="/cart/add"
            method="post"
            class="product-related-qv__form"
          >

            ${buildVariants(product)}

            <input
              type="hidden"
              name="quantity"
              value="1"
            >

            <button
              type="submit"
              class="product-related-qv__submit"
            >
              AJOUTER AU PANIER
            </button>

          </form>


          <a
            href="${product.url}"
            class="product-related-qv__details"
          >
            VOIR LE PRODUIT
          </a>

        </div>

      `;

/* =====================================================
   QUICK VIEW — COULEUR + TAILLE
===================================================== */

const quickViewForm =
  content.querySelector('.product-related-qv__form');

if (quickViewForm) {

  const variantInput =
    quickViewForm.querySelector('[data-qv-variant-id]');

  const submitButton =
    quickViewForm.querySelector('.product-related-qv__submit');


  function updateQuickViewVariant() {

    const colorInput =
      quickViewForm.querySelector(
        '[data-qv-color]:checked'
      );

    const sizeInput =
      quickViewForm.querySelector(
        '[data-qv-size]:checked'
      );


    const selectedColor =
      colorInput ? colorInput.value : null;

    const selectedSize =
      sizeInput ? sizeInput.value : null;


    const matchingVariant =
      product.variants.find(variant => {

        const parts =
          variant.title
            .split(' / ')
            .map(part => part.trim());


        const variantColor =
          parts[0] || null;

        const variantSize =
          parts[1] || null;


        return (
          (!selectedColor || variantColor === selectedColor) &&
          (!selectedSize || variantSize === selectedSize)
        );

      });


    if (!matchingVariant) {

      if (submitButton) {
        submitButton.disabled = true;
        submitButton.textContent = 'INDISPONIBLE';
      }

      return;
    }


    variantInput.value =
      matchingVariant.id;


    if (submitButton) {

      submitButton.disabled =
        !matchingVariant.available;

      submitButton.textContent =
        matchingVariant.available
          ? 'AJOUTER AU PANIER'
          : 'ÉPUISÉ';

    }

  }


  quickViewForm.addEventListener(
    'change',
    function(event) {

      if (
        event.target.matches('[data-qv-color]') ||
        event.target.matches('[data-qv-size]')
      ) {
        updateQuickViewVariant();
      }

    }
  );


  updateQuickViewVariant();

}
    } catch (error) {

      content.innerHTML =
        '<div class="product-related-qv__loading">PRODUIT INDISPONIBLE</div>';

    }

  }


  section.addEventListener(
    'click',
    function (event) {

      const quickButton =
        event.target.closest(
          '[data-product-related-quick-add]'
        );


      if (quickButton) {

        event.preventDefault();
        event.stopPropagation();

        const handle =
          quickButton.dataset.productHandle;

        if (handle) {
          loadProduct(handle);
        }

        return;
      }


      if (
        event.target.closest(
          '[data-product-related-qv-close]'
        )
      ) {

        closeModal();
        return;
      }


      if (event.target === overlay) {
        closeModal();
      }

    }
  );


  document.addEventListener(
    'keydown',
    function (event) {

      if (event.key === 'Escape') {
        closeModal();
      }

    }
  );

})();
</script>
