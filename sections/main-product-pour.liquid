<script>
(function () {

  const guide =
  document.querySelector(
    '[data-pour-size-guide]'
  );

const openButton =
  document.querySelector(
    '[data-pour-size-guide-open]'
  );

if (!guide || !openButton) {
  return;
}

const productForm =
  document.querySelector(
    '.product-page-pour__form'
  );

const addButton =
  guide.querySelector(
    '[data-size-guide-add]'
  );

const addButtonText =
  guide.querySelector(
    '[data-size-guide-add-text]'
  );

const variants =
  {{ product.variants | json }};

  function openSizeGuide() {

    guide.classList.add(
      'is-active'
    );

    guide.setAttribute(
      'aria-hidden',
      'false'
    );

  }


  function closeSizeGuide() {

    guide.classList.remove(
      'is-active'
    );

    guide.setAttribute(
      'aria-hidden',
      'true'
    );

  }

/* =========================================================
   SÉLECTION D'UNE TAILLE
========================================================= */

guide.addEventListener(
  'click',
  function (event) {

    const sizeButton =
      event.target.closest(
        '[data-size-guide-size]'
      );

    if (!sizeButton) {
      return;
    }


    const selectedSize =
      sizeButton.dataset.size;

    const selectedIndex =
      sizeButton.dataset.sizeIndex;


    /* =========================================
       SURBRILLANCE DE LA COLONNE
    ========================================= */

    guide
      .querySelectorAll(
        '[data-size-guide-column]'
      )
      .forEach(
        function (element) {

          element.classList.toggle(
            'is-selected',
            element.dataset.sizeGuideColumn ===
              selectedIndex
          );

        }
      );


    guide
      .querySelectorAll(
        '[data-size-guide-size]'
      )
      .forEach(
        function (button) {

          button.classList.toggle(
            'is-selected',
            button === sizeButton
          );

        }
      );


    /* =========================================
       SYNCHRONISE AVEC LE VRAI FORMULAIRE
    ========================================= */

    if (!productForm) {
      return;
    }


    const optionInputs =
      Array.from(
        productForm.querySelectorAll(
          'input[name^="options["]'
        )
      );


    let sizeInput =
      optionInputs.find(
        function (input) {

          const name =
            input.name.toLowerCase();

          return (
            input.value === selectedSize &&
            (
              name.includes('taille') ||
              name.includes('size')
            )
          );

        }
      );


    /*
     * Sécurité si Shopify utilise
     * un autre nom pour l'option.
     */
    if (!sizeInput) {

      sizeInput =
        optionInputs.find(
          function (input) {
            return input.value === selectedSize;
          }
        );

    }


    if (!sizeInput) {
      return;
    }


    sizeInput.checked = true;


    sizeInput.dispatchEvent(
      new Event(
        'change',
        {
          bubbles: true
        }
      )
    );


    /* =========================================
       RÉCUPÈRE LA VARIANTE APRÈS SYNCHRONISATION
    ========================================= */

    window.setTimeout(
      function () {

        const variantIdInput =
          productForm.querySelector(
            '[data-product-variant-id]'
          );


        if (!variantIdInput) {
          return;
        }


        const selectedVariant =
          variants.find(
            function (variant) {

              return String(variant.id) ===
                String(variantIdInput.value);

            }
          );


        if (
          !selectedVariant ||
          !selectedVariant.available
        ) {

          addButton.disabled = true;

          addButtonText.textContent =
            'TAILLE ÉPUISÉE';

          return;
        }


        addButton.disabled = false;


        const price =
          new Intl.NumberFormat(
            'fr-FR',
            {
              style: 'currency',
              currency: 'EUR'
            }
          ).format(
            selectedVariant.price / 100
          );


        addButtonText.textContent =
          'PRÉCOMANDEZ — ' + price;

      },
      0
    );

  }
);
/* =========================================================
   AJOUT AU PANIER DEPUIS LE GUIDE
========================================================= */

if (addButton && productForm) {

  addButton.addEventListener(
    'click',
    function () {

      if (addButton.disabled) {
        return;
      }

      const realSubmitButton =
        productForm.querySelector(
          '.product-page-pour__add'
        );

      if (!realSubmitButton) {
        return;
      }

      closeSizeGuide();

      productForm.requestSubmit(
        realSubmitButton
      );

    }
  );

}
  openButton.addEventListener(
    'click',
    openSizeGuide
  );


  guide.addEventListener(
    'click',
    function (event) {

      if (
        event.target.closest(
          '[data-pour-size-guide-close]'
        )
      ) {
        closeSizeGuide();
      }

    }
  );


  document.addEventListener(
    'keydown',
    function (event) {

      if (
        event.key === 'Escape' &&
        guide.classList.contains('is-active')
      ) {
        closeSizeGuide();
      }

    }
  );

})();
</script>
</section>
<script>
(function () {

  const productSection =
    document.querySelector(
      '.product-page-pour[data-product-page]'
    );

  if (!productSection) return;

  const form =
    productSection.querySelector(
      '.product-page-pour__form'
    );

  if (!form) return;

  const variantInput =
    form.querySelector(
      '[data-product-variant-id]'
    );

  const variants =
    {{ product.variants | json }};


  function updateVariant() {

    const selectedOptions =
      Array.from(
        form.querySelectorAll(
          'input[name^="options["]:checked'
        )
      ).map(
        input => input.value
      );


    const matchingVariant =
      variants.find(
        variant =>
          variant.options.every(
            (option, index) =>
              option === selectedOptions[index]
          )
      );


    if (!matchingVariant) {
      return;
    }


    variantInput.value =
      matchingVariant.id;


    const submitButton =
      form.querySelector(
        '.product-page-pour__add'
      );


    if (submitButton) {

      submitButton.disabled =
        !matchingVariant.available;

      submitButton.textContent =
        matchingVariant.available
          ? 'PRÉCOMANDEZ'
          : 'ÉPUISÉ';

    }

  }


  form.addEventListener(
    'change',
    function (event) {

      if (
        event.target.matches(
          'input[name^="options["]'
        )
      ) {
        updateVariant();
      }

    }
  );


  updateVariant();

})();
</script>


<script>
(function () {

  const gallery = document.querySelector(
    '[data-mobile-product-gallery]'
  );

  const counter = document.querySelector(
    '[data-mobile-gallery-current]'
  );

  if (!gallery) return;

  const originalSlides = Array.from(
    gallery.querySelectorAll(
      '[data-mobile-product-slide]'
    )
  );

  if (originalSlides.length < 2) return;


  /* =====================================================
     CLONES
  ===================================================== */

  const firstClone =
    originalSlides[0].cloneNode(true);

  const lastClone =
    originalSlides[
      originalSlides.length - 1
    ].cloneNode(true);


  firstClone.dataset.carouselClone = 'first';
  lastClone.dataset.carouselClone = 'last';


  gallery.insertBefore(
    lastClone,
    originalSlides[0]
  );

  gallery.appendChild(
    firstClone
  );


  const allSlides = Array.from(
    gallery.querySelectorAll(
      '[data-mobile-product-slide]'
    )
  );


  /* =====================================================
     POSITION INITIALE
  ===================================================== */

  function setPosition(position) {

    gallery.style.scrollSnapType = 'none';
    gallery.style.scrollBehavior = 'auto';

    gallery.scrollLeft =
      position * gallery.clientWidth;

    requestAnimationFrame(() => {

      gallery.style.scrollSnapType =
        'x mandatory';

      gallery.style.scrollBehavior =
        '';

    });

  }


  requestAnimationFrame(() => {
    setPosition(1);
  });


  /* =====================================================
     COMPTEUR
  ===================================================== */

  function updateCounter() {

    const width =
      gallery.clientWidth;

    if (!width) return;

    const position =
      Math.round(
        gallery.scrollLeft / width
      );

    let realIndex =
      position - 1;


    if (realIndex < 0) {
      realIndex =
        originalSlides.length - 1;
    }


    if (
      realIndex >=
      originalSlides.length
    ) {
      realIndex = 0;
    }


    if (counter) {
      counter.textContent =
        String(realIndex + 1);
    }

  }


  /* =====================================================
     CARROUSEL INFINI
  ===================================================== */

  let scrollTimer = null;


  gallery.addEventListener(
    'scroll',
    function () {

      updateCounter();

      clearTimeout(scrollTimer);


      scrollTimer = setTimeout(
        function () {

          const width =
            gallery.clientWidth;

          if (!width) return;


          const position =
            Math.round(
              gallery.scrollLeft / width
            );


          /*
           * 2 → 1
           *
           * On arrive sur le clone de 1.
           * On attend simplement la fin du
           * déplacement naturel avant de
           * repositionner sur la vraie 1.
           */

          if (
            position ===
            allSlides.length - 1
          ) {

            gallery.style.scrollSnapType =
              'none';

            gallery.style.scrollBehavior =
              'auto';

            gallery.scrollLeft =
              width;

            requestAnimationFrame(
              function () {

                gallery.style.scrollSnapType =
                  'x mandatory';

                gallery.style.scrollBehavior =
                  '';

              }
            );

            updateCounter();

            return;
          }


          /*
           * 1 → dernière
           */

          if (position === 0) {

            gallery.style.scrollSnapType =
              'none';

            gallery.style.scrollBehavior =
              'auto';

            gallery.scrollLeft =
              width *
              originalSlides.length;

            requestAnimationFrame(
              function () {

                gallery.style.scrollSnapType =
                  'x mandatory';

                gallery.style.scrollBehavior =
                  '';

              }
            );

            updateCounter();

            return;
          }


          updateCounter();

        },
        30
      );

    },
    {
      passive: true
    }
  );


  /* =====================================================
     INITIALISATION
  ===================================================== */

  updateCounter();


  /* =====================================================
     RESIZE
  ===================================================== */

  window.addEventListener(
    'resize',
    function () {

      const width =
        gallery.clientWidth;

      if (!width) return;

      const position =
        Math.round(
          gallery.scrollLeft / width
        );

      gallery.style.scrollSnapType =
        'none';

      gallery.scrollLeft =
        position * width;

      requestAnimationFrame(
        function () {

          gallery.style.scrollSnapType =
            'x mandatory';

        }
      );

    }
  );


})();
</script>
<script>
(function () {

  const section = document.querySelector(
    '.product-page-pour[data-product-page]'
  );

  if (!section) return;


  /* =====================================================
     DONNÉES DES IMAGES
  ===================================================== */

  const images = [
    {% for image in product.images %}
      {
        src: {{ image | image_url: width: 3000 | json }},
        alt: {{ image.alt | escape | json }}
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ];

  if (!images.length) return;


  /* =====================================================
     DESKTOP
  ===================================================== */

  const mainImage =
    section.querySelector('[data-main-product-image]');

  const desktopCurrent =
    section.querySelector('[data-desktop-gallery-current]');

  const desktopPrev =
    section.querySelector('[data-desktop-gallery-prev]');

  const desktopNext =
    section.querySelector('[data-desktop-gallery-next]');


  let currentIndex = 0;


  function showDesktopImage(index) {

    if (!images.length) return;

    if (index < 0) {
      index = images.length - 1;
    }

    if (index >= images.length) {
      index = 0;
    }

    currentIndex = index;

    if (mainImage) {
      mainImage.src = images[currentIndex].src;
      mainImage.alt = images[currentIndex].alt || '';
    }

    if (desktopCurrent) {
      desktopCurrent.textContent =
        String(currentIndex + 1);
    }
  }


  if (desktopPrev) {
    desktopPrev.addEventListener(
      'click',
      function () {
        showDesktopImage(currentIndex - 1);
      }
    );
  }


  if (desktopNext) {
    desktopNext.addEventListener(
      'click',
      function () {
        showDesktopImage(currentIndex + 1);
      }
    );
  }


  /* =====================================================
     PLEIN ÉCRAN
  ===================================================== */

  const fullscreen =
    section.querySelector('[data-product-fullscreen]');

  const fullscreenImage =
    section.querySelector('[data-fullscreen-image]');

  const fullscreenCurrent =
    section.querySelector('[data-fullscreen-current]');

  const fullscreenOpen =
    section.querySelector('[data-product-fullscreen-open]');

  const fullscreenClose =
    section.querySelector('[data-product-fullscreen-close]');

  const fullscreenPrev =
    section.querySelector('[data-fullscreen-prev]');

  const fullscreenNext =
    section.querySelector('[data-fullscreen-next]');


  function updateFullscreen() {

    if (!fullscreenImage) return;

    fullscreenImage.src =
      images[currentIndex].src;

    fullscreenImage.alt =
      images[currentIndex].alt || '';

    if (fullscreenCurrent) {
      fullscreenCurrent.textContent =
        String(currentIndex + 1);
    }
  }


  function openFullscreen() {

    if (!fullscreen) return;

    updateFullscreen();

    fullscreen.classList.add('is-active');

    fullscreen.setAttribute(
      'aria-hidden',
      'false'
    );

    document.body.style.overflow = 'hidden';
  }


  function closeFullscreen() {

    if (!fullscreen) return;

    fullscreen.classList.remove('is-active');

    fullscreen.setAttribute(
      'aria-hidden',
      'true'
    );

    document.body.style.overflow = '';
  }


  function changeFullscreenImage(direction) {

    if (direction > 0) {
      currentIndex++;

      if (currentIndex >= images.length) {
        currentIndex = 0;
      }
    } else {
      currentIndex--;

      if (currentIndex < 0) {
        currentIndex = images.length - 1;
      }
    }

    showDesktopImage(currentIndex);
    updateFullscreen();
  }


  if (fullscreenOpen) {
    fullscreenOpen.addEventListener(
      'click',
      openFullscreen
    );
  }


  if (fullscreenClose) {
    fullscreenClose.addEventListener(
      'click',
      closeFullscreen
    );
  }


  if (fullscreenPrev) {
    fullscreenPrev.addEventListener(
      'click',
      function () {
        changeFullscreenImage(-1);
      }
    );
  }


  if (fullscreenNext) {
    fullscreenNext.addEventListener(
      'click',
      function () {
        changeFullscreenImage(1);
      }
    );
  }


  /* =====================================================
     CLAVIER
  ===================================================== */

  document.addEventListener(
    'keydown',
    function (event) {

      if (
        !fullscreen ||
        !fullscreen.classList.contains('is-active')
      ) {
        return;
      }

      if (event.key === 'Escape') {
        closeFullscreen();
      }

      if (event.key === 'ArrowLeft') {
        changeFullscreenImage(-1);
      }

      if (event.key === 'ArrowRight') {
        changeFullscreenImage(1);
      }

    }
  );


})();
</script>

<script>
(function () {

  const section =
    document.querySelector(
      '.product-page-pour[data-product-page]'
    );

  if (!section) return;


  const panel =
    section.querySelector(
      '[data-product-info-panel]'
    );


  const triggers =
    section.querySelectorAll(
      '[data-product-panel-open]'
    );


  const closeButtons =
    section.querySelectorAll(
      '[data-product-panel-close]'
    );


  const panelContents =
    section.querySelectorAll(
      '[data-product-panel-content]'
    );


  const panelTitle =
    section.querySelector(
      '[data-product-panel-title]'
    );


  if (!panel) return;


  /* =====================================================
     OUVRIR UN PANNEAU
  ===================================================== */

  function openPanel(type) {

    /* Masque tous les contenus */
    panelContents.forEach(function (content) {

      content.classList.remove('is-active');

    });


    /* Affiche le bon contenu */
    const activeContent =
      section.querySelector(
        '[data-product-panel-content="' +
        type +
        '"]'
      );


    if (activeContent) {

      activeContent.classList.add(
        'is-active'
      );

    }


    /* Titre */
    if (panelTitle) {

      if (type === 'details') {

        panelTitle.textContent =
          'DÉTAILS DU PRODUIT';

      }

      if (type === 'faq') {

        panelTitle.textContent =
          'FAQ SUR LES PRODUITS';

      }

      if (type === 'shipping') {

        panelTitle.textContent =
          'EXPÉDITION & RETOURS';

      }

    }


    /* Ouvre */
    panel.classList.add('is-active');

    panel.setAttribute(
      'aria-hidden',
      'false'
    );


    /* Bloque le scroll derrière */
    document.body.style.overflow =
      'hidden';

  }


  /* =====================================================
     FERMER
  ===================================================== */

  function closePanel() {

    panel.classList.remove(
      'is-active'
    );

    panel.setAttribute(
      'aria-hidden',
      'true'
    );


    document.body.style.overflow =
      '';

  }


  /* =====================================================
     BOUTONS
  ===================================================== */

  triggers.forEach(function (trigger) {

    trigger.addEventListener(
      'click',
      function () {

        const type =
          trigger.dataset.productPanelOpen;

        if (!type) return;

        openPanel(type);

      }
    );

  });


  /* =====================================================
     FERMETURE
  ===================================================== */

  closeButtons.forEach(function (button) {

    button.addEventListener(
      'click',
      closePanel
    );

  });


  /* =====================================================
     ÉCHAP
  ===================================================== */

  document.addEventListener(
    'keydown',
    function (event) {

      if (
        event.key === 'Escape' &&
        panel.classList.contains('is-active')
      ) {

        closePanel();

      }

    }
  );


})();
</script>
