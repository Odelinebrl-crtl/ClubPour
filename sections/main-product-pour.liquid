<section class="product-page-pour" data-product-page>


  <div class="product-page-pour__top">

    <!-- GALERIE PRODUIT -->
    <div class="product-page-pour__gallery">

      {% if product.images.size > 0 %}

        <!-- DESKTOP : GRANDE IMAGE + MINIATURES SUPERPOSÉES -->
        <div class="product-page-pour__desktop-gallery">

          <div class="product-page-pour__main-media">
            <img
              src="{{ product.featured_image | image_url: width: 2400 }}"
              alt="{{ product.featured_image.alt | escape }}"
              class="product-page-pour__main-image"
              data-main-product-image
              width="{{ product.featured_image.width }}"
              height="{{ product.featured_image.height }}"
            >
          </div>

          {% if product.images.size > 1 %}
            <div class="product-page-pour__thumbs" aria-label="Galerie produit">

              {% for image in product.images %}
                <button
                  type="button"
                  class="product-page-pour__thumb{% if forloop.first %} is-active{% endif %}"
                  data-product-thumb
                  data-image="{{ image | image_url: width: 2400 }}"
                  aria-label="Voir l'image {{ forloop.index }}"
                >
                  <img
                    src="{{ image | image_url: width: 500 }}"
                    alt="{{ image.alt | escape }}"
                    loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                    width="{{ image.width }}"
                    height="{{ image.height }}"
                  >
                </button>
              {% endfor %}

            </div>
          {% endif %}

        </div>

        <!-- MOBILE : CARROUSEL PLEINE LARGEUR -->
        <div class="product-page-pour__mobile-gallery" data-mobile-product-gallery>

          {% for image in product.images %}
            <div
              class="product-page-pour__mobile-slide"
              data-mobile-product-slide
              data-image-index="{{ forloop.index0 }}"
            >
              <img
                src="{{ image | image_url: width: 1800 }}"
                alt="{{ image.alt | escape }}"
                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                width="{{ image.width }}"
                height="{{ image.height }}"
              >
            </div>
          {% endfor %}

        </div>

        {% if product.images.size > 1 %}
          <div class="product-page-pour__mobile-counter" aria-hidden="true">
            <span data-mobile-gallery-current>1</span>
            <span>/</span>
            <span>{{ product.images.size }}</span>
          </div>
        {% endif %}

      {% endif %}

    </div>

    <!-- INFOS PRODUIT -->
    <div class="product-page-pour__info">

      <div class="product-page-pour__info-inner">

        <h1 class="product-page-pour__title">
          {{ product.title }}
        </h1>

        {% if product.metafields.custom.subtitle != blank %}
          <p class="product-page-pour__subtitle">
            {{ product.metafields.custom.subtitle }}
          </p>
        {% endif %}

        <div class="product-page-pour__price">
          {{ product.selected_or_first_available_variant.price | money }}
        </div>

        {% form 'product', product, class: 'product-page-pour__form' %}

          <input
            type="hidden"
            name="id"
            value="{{ product.selected_or_first_available_variant.id }}"
            data-product-variant-id
          >

          {% unless product.has_only_default_variant %}

            {% for option in product.options_with_values %}
              <div class="product-page-pour__option">

                <p class="product-page-pour__option-label">
                  {{ option.name }}
                </p>

                <div class="product-page-pour__option-values">

                  {% for value in option.values %}
                    <label class="product-page-pour__option-value">

                      <input
                        type="radio"
                        name="options[{{ option.name | escape }}]"
                        value="{{ value | escape }}"
                        {% if option.selected_value == value %}checked{% endif %}
                      >

                      <span>
                        {{ value }}
                      </span>

                    </label>
                  {% endfor %}

                </div>

              </div>
            {% endfor %}

          {% endunless %}

          <div class="product-page-pour__buy-row">

            <div class="product-page-pour__quantity">

              <button type="button" data-qty-minus>
                −
              </button>

              <input
                type="number"
                name="quantity"
                value="1"
                min="1"
                data-qty-input
              >

              <button type="button" data-qty-plus>
                +
              </button>

            </div>

            <button
              type="submit"
              class="product-page-pour__add"
              {% unless product.selected_or_first_available_variant.available %}
                disabled
              {% endunless %}
            >
              {% if product.selected_or_first_available_variant.available %}
                PRÉCOMMANDEZ
              {% else %}
                ÉPUISÉ
              {% endif %}
            </button>

          </div>

        {% endform %}
<div class="product-page-pour__size-guide-row">
  <button
    type="button"
    class="product-page-pour__size-guide-trigger"
    data-pour-size-guide-open
  >
    GUIDE DES TAILLES
  </button>
</div>
        {% if product.description != blank %}
          <div class="product-page-pour__description">
            {{ product.description }}
          </div>
        {% endif %}
  <!-- DETAILS -->
  <div class="product-page-pour__details">

    <div class="product-page-pour__details-title">
      CONÇU POUR ÊTRE PORTÉ, REPORTÉ, VÉCU.
    </div>

    <div class="product-page-pour__tabs">

      <button
        class="product-page-pour__tab is-active"
        data-product-tab="composition"
      >
        COMPOSITION
      </button>

      <button
        class="product-page-pour__tab"
        data-product-tab="entretien"
      >
        ENTRETIEN
      </button>

    </div>

    <div class="product-page-pour__tab-content is-active" data-product-panel="composition">
      {% if section.settings.composition != blank %}
        {{ section.settings.composition }}
      {% else %}
        100 % coton biologique. Coupe premium. Matière épaisse et confortable.
      {% endif %}
    </div>

    <div class="product-page-pour__tab-content" data-product-panel="entretien">
      {% if section.settings.care != blank %}
        {{ section.settings.care }}
      {% else %}
        Lavage à 30°C sur l’envers. Ne pas sécher en machine. Repassage doux.
      {% endif %}
    </div>

  </div>
      </div>

    </div>

  </div>

<!-- =====================================================
     GUIDE DES TAILLES — PAGE PRODUIT UNIQUEMENT
===================================================== -->

<div
  class="pour-size-guide"
  data-pour-size-guide
  aria-hidden="true"
>

  <div class="pour-size-guide__header">

    <h2 class="pour-size-guide__title">
      GUIDE DES TAILLES
    </h2>

    <button
      type="button"
      class="pour-size-guide__close"
      data-pour-size-guide-close
      aria-label="Fermer le guide des tailles"
    ></button>

  </div>


  <div class="pour-size-guide__body">

    <p class="pour-size-guide__eyebrow">
      MESURES DU VÊTEMENT
    </p>


    {% if product.metafields.custom.size_labels != blank %}

      {% assign pour_sizes = product.metafields.custom.size_labels.value | split: '|' %}
      {% assign pour_chest = product.metafields.custom.size_chest.value | split: '|' %}
      {% assign pour_length = product.metafields.custom.size_length.value | split: '|' %}
      {% assign pour_sleeve = product.metafields.custom.size_sleeve.value | split: '|' %}

      <div class="pour-size-guide__table-wrap">

        <table class="pour-size-guide__table">

          <thead>
            <tr>

              <th></th>

             {% for size in pour_sizes %}
  <th
    class="pour-size-guide__size-column"
    data-size-guide-column="{{ forloop.index0 }}"
  >
    <button
      type="button"
      class="pour-size-guide__size-button"
      data-size-guide-size
      data-size="{{ size | strip | escape }}"
      data-size-index="{{ forloop.index0 }}"
    >
      {{ size | strip }}
    </button>
  </th>
{% endfor %}

            </tr>
          </thead>


          <tbody>

            {% if product.metafields.custom.size_chest != blank %}
              <tr>
                <th>POITRINE</th>

              {% for value in pour_chest %}
  <td
    data-size-guide-column="{{ forloop.index0 }}"
  >
    {{ value | strip }}
  </td>
{% endfor %}
              </tr>
            {% endif %}


            {% if product.metafields.custom.size_length != blank %}
              <tr>
                <th>LONGUEUR</th>

                {% for value in pour_length %}
  <td
    data-size-guide-column="{{ forloop.index0 }}"
  >
    {{ value | strip }}
  </td>
{% endfor %}
              </tr>
            {% endif %}


            {% if product.metafields.custom.size_sleeve != blank %}
              <tr>
                <th>MANCHE</th>

               {% for value in pour_sleeve %}
  <td
    data-size-guide-column="{{ forloop.index0 }}"
  >
    {{ value | strip }}
  </td>
{% endfor %}
              </tr>
            {% endif %}

          </tbody>

        </table>

      </div>
<button
  type="button"
  class="pour-size-guide__add"
  data-size-guide-add
  disabled
>
  <span data-size-guide-add-text>
    SÉLECTIONNEZ UNE TAILLE
  </span>
</button>
    {% else %}

      <p class="pour-size-guide__empty">
        Guide des tailles prochainement disponible.
      </p>

    {% endif %}

<div class="pour-size-guide__fit-advice">
  <p>
Coupe oversize. Pour un porté plus ajusté, choisissez une taille en dessous de votre taille habituelle.
 </p>
</div>
    {% if product.metafields.custom.model_height != blank
      or product.metafields.custom.model_weight != blank
      or product.metafields.custom.model_size != blank
    %}

      <div class="pour-size-guide__model">

        <p class="pour-size-guide__model-title">
          LE MODÈLE
        </p>

        <p class="pour-size-guide__model-text">

          {% if product.metafields.custom.model_height != blank %}
            Le mannequin mesure
            {{ product.metafields.custom.model_height.value }}
          {% endif %}

          {% if product.metafields.custom.model_weight != blank %}
           , pèse
            {{ product.metafields.custom.model_weight.value }}
          {% endif %}

          {% if product.metafields.custom.model_size != blank %}
            et porte une taille
            {{ product.metafields.custom.model_size.value }}.
          {% endif %}

        </p>

      </div>

    {% endif %}

  </div>

</div>
 <!-- =====================================================
     VOIR AUSSI — 5 PRODUITS PERSONNALISABLES
===================================================== -->

<div class="product-page-pour__related">

  <div class="product-page-pour__related-heading">
    VOIR AUSSI
  </div>

<div class="product-page-pour__related-carousel">

  <button
    type="button"
    class="product-page-pour__related-arrow product-page-pour__related-arrow--prev"
    data-related-prev
    aria-label="Produits précédents"
  >
    ‹
  </button>

  <div
    class="product-page-pour__related-grid"
    data-related-grid
  >

    {% for i in (1..5) %}

      {% assign product_key = 'related_product_' | append: i %}
      {% assign image_key = 'related_image_' | append: i %}

     {% assign related_product = section.settings[product_key] %}
{% assign custom_image = section.settings[image_key] %}

{% if related_product == blank %}
  {% assign fallback_index = i | minus: 1 %}
  {% assign related_product = collections.all.products[fallback_index] %}
{% endif %}

{% if related_product != blank and related_product.id != product.id %}
        <div class="product-page-pour__related-card">

          <div class="product-page-pour__related-media">

            <a
              href="{{ related_product.url }}"
              class="product-page-pour__related-media-link"
              aria-label="{{ related_product.title }}"
            >

              {% if custom_image != blank %}

                {{
                  custom_image
                  | image_url: width: 1200
                  | image_tag:
                    class: 'product-page-pour__related-image product-page-pour__related-image--primary',
                    loading: 'lazy',
                    alt: related_product.title
                }}

              {% elsif related_product.featured_image != blank %}

                {{
                  related_product.featured_image
                  | image_url: width: 1200
                  | image_tag:
                    class: 'product-page-pour__related-image product-page-pour__related-image--primary',
                    loading: 'lazy',
                    alt: related_product.title
                }}

              {% endif %}

            </a>


            <!-- QUICK ADD + -->

            <button
              type="button"
              class="product-page-pour__related-quick-add"
              data-quick-add
              data-product-handle="{{ related_product.handle }}"
              aria-label="Ajouter rapidement {{ related_product.title }}"
            ></button>

          </div>


          <a
            href="{{ related_product.url }}"
            class="product-page-pour__related-info"
          >

            <div class="product-page-pour__related-title">
              {{ related_product.title }}
            </div>

            <div class="product-page-pour__related-price">
              {{ related_product.price | money }}
            </div>

          </a>

        </div>

      {% endif %}

    {% endfor %}

      </div>

  <button
    type="button"
    class="product-page-pour__related-arrow product-page-pour__related-arrow--next"
    data-related-next
    aria-label="Produits suivants"
  >
    ›
  </button>

</div>

</div>
<!-- FIN VOIR AUSSI -->

<style>

/* =========================================================
   POUR — FICHE PRODUIT / GALERIE
   Inspiration : présentation REPRESENT
========================================================= */

.product-page-pour {
  width: 100%;
  margin: 0;
  padding: 0;
  padding-top: 84px;
  color: #111111;
  background: #ffffff;
}

.product-page-pour *,
.product-page-pour *::before,
.product-page-pour *::after {
  box-sizing: border-box;
}

/* FIL D'ARIANE SUPPRIMÉ */
.product-page-pour__breadcrumb {
  display: none !important;
}

/* =========================================================
   DESKTOP — GALERIE + INFOS
========================================================= */

.product-page-pour__top {
  display: grid;
  grid-template-columns: 50% 50%;
  gap: 0;
  align-items: start;
  width: 100%;
  margin: 0;
  padding: 0;
}

.product-page-pour__gallery {
  position: relative;
  width: 100%;
  min-width: 0;
}

.product-page-pour__desktop-gallery {
  position: relative;
  width: 100%;
}

.product-page-pour__main-media {
  position: relative;
  width: 100% !important;
 height: calc(100vh - 66px);
  min-height: 0;
  margin-left: 0 !important;
  margin-right: 0 !important;
  overflow: hidden;
  background: #f5f5f3;

  display: flex;
  align-items: center;
  justify-content: center;
}

.product-page-pour__main-image {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: center center;
}
/* =========================================================
   MINIATURES DESKTOP — SUPERPOSÉES À GAUCHE
========================================================= */

.product-page-pour__thumbs {
  position: absolute;
  top: 22px;
  left: 22px;
  z-index: 5;

  display: flex;
  flex-direction: column;
  align-items: flex-start;

  gap: 8px;
  width: 74px;
  max-height: calc(100% - 44px);

  overflow-y: auto;
  overflow-x: hidden;

  scrollbar-width: none;
}

.product-page-pour__thumbs::-webkit-scrollbar {
  display: none;
}

.product-page-pour__thumb {
  flex: 0 0 auto;

  width: 62px;
  height: 78px;

  padding: 0;
  margin: 0;

  border: 0;
  outline: 0;

  background: rgba(255, 255, 255, .18);

  opacity: .52;

  cursor: pointer;

  overflow: hidden;

  transition:
    opacity .25s ease,
    transform .25s ease,
    background .25s ease;
}

.product-page-pour__thumb img {
  display: block;

  width: 100%;
  height: 100%;

  object-fit: cover;
  object-position: center;
}

.product-page-pour__thumb:hover {
  opacity: .9;
  transform: translateX(2px);
}

.product-page-pour__thumb.is-active {
  opacity: 1;
  background: rgba(255, 255, 255, .92);
}

/* =========================================================
   MOBILE — GALERIE PLEINE LARGEUR / SWIPE
========================================================= */

.product-page-pour__mobile-gallery {
  display: none;
}

.product-page-pour__mobile-counter {
  display: none;
}

/* =========================================================
   INFOS PRODUIT — DESKTOP
========================================================= */

.product-page-pour__info {
  width: 100%;
  min-width: 0;
}

.product-page-pour__info-inner {
  width: 100%;
  max-width: 500px;
  padding-top: clamp(32px, 4vw, 58px);
  padding-left: clamp(36px, 5vw, 76px);
  padding-right: clamp(24px, 4vw, 64px);
}

/* =========================================================
   MOBILE
========================================================= */

@media screen and (max-width: 768px) {

  .product-page-pour {
    padding-top: 72px;
  }

  .product-page-pour__top {
    display: block;
    width: 100%;
    margin: 0;
    padding: 0;
  }

  .product-page-pour__gallery {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
  }

  /* On supprime entièrement la galerie desktop sur mobile */
  .product-page-pour__desktop-gallery {
    display: none;
  }

  /* Carrousel horizontal plein écran */
  .product-page-pour__mobile-gallery {
    display: flex;

    width: 100vw;

    overflow-x: auto;
    overflow-y: hidden;

    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
-webkit-overflow-scrolling: touch;

scrollbar-width: none;
overscroll-behavior-x: contain;
  }

  .product-page-pour__mobile-gallery::-webkit-scrollbar {
    display: none;
  }

  .product-page-pour__mobile-slide {
    flex: 0 0 100vw;

    width: 100vw;
    aspect-ratio: 4 / 5;

    scroll-snap-align: start;
scroll-snap-stop: normal;

    overflow: hidden;

    background: #f5f5f3;
  }

  .product-page-pour__mobile-slide img {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: contain;
    object-position: center;
  }

  .product-page-pour__mobile-counter {
    display: flex;
    align-items: center;
    gap: 5px;

    position: absolute;
    right: 16px;
    bottom: 16px;
    z-index: 10;

    padding: 7px 10px;

    background: rgba(255, 255, 255, .82);

    font-size: 10px;
    line-height: 1;
    letter-spacing: .08em;

    pointer-events: none;
  }

  /* Informations sous la galerie */
  .product-page-pour__info {
    width: 100%;
  }

  .product-page-pour__info-inner {
    width: 100%;
    max-width: none;

    padding:
      34px
      16px
      0;
  }

  /* =====================================================
     TEXTES MOBILE — MODIFIÉS UNIQUEMENT ICI
  ===================================================== */

  .product-page-pour__title {
    margin-bottom: 16px;

    font-size: 23px !important;
    line-height: 1.05;
    letter-spacing: -.025em;
  }

  .product-page-pour__subtitle {
    margin-bottom: 20px;

    max-width: 100%;

    font-size: 11px !important;
    line-height: 1.35;
  }

  .product-page-pour__price {
    margin-bottom: 30px;

    font-size: 20px !important;
    line-height: 1;
  }

  .product-page-pour__option {
    margin-bottom: 26px;
  }

  .product-page-pour__option-label {
    margin-bottom: 10px;

    font-size: 10px !important;
    letter-spacing: .08em;
  }

  .product-page-pour__option-value span {
    min-width: 46px;
    height: 38px;

    padding: 0 13px;

    font-size: 10px !important;
  }

  .product-page-pour__description {
    max-width: 100%;

    margin-top: 42px;

    font-size: 12px !important;
    line-height: 1.45;
  }

  .product-page-pour__details {
    width: 100%;
    max-width: none;

    margin-top: 70px;
    padding-bottom: 70px;
  }

  .product-page-pour__details-title {
    font-size: 26px !important;
    line-height: 1.05;
  }

  .product-page-pour__tab {
    font-size: 11px !important;
  }

  .product-page-pour__tab-content {
    font-size: 12px !important;
    line-height: 1.5;
  }

}

/* Petits mobiles */
@media screen and (max-width: 390px) {

  .product-page-pour__info-inner {
    padding-left: 14px;
    padding-right: 14px;
  }

  .product-page-pour__title {
    font-size: 22px !important;
  }

  .product-page-pour__price {
    font-size: 19px !important;
  }

}

/* =========================================================
   GUIDE DES TAILLES
========================================================= */

.pour-size-guide {
  position: fixed;
  top: 0;
  right: 0;

  z-index: 99990;

width: min(680px, 100vw);
  height: 100dvh;

  background: #ffffff;
  color: #111111;

  overflow-y: auto;

  transform: translateX(100%);
  visibility: hidden;

  transition:
    transform .45s cubic-bezier(.22,1,.36,1),
    visibility .45s;
}

.pour-size-guide.is-active {
  transform: translateX(0);
  visibility: visible;
}


/* LIEN SUR LA PAGE PRODUIT */

.product-page-pour__size-guide-row {
  margin-top: 18px;
}

.product-page-pour__size-guide-trigger {
  padding: 0;

  border: 0;
  border-bottom: 1px solid #111111;

  background: transparent;
  color: #111111;

  font: inherit;
  font-size: 10px;
  font-weight: 400;

  letter-spacing: .12em;

  text-transform: uppercase;

  cursor: pointer;
}


/* HEADER */

.pour-size-guide__header {
  position: relative;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 35px 40px;

  border-bottom: 1px solid #e5e5e5;
}

.pour-size-guide__title {
  margin: 0;

  font-size: 13px;
  font-weight: 400;

  letter-spacing: .08em;
}


/* CROIX */

.pour-size-guide__close {
  position: relative;

  width: 28px;
  height: 28px;

  padding: 0;

  border: 0;

  background: transparent;

  cursor: pointer;
}

.pour-size-guide__close::before,
.pour-size-guide__close::after {
  content: "";

  position: absolute;

  top: 50%;
  left: 50%;

  width: 20px;
  height: 1px;

  background: #111111;
}

.pour-size-guide__close::before {
  transform: translate(-50%, -50%) rotate(45deg);
}

.pour-size-guide__close::after {
  transform: translate(-50%, -50%) rotate(-45deg);
}


/* CONTENU */

.pour-size-guide__body {
  padding: 45px 40px 60px;
}

.pour-size-guide__eyebrow,
.pour-size-guide__model-title {
  margin: 0 0 25px;

  font-size: 10px;
  font-weight: 400;

  letter-spacing: .14em;

  text-transform: uppercase;
}


/* TABLEAU */

.pour-size-guide__table-wrap {
  width: 100%;

  overflow-x: auto;
}

.pour-size-guide__table {
  width: 100%;

  border-collapse: collapse;

  font-size: 11px;
}

.pour-size-guide__table th,
.pour-size-guide__table td {
  padding: 17px 10px;

  border-bottom: 1px solid #e5e5e5;

  text-align: center;

