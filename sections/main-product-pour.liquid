<section class="product-page-pour" data-product-page>


  <div class="product-page-pour__top">

    <!-- GALERIE PRODUIT -->
    <div class="product-page-pour__gallery">

      {% if product.images.size > 0 %}

        <!-- DESKTOP : GRANDE IMAGE + MINIATURES SUPERPOSÉES -->
        <div class="product-page-pour__desktop-gallery">

         <div class="product-page-pour__main-media">

  <img
    src="{{ product.featured_image | image_url: width: 2400 }}"
    alt="{{ product.featured_image.alt | escape }}"
    class="product-page-pour__main-image"
    data-main-product-image
    width="{{ product.featured_image.width }}"
    height="{{ product.featured_image.height }}"
  >

  <!-- FLÈCHE GAUCHE -->
  <button
    type="button"
    class="product-page-pour__gallery-arrow product-page-pour__gallery-arrow--prev"
    data-desktop-gallery-prev
    aria-label="Image précédente"
  >
    ‹
  </button>

  <!-- FLÈCHE DROITE -->
  <button
    type="button"
    class="product-page-pour__gallery-arrow product-page-pour__gallery-arrow--next"
    data-desktop-gallery-next
    aria-label="Image suivante"
  >
    ›
  </button>

  <!-- COMPTEUR + MANNEQUIN -->
  {% if product.images.size > 1 %}
    <div class="product-page-pour__media-caption">

      <span class="product-page-pour__media-counter">
        <span data-desktop-gallery-current>1</span>
        <span>/</span>
        <span>{{ product.images.size }}</span>
      </span>

      {% if product.metafields.custom.model_height != blank
        or product.metafields.custom.model_weight != blank
        or product.metafields.custom.model_size != blank
      %}
        <span class="product-page-pour__model-caption">

          {% if product.metafields.custom.model_height != blank %}
            Le mannequin mesure {{ product.metafields.custom.model_height.value }}
          {% endif %}

          {% if product.metafields.custom.model_weight != blank %}
            et pèse {{ product.metafields.custom.model_weight.value }}
          {% endif %}

          {% if product.metafields.custom.model_size != blank %}
            et porte une taille {{ product.metafields.custom.model_size.value }}.
          {% endif %}

        </span>
      {% endif %}

    </div>
  {% endif %}

  <!-- AGRANDISSEMENT -->
  <button
    type="button"
    class="product-page-pour__fullscreen-trigger"
    data-product-fullscreen-open
    aria-label="Agrandir les images"
  >
    ⛶
  </button>

</div>

         

        </div>

        <!-- MOBILE : CARROUSEL PLEINE LARGEUR -->
        <div class="product-page-pour__mobile-gallery" data-mobile-product-gallery>

          {% for image in product.images %}
            <div
              class="product-page-pour__mobile-slide"
              data-mobile-product-slide
              data-image-index="{{ forloop.index0 }}"
            >
              <img
                src="{{ image | image_url: width: 1800 }}"
                alt="{{ image.alt | escape }}"
                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                width="{{ image.width }}"
                height="{{ image.height }}"
              >
            </div>
          {% endfor %}

        </div>

       {% if product.images.size > 1 %}
  <div class="product-page-pour__mobile-counter" aria-hidden="true">

    <span class="product-page-pour__mobile-counter-number">
      <span data-mobile-gallery-current>1</span>
      <span>/</span>
      <span>{{ product.images.size }}</span>
    </span>

    {% if product.metafields.custom.model_height != blank
      or product.metafields.custom.model_weight != blank
      or product.metafields.custom.model_size != blank
    %}
      <span class="product-page-pour__mobile-model">

        {% if product.metafields.custom.model_height != blank %}
          Le mannequin mesure {{ product.metafields.custom.model_height.value }}
        {% endif %}

        {% if product.metafields.custom.model_weight != blank %}
          et pèse {{ product.metafields.custom.model_weight.value }}
        {% endif %}

        {% if product.metafields.custom.model_size != blank %}
          et porte une taille {{ product.metafields.custom.model_size.value }}.
        {% endif %}

      </span>
    {% endif %}

  </div>
{% endif %}

      {% endif %}

    </div>

    <!-- INFOS PRODUIT -->
    <div class="product-page-pour__info">

      <div class="product-page-pour__info-inner">

        <h1 class="product-page-pour__title">
          {{ product.title }}
        </h1>

        {% if product.metafields.custom.subtitle != blank %}
          <p class="product-page-pour__subtitle">
            {{ product.metafields.custom.subtitle }}
          </p>
        {% endif %}

        <div class="product-page-pour__price">
          {{ product.selected_or_first_available_variant.price | money }}
        </div>

        {% form 'product', product, class: 'product-page-pour__form' %}

          <input
            type="hidden"
            name="id"
            value="{{ product.selected_or_first_available_variant.id }}"
            data-product-variant-id
          >

          {% unless product.has_only_default_variant %}

            {% for option in product.options_with_values %}
              <div class="product-page-pour__option">

                <p class="product-page-pour__option-label">
                  {{ option.name }}
                </p>

                <div class="product-page-pour__option-values">

                  {% for value in option.values %}
                    <label class="product-page-pour__option-value">

                      <input
                        type="radio"
                        name="options[{{ option.name | escape }}]"
                        value="{{ value | escape }}"
                        {% if option.selected_value == value %}checked{% endif %}
                      >

                      <span>
                        {{ value }}
                      </span>

                    </label>
                  {% endfor %}

                </div>

              </div>
            {% endfor %}

          {% endunless %}

          <div class="product-page-pour__buy-row">

            <div class="product-page-pour__quantity">

              <button type="button" data-qty-minus>
                −
              </button>

              <input
                type="number"
                name="quantity"
                value="1"
                min="1"
                data-qty-input
              >

              <button type="button" data-qty-plus>
                +
              </button>

            </div>

            <button
              type="submit"
              class="product-page-pour__add"
              {% unless product.selected_or_first_available_variant.available %}
                disabled
              {% endunless %}
            >
              {% if product.selected_or_first_available_variant.available %}
                PRÉCOMMANDEZ
              {% else %}
                ÉPUISÉ
              {% endif %}
            </button>

          </div>
<p class="product-page-pour__preorder-note">
  Précommande — expédition à partir du 20 octobre.
</p>
        {% endform %}
<div class="product-page-pour__size-guide-row">
  <button
    type="button"
    class="product-page-pour__size-guide-trigger"
    data-pour-size-guide-open
  >
    GUIDE DES TAILLES
  </button>
</div>
        {% if product.description != blank %}
          <div class="product-page-pour__description">
            {{ product.description }}
          </div>
        {% endif %}
  <!-- DETAILS -->
  <div class="product-page-pour__details">

    <div class="product-page-pour__details-title">
      CONÇU POUR ÊTRE PORTÉ, REPORTÉ, VÉCU.
    </div>

  <div class="product-page-pour__accordions">

  <!-- DÉTAILS DU PRODUIT -->
  <button
    type="button"
    class="product-page-pour__accordion-trigger"
    data-product-panel-open="details"
  >
    <span class="product-page-pour__accordion-icon">+</span>
    <span>DÉTAILS DU PRODUIT</span>
  </button>


  <!-- FAQ -->
  <button
    type="button"
    class="product-page-pour__accordion-trigger"
    data-product-panel-open="faq"
  >
    <span class="product-page-pour__accordion-icon">+</span>
    <span>FAQ SUR LES PRODUITS</span>
  </button>


  <!-- EXPÉDITION & RETOURS -->
  <button
    type="button"
    class="product-page-pour__accordion-trigger"
    data-product-panel-open="shipping"
  >
    <span class="product-page-pour__accordion-icon">+</span>
    <span>EXPÉDITION & RETOURS</span>
  </button>

</div>


<!-- =====================================================
     PANNEAU LATÉRAL — INFORMATIONS PRODUIT
===================================================== -->

<div
  class="product-page-pour__info-panel"
  data-product-info-panel
  aria-hidden="true"
>

  <!-- FOND CLIQUABLE -->
  <button
    type="button"
    class="product-page-pour__info-panel-overlay"
    data-product-panel-close
    aria-label="Fermer"
  ></button>


  <!-- PANNEAU -->
  <aside
    class="product-page-pour__info-panel-inner"
    aria-label="Informations produit"
  >

    <!-- HEADER -->
    <div class="product-page-pour__info-panel-header">

      <div
        class="product-page-pour__info-panel-title"
        data-product-panel-title
      >
        DÉTAILS DU PRODUIT
      </div>

      <button
        type="button"
        class="product-page-pour__info-panel-close"
        data-product-panel-close
        aria-label="Fermer"
      ></button>

    </div>


    <!-- CONTENU DÉTAILS -->
<div
  class="product-page-pour__info-panel-content"
  data-product-panel-content="details"
>
  <div class="product-page-pour__info-panel-text">
    {% if section.settings.composition != blank %}
      {{ section.settings.composition
        | replace: 'COUPE', '<strong>COUPE</strong>'
        | replace: 'MATIÈRE', '<strong>MATIÈRE</strong>'
        | replace: 'DÉTAILS', '<strong>DÉTAILS</strong>'
        | replace: 'ENTRETIEN', '<strong>ENTRETIEN</strong>'
        | raw
      }}
    {% else %}
      Retrouvez ici toutes les informations concernant ce produit.
    {% endif %}
  </div>
</div>


 <!-- CONTENU FAQ -->
<div
  class="product-page-pour__info-panel-content"
  data-product-panel-content="faq"
>

  <div class="product-page-pour__faq">

    <details class="product-page-pour__faq-item">
      <summary class="product-page-pour__faq-question">
        <span>COMMENT TAILLE LE T-SHIRT POUR ?</span>
        <span class="product-page-pour__faq-icon"></span>
      </summary>

      <div class="product-page-pour__faq-answer">
        Le t-shirt POUR adopte une coupe oversized, pensée pour offrir une silhouette ample et contemporaine. Pour un porté plus ajusté, nous recommandons de choisir une taille en dessous de votre taille habituelle.
      </div>
    </details>


    <details class="product-page-pour__faq-item">
      <summary class="product-page-pour__faq-question">
        <span>DE QUELLE MATIÈRE EST COMPOSÉ LE T-SHIRT POUR ?</span>
        <span class="product-page-pour__faq-icon"></span>
      </summary>

      <div class="product-page-pour__faq-answer">
        Notre t-shirt est confectionné en 100 % coton biologique filé et peigné, avec un grammage de 200 GSM. Son tissu lavé offre un toucher souple et un rendu naturellement structuré.
      </div>
    </details>


    <details class="product-page-pour__faq-item">
      <summary class="product-page-pour__faq-question">
        <span>COMMENT ENTRETENIR MON T-SHIRT POUR ?</span>
        <span class="product-page-pour__faq-icon"></span>
      </summary>

      <div class="product-page-pour__faq-answer">
        Nous vous recommandons de laver le t-shirt avec des couleurs similaires, sur l’envers, afin de préserver au mieux sa matière et son imprimé.
      </div>
    </details>


    <details class="product-page-pour__faq-item">
      <summary class="product-page-pour__faq-question">
        <span>PUIS-JE METTRE MON T-SHIRT POUR AU SÈCHE-LINGE ?</span>
        <span class="product-page-pour__faq-icon"></span>
      </summary>

      <div class="product-page-pour__faq-answer">
        Nous vous recommandons de ne pas utiliser de sèche-linge. Privilégiez un séchage à l’air libre afin de préserver la matière et la tenue du t-shirt.
      </div>
    </details>

  </div>

</div>


    <!-- CONTENU EXPÉDITION -->
    <div
      class="product-page-pour__info-panel-content"
      data-product-panel-content="shipping"
    >

      <div class="product-page-pour__info-panel-text">
        {% if section.settings.shipping != blank %}
        {{ section.settings.shipping
  | replace: 'EXPÉDITION', '<strong>EXPÉDITION</strong>'
  | replace: 'PRÉCOMMANDES', '<strong>PRÉCOMMANDES</strong>'
  | replace: 'COMMANDES COURANTES', '<strong>COMMANDES COURANTES</strong>'
  | replace: 'RETOURS & ÉCHANGES', '<strong>RETOURS & ÉCHANGES</strong>'
  | raw
}}
        {% else %}
          Retrouvez ici toutes les informations concernant l’expédition et les retours.
        {% endif %}
      </div>

    </div>

  </aside>

</div>
      </div>

    </div>

  </div>
<!-- =====================================================
     GALERIE PLEIN ÉCRAN
===================================================== -->

<div
  class="product-page-pour__fullscreen"
  data-product-fullscreen
  aria-hidden="true"
>

  <button
    type="button"
    class="product-page-pour__fullscreen-close"
    data-product-fullscreen-close
    aria-label="Fermer"
  ></button>

  <button
    type="button"
    class="product-page-pour__fullscreen-arrow product-page-pour__fullscreen-arrow--prev"
    data-fullscreen-prev
    aria-label="Image précédente"
  >
    ‹
  </button>

  <div class="product-page-pour__fullscreen-media">
    <img
      src="{{ product.featured_image | image_url: width: 3000 }}"
      alt="{{ product.featured_image.alt | escape }}"
      data-fullscreen-image
    >
  </div>

  <button
    type="button"
    class="product-page-pour__fullscreen-arrow product-page-pour__fullscreen-arrow--next"
    data-fullscreen-next
    aria-label="Image suivante"
  >
    ›
  </button>

  <div class="product-page-pour__fullscreen-counter">
    <span data-fullscreen-current>1</span>
    <span>/</span>
    <span>{{ product.images.size }}</span>
  </div>

</div>
<!-- =====================================================
     GUIDE DES TAILLES — PAGE PRODUIT UNIQUEMENT
===================================================== -->

<div
  class="pour-size-guide"
  data-pour-size-guide
  aria-hidden="true"
>

  <div class="pour-size-guide__header">

    <h2 class="pour-size-guide__title">
      GUIDE DES TAILLES
    </h2>

    <button
      type="button"
      class="pour-size-guide__close"
      data-pour-size-guide-close
      aria-label="Fermer le guide des tailles"
    ></button>

  </div>


  <div class="pour-size-guide__body">

    <p class="pour-size-guide__eyebrow">
      MESURES DU VÊTEMENT
    </p>


    {% if product.metafields.custom.size_labels != blank %}

      {% assign pour_sizes = product.metafields.custom.size_labels.value | split: '|' %}
      {% assign pour_chest = product.metafields.custom.size_chest.value | split: '|' %}
      {% assign pour_length = product.metafields.custom.size_length.value | split: '|' %}
      {% assign pour_sleeve = product.metafields.custom.size_sleeve.value | split: '|' %}

      <div class="pour-size-guide__table-wrap">

        <table class="pour-size-guide__table">

          <thead>
            <tr>

              <th></th>

             {% for size in pour_sizes %}
  <th
    class="pour-size-guide__size-column"
    data-size-guide-column="{{ forloop.index0 }}"
  >
    <button
      type="button"
      class="pour-size-guide__size-button"
      data-size-guide-size
      data-size="{{ size | strip | escape }}"
      data-size-index="{{ forloop.index0 }}"
    >
      {{ size | strip }}
    </button>
  </th>
{% endfor %}

            </tr>
          </thead>


          <tbody>

            {% if product.metafields.custom.size_chest != blank %}
              <tr>
                <th>POITRINE</th>

              {% for value in pour_chest %}
  <td
    data-size-guide-column="{{ forloop.index0 }}"
  >
    {{ value | strip }}
  </td>
{% endfor %}
              </tr>
            {% endif %}


            {% if product.metafields.custom.size_length != blank %}
              <tr>
                <th>LONGUEUR</th>

                {% for value in pour_length %}
  <td
    data-size-guide-column="{{ forloop.index0 }}"
  >
    {{ value | strip }}
  </td>
{% endfor %}
              </tr>
            {% endif %}


            {% if product.metafields.custom.size_sleeve != blank %}
              <tr>
                <th>MANCHE</th>

               {% for value in pour_sleeve %}
  <td
    data-size-guide-column="{{ forloop.index0 }}"
  >
    {{ value | strip }}
  </td>
{% endfor %}
              </tr>
            {% endif %}

          </tbody>

        </table>

      </div>
<button
  type="button"
  class="pour-size-guide__add"
  data-size-guide-add
  disabled
>
  <span data-size-guide-add-text>
    SÉLECTIONNEZ UNE TAILLE
  </span>
</button>
    {% else %}

      <p class="pour-size-guide__empty">
        Guide des tailles prochainement disponible.
      </p>

    {% endif %}

<div class="pour-size-guide__fit-advice">
  <p>
Coupe oversize. Pour un porté plus ajusté, choisissez une taille en dessous de votre taille habituelle.
 </p>
</div>
    {% if product.metafields.custom.model_height != blank
      or product.metafields.custom.model_weight != blank
      or product.metafields.custom.model_size != blank
    %}

      <div class="pour-size-guide__model">

        <p class="pour-size-guide__model-title">
          LE MODÈLE
        </p>

        <p class="pour-size-guide__model-text">

          {% if product.metafields.custom.model_height != blank %}
            Le mannequin mesure
            {{ product.metafields.custom.model_height.value }}
          {% endif %}

          {% if product.metafields.custom.model_weight != blank %}
          et pèse
            {{ product.metafields.custom.model_weight.value }}
          {% endif %}

          {% if product.metafields.custom.model_size != blank %}
            et porte une taille
            {{ product.metafields.custom.model_size.value }}.
          {% endif %}

        </p>

      </div>

    {% endif %}

  </div>

</div>
<!-- =====================================================
     STYLE AVEC — 4 PRODUITS
===================================================== -->

<div class="product-page-pour__style-with">

  <div class="product-page-pour__style-with-heading">
    TU AIMERAIS PEUT-ÊTRE AUSSI
  </div>

  <div class="product-page-pour__style-with-grid">

    {% for i in (1..4) %}

  {% assign product_key = 'style_with_product_' | append: i %}
  {% assign image_key = 'style_with_image_' | append: i %}
  {% assign hover_image_key = 'style_with_hover_image_' | append: i %}

  {% assign style_product = section.settings[product_key] %}
  {% assign style_image = section.settings[image_key] %}
  {% assign style_hover_image = section.settings[hover_image_key] %}

  {% if style_product != blank %}

        <article class="product-page-pour__style-with-card">

          <div class="product-page-pour__style-with-media">

            <a
              href="{{ style_product.url }}"
              class="product-page-pour__style-with-media-link"
              aria-label="{{ style_product.title }}"
            >

              {% if style_image != blank %}

                {{
                  style_image
                  | image_url: width: 1800
                  | image_tag:
                    class: 'product-page-pour__style-with-image',
                    loading: 'lazy',
                    alt: style_product.title
                }}

           {% elsif style_product.featured_image != blank %}

  {{
    style_product.featured_image
    | image_url: width: 1800
    | image_tag:
      class: 'product-page-pour__style-with-image',
      loading: 'lazy',
      alt: style_product.title
  }}

{% endif %}

{% if style_hover_image != blank %}
  {{
    style_hover_image
    | image_url: width: 1800
    | image_tag:
      class: 'product-page-pour__style-with-image product-page-pour__style-with-image--hover',
      loading: 'lazy',
      alt: style_product.title
  }}
{% endif %}

            </a>

            <!-- QUICK ADD + -->

            <button
              type="button"
              class="product-page-pour__style-with-quick-add"
              data-quick-add
              data-product-handle="{{ style_product.handle }}"
              aria-label="Ajouter rapidement {{ style_product.title }}"
            ></button>

          </div>

          <a
            href="{{ style_product.url }}"
            class="product-page-pour__style-with-info"
          >

            <div class="product-page-pour__style-with-title">
              {{ style_product.title }}
            </div>

            <div class="product-page-pour__style-with-price">
              {{ style_product.price | money }}
            </div>

          </a>

        </article>

      {% endif %}

    {% endfor %}

  </div>

</div>
<style>


/* =========================================================
   POUR — FICHE PRODUIT / GALERIE
   Inspiration : présentation REPRESENT
========================================================= */

.product-page-pour {
  width: 100%;
  margin: 0;
  padding: 0;
  padding-top: 84px;
  color: #111111;
  background: #ffffff;
}

.product-page-pour *,
.product-page-pour *::before,
.product-page-pour *::after {
  box-sizing: border-box;
}

/* FIL D'ARIANE SUPPRIMÉ */
.product-page-pour__breadcrumb {
  display: none !important;
}

/* =========================================================
   DESKTOP — GALERIE + INFOS
========================================================= */

.product-page-pour__top {
  display: grid;
  grid-template-columns: 50% 50%;
  gap: 0;
  align-items: start;
  width: 100%;
  margin: 0;
  padding: 0;
}

.product-page-pour__gallery {
  position: relative;
  width: 100%;
  min-width: 0;
}

.product-page-pour__desktop-gallery {
  position: relative;
  width: 100%;
}

.product-page-pour__main-media {
  position: relative;
  width: 100% !important;
 height: calc(100vh - 66px);
  min-height: 0;
  margin-left: 0 !important;
  margin-right: 0 !important;
  overflow: hidden;
  background: #f5f5f3;

  display: flex;
  align-items: center;
  justify-content: center;
}

.product-page-pour__main-image {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: center center;
}
/* =========================================================
   MINIATURES DESKTOP — SUPERPOSÉES À GAUCHE
========================================================= */

.product-page-pour__thumbs {
  position: absolute;
  top: 22px;
  left: 22px;
  z-index: 5;

  display: flex;
  flex-direction: column;
  align-items: flex-start;

  gap: 8px;
  width: 74px;
  max-height: calc(100% - 44px);

  overflow-y: auto;
  overflow-x: hidden;

  scrollbar-width: none;
}

.product-page-pour__thumbs::-webkit-scrollbar {
  display: none;
}

.product-page-pour__thumb {
  flex: 0 0 auto;

  width: 62px;
  height: 78px;

  padding: 0;
  margin: 0;

  border: 0;
  outline: 0;

  background: rgba(255, 255, 255, .18);

  opacity: .52;

  cursor: pointer;

  overflow: hidden;

  transition:
    opacity .25s ease,
    transform .25s ease,
    background .25s ease;
}

.product-page-pour__thumb img {
  display: block;

  width: 100%;
  height: 100%;

  object-fit: cover;
  object-position: center;
}

.product-page-pour__thumb:hover {
  opacity: .9;
  transform: translateX(2px);
}

.product-page-pour__thumb.is-active {
  opacity: 1;
  background: rgba(255, 255, 255, .92);
}

/* =========================================================
   MOBILE — GALERIE PLEINE LARGEUR / SWIPE
========================================================= */

