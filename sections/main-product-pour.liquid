<section class="product-page-pour" data-product-page>

 <div class="product-page-pour__breadcrumb">

  <a
    href="/pages/boutique?view=vetements"
    class="product-page-pour__breadcrumb-link"
  >
    BOUTIQUE
  </a>

  <span class="product-page-pour__breadcrumb-separator">
    /
  </span>

  <a
    href="/pages/collection-001?view=collection-001"
    class="product-page-pour__breadcrumb-link"
  >
    COLLECTION 001
  </a>

  <span class="product-page-pour__breadcrumb-separator">
    /
  </span>

  <span class="product-page-pour__breadcrumb-current">
    {{ product.title }}
  </span>

</div>


  <div class="product-page-pour__top">

    <!-- GALERIE -->
    <div class="product-page-pour__gallery">

      {% if product.images.size > 0 %}

        <div class="product-page-pour__main-media">
          <img
            src="{{ product.featured_image | image_url: width: 1800 }}"
            alt="{{ product.featured_image.alt | escape }}"
            class="product-page-pour__main-image"
            data-main-product-image
            width="{{ product.featured_image.width }}"
            height="{{ product.featured_image.height }}"
          >
        </div>

        {% if product.images.size > 1 %}
          <div class="product-page-pour__thumbs">

            {% for image in product.images %}
              <button
                type="button"
                class="product-page-pour__thumb{% if forloop.first %} is-active{% endif %}"
                data-product-thumb
                data-image="{{ image | image_url: width: 1800 }}"
                aria-label="Voir l'image {{ forloop.index }}"
              >
                <img
                  src="{{ image | image_url: width: 400 }}"
                  alt="{{ image.alt | escape }}"
                  loading="lazy"
                  width="{{ image.width }}"
                  height="{{ image.height }}"
                >
              </button>
            {% endfor %}

          </div>
        {% endif %}

      {% endif %}

    </div>

    <!-- INFOS PRODUIT -->
    <div class="product-page-pour__info">

      <div class="product-page-pour__info-inner">

        <h1 class="product-page-pour__title">
          {{ product.title }}
        </h1>

        {% if product.metafields.custom.subtitle != blank %}
          <p class="product-page-pour__subtitle">
            {{ product.metafields.custom.subtitle }}
          </p>
        {% endif %}

        <div class="product-page-pour__price">
          {{ product.selected_or_first_available_variant.price | money }}
        </div>

        {% form 'product', product, class: 'product-page-pour__form' %}

          <input
            type="hidden"
            name="id"
            value="{{ product.selected_or_first_available_variant.id }}"
            data-product-variant-id
          >

          {% unless product.has_only_default_variant %}

            {% for option in product.options_with_values %}
              <div class="product-page-pour__option">

                <p class="product-page-pour__option-label">
                  {{ option.name }}
                </p>

                <div class="product-page-pour__option-values">

                  {% for value in option.values %}
                    <label class="product-page-pour__option-value">

                      <input
                        type="radio"
                        name="options[{{ option.name | escape }}]"
                        value="{{ value | escape }}"
                        {% if option.selected_value == value %}checked{% endif %}
                      >

                      <span>
                        {{ value }}
                      </span>

                    </label>
                  {% endfor %}

                </div>

              </div>
            {% endfor %}

          {% endunless %}

          <div class="product-page-pour__buy-row">

            <div class="product-page-pour__quantity">

              <button type="button" data-qty-minus>
                −
              </button>

              <input
                type="number"
                name="quantity"
                value="1"
                min="1"
                data-qty-input
              >

              <button type="button" data-qty-plus>
                +
              </button>

            </div>

            <button
              type="submit"
              class="product-page-pour__add"
              {% unless product.selected_or_first_available_variant.available %}
                disabled
              {% endunless %}
            >
              {% if product.selected_or_first_available_variant.available %}
                AJOUTER AU PANIER
              {% else %}
                ÉPUISÉ
              {% endif %}
            </button>

          </div>

        {% endform %}
<div class="product-page-pour__size-guide-row">
  <button
    type="button"
    class="product-page-pour__size-guide-trigger"
    data-pour-size-guide-open
  >
    GUIDE DES TAILLES
  </button>
</div>
        {% if product.description != blank %}
          <div class="product-page-pour__description">
            {{ product.description }}
          </div>
        {% endif %}
  <!-- DETAILS -->
  <div class="product-page-pour__details">

    <div class="product-page-pour__details-title">
      CONÇU POUR ÊTRE PORTÉ, REPORTÉ, VÉCU.
    </div>

    <div class="product-page-pour__tabs">

      <button
        class="product-page-pour__tab is-active"
        data-product-tab="composition"
      >
        COMPOSITION
      </button>

      <button
        class="product-page-pour__tab"
        data-product-tab="entretien"
      >
        ENTRETIEN
      </button>

    </div>

    <div class="product-page-pour__tab-content is-active" data-product-panel="composition">
      {% if section.settings.composition != blank %}
        {{ section.settings.composition }}
      {% else %}
        100 % coton biologique. Coupe premium. Matière épaisse et confortable.
      {% endif %}
    </div>

    <div class="product-page-pour__tab-content" data-product-panel="entretien">
      {% if section.settings.care != blank %}
        {{ section.settings.care }}
      {% else %}
        Lavage à 30°C sur l’envers. Ne pas sécher en machine. Repassage doux.
      {% endif %}
    </div>

  </div>
      </div>

    </div>

  </div>

<!-- =====================================================
     GUIDE DES TAILLES — PAGE PRODUIT UNIQUEMENT
===================================================== -->

<div
  class="pour-size-guide"
  data-pour-size-guide
  aria-hidden="true"
>

  <div class="pour-size-guide__header">

    <h2 class="pour-size-guide__title">
      GUIDE DES TAILLES
    </h2>

    <button
      type="button"
      class="pour-size-guide__close"
      data-pour-size-guide-close
      aria-label="Fermer le guide des tailles"
    ></button>

  </div>


  <div class="pour-size-guide__body">

    <p class="pour-size-guide__eyebrow">
      MESURES DU VÊTEMENT
    </p>


    {% if product.metafields.custom.size_labels != blank %}

      {% assign pour_sizes = product.metafields.custom.size_labels.value | split: '|' %}
      {% assign pour_chest = product.metafields.custom.size_chest.value | split: '|' %}
      {% assign pour_length = product.metafields.custom.size_length.value | split: '|' %}
      {% assign pour_sleeve = product.metafields.custom.size_sleeve.value | split: '|' %}

      <div class="pour-size-guide__table-wrap">

        <table class="pour-size-guide__table">

          <thead>
            <tr>

              <th></th>

             {% for size in pour_sizes %}
  <th
    class="pour-size-guide__size-column"
    data-size-guide-column="{{ forloop.index0 }}"
  >
    <button
      type="button"
      class="pour-size-guide__size-button"
      data-size-guide-size
      data-size="{{ size | strip | escape }}"
      data-size-index="{{ forloop.index0 }}"
    >
      {{ size | strip }}
    </button>
  </th>
{% endfor %}

            </tr>
          </thead>


          <tbody>

            {% if product.metafields.custom.size_chest != blank %}
              <tr>
                <th>POITRINE</th>

              {% for value in pour_chest %}
  <td
    data-size-guide-column="{{ forloop.index0 }}"
  >
    {{ value | strip }}
  </td>
{% endfor %}
              </tr>
            {% endif %}


            {% if product.metafields.custom.size_length != blank %}
              <tr>
                <th>LONGUEUR</th>

                {% for value in pour_length %}
  <td
    data-size-guide-column="{{ forloop.index0 }}"
  >
    {{ value | strip }}
  </td>
{% endfor %}
              </tr>
            {% endif %}


            {% if product.metafields.custom.size_sleeve != blank %}
              <tr>
                <th>MANCHE</th>

               {% for value in pour_sleeve %}
  <td
    data-size-guide-column="{{ forloop.index0 }}"
  >
    {{ value | strip }}
  </td>
{% endfor %}
              </tr>
            {% endif %}

          </tbody>

        </table>

      </div>
<button
  type="button"
  class="pour-size-guide__add"
  data-size-guide-add
  disabled
>
  <span data-size-guide-add-text>
    SÉLECTIONNEZ UNE TAILLE
  </span>
</button>
    {% else %}

      <p class="pour-size-guide__empty">
        Guide des tailles prochainement disponible.
      </p>

    {% endif %}

<div class="pour-size-guide__fit-advice">
  <p>
    Nos coupes sont oversize. Pour un rendu optimal, nous vous conseillons de choisir une taille en dessous de votre taille habituelle.
  </p>
</div>
    {% if product.metafields.custom.model_height != blank
      or product.metafields.custom.model_weight != blank
      or product.metafields.custom.model_size != blank
    %}

      <div class="pour-size-guide__model">

        <p class="pour-size-guide__model-title">
          LE MODÈLE
        </p>

        <p class="pour-size-guide__model-text">

          {% if product.metafields.custom.model_height != blank %}
            Le mannequin mesure
            {{ product.metafields.custom.model_height.value }}
          {% endif %}

          {% if product.metafields.custom.model_weight != blank %}
           , pèse
            {{ product.metafields.custom.model_weight.value }}
          {% endif %}

          {% if product.metafields.custom.model_size != blank %}
            et porte une taille
            {{ product.metafields.custom.model_size.value }}.
          {% endif %}

        </p>

      </div>

    {% endif %}

  </div>

</div>
 <!-- =====================================================
     VOIR AUSSI — 5 PRODUITS PERSONNALISABLES
===================================================== -->

<div class="product-page-pour__related">

  <div class="product-page-pour__related-heading">
    VOIR AUSSI
  </div>

<div class="product-page-pour__related-carousel">

  <button
    type="button"
    class="product-page-pour__related-arrow product-page-pour__related-arrow--prev"
    data-related-prev
    aria-label="Produits précédents"
  >
    ‹
  </button>

  <div
    class="product-page-pour__related-grid"
    data-related-grid
  >

    {% for i in (1..5) %}

      {% assign product_key = 'related_product_' | append: i %}
      {% assign image_key = 'related_image_' | append: i %}

     {% assign related_product = section.settings[product_key] %}
{% assign custom_image = section.settings[image_key] %}

{% if related_product == blank %}
  {% assign fallback_index = i | minus: 1 %}
  {% assign related_product = collections.all.products[fallback_index] %}
{% endif %}

{% if related_product != blank and related_product.id != product.id %}
        <div class="product-page-pour__related-card">

          <div class="product-page-pour__related-media">

            <a
              href="{{ related_product.url }}"
              class="product-page-pour__related-media-link"
              aria-label="{{ related_product.title }}"
            >

              {% if custom_image != blank %}

                {{
                  custom_image
                  | image_url: width: 1200
                  | image_tag:
                    class: 'product-page-pour__related-image product-page-pour__related-image--primary',
                    loading: 'lazy',
                    alt: related_product.title
                }}

              {% elsif related_product.featured_image != blank %}

                {{
                  related_product.featured_image
                  | image_url: width: 1200
                  | image_tag:
                    class: 'product-page-pour__related-image product-page-pour__related-image--primary',
                    loading: 'lazy',
                    alt: related_product.title
                }}

              {% endif %}

            </a>


            <!-- QUICK ADD + -->

            <button
              type="button"
              class="product-page-pour__related-quick-add"
              data-quick-add
              data-product-handle="{{ related_product.handle }}"
              aria-label="Ajouter rapidement {{ related_product.title }}"
            ></button>

          </div>


          <a
            href="{{ related_product.url }}"
            class="product-page-pour__related-info"
          >

            <div class="product-page-pour__related-title">
              {{ related_product.title }}
            </div>

            <div class="product-page-pour__related-price">
              {{ related_product.price | money }}
            </div>

          </a>

        </div>

      {% endif %}

    {% endfor %}

      </div>

  <button
    type="button"
    class="product-page-pour__related-arrow product-page-pour__related-arrow--next"
    data-related-next
    aria-label="Produits suivants"
  >
    ›
  </button>

</div>

</div>
<!-- FIN VOIR AUSSI -->

<style>
/* =========================================================
   GUIDE DES TAILLES
========================================================= */

.pour-size-guide {
  position: fixed;
  top: 0;
  right: 0;

  z-index: 99990;

width: min(680px, 100vw);
  height: 100dvh;

  background: #ffffff;
  color: #111111;

  overflow-y: auto;

  transform: translateX(100%);
  visibility: hidden;

  transition:
    transform .45s cubic-bezier(.22,1,.36,1),
    visibility .45s;
}

.pour-size-guide.is-active {
  transform: translateX(0);
  visibility: visible;
}


/* LIEN SUR LA PAGE PRODUIT */

.product-page-pour__size-guide-row {
  margin-top: 18px;
}

.product-page-pour__size-guide-trigger {
  padding: 0;

  border: 0;
  border-bottom: 1px solid #111111;

  background: transparent;
  color: #111111;

  font: inherit;
  font-size: 10px;
  font-weight: 400;

  letter-spacing: .12em;

  text-transform: uppercase;

  cursor: pointer;
}


/* HEADER */

.pour-size-guide__header {
  position: relative;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 35px 40px;

  border-bottom: 1px solid #e5e5e5;
}

.pour-size-guide__title {
  margin: 0;

  font-size: 13px;
  font-weight: 400;

  letter-spacing: .08em;
}


/* CROIX */

.pour-size-guide__close {
  position: relative;

  width: 28px;
  height: 28px;

  padding: 0;

  border: 0;

  background: transparent;

  cursor: pointer;
}

.pour-size-guide__close::before,
.pour-size-guide__close::after {
  content: "";

  position: absolute;

  top: 50%;
  left: 50%;

  width: 20px;
  height: 1px;

  background: #111111;
}

.pour-size-guide__close::before {
  transform: translate(-50%, -50%) rotate(45deg);
}

.pour-size-guide__close::after {
  transform: translate(-50%, -50%) rotate(-45deg);
}


/* CONTENU */

.pour-size-guide__body {
  padding: 45px 40px 60px;
}

.pour-size-guide__eyebrow,
.pour-size-guide__model-title {
  margin: 0 0 25px;

  font-size: 10px;
  font-weight: 400;

  letter-spacing: .14em;

  text-transform: uppercase;
}


/* TABLEAU */

.pour-size-guide__table-wrap {
