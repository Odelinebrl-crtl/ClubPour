<script>
(() => {
  const root = document.querySelector('#PourAbout-{{ section.id }}');
  if (!root) return;

  let lastScrollY = window.scrollY;
  let scrollDirection = 'down';
  let parallaxTicking = false;

  function updateScrollDirection() {
    const currentY = window.scrollY;

    if (currentY > lastScrollY + 2) {
      scrollDirection = 'down';
    } else if (currentY < lastScrollY - 2) {
      scrollDirection = 'up';
    }

    lastScrollY = currentY;
  }

  window.addEventListener('scroll', updateScrollDirection, { passive: true });

  /* ========================================================
     SCROLL REVEAL
     Même logique que Club Privilèges :
     - apparition à l'entrée
     - direction différente en remontant
     - reset uniquement quand on remonte au-dessus
  ======================================================== */

  const revealSections = root.querySelectorAll('[data-pour-about-reveal]');

  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        const section = entry.target;
        const items = section.querySelectorAll('.pour-about__reveal-item');

        if (entry.isIntersecting) {
          items.forEach((item) => {
            item.classList.remove(
              'is-visible',
              'is-from-above',
              'is-from-below'
            );

            if (scrollDirection === 'up') {
              item.classList.add('is-from-above');
            } else {
              item.classList.add('is-from-below');
            }

            const delay = Number(item.dataset.revealDelay || 0);
            item.style.transitionDelay = `${delay}ms`;
          });

          requestAnimationFrame(() => {
            requestAnimationFrame(() => {
              items.forEach((item) => {
                item.classList.add('is-visible');
              });
            });
          });
        } else {
          if (
            scrollDirection === 'up' &&
            entry.boundingClientRect.top > 0
          ) {
            items.forEach((item) => {
              item.classList.remove(
                'is-visible',
                'is-from-above',
                'is-from-below'
              );
              item.style.transitionDelay = '0ms';
            });
          }
        }
      });
    },
    {
      threshold: 0.12,
      rootMargin: '-5% 0px -5% 0px'
    }
  );

  revealSections.forEach((section) => revealObserver.observe(section));

  /* ========================================================
     PARALLAX
  ======================================================== */

  const parallaxTargets = [
    {
      section: root.querySelector('[data-pour-about-hero]'),
      image: root.querySelector('.pour-about__hero-image'),
      amount: 0.12,
      max: 95
    },
    {
      section: root.querySelector('[data-pour-about-parallax]'),
      image: root.querySelector('.pour-about__editorial-image'),
      amount: 0.10,
      max: 90
    },
    {
      section: root.querySelectorAll('[data-pour-about-parallax]')[1],
      image: root.querySelector('.pour-about__final-image'),
      amount: 0.10,
      max: 90
    }
  ];

  function updateParallax() {
    parallaxTargets.forEach((target) => {
      if (!target.section || !target.image) return;

      const rect = target.section.getBoundingClientRect();

      if (
        rect.bottom <= 0 ||
        rect.top >= window.innerHeight
      ) {
        return;
      }

      const viewportCenter = window.innerHeight / 2;
      const sectionCenter = rect.top + rect.height / 2;
      const distance = sectionCenter - viewportCenter;

      let offset = -distance * target.amount;
      offset = Math.max(
        -target.max,
        Math.min(target.max, offset)
      );

      target.image.style.transform =
        `translate3d(0, ${offset}px, 0) scale(1.08)`;
    });
  }

  function requestParallaxUpdate() {
    if (parallaxTicking) return;

    parallaxTicking = true;

    requestAnimationFrame(() => {
      updateParallax();
      parallaxTicking = false;
    });
  }

  window.addEventListener('scroll', requestParallaxUpdate, {
    passive: true
  });

  window.addEventListener('resize', requestParallaxUpdate);

  requestParallaxUpdate();

  /* ========================================================
     SHOPIFY THEME EDITOR
  ======================================================== */

  document.addEventListener('shopify:section:load', (event) => {
    if (event.detail && event.detail.sectionId === '{{ section.id }}') {
      requestParallaxUpdate();
    }
  });
})();
</script>


