{% comment %}
  ============================================================
  POUR — PAGE À PROPOS / LA MARQUE
  File: sections/pour-about.liquid

  Structure :
  01 — Hero
  02 — Notre histoire
  03 — POUR / Inspirations
  04 — Notre vision
  05 — La suite
  ============================================================
{% endcomment %}

<div id="PourAbout-{{ section.id }}" class="pour-about">

  <!-- =========================================================
       01 — HERO
  ========================================================= -->

  <section class="pour-about__hero">

    <div class="pour-about__hero-media">
      {% if section.settings.hero_image != blank %}
        {{
          section.settings.hero_image
          | image_url: width: 3000
          | image_tag:
            class: 'pour-about__hero-image',
            loading: 'eager'
        }}
      {% else %}
        <div class="pour-about__placeholder">
          {{ 'lifestyle-2' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>

    <div class="pour-about__hero-overlay"></div>

    <div class="pour-about__hero-content">

      <p class="pour-about__eyebrow reveal" data-delay="0">
        {{ section.settings.hero_eyebrow }}
      </p>

      <h1 class="pour-about__hero-title reveal" data-delay="100">
        {{ section.settings.hero_title }}
      </h1>

      <p class="pour-about__hero-text reveal" data-delay="200">
        {{ section.settings.hero_text }}
      </p>

    </div>

  </section>


  <!-- =========================================================
       02 — NOTRE HISTOIRE
  ========================================================= -->

  <section class="pour-about__story">

    <div class="pour-about__story-media reveal" data-delay="0">
      {% if section.settings.story_image != blank %}
        {{
          section.settings.story_image
          | image_url: width: 2400
          | image_tag:
            class: 'pour-about__image',
            loading: 'lazy'
        }}
      {% else %}
        <div class="pour-about__placeholder">
          {{ 'lifestyle-1' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>

    <div class="pour-about__story-content">

      <p class="pour-about__eyebrow reveal" data-delay="80">
        {{ section.settings.story_eyebrow }}
      </p>

      <h2 class="pour-about__title reveal" data-delay="140">
        {{ section.settings.story_title }}
      </h2>

      <div class="pour-about__text reveal" data-delay="220">
        {{ section.settings.story_text }}
      </div>

    </div>

  </section>


  <!-- =========================================================
       03 — POUR / INSPIRATIONS
  ========================================================= -->

  <section class="pour-about__inspiration">

    <div class="pour-about__inspiration-media">

      {% if section.settings.inspiration_image != blank %}
        {{
          section.settings.inspiration_image
          | image_url: width: 3000
          | image_tag:
            class: 'pour-about__inspiration-image',
            loading: 'lazy'
        }}
      {% else %}
        <div class="pour-about__placeholder">
          {{ 'lifestyle-2' | placeholder_svg_tag }}
        </div>
      {% endif %}

    </div>

    <div class="pour-about__inspiration-overlay"></div>

    <div class="pour-about__inspiration-content">

      <p class="pour-about__eyebrow reveal" data-delay="0">
        {{ section.settings.inspiration_eyebrow }}
      </p>

      <h2 class="pour-about__inspiration-title reveal" data-delay="100">
        {{ section.settings.inspiration_title }}
      </h2>

      <div class="pour-about__inspiration-text reveal" data-delay="200">
        {{ section.settings.inspiration_text }}
      </div>

    </div>

  </section>


  <!-- =========================================================
       04 — NOTRE VISION
  ========================================================= -->

  <section class="pour-about__vision">

    <div class="pour-about__vision-header">

      <p class="pour-about__eyebrow reveal" data-delay="0">
        {{ section.settings.vision_eyebrow }}
      </p>

      <h2 class="pour-about__vision-title reveal" data-delay="100">
        {{ section.settings.vision_title }}
      </h2>

    </div>


    <div class="pour-about__vision-grid">

      <!-- ITEM 01 -->
      <article class="pour-about__vision-item reveal" data-delay="0">

        <span class="pour-about__vision-number">01</span>

        <div>
          <h3>{{ section.settings.vision_1_title }}</h3>
          <p>{{ section.settings.vision_1_text }}</p>
        </div>

      </article>


      <!-- ITEM 02 -->
      <article class="pour-about__vision-item reveal" data-delay="80">

        <span class="pour-about__vision-number">02</span>

        <div>
          <h3>{{ section.settings.vision_2_title }}</h3>
          <p>{{ section.settings.vision_2_text }}</p>
        </div>

      </article>


      <!-- ITEM 03 -->
      <article class="pour-about__vision-item reveal" data-delay="160">

        <span class="pour-about__vision-number">03</span>

        <div>
          <h3>{{ section.settings.vision_3_title }}</h3>
          <p>{{ section.settings.vision_3_text }}</p>
        </div>

      </article>


      <!-- ITEM 04 -->
      <article class="pour-about__vision-item reveal" data-delay="240">

        <span class="pour-about__vision-number">04</span>

        <div>
          <h3>{{ section.settings.vision_4_title }}</h3>
          <p>{{ section.settings.vision_4_text }}</p>
        </div>

      </article>

    </div>


    <!-- ENGAGEMENTS COURTS -->

    <div class="pour-about__values reveal" data-delay="100">

      <span>100 % COTON</span>
      <span>VEGAN</span>
      <span>IMPRESSION EN FRANCE</span>
      <span>PRODUCTIONS MAÎTRISÉES</span>

    </div>

  </section>


  <!-- =========================================================
       05 — LA SUITE
  ========================================================= -->

  <section class="pour-about__future">

    <div class="pour-about__future-media">

      {% if section.settings.future_image != blank %}
        {{
          section.settings.future_image
          | image_url: width: 3000
          | image_tag:
            class: 'pour-about__future-image',
            loading: 'lazy'
        }}
      {% else %}
        <div class="pour-about__placeholder">
          {{ 'lifestyle-2' | placeholder_svg_tag }}
        </div>
      {% endif %}

    </div>

    <div class="pour-about__future-overlay"></div>

    <div class="pour-about__future-content">

      <p class="pour-about__eyebrow reveal" data-delay="0">
        {{ section.settings.future_eyebrow }}
      </p>

      <h2 class="pour-about__future-title reveal" data-delay="100">
        {{ section.settings.future_title }}
      </h2>

      <div class="pour-about__future-text reveal" data-delay="200">
        {{ section.settings.future_text }}
      </div>

      {% if section.settings.final_link != blank %}

        <a
          href="{{ section.settings.final_link }}"
          class="pour-about__final-link reveal"
          data-delay="280"
        >
          {{ section.settings.final_link_label }}
          <span>→</span>
        </a>

      {% endif %}

    </div>

  </section>

</div>


<style>

/* =========================================================
   ROOT
========================================================= */

#PourAbout-{{ section.id }} {

  --pour-black: #111111;
  --pour-white: #ffffff;
  --pour-cream: #faf9f6;
  --pour-grey: #666666;
  --pour-border: rgba(17,17,17,.13);

  margin: 0;
  padding: 0;

  color: var(--pour-black);
  background: var(--pour-white);

  overflow: hidden;
}


#PourAbout-{{ section.id }} *,
#PourAbout-{{ section.id }} *::before,
#PourAbout-{{ section.id }} *::after {

  box-sizing: border-box;

}


/* =========================================================
   TYPOGRAPHY
========================================================= */

#PourAbout-{{ section.id }} .pour-about__eyebrow {

  margin: 0;

  font-family:
    "Helvetica Neue",
    Helvetica,
    Arial,
    sans-serif;

  font-size: 10px;
  font-weight: 400;

  line-height: 1;

  letter-spacing: .18em;

  text-transform: uppercase;

}


#PourAbout-{{ section.id }} .pour-about__text,
#PourAbout-{{ section.id }} .pour-about__inspiration-text,
#PourAbout-{{ section.id }} .pour-about__future-text {

  font-family:
    "Helvetica Neue",
    Helvetica,
    Arial,
    sans-serif;

  font-size: 13px;

  font-weight: 400;

  line-height: 1.75;

  color: var(--pour-grey);

}


#PourAbout-{{ section.id }} .pour-about__title,
#PourAbout-{{ section.id }} .pour-about__hero-title,
#PourAbout-{{ section.id }} .pour-about__inspiration-title,
#PourAbout-{{ section.id }} .pour-about__vision-title,
#PourAbout-{{ section.id }} .pour-about__future-title {

  font-family:
    "Helvetica Neue",
    Helvetica,
    Arial,
    sans-serif;

  font-weight: 400;

  text-transform: uppercase;

}


/* =========================================================
   REVEAL
========================================================= */

#PourAbout-{{ section.id }} .reveal {

  opacity: 0;

  transform:
    translate3d(0, 45px, 0);

  transition:

    opacity .8s ease,

    transform 1s cubic-bezier(.22,1,.36,1);

}


#PourAbout-{{ section.id }} .reveal.is-visible {

  opacity: 1;

  transform:
    translate3d(0,0,0);

}


/* =========================================================
   HERO
========================================================= */

#PourAbout-{{ section.id }} .pour-about__hero {

  position: relative;

  height: 100svh;
  min-height: 680px;

  overflow: hidden;

  background: var(--pour-black);

  color: var(--pour-white);

}


#PourAbout-{{ section.id }} .pour-about__hero-media {

  position: absolute;

  inset: 0;

}


#PourAbout-{{ section.id }} .pour-about__hero-image {

  position: absolute;

  top: -6%;
  left: 0;

  width: 100%;
  height: 112%;

  max-width: none;

  object-fit: cover;

  object-position: center;

  transform: scale(1.05);

  will-change: transform;

}


#PourAbout-{{ section.id }} .pour-about__hero-overlay {

  position: absolute;

  inset: 0;

  background:
    linear-gradient(
      to bottom,
      rgba(0,0,0,.08),
      rgba(0,0,0,.42)
    );

  z-index: 1;

}


#PourAbout-{{ section.id }} .pour-about__hero-content {

  position: absolute;

  left: 50%;
  bottom: 42px;

  z-index: 2;

  width: min(100%, 1100px);

  padding: 30px;

  text-align: center;

  transform: translateX(-50%);

}


#PourAbout-{{ section.id }} .pour-about__hero-title {

  margin: 28px 0 0;

  font-size:
    clamp(70px, 11vw, 175px);

  line-height: .76;

  letter-spacing: -.085em;

}


#PourAbout-{{ section.id }} .pour-about__hero-text {

  max-width: 440px;

  margin: 28px auto 0;

  font-family:
    "Helvetica Neue",
    Helvetica,
    Arial,
    sans-serif;

  font-size: 11px;

  line-height: 1.6;

  letter-spacing: .04em;

}


/* =========================================================
   STORY
========================================================= */

#PourAbout-{{ section.id }} .pour-about__story {

  display: grid;

  grid-template-columns:
    1fr 1fr;

  min-height: 88vh;

  background: var(--pour-cream);

}


#PourAbout-{{ section.id }} .pour-about__story-media {

  position: relative;

  min-height: 88vh;

  overflow: hidden;

  background: #e9e7e2;

}


#PourAbout-{{ section.id }} .pour-about__image {

  position: absolute;

  inset: -4% 0;

  width: 100%;
  height: 108%;

  max-width: none;

  object-fit: cover;

}


#PourAbout-{{ section.id }} .pour-about__story-content {

  display: flex;

  flex-direction: column;

  justify-content: center;

  padding:
    8vw 7vw;

}


#PourAbout-{{ section.id }} .pour-about__title {

  max-width: 700px;

  margin: 45px 0 38px;

  font-size:
    clamp(52px, 6vw, 96px);

  line-height: .84;

  letter-spacing: -.075em;

}


#PourAbout-{{ section.id }} .pour-about__story .pour-about__text {

  max-width: 580px;

}


#PourAbout-{{ section.id }} .pour-about__story .pour-about__text p {

  margin: 0 0 18px;

}


#PourAbout-{{ section.id }} .pour-about__story .pour-about__text p:last-child {

  margin-bottom: 0;

}


/* =========================================================
   INSPIRATION
========================================================= */

#PourAbout-{{ section.id }} .pour-about__inspiration {

  position: relative;

  height: 86vh;

  min-height: 680px;

  overflow: hidden;

  background: var(--pour-black);

  color: var(--pour-white);

}


#PourAbout-{{ section.id }} .pour-about__inspiration-media {

  position: absolute;

  inset: 0;

}


#PourAbout-{{ section.id }} .pour-about__inspiration-image {

  position: absolute;

  top: -7%;
  left: 0;

  width: 100%;
  height: 114%;

  max-width: none;

  object-fit: cover;

  transform: scale(1.05);

}


#PourAbout-{{ section.id }} .pour-about__inspiration-overlay {

  position: absolute;

  inset: 0;

  z-index: 1;

  background:
    linear-gradient(
      to top,
      rgba(0,0,0,.62),
      rgba(0,0,0,.12)
    );

}


#PourAbout-{{ section.id }} .pour-about__inspiration-content {

  position: absolute;

  left: 50%;
  bottom: 45px;

  z-index: 2;

  width: min(100%, 1200px);

  padding: 30px;

  transform: translateX(-50%);

}


#PourAbout-{{ section.id }} .pour-about__inspiration-title {

  max-width: 1000px;

  margin: 34px 0 0;

  font-size:
    clamp(65px, 10vw, 160px);

  line-height: .75;

  letter-spacing: -.085em;

}


#PourAbout-{{ section.id }} .pour-about__inspiration-text {

  max-width: 520px;

  margin: 38px 0 0;

  color: rgba(255,255,255,.86);

}


#PourAbout-{{ section.id }} .pour-about__inspiration-text p {

  margin: 0 0 15px;

}


#PourAbout-{{ section.id }} .pour-about__inspiration-text p:last-child {

  margin-bottom: 0;

}


/* =========================================================
   VISION
========================================================= */

#PourAbout-{{ section.id }} .pour-about__vision {

  padding:
    145px 32px 110px;

  background: var(--pour-white);

}


#PourAbout-{{ section.id }} .pour-about__vision-header {

  width: min(100%, 1250px);

  margin: 0 auto 85px;

}


#PourAbout-{{ section.id }} .pour-about__vision-title {

  max-width: 1050px;

  margin: 45px 0 0;

  font-size:
    clamp(60px, 8vw, 125px);

  line-height: .8;

  letter-spacing: -.08em;

}


#PourAbout-{{ section.id }} .pour-about__vision-grid {

  display: grid;

  grid-template-columns:
    repeat(2, 1fr);

  gap: 18px;

  width: min(100%, 1250px);

  margin: 0 auto;

}


#PourAbout-{{ section.id }} .pour-about__vision-item {

  min-height: 300px;

  padding: 28px;

  display: flex;

  flex-direction: column;

  justify-content: space-between;

  border: 1px solid var(--pour-border);

  background: var(--pour-cream);

}


#PourAbout-{{ section.id }} .pour-about__vision-number {

  font-family:
    "Helvetica Neue",
    Helvetica,
    Arial,
    sans-serif;

  font-size: 9px;

  color: #777;

  letter-spacing: .12em;

}


#PourAbout-{{ section.id }} .pour-about__vision-item h3 {

  margin: 0 0 20px;

  font-family:
    "Helvetica Neue",
    Helvetica,
    Arial,
    sans-serif;

  font-size:
    clamp(35px, 4vw, 62px);

  font-weight: 400;

  line-height: .86;

  letter-spacing: -.065em;

  text-transform: uppercase;

}


#PourAbout-{{ section.id }} .pour-about__vision-item p {

  max-width: 390px;

  margin: 0;

  font-family:
    "Helvetica Neue",
    Helvetica,
    Arial,
    sans-serif;

  font-size: 12px;

  line-height: 1.65;

  color: var(--pour-grey);

}


/* =========================================================
   VALUES
========================================================= */

#PourAbout-{{ section.id }} .pour-about__values {

  display: flex;

  justify-content: center;

  align-items: center;

  flex-wrap: wrap;

  gap: 0;

  width: min(100%, 1250px);

  margin: 75px auto 0;

  border-top:
    1px solid var(--pour-border);

  border-bottom:
    1px solid var(--pour-border);

}


#PourAbout-{{ section.id }} .pour-about__values span {

  padding:
    20px 28px;

  font-family:
    "Helvetica Neue",
    Helvetica,
    Arial,
    sans-serif;

  font-size: 9px;

  letter-spacing: .13em;

  text-transform: uppercase;

  color: #555;

}


/* =========================================================
   FUTURE
========================================================= */

#PourAbout-{{ section.id }} .pour-about__future {

  position: relative;

  height: 88vh;

  min-height: 680px;

  overflow: hidden;

  background: var(--pour-black);

  color: var(--pour-white);

}


#PourAbout-{{ section.id }} .pour-about__future-media {

  position: absolute;

  inset: 0;

}


#PourAbout-{{ section.id }} .pour-about__future-image {

  position: absolute;

  top: -7%;
  left: 0;

  width: 100%;
  height: 114%;

  max-width: none;

  object-fit: cover;

  transform: scale(1.05);

}


#PourAbout-{{ section.id }} .pour-about__future-overlay {

  position: absolute;

  inset: 0;

  z-index: 1;

  background:
    linear-gradient(
      to top,
      rgba(0,0,0,.58),
      rgba(0,0,0,.12)
    );

}


#PourAbout-{{ section.id }} .pour-about__future-content {

  position: absolute;

  left: 50%;
  bottom: 42px;

  z-index: 2;

  width: min(100%, 1050px);

  padding: 30px;

  text-align: center;

  transform: translateX(-50%);

}


#PourAbout-{{ section.id }} .pour-about__future-title {

  margin: 32px auto 0;

  font-size:
    clamp(65px, 10vw, 165px);

  line-height: .74;

  letter-spacing: -.085em;

}


#PourAbout-{{ section.id }} .pour-about__future-text {

  max-width: 540px;

  margin: 32px auto 0;

  color: rgba(255,255,255,.88);

}


#PourAbout-{{ section.id }} .pour-about__future-text p {

  margin: 0 0 16px;

}


#PourAbout-{{ section.id }} .pour-about__future-text p:last-child {

  margin-bottom: 0;

}


#PourAbout-{{ section.id }} .pour-about__final-link {

  display: inline-flex;

  align-items: center;

  gap: 17px;

  margin-top: 30px;

  padding-bottom: 7px;

  border-bottom:
    1px solid rgba(255,255,255,.65);

  color: white;

  font-family:
    "Helvetica Neue",
    Helvetica,
    Arial,
    sans-serif;

  font-size: 10px;

  letter-spacing: .12em;

  text-transform: uppercase;

  text-decoration: none;

}


#PourAbout-{{ section.id }} .pour-about__final-link span {

  font-size: 15px;

  transition:
    transform .35s ease;

}


#PourAbout-{{ section.id }} .pour-about__final-link:hover span {

  transform:
    translateX(5px);

}


/* =========================================================
   PLACEHOLDER
========================================================= */

#PourAbout-{{ section.id }} .pour-about__placeholder {

  width: 100%;
  height: 100%;

}


#PourAbout-{{ section.id }} .pour-about__placeholder svg {

  display: block;

  width: 100%;
  height: 100%;

}


/* =========================================================
   MOBILE
========================================================= */

@media screen and (max-width: 768px) {


  /* HERO */

  #PourAbout-{{ section.id }} .pour-about__hero {

    min-height: 650px;

  }


  #PourAbout-{{ section.id }} .pour-about__hero-content {

    bottom: 24px;

    width: 100%;

    padding:
      20px 16px;

  }


  #PourAbout-{{ section.id }} .pour-about__hero-title {

    margin-top: 25px;

    font-size:
      clamp(58px, 17vw, 92px);

  }


  #PourAbout-{{ section.id }} .pour-about__hero-text {

    max-width: 330px;

    margin-top: 22px;

    font-size: 10px;

  }


  /* STORY */

  #PourAbout-{{ section.id }} .pour-about__story {

    display: flex;

    flex-direction: column;

  }


  #PourAbout-{{ section.id }} .pour-about__story-media {

    min-height: 62vh;

  }


  #PourAbout-{{ section.id }} .pour-about__story-content {

    padding:
      90px 20px 100px;

  }


  #PourAbout-{{ section.id }} .pour-about__title {

    margin:
      38px 0 30px;

    font-size:
      clamp(48px, 14vw, 78px);

  }


  /* INSPIRATION */

  #PourAbout-{{ section.id }} .pour-about__inspiration {

    height: 78vh;

    min-height: 600px;

  }


  #PourAbout-{{ section.id }} .pour-about__inspiration-content {

    left: 0;
    bottom: 25px;

    width: 100%;

    padding:
      20px;

  }


  #PourAbout-{{ section.id }} .pour-about__inspiration-title {

    margin-top: 28px;

    font-size:
      clamp(58px, 18vw, 105px);

  }


  #PourAbout-{{ section.id }} .pour-about__inspiration-text {

    margin-top: 28px;

    font-size: 12px;

  }


  /* VISION */

  #PourAbout-{{ section.id }} .pour-about__vision {

    padding:
      105px 16px 90px;

  }


  #PourAbout-{{ section.id }} .pour-about__vision-header {

    margin-bottom: 55px;

  }


  #PourAbout-{{ section.id }} .pour-about__vision-title {

    margin-top: 30px;

    font-size:
      clamp(50px, 15vw, 82px);

  }


  #PourAbout-{{ section.id }} .pour-about__vision-grid {

    grid-template-columns: 1fr;

    gap: 12px;

  }


  #PourAbout-{{ section.id }} .pour-about__vision-item {

    min-height: 320px;

    padding: 25px;

  }


  #PourAbout-{{ section.id }} .pour-about__vision-item h3 {

    font-size:
      clamp(38px, 11vw, 60px);

  }


  #PourAbout-{{ section.id }} .pour-about__values {

    margin-top: 55px;

    justify-content: flex-start;

  }


  #PourAbout-{{ section.id }} .pour-about__values span {

    width: 50%;

    padding:
      17px 10px;

    text-align: center;

    font-size: 8px;

  }


  /* FUTURE */

  #PourAbout-{{ section.id }} .pour-about__future {

    height: 78vh;

    min-height: 600px;

  }


  #PourAbout-{{ section.id }} .pour-about__future-content {

    left: 0;
    bottom: 24px;

    width: 100%;

    padding:
      20px 16px;

  }


  #PourAbout-{{ section.id }} .pour-about__future-title {

    font-size:
      clamp(56px, 18vw, 105px);

  }


  #PourAbout-{{ section.id }} .pour-about__future-text {

    margin-top: 26px;

    font-size: 11px;

  }


}


/* =========================================================
   REDUCED MOTION
========================================================= */

@media (prefers-reduced-motion: reduce) {

  #PourAbout-{{ section.id }} .reveal {

    opacity: 1;

    transform: none;

    transition: none;

  }

  #PourAbout-{{ section.id }} img {

    transform: none !important;

  }

}

</style>


<script>

(() => {

  const root =
    document.querySelector(
      '#PourAbout-{{ section.id }}'
    );

  if (!root) return;


  /* =======================================================
     SCROLL REVEAL
  ======================================================= */

  const revealItems =
    root.querySelectorAll('.reveal');


  const observer =
    new IntersectionObserver(

      (entries) => {

        entries.forEach((entry) => {

          if (!entry.isIntersecting) return;


          const item =
            entry.target;


          const delay =
            Number(
              item.dataset.delay || 0
            );


          item.style.transitionDelay =
            `${delay}ms`;


          requestAnimationFrame(() => {

            item.classList.add(
              'is-visible'
            );

          });


          observer.unobserve(item);

        });

      },

      {
        threshold: 0.12,
        rootMargin:
          '0px 0px -5% 0px'
      }

    );


  revealItems.forEach((item) => {

    observer.observe(item);

  });


  /* =======================================================
     SIMPLE PARALLAX
  ======================================================= */

  const parallaxImages =
    root.querySelectorAll(
      '.pour-about__hero-image, .pour-about__inspiration-image, .pour-about__future-image'
    );


  let ticking = false;


  function updateParallax() {

    parallaxImages.forEach((image) => {

      const section =
        image.closest(
          '.pour-about__hero, .pour-about__inspiration, .pour-about__future'
        );


      if (!section) return;


      const rect =
        section.getBoundingClientRect();


      if (
        rect.bottom < 0 ||
        rect.top > window.innerHeight
      ) {
        return;
      }


      const center =
        window.innerHeight / 2;


      const sectionCenter =
        rect.top + rect.height / 2;


      const distance =
        sectionCenter - center;


      const offset =
        Math.max(
          -45,
          Math.min(
            45,
            -distance * 0.08
          )
        );


      image.style.transform =
        `translate3d(0, ${offset}px, 0) scale(1.05)`;

    });


    ticking = false;

  }


  function requestParallax() {

    if (ticking) return;


    ticking = true;


    requestAnimationFrame(
      updateParallax
    );

  }


  window.addEventListener(
    'scroll',
    requestParallax,
    { passive: true }
  );


  window.addEventListener(
    'resize',
    requestParallax
  );


  requestParallax();


})();

</script>


