<section
  id="EditorialImagePour-{{ section.id }}"
  class="editorial-image-pour"
>

  <div class="editorial-image-pour__inner">


    <!-- =====================================================
         IMAGE GAUCHE
    ====================================================== -->

    <div class="editorial-image-pour__media">

      {% if section.settings.image != blank %}

        {{
          section.settings.image
          | image_url: width: 1800
          | image_tag:
            class: 'editorial-image-pour__image',
            loading: 'lazy'
        }}

      {% else %}

        <div class="editorial-image-pour__placeholder">
          {{ 'lifestyle-1' | placeholder_svg_tag }}
        </div>

      {% endif %}

    </div>


    <!-- =====================================================
         CONTENU DROITE
    ====================================================== -->

    <div class="editorial-image-pour__content">


      {% if section.settings.eyebrow != blank %}

        <p
          class="editorial-image-pour__eyebrow editorial-image-pour__reveal"
          data-delay="0"
        >
          {{ section.settings.eyebrow }}
        </p>

      {% endif %}


      {% if section.settings.heading != blank %}

        <h2
          class="editorial-image-pour__heading editorial-image-pour__reveal"
          data-delay="90"
        >
          {{ section.settings.heading }}
        </h2>

      {% endif %}


      {% if section.settings.text != blank %}

        <div
          class="editorial-image-pour__text editorial-image-pour__reveal"
          data-delay="180"
        >
          {{ section.settings.text }}
        </div>

      {% endif %}


      {% if section.settings.button_label != blank %}

        <a
          href="{{ section.settings.button_link }}"
          class="editorial-image-pour__button editorial-image-pour__reveal"
          data-delay="270"
        >
          <span>
            {{ section.settings.button_label }}
          </span>

          <span aria-hidden="true">
            →
          </span>
        </a>

      {% endif %}

    </div>

  </div>

</section>


<style>

/* =========================================================
   EDITORIAL IMAGE — POUR
========================================================= */

#EditorialImagePour-{{ section.id }} {
  width: 100%;

  margin: 0;
  padding: 0;

  background: #FAF9F6;

  color: #111111;
}



/* =========================================================
   STRUCTURE
========================================================= */

#EditorialImagePour-{{ section.id }}
.editorial-image-pour__inner {
  display: grid;

  grid-template-columns:
    minmax(0, 1.2fr)
    minmax(380px, .8fr);

  align-items: stretch;

  gap: 0;

  width: 100%;
  height: 580px;

  margin: 0;
}


/* =========================================================
   IMAGE
========================================================= */

#EditorialImagePour-{{ section.id }}
.editorial-image-pour__media {
  width: 100%;
  height: 580px;
  min-height: 0;
  overflow: hidden;
}


#EditorialImagePour-{{ section.id }}
.editorial-image-pour__image {
  display: block;

  width: 100%;
  height: 100%;

  object-fit: cover;
  object-position: center;
}

#EditorialImagePour-{{ section.id }}
.editorial-image-pour__placeholder,
#EditorialImagePour-{{ section.id }}
.editorial-image-pour__placeholder svg {
  width: 100%;
  height: 100%;
}


/* =========================================================
   CONTENU
========================================================= */

#EditorialImagePour-{{ section.id }}
.editorial-image-pour__content {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;

  max-width: 560px;

  padding:
    90px
    7vw;

  box-sizing: border-box;
}

/* PETIT TITRE */

#EditorialImagePour-{{ section.id }}
.editorial-image-pour__eyebrow {
  margin: 0 0 28px;

  font-family:
    "Helvetica Neue",
    Helvetica,
    Arial,
    sans-serif;

  font-size: 9px;
  font-weight: 400;

  line-height: 1;

  letter-spacing: .20em;

  text-transform: uppercase;

  color: rgba(17,17,17,.58);
}


/* GRAND TITRE */

#EditorialImagePour-{{ section.id }}
.editorial-image-pour__heading {
  margin: 0;

  font-family:
    "Helvetica Neue",
    Helvetica,
    Arial,
    sans-serif;

  font-size:
    clamp(
      36px,
      4vw,
      64px
    );

  font-weight: 400;

  line-height: .98;

  letter-spacing: -.045em;

  text-transform: uppercase;

  color: #111111;
}


/* TEXTE */

#EditorialImagePour-{{ section.id }}
.editorial-image-pour__text {
  max-width: 470px;

  margin-top: 30px;

  font-family:
    "Helvetica Neue",
    Helvetica,
    Arial,
    sans-serif;

  font-size: 13px;
  font-weight: 400;

  line-height: 1.65;

  color: rgba(17,17,17,.68);
}


#EditorialImagePour-{{ section.id }}
.editorial-image-pour__text p {
  margin: 0;
}


/* =========================================================
   BOUTON
========================================================= */

#EditorialImagePour-{{ section.id }}
.editorial-image-pour__button {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  gap: 16px;

  min-width: 165px;
  height: 48px;

  margin-top: 38px;

  padding: 0 24px;

  border: 1px solid #111111;

  background-color: #111111;
  color: #ffffff;

  font-family:
    "Helvetica Neue",
    Helvetica,
    Arial,
    sans-serif;

  font-size: 10px;
  font-weight: 400;

  letter-spacing: .12em;

  text-transform: uppercase;
  text-decoration: none;

  transition:
    background-color .65s cubic-bezier(.22,1,.36,1),
    color .55s cubic-bezier(.22,1,.36,1),
    border-color .65s cubic-bezier(.22,1,.36,1);
}


#EditorialImagePour-{{ section.id }}
.editorial-image-pour__button:hover {
  background-color: #ffffff;
  color: #111111;
  border-color: #111111;
}


/* =========================================================
   REVEAL AU SCROLL — TEXTE UNIQUEMENT
========================================================= */

#EditorialImagePour-{{ section.id }}
.editorial-image-pour__reveal {
  opacity: 0;

  transform: translateY(42px);

  transition:
    opacity .8s cubic-bezier(.22,1,.36,1),
    transform .8s cubic-bezier(.22,1,.36,1);

  transition-delay:
    var(--editorial-delay, 0ms);

  will-change:
    opacity,
    transform;
}


#EditorialImagePour-{{ section.id }}
.editorial-image-pour__reveal.is-visible {
  opacity: 1;

  transform: translateY(0);
}


/* =========================================================
   MOBILE
========================================================= */

@media screen and (max-width: 768px) {

  #EditorialImagePour-{{ section.id }} {
    padding:
      65px
      16px
      80px;
  }


  #EditorialImagePour-{{ section.id }}
  .editorial-image-pour__inner {
    grid-template-columns: 1fr;

    gap: 50px;

    width: 100%;
  }


  #EditorialImagePour-{{ section.id }}
  .editorial-image-pour__content {
    max-width: none;
  }


  #EditorialImagePour-{{ section.id }}
  .editorial-image-pour__heading {
    font-size:
      clamp(
        38px,
        12vw,
        56px
      );
  }


  #EditorialImagePour-{{ section.id }}
  .editorial-image-pour__button {
    margin-top: 30px;
  }

}

</style>


<script>

(function () {

  function initEditorialImagePour() {

    const section =
      document.getElementById(
        'EditorialImagePour-{{ section.id }}'
      );

    if (!section) return;


    const elements =
      section.querySelectorAll(
        '.editorial-image-pour__reveal'
      );


    elements.forEach((element) => {

      const delay =
        element.getAttribute(
          'data-delay'
        ) || 0;


      element.style.setProperty(
        '--editorial-delay',
        delay + 'ms'
      );

    });


    const observer =
      new IntersectionObserver(
        (entries) => {

          entries.forEach((entry) => {

            if (entry.isIntersecting) {

              entry.target
                .classList
                .add('is-visible');

            } else {

              entry.target
                .classList
                .remove('is-visible');

            }

          });

        },
        {
          threshold: .18,
          rootMargin:
            '0px 0px -8% 0px'
        }
      );


    elements.forEach((element) => {

      observer.observe(element);

    });

  }


  if (
    document.readyState === 'loading'
  ) {

    document.addEventListener(
      'DOMContentLoaded',
      initEditorialImagePour
    );

  } else {

    initEditorialImagePour();

  }


  document.addEventListener(
    'shopify:section:load',
    initEditorialImagePour
  );

})();

</script>


{% schema %}
{
  "name": "Bloc image éditorial",

  "settings": [

    {
      "type": "image_picker",
      "id": "image",
      "label": "Image gauche"
    },

    {
      "type": "text",
      "id": "eyebrow",
      "label": "Petit titre",
      "default": "COLLECTION 001"
    },

    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "UNE PIÈCE. UNE HISTOIRE."
    },

    {
      "type": "richtext",
      "id": "text",
      "label": "Texte",
      "default": "<p>Une pièce pensée dans les détails, inspirée par l’automobile et conçue pour accompagner bien plus que la route.</p>"
    },

    {
      "type": "text",
      "id": "button_label",
      "label": "Texte du bouton",
      "default": "ACHETER"
    },

    {
      "type": "url",
      "id": "button_link",
      "label": "Lien du bouton"
    }

  ],

  "presets": [
    {
      "name": "Bloc image éditorial"
    }
  ]
}
{% endschema %}
