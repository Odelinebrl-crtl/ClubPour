
<section
  id="VideoHero-{{ section.id }}"
  class="pour-video-hero"
  data-video-parallax
>
  <div class="pour-video-hero__media">

    {% if section.settings.video != blank %}
      {{
        section.settings.video
        | video_tag:
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          playsinline: true,
          class: 'pour-video-hero__video'
      }}
    {% else %}
      <div class="pour-video-hero__placeholder">
        AJOUTEZ UNE VIDÉO
      </div>
    {% endif %}

    

{% if section.settings.mobile_video != blank %}
  <video
    class="pour-video-hero__video pour-video-hero__video--mobile"
    autoplay
    muted
    loop
    playsinline
    webkit-playsinline
    preload="auto"
    disablepictureinpicture
    controlslist="nodownload nofullscreen noremoteplayback"
  >
    {% for source in section.settings.mobile_video.sources %}
      <source src="{{ source.url }}" type="{{ source.mime_type }}">
    {% endfor %}
  </video>
{% endif %}



  </div>
</section>

{% schema %}
{
  "name": "Vidéo plein écran POUR",
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "Vidéo"
    },
    {
  "type": "video",
  "id": "mobile_video",
  "label": "Vidéo mobile"
}
  ],
  "presets": [
    {
      "name": "Vidéo plein écran POUR"
    }
  ]
}
{% endschema %}