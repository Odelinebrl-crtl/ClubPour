
<section
  id="VideoHero-{{ section.id }}"
  class="pour-video-hero"
  data-video-parallax
>
  <div class="pour-video-hero__media">

    {% if section.settings.video != blank %}
      {{
        section.settings.video
        | video_tag:
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          playsinline: true,
          class: 'pour-video-hero__video'
      }}
    {% else %}
      <div class="pour-video-hero__placeholder">
        AJOUTEZ UNE VIDÉO
      </div>
    {% endif %}

    
{% if section.settings.mobile_video != blank %}
  <video
    class="pour-video-hero__video pour-video-hero__video--mobile"
    autoplay
    muted
    loop
    playsinline
    webkit-playsinline
    preload="auto"
    disablepictureinpicture
  >
    {% for source in section.settings.mobile_video.sources %}
      <source src="{{ source.url }}" type="{{ source.mime_type }}">
    {% endfor %}
  </video>
{% endif %}


  </div>
</section>
<script>
document.addEventListener('DOMContentLoaded', function () {
  const videos = document.querySelectorAll('.pour-video-hero__video--mobile');

  videos.forEach(function (video) {
    video.muted = true;
    video.defaultMuted = true;
    video.loop = true;
    video.controls = false;
    video.setAttribute('muted', '');
    video.setAttribute('playsinline', '');
    video.setAttribute('autoplay', '');
    video.removeAttribute('controls');

    const playVideo = function () {
      const promise = video.play();
      if (promise && promise.catch) {
        promise.catch(function () {});
      }
    };

    playVideo();
    video.addEventListener('canplay', playVideo);
  });
});
</script>
{% schema %}
{
  "name": "Vidéo plein écran POUR",
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "Vidéo"
    },
    {
  "type": "video",
  "id": "mobile_video",
  "label": "Vidéo mobile"
}
  ],
  "presets": [
    {
      "name": "Vidéo plein écran POUR"
    }
  ]
}
{% endschema %}