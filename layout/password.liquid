<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    >

    <title>
      {{ page_title }}
      {% unless page_title contains shop.name %}
        — {{ shop.name }}
      {% endunless %}
    </title>

    {{ content_for_header }}

    {{ 'base.css' | asset_url | stylesheet_tag }}

    <link
      rel="icon"
      type="image/png"
      href="{{ 'favicon.png' | asset_url }}"
    >
  </head>

  <body>

    {{ content_for_layout }}

  </body>
</html>
