<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <script>
(function () {
  const LANGUAGE_KEY = 'pour_language_selected';

  // Langue actuellement affichée par Shopify
  const currentLanguage = {{ localization.language.iso_code | json }};

  // Vérifie si une langue a déjà été choisie manuellement
  const manualLanguage = sessionStorage.getItem(LANGUAGE_KEY);

  /*
   * PREMIÈRE VISITE DE LA SESSION
   *
   * Si Shopify arrive directement sur une langue autre que FR,
   * on revient en français.
   */
  if (!manualLanguage && currentLanguage !== 'fr') {
    const path = window.location.pathname;

    const localizedPath = path.replace(
      /^\/(en|de|es|it|nl|pt)(?=\/|$)/,
      ''
    ) || '/';

    window.location.replace(
      localizedPath +
      window.location.search +
      window.location.hash
    );

    return;
  }

  /*
   * DÉTECTION DU CHOIX MANUEL
   *
   * On écoute uniquement le sélecteur Shopify.
   */
  document.addEventListener('change', function (event) {

    const select = event.target.closest(
      'select[name="language_code"]'
    );

    if (!select) return;

    /*
     * IMPORTANT :
     * On enregistre le choix AVANT que Shopify
     * recharge la page.
     */
    sessionStorage.setItem(
      LANGUAGE_KEY,
      select.value
    );

  }, true);

})();
</script>
  <head>
    <meta charset="utf-8">

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    >

       <title>
      {{ page_title }}
      {% unless page_title contains shop.name %}
        — {{ shop.name }}
      {% endunless %}
    </title>

    {{ content_for_header }}

    {{ 'base.css' | asset_url | stylesheet_tag }}

  {% if request.path contains '/challenge' %}
  <style>
    .shopify-challenge__container {
      padding-top: 120px !important;
    }
  </style>
{% endif %}

{% if request.path contains '/policies/' %}
  <style>
    /* Décalage du contenu des pages légales Shopify */
    .shopify-policy__container {
      padding-top: 120px !important;
    }
  </style>
{% endif %}

{% if request.path contains '/tools' or request.path contains '/unsubscribe' %}
  <style>
    /* Décalage de la page de désabonnement du Club Privilège */
    .shopify-email-marketing-confirmation__container,
    .shopify-email-marketing-unsubscribe__container {
      padding-top: 120px !important;
    }
  </style>
{% endif %}
<link
  rel="icon"
  type="image/png"
  href="{{ 'favicon.png' | asset_url }}"
>
  </head>

  <body>

    {% section 'header' %}

    <main id="MainContent">
      {{ content_for_layout }}
    </main>
{% section 'footer' %}

{% render 'pour-cookie-banner' %}

{{ 'pour-cookie-banner.css' | asset_url | stylesheet_tag }}

<script
  src="{{ 'pour-cookie-banner.js' | asset_url }}"
  defer
></script>
<!-- =========================================================
     POUR — QUICK VIEW
========================================================= -->

<div
  class="pour-quickview-overlay"
  data-pour-quickview-overlay
></div>

<div
  class="pour-quickview"
  data-pour-quickview
  aria-hidden="true"
>

  <button
    type="button"
    class="pour-quickview__close"
    data-pour-quickview-close
    aria-label="Fermer"
  ></button>

  <div
    class="pour-quickview__content"
    data-pour-quickview-content
  ></div>

</div>
<script>
  window.PourTranslations = {
    size: {{ 'pour_products.size' | t | json }},
    loading: {{ 'pour_products.loading' | t | json }},
    preorder: {{ 'pour_products.preorder' | t | json }},
    unavailable: {{ 'pour_products.unavailable' | t | json }},
    sold_out: {{ 'pour_product.sold_out' | t | json }},
    view_product: {{ 'pour_common.view_product' | t | json }}
  };
</script>
    <script
      src="{{ 'theme.js' | asset_url }}"
      defer
    ></script>
<script>
document.addEventListener('mouseover', function(event) {

  const button = event.target.closest(
    'form[action*="/cart/add"] button[type="submit"]'
  );

  if (!button) return;
button.style.setProperty(
  'transition',
  'background-color 0.35s ease, color 0.35s ease, border-color 0.35s ease',
  'important'
);
  const text = button.textContent.trim().toUpperCase();

  if (
    text !== 'AJOUTER AU PANIER' &&
    text !== 'AJOUTER'
  ) {
    return;
  }

  button.style.setProperty(
    'background',
    '#ffffff',
    'important'
  );

  button.style.setProperty(
    'color',
    '#111111',
    'important'
  );

  button.style.setProperty(
    'border-color',
    '#111111',
    'important'
  );

});


document.addEventListener('mouseout', function(event) {

  const button = event.target.closest(
    'form[action*="/cart/add"] button[type="submit"]'
  );

  if (!button) return;

  const text = button.textContent.trim().toUpperCase();

  if (
    text !== 'AJOUTER AU PANIER' &&
    text !== 'AJOUTER'
  ) {
    return;
  }

  button.style.setProperty(
    'background',
    '#111111',
    'important'
  );

  button.style.setProperty(
    'color',
    '#ffffff',
    'important'
  );

  button.style.setProperty(
    'border-color',
    '#111111',
    'important'
  );

});
</script>
  </body>
</html>
