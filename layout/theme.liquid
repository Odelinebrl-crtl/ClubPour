<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    >

    <title>
      {{ page_title }}
      {% unless page_title contains shop.name %}
        — {{ shop.name }}
      {% endunless %}
    </title>

    {{ content_for_header }}

    {{ 'base.css' | asset_url | stylesheet_tag }}
  </head>

  <body>

    {% section 'header' %}

    <main id="MainContent">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}
<!-- =========================================================
     POUR — QUICK VIEW
========================================================= -->

<div
  class="pour-quickview-overlay"
  data-pour-quickview-overlay
></div>

<div
  class="pour-quickview"
  data-pour-quickview
  aria-hidden="true"
>

  <button
    type="button"
    class="pour-quickview__close"
    data-pour-quickview-close
    aria-label="Fermer"
  ></button>

  <div
    class="pour-quickview__content"
    data-pour-quickview-content
  ></div>

</div>
    <script
      src="{{ 'theme.js' | asset_url }}"
      defer
    ></script>

  </body>
</html>
