<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    >

       <title>
      {{ page_title }}
      {% unless page_title contains shop.name %}
        — {{ shop.name }}
      {% endunless %}
    </title>

    {{ content_for_header }}

    {{ 'base.css' | asset_url | stylesheet_tag }}

  {% if request.path contains '/challenge' %}
  <style>
    .shopify-challenge__container {
      padding-top: 120px !important;
    }
  </style>
{% endif %}

{% if request.path contains '/policies/' %}
  <style>
    /* Décalage du contenu des pages légales Shopify */
    .shopify-policy__container {
      padding-top: 120px !important;
    }
  </style>
{% endif %}

{% if request.path contains '/tools' or request.path contains '/unsubscribe' %}
  <style>
    /* Décalage de la page de désabonnement du Club Privilège */
    .shopify-email-marketing-confirmation__container,
    .shopify-email-marketing-unsubscribe__container {
      padding-top: 120px !important;
    }
  </style>
{% endif %}
  </head>

  <body>

    {% section 'header' %}

    <main id="MainContent">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}
   <div
  id="PourCookieBanner"
  style="
    position: fixed !important;
    inset: 0 !important;
    z-index: 999999999 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    padding: 24px !important;
    box-sizing: border-box !important;
    background: rgba(0,0,0,.76) !important;
    color: white !important;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif !important;
    text-align: center !important;
  "
>
  <div>
    <h2 style="
      margin: 0 0 20px !important;
      font-size: 18px !important;
      font-weight: 500 !important;
    ">
      POUR TEST 123456
    </h2>

    <p style="
      max-width: 560px !important;
      margin: 0 auto 25px !important;
      font-size: 14px !important;
      line-height: 1.5 !important;
    ">
      Nous utilisons des cookies nécessaires au fonctionnement du site ainsi
      que, avec votre accord, des cookies permettant d’améliorer votre
      expérience.
    </p>

    <button
      type="button"
      style="
        width: 400px !important;
        max-width: 100% !important;
        min-height: 60px !important;
        border: 1px solid white !important;
        border-radius: 0 !important;
        background: white !important;
        color: #111 !important;
        font-family: inherit !important;
        cursor: pointer !important;
      "
    >
      ACCEPTER & FERMER
    </button>
  </div>
</div>

    {{ 'pour-cookie-banner.css' | asset_url | stylesheet_tag }}

    <script
      src="{{ 'pour-cookie-banner.js' | asset_url }}"
      defer
    ></script>
<!-- =========================================================
     POUR — QUICK VIEW
========================================================= -->

<div
  class="pour-quickview-overlay"
  data-pour-quickview-overlay
></div>

<div
  class="pour-quickview"
  data-pour-quickview
  aria-hidden="true"
>

  <button
    type="button"
    class="pour-quickview__close"
    data-pour-quickview-close
    aria-label="Fermer"
  ></button>

  <div
    class="pour-quickview__content"
    data-pour-quickview-content
  ></div>

</div>
    <script
      src="{{ 'theme.js' | asset_url }}"
      defer
    ></script>
<script>
document.addEventListener('mouseover', function(event) {

  const button = event.target.closest(
    'form[action*="/cart/add"] button[type="submit"]'
  );

  if (!button) return;
button.style.setProperty(
  'transition',
  'background-color 0.35s ease, color 0.35s ease, border-color 0.35s ease',
  'important'
);
  const text = button.textContent.trim().toUpperCase();

  if (
    text !== 'AJOUTER AU PANIER' &&
    text !== 'AJOUTER'
  ) {
    return;
  }

  button.style.setProperty(
    'background',
    '#ffffff',
    'important'
  );

  button.style.setProperty(
    'color',
    '#111111',
    'important'
  );

  button.style.setProperty(
    'border-color',
    '#111111',
    'important'
  );

});


document.addEventListener('mouseout', function(event) {

  const button = event.target.closest(
    'form[action*="/cart/add"] button[type="submit"]'
  );

  if (!button) return;

  const text = button.textContent.trim().toUpperCase();

  if (
    text !== 'AJOUTER AU PANIER' &&
    text !== 'AJOUTER'
  ) {
    return;
  }

  button.style.setProperty(
    'background',
    '#111111',
    'important'
  );

  button.style.setProperty(
    'color',
    '#ffffff',
    'important'
  );

  button.style.setProperty(
    'border-color',
    '#111111',
    'important'
  );

});
</script>
  </body>
</html>
